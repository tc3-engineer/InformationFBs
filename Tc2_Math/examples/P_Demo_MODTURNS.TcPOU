<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MODTURNS" Id="{c5180011-0e0e-59e9-805d-208fff358f5b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MODTURNS
VAR
    lrAxisAbsPositionDeg : LREAL := 800.56; // 伺服累计绝对位置（度）；在线写值模拟编码器读数
    lrTurnSizeDeg        : LREAL := 360.0; // 一圈大小（NC 模值范围）
    nCompletedTurns      : DINT; // MODTURNS 输出：朝零截断的整数圈数；DINT 范围限制 ±2^31
    lrAngleInTurnDeg     : LREAL; // LMOD 输出：圈内带符号余数；与 MODTURNS 互补恢复原值
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：长行程伺服 + 转盘——累计角度跑多圈后要拆成"圈数 + 圈内位置"两份显示：
//       圈数给操作员看进度，圈内位置驱动指示灯阵列。MODTURNS + LMOD 是 PDF
//       推荐的标准配对方式。
//
// 价值：MODTURNS 给 DINT 整数圈数可直接喂给计数器/数组下标；与 LMOD 配对
//       一次性分解累计量，省去 LTRUNC + 减法的三步代码。
//
// 验证步骤：
//   1. 引用 Tc2_Math
//   2. 在 PLC 项目右键 → Add Existing Item (.TcPOU) → 选本文件 → OK
//   3. 编译、登录、运行
//   4. 在线 monitor 看：
//      - lrAxisAbsPositionDeg = 800.56 → nCompletedTurns = 2,
//        lrAngleInTurnDeg = 80.56 （2*360 + 80.56 = 800.56 ✓）
//      - 在线改 -400.56 → -1, -40.56 （-1*360 + -40.56 = -400.56 ✓）
//      - 改 720 → 2, 0 （整 2 圈）
//      - 改 359.99 → 0, 359.99 （差一点不到 1 圈）
// 注：MODTURNS 朝零截断；MODABS 不与 MODTURNS 严格互补，配对必须用 LMOD。
// =============================================================================

// 单行调用：MODTURNS 给整数商；返回 DINT 直接用
nCompletedTurns := MODTURNS(lrAxisAbsPositionDeg, lrTurnSizeDeg);

// 与 LMOD 配对：MODTURNS * m + LMOD = 原值（PDF 标准用法）
lrAngleInTurnDeg := LMOD(lrAxisAbsPositionDeg, lrTurnSizeDeg);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
