<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2QueryStatus" Id="{9b78fd57-2ad7-5638-947e-20567158f139}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2QueryStatus
VAR
    fbFB_DALIV2QueryStatus        : FB_DALIV2QueryStatus;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    nLampAddr        : BYTE := 0;

    nQueryData       : BYTE;

    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：巡检读取 short addr 0 的 查询灯具状态字节（8 个状态位的位图）。
//
// 价值：HMI 实时显示 / 上线批量校验用。
//
// 验证步骤：
//   1. 通信 FB 跑起；编译；登录。
//   2. 在线 bTrigger 一次上升沿；等 bBusy 回 FALSE。
//   3. 观察 fbFB_DALIV2QueryStatus.nQueryData 应为预期值（参考本 FB 文档 §4 描述）。
// =============================================================================
fbFB_DALIV2QueryStatus(
    bStart           := bTrigger,
    nAddr            := nLampAddr,
    eAddrType        := eDALIV2AddrTypeShort,
    eCommandPriority := eDALIV2CommandPriorityLow,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2QueryStatus.bBusy;
bErr   := fbFB_DALIV2QueryStatus.bError;
nErrId := fbFB_DALIV2QueryStatus.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
