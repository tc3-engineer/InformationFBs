<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.MEMCMP Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_MEMCMP" pouType="program">
        <interface>
          <localVars>
            <variable name="stCurrent">
              <type><array><dimension lower="0" upper="199"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本次工艺参数缓冲（200 字节）</xhtml></documentation>
            </variable>
            <variable name="stLastSaved">
              <type><array><dimension lower="0" upper="199"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上次落盘版本</xhtml></documentation>
            </variable>
            <variable name="bCompareRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次比较</xhtml></documentation>
            </variable>
            <variable name="nCmpResult">
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">比较结果：-1 / 0 / 1</xhtml></documentation>
            </variable>
            <variable name="bParamsChanged">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 与上次不同，需要落盘</xhtml></documentation>
            </variable>
            <variable name="rtCmp">
              <type><derived name="R_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿检测</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：检查工艺参数结构体（200 字节）是否与上次落盘的版本一致，一致则跳过持久化写盘。
// 价值：一行调用替代 200 次手写逐字节比对。
// 验证：同步两份缓冲区 → 在线触发 bCompareRequest → nCmpResult = 0；故意改 stCurrent 中一个字节 → nCmpResult = 1 或 -1。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

rtCmp(CLK := bCompareRequest);
IF rtCmp.Q THEN
    nCmpResult := MEMCMP(
        pBuf1 := ADR(stCurrent),
        pBuf2 := ADR(stLastSaved),
        n     := SIZEOF(stCurrent)
    );
    // 业务侧：非 0 即视为有变化
    bParamsChanged := (nCmpResult &lt;&gt; 0);
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
