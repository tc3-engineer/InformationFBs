<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_GetRtPerformanceData" Id="{0863bd6d-3283-509b-bb55-f884b191bca8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_GetRtPerformanceData
VAR
    fbFB_GetRtPerformanceData : FB_GetRtPerformanceData; // FB_GetRtPerformanceData 实例
    bExecute                  : BOOL;
    bReset                    : BOOL;
    tTimeout                  : TIME;
    sNetId                    : T_AmsNetId;
    bBusy                     : BOOL;
    bError                    : BOOL;
    nErrorId                  : UDINT;
    nUsedCpuCount             : UDINT;
    stRtPerformanceData       : ARRAY[1..nMaxCpuCount] OF ST_RtPerformanceData;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：深度性能分析。
// 价值：综合字段。
// 验证：触发后 stPerf 装载多个字段。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_GetRtPerformanceData(
    bExecute := bExecute,
    bReset := bReset,
    tTimeout := tTimeout,
    sNetId := sNetId,
    bBusy := bBusy,
    bError := bError,
    nErrorId := nErrorId,
    nUsedCpuCount := nUsedCpuCount,
    stRtPerformanceData := stRtPerformanceData
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
