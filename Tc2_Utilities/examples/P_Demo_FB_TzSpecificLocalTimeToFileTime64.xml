  <contentHeader name="Tc2_Utilities.FB_TzSpecificLocalTimeToFileTime64 Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TzSpecificLocalTimeToFileTime64" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_TzSpecificLocalTimeToFileTime64">
              <type><derived name="FB_TzSpecificLocalTimeToFileTime64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_TzSpecificLocalTimeToFileTime64 实例</xhtml></documentation>
            </variable>
            <variable name="bConv">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTz">
              <type><derived name="TIME_ZONE_INFORMATION"/></type>
            </variable>
            <variable name="stLocal">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
            <variable name="stFtOut">
              <type><derived name="T_ULARGE_INTEGER"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：本地时间转 FileTime。
// 价值：等价 Win32 API。
// 验证：给 stLocal 当前本地时间，转换后 stFtOut 应为合理 FileTime。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_TzSpecificLocalTimeToFileTime64(
    tzInfo := stTz, bExecute := bConv, stLocal := stLocal,
    stFileTime =&gt; stFtOut
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
