  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileTime64ToTzSpecificLocalTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_FileTime64ToTzSpecificLocalTime">
              <type><derived name="FB_FileTime64ToTzSpecificLocalTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileTime64ToTzSpecificLocalTime 实例</xhtml></documentation>
            </variable>
            <variable name="bConv">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTz">
              <type><derived name="TIME_ZONE_INFORMATION"/></type>
            </variable>
            <variable name="stFt">
              <type><derived name="T_ULARGE_INTEGER"/></type>
            </variable>
            <variable name="stLocalOut">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读文件修改 FileTime 转本地。
// 价值：封装 epoch + 时区计算。
// 验证：给 stFt 填一个典型 FileTime（如 130428000000000000，约 2014 年），转换后 stLocalOut 应为合理本地时间。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_FileTime64ToTzSpecificLocalTime(
    tzInfo := stTz, bExecute := bConv, stFileTime := stFt,
    stLocal =&gt; stLocalOut
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
