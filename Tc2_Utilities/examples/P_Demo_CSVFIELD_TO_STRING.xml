  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_CSVFIELD_TO_STRING" pouType="program">
        <interface>
          <localVars>
            <variable name="sRawField"><initialValue><simpleValue value="&quot;PumpAlpha&quot;"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：CSV 原始字段</xhtml></documentation></variable>
            <variable name="sCleanField"><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">去引号后的纯字段</xhtml></documentation></variable>
            <variable name="bParse"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读 CSV 文本配置：纯字符串字段（设备名、操作员名）的逐字段提取。
// 价值：替代手写 `STRTOK` + 引号处理；本函数 1 行带 CSV 规范遵守。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bParse THEN
    sCleanField := CSVFIELD_TO_STRING(in := sRawField, bQM := TRUE);
    bParse := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
