    <pous>
      <pou name="P_Demo_TC_CoreBoostMonitor" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCBM">
              <type><derived name="TC_CoreBoostMonitor"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TC_CoreBoostMonitor 实例（默认 nCoreId=-1）</xhtml></documentation>
            </variable>
            <variable name="hrResult">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">方法返回 HRESULT</xhtml></documentation>
            </variable>
            <variable name="bThermalAny">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">任一核因温度限频</xhtml></documentation>
            </variable>
            <variable name="bPowerAny">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">任一核因功率限频</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.TC_CoreBoostMonitor 演示程序（FB 实例）
// ============================================================
// 注意：必须 Intel Core i 11 代+ 且 TwinCAT Core Boost 已启用
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. Real-time Settings 启用 Core Boost
//   3. 编译 + 登录
//   4. 在线监视 fbCBM.bError / fbCBM.hrErrorCode
// ============================================================

hrResult := fbCBM.GetAllRtCoreThrottling(bThermalAny, bPowerAny);
</xhtml>
          </ST>
        </body>
      </pou>
