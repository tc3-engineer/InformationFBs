<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_IDN_Write Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_IDN_Write" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSercosIdnWrite">
              <type><derived name="IOF_SER_IDN_Write"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS IDN 写 FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nIdnToWrite">
              <initialValue><simpleValue value="100"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要写的 IDN</xhtml></documentation>
            </variable>
            <variable name="bStartIdnWrite">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="nDrivePort">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive port</xhtml></documentation>
            </variable>
            <variable name="nCachedAttrib">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已知属性</xhtml></documentation>
            </variable>
            <variable name="aWriteBuffer">
              <type><array><dimension lower="1" upper="4"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要写入的数据缓冲（4 字节 = DINT 大小）</xhtml></documentation>
            </variable>
            <variable name="cbWriteBufferLen">
              <initialValue><simpleValue value="4"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">缓冲长度</xhtml></documentation>
            </variable>
            <variable name="tIdnWriteTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="nWriteAttribOut">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">属性返回</xhtml></documentation>
            </variable>
            <variable name="stWriteAttribDecoded">
              <type><derived name="ST_SercosParamAttrib"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">属性分解</xhtml></documentation>
            </variable>
            <variable name="bIdnWriteBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bIdnWriteErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nIdnWriteErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：调试期：phase 2 下把 drive 1 的 IDN-100 写为工程定制值。
// 价值：参数纳入 PLC 程序版本控制。
// 验证：先用 IOF_SER_SetPhase 切到 phase 2；填好 aWriteBuffer 含要写入的值，写 bStartIdnWrite := TRUE → bIdnWriteBusy 短暂 TRUE → 回 FALSE 后 nIdnWriteErrId = 0 表示成功；再用 IOF_SER_IDN_Read 读回校验。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次调用；PDF VAR 描述写 dwDestAddr，但实际入口名是 dwSrcAddr（写时用 dwSrcAddr）
fbSercosIdnWrite(
    sNetId    := sLocalNetId,
    nIDN      := nIdnToWrite,
    bExecute  := bStartIdnWrite,
    nPort     := nDrivePort,
    nAttrib   := nCachedAttrib,
    cbLen     := cbWriteBufferLen,
    dwSrcAddr := ADR(aWriteBuffer),
    tTimeout  := tIdnWriteTimeout,
    nAttribRd =&gt; nWriteAttribOut,
    sAttrib   =&gt; stWriteAttribDecoded,
    bBusy     =&gt; bIdnWriteBusy,
    bError    =&gt; bIdnWriteErr,
    nErrId    =&gt; nIdnWriteErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
