<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.ADSRDWRT Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ADSRDWRT" pouType="program">
        <interface>
          <localVars>
            <variable name="fbADSRDWRT">
              <type><derived name="ADSRDWRT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADSRDWRT 实例</xhtml></documentation>
            </variable>
            <variable name="bReadSymReq">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发一次按名读</xhtml></documentation>
            </variable>
            <variable name="sSymbolName">
              <initialValue><simpleValue value="'.fActualPosition'"/></initialValue>
              <type><string><length>80</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">对端 PLC 全局变量名（前导点）</xhtml></documentation>
            </variable>
            <variable name="nSymNameLen">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">运行时填入 LEN(sSymbolName)+1</xhtml></documentation>
            </variable>
            <variable name="rRemoteValue">
              <type><LREAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读到的值</xhtml></documentation>
            </variable>
            <variable name="bAdsBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">正在读</xhtml></documentation>
            </variable>
            <variable name="bAdsErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误</xhtml></documentation>
            </variable>
            <variable name="nLastAdsError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误码</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.ADSRDWRT 演示程序
// ============================================================
// 场景：主 PLC 跨 ADS 按名读取从 PLC 的 .fActualPosition 做位置融合。
// 价值：替代两步 ADSWRITE 拿句柄 + ADSREAD 拿值，单次往返省延迟。
// 验证：登录后 bReadSymReq := TRUE，bAdsBusy 闪一下后 rRemoteValue 装入对端实际位置。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 字符串长度包含 STRING 终止符
nSymNameLen := LEN(sSymbolName) + 1;

fbADSRDWRT(
    NETID := '', PORT := 851, IDXGRP := 16#0000F004, IDXOFFS := 0, WRITELEN := nSymNameLen, READLEN := SIZEOF(rRemoteValue), SRCADDR := ADR(sSymbolName), DESTADDR := ADR(rRemoteValue), WRTRD := bReadSymReq, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY =&gt; bAdsBusy, ERR =&gt; bAdsErr, ERRID =&gt; nLastAdsError
);

</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
