<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.SendMessage2 Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_SendMessage2" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLogger">
              <type><derived name="FB_TcEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EventLogger 实例</xhtml></documentation>
            </variable>
            <variable name="guidEventClass">
              <type><derived name="GUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件类 GUID</xhtml></documentation>
            </variable>
            <variable name="sBatchId">
              <initialValue><simpleValue value="'B-2026-0511-001'"/></initialValue>
              <type><string><length>64</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">批次号</xhtml></documentation>
            </variable>
            <variable name="sJsonAttribute">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拼接好的完整 JSON</xhtml></documentation>
            </variable>
            <variable name="bRecipeChange">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">配方切换信号</xhtml></documentation>
            </variable>
            <variable name="bRecipeChangePrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：配方切换审计带批次上下文
// 价值：一次调用完成事件 + JSON 附加
// 验证：登录后写 bRecipeChange := TRUE，HMI EventLogger 事件详情应能看到 JSON 字段含 batch id
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 拼接 JSON
sJsonAttribute := CONCAT('{"batch":"', CONCAT(sBatchId, '"}'));

// 边沿触发：发送 message 同时附 JSON 上下文
IF bRecipeChange AND NOT bRecipeChangePrev THEN
    hr := fbLogger.SendMessage2(
        eventClass := guidEventClass,
        nEventId := 3002,
        eSeverity := TcEventSeverity.Info,
        ipSourceInfo := 0,
        nTimeStamp := 0,
        ipArguments := 0,
        sJsonAttribute := sJsonAttribute);
END_IF;
bRecipeChangePrev := bRecipeChange;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
