  <contentHeader name="Tc2_Utilities.FB_TzSpecificLocalTimeToSystemTime Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TzSpecificLocalTimeToSystemTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_TzSpecificLocalTimeToSystemTime">
              <type><derived name="FB_TzSpecificLocalTimeToSystemTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_TzSpecificLocalTimeToSystemTime 实例</xhtml></documentation>
            </variable>
            <variable name="bConvert">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTz">
              <type><derived name="TIME_ZONE_INFORMATION"/></type>
            </variable>
            <variable name="stLocal">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
            <variable name="stUtcOut">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 本地时间转 UTC 存数据库。
// 价值：本地 + UTC 两全。
// 验证：给 stLocal 填本地时间，触发后 stUtcOut 应为减去时区偏移的 UTC。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_TzSpecificLocalTimeToSystemTime(
    tzInfo := stTz, bExecute := bConvert, stLocal := stLocal,
    stUTC =&gt; stUtcOut
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
