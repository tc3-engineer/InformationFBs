  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_WSTRNCPY" pouType="program">
        <interface>
          <localVars>
            <variable name="wsSrc"><initialValue><simpleValue value="&quot;HMI text alpha&quot;"/></initialValue><type><wstring><length>255</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：源 WSTRING</xhtml></documentation></variable>
            <variable name="wsDst"><type><wstring><length>64</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 WSTRING</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完整复制</xhtml></documentation></variable>
            <variable name="nSrcLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">源字符数</xhtml></documentation></variable>
            <variable name="nDstLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标字符数</xhtml></documentation></variable>
            <variable name="bCopy"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 字符串缓冲动态复制——索引可能越界，比 `:=` 更安全。
// 价值：`Tc2_Standard.WSTRNCPY` ⚠️ 不存在（标准库无对应）——本函数填补 WSTRING 安全复制空缺。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bCopy THEN
    bOk := WSTRNCPY(pDst     := ADR(wsDst),
                    pSrc     := ADR(wsSrc),
                    nDstSize := SIZEOF(wsDst),
                    nSrcLen  => nSrcLen,
                    nDstLen  => nDstLen);
    bCopy := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
