    </dataTypes>
    <pous>
      <pou name="P_Demo_F_BIGTYPE" pouType="program">
        <interface>
          <localVars>
            <variable name="stCurrentRecipe"><type><derived name="ST_Recipe"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前配方</xhtml></documentation>
            </variable>
            <variable name="argRecipe"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">配方打包后的 T_Arg</xhtml></documentation>
            </variable>
            <variable name="bPackRecipe"><type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 触发一次打包</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.F_BIGTYPE 演示程序
// ============================================================
// 场景：把整段配方结构体作为一个 T_Arg 送给 EventLogger 当报警上下文。
// 价值：结构体没有专用 F_&lt;TYPE&gt;，本函数按字节打包；下游靠 cbLen 取整段。
// 验证：在线写 stCurrentRecipe.nRecipeId := 7、bPackRecipe := TRUE；
//       下一周期 argRecipe.cbLen 应等于 SIZEOF(stCurrentRecipe)，argRecipe.pData &lt;&gt; 0。
// ============================================================

IF bPackRecipe THEN
    // 用 ADR + SIZEOF 把整个结构体打包，eType 自动选 BIGTYPE 枚举
    argRecipe := F_BIGTYPE(pData := ADR(stCurrentRecipe),
                           cbLen := SIZEOF(stCurrentRecipe));
    bPackRecipe := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
