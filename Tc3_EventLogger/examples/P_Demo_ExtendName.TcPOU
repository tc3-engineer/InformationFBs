<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ExtendName" Id="{67e7a3f4-3f43-5b08-9bfd-1b0a59347837}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ExtendName
VAR
    fbSrc         : FB_TcSourceInfo; // 源信息实例
    sStationId    : STRING(40) := 'Station-01'; // 工位号后缀
    bDoExtend     : BOOL := FALSE; // 上升沿触发
    bDoExtendPrev : BOOL; // 边沿检测
    hr            : HRESULT; // 返回值监视
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：给当前工位的 SourceInfo 加工位号后缀
// 价值：事件天然带工位标识
// 验证：登录后调用一次 ExtendName 后 fbSrc.sSourceName 应包含 sExtName 内容
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoExtend AND NOT bDoExtendPrev THEN
    hr := fbSrc.ExtendName(sExtName := sStationId);
END_IF;
bDoExtendPrev := bDoExtend;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
