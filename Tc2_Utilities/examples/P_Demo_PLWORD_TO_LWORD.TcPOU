<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PLWORD_TO_LWORD" Id="{aef5931e-11d0-502c-a834-5ec43413cac2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PLWORD_TO_LWORD
VAR
    nRealValue           : LWORD := 16#0123456789ABCDEF; // 模拟 wire 缓冲区中的 LWORD 字段
    pLWORDField          : POINTER TO LWORD; // 业务侧先算好的字段地址（ADR 或 pBase+nOff）
    bExtractField        : BOOL; // 在线置 TRUE 触发一次解析
    nRealValue_extracted : LWORD; // 解析后的副本，供业务逻辑使用
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.PLWORD_TO_LWORD 演示程序（FUNCTION）
// ============================================================
// 场景：从一段二进制 wire 缓冲区里按偏移取 LWORD 字段（Modbus/CAN/ADS Raw）。
// 价值：替代手写 pField + nOff + ^ 指针算术；一次调用取值，少打错符号。
// 验证：在线写 nRealValue := 16#0123456789ABCDEF；bExtractField := TRUE；
//       下一周期 nRealValue_extracted 应等于 nRealValue。
// ============================================================

// 业务代码通常已经算好字段地址（pBase + 协议偏移）；演示用 ADR 等价
pLWORDField := ADR(nRealValue);

IF bExtractField AND pLWORDField <> 0 THEN
    // 单次完整调用：避免手写 ^ 解引用，统一风格便于和字节序转换串联
    nRealValue_extracted := PLWORD_TO_LWORD(pLWORDField);
    bExtractField := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
