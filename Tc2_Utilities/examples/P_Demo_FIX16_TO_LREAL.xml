  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FIX16_TO_LREAL" pouType="program">
        <interface>
          <localVars>
            <variable name="bResult">
              <type><LREAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FIX16_TO_LREAL 的返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
            <variable name="fp">
              <type><derived name="T_FIX16"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测试用本地变量</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FIX16_TO_LREAL 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及依赖类型所在的库）
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 观察 bResult 应为 12.5（当 fp 来自 LREAL_TO_FIX16(12.5, 8)）
// ============================================================

fp := LREAL_TO_FIX16(12.5, 8);
IF bRun THEN
    bResult := FIX16_TO_LREAL(fp);
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
