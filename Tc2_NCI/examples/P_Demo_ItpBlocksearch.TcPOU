<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ItpBlocksearch" Id="{7bc941f3-0e66-59d9-a45e-31d8391adbdf}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ItpBlocksearch
VAR
    fbItpBlocksearch                      : ItpBlocksearch;  // 被演示 FB 实例
    rtTrig                                : R_TRIG;  // 边沿触发器，把人工『按一下』转上升沿
    bDoIt                                 : BOOL := FALSE;  // 在线写 TRUE 触发一次
    nBlockId_in                           : UDINT := 0;
    eBlockSearchMode_in                   : E_ItpBlockSearchMode;
    eDryRunMode_in                        : E_ItpDryRunMode;
    fLength_in                            : LREAL := 0.0;
    sPrgName_in                           : STRING(255) := '';  // 见 §3
    nPrgLength_in                         : UDINT := 0;
    tTimeOut_in                           : TIME := T#2S;  // ADS 调用超时
    sAxesList_in                          : ST_ItpAxes;
    sOptions_in                           : ST_ItpBlockSearchOptions;
    sNciToPlc_inst                        : NCTOPLC_NCICHANNEL_REF;  // VAR_IN_OUT 引用对象
    bBusy_out                             : BOOL;
    bErr_out                              : BOOL;
    nErrId_out                            : UDINT;
    bDone_out                             : BOOL;
    sStartPosition_out                    : ST_ItpBlockSearchStartPosition;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_NCI.ItpBlocksearch 演示程序
// ============================================================
// 场景：CNC 加工到一半暂停（换刀 / 班次结束），第二天从指定段续接执行。
// 价值：把『跳到某段』封装成『记录数据 + 定位解释器 + 续接执行』三步骤，避免手算 G-Code 跳段。
// 验证：前置：用 ItpGetBlocksearchData 记下当前位置；调本 FB 定位；操作员手动把物理轴搬到 sStartPosition；最后 ItpStepOnAfterBlocksearch 续接。在线观察 bDone → TRUE。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_NCI（References → Add library）
//   3. 在 System Manager 把 NCI 通道接口 Link 给 sNciToPlc_inst / sPlcToNci_inst
//      （NCTOPLC_NCICHANNEL_REF 给 AT %I*、PLCTONC_NCICHANNEL_REF 给 AT %Q*）
//   4. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 把人工按下的电平转成真正的上升沿；这是 bExecute 系列引脚的标准用法
rtTrig(CLK := bDoIt);

// 单次完整调用：所有 VAR_INPUT / VAR_IN_OUT / VAR_OUTPUT 引脚显式赋值或绑定
fbItpBlocksearch(
    bExecute         := rtTrig.Q,
    nBlockId         := nBlockId_in,
    eBlockSearchMode := eBlockSearchMode_in,
    eDryRunMode      := eDryRunMode_in,
    fLength          := fLength_in,
    sPrgName         := sPrgName_in,
    nPrgLength       := nPrgLength_in,
    tTimeOut         := tTimeOut_in,
    sAxesList        := sAxesList_in,
    sOptions         := sOptions_in,
    sNciToPlc        := sNciToPlc_inst,
    bBusy            => bBusy_out,
    bErr             => bErr_out,
    nErrId           => nErrId_out,
    bDone            => bDone_out,
    sStartPosition   => sStartPosition_out
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
