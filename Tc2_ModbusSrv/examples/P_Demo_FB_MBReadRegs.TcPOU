<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MBReadRegs" Id="{e8aeeebd-3dda-5546-89fe-d2392fdf176a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MBReadRegs
VAR
    fbReadRegs    : FB_MBReadRegs;
    sTargetIp     : STRING(15) := '192.168.1.50';   // 目标 Modbus 设备 IP（按现场改）
    bTrigger      : BOOL;          // 在线置一次上升沿触发本次访问
    bBusy         : BOOL;          // 在线 monitor：执行中为 TRUE
    bError        : BOOL;          // 出错置 TRUE
    nErrId        : UDINT;         // 出错时的 ADS/Modbus 错误码
    nReadCount    : UDINT;         // 实际读到的字节数
    arrData       : ARRAY [0..1] OF WORD;   // 读回数据落点
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ModbusSrv.FB_MBReadRegs 演示程序（Modbus TCP 客户端 / 主站）
// ============================================================
// 场景：读取变频器、温控表、电表等 Modbus 设备的保持寄存器，例如读回设定频率、实际转速、累计电量等 16 位过程量。
// 价值：保持寄存器是最常用的 Modbus 数据区；本 FB 把功能码 3 封装为一次调用，按字节序自动落入 `WORD` 数组，省去拼包解包。
// 验证：登录后在线置 bTrigger := TRUE 触发一次；观察 bBusy 在数个周期后回 FALSE，
//       bError 应为 FALSE、nErrId 应为 0；若对端不在线则 bError=TRUE 且 nErrId 含超时码。
//       本例：读 2 个保持寄存器（如频率+转速）
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ModbusSrv（References → Add library），并确保 TF6250 Modbus TCP 已授权运行
//   3. 把 sTargetIp 改成现场 Modbus 设备 IP；编译 → 登录 → 运行
//   4. 在线脉冲 bTrigger，按上方『验证』观察输出
// ============================================================

// 单次完整调用：所有 VAR_INPUT 显式赋值；bExecute 边沿触发一次
fbReadRegs(
    sIPAddr   := sTargetIp,
    nTCPPort  := MODBUS_TCP_PORT,
    nUnitID   := 16#FF,
    nQuantity := 2,
    nMBAddr   := 0,
    cbLength  := SIZEOF(arrData),
    pDestAddr := ADR(arrData),
    bExecute  := bTrigger,
    tTimeout  := T#5S,
    bBUSY     => bBusy,
    bError    => bError,
    nErrId    => nErrId,
    cbRead    => nReadCount
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
