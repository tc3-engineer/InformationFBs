<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_SaveFlash Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_SaveFlash" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSercosSaveFlash">
              <type><derived name="IOF_SER_SaveFlash"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS 配置保存到 EEPROM FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nSercosDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="bSaveConfigReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 按钮：保存配置（上升沿触发）</xhtml></documentation>
            </variable>
            <variable name="tSaveTimeout">
              <initialValue><simpleValue value="T#10S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时（EEPROM 写较慢）</xhtml></documentation>
            </variable>
            <variable name="bSaveBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bSaveErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：调试完 SERCOS 参数后，工程师 HMI 点"保存配置"按钮，写入主站 EEPROM。
// 价值：避免每次重启重配。
// 验证：⚠️ 不要随便测试——会写 EEPROM。仅在工程师确认参数无误时触发：写 bSaveConfigReq := TRUE → bSaveBusy 短暂 TRUE → 回 FALSE 后 nLastErrCode = 0 表示写入成功。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：本 FB 会写 EEPROM，10 万次寿命；不要循环调用！
// 仅在工程师手动触发时调用。
fbSercosSaveFlash(
    NETID    := sLocalNetId,
    DEVICEID := nSercosDeviceId,
    SAVE     := bSaveConfigReq,
    TMOUT    := tSaveTimeout,
    BUSY     =&gt; bSaveBusy,
    ERR      =&gt; bSaveErr,
    ERRID    =&gt; nLastErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
