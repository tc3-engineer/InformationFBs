<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_ScopeServerControl Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_ScopeServerControl" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_ScopeServerControl">
              <type><derived name="FB_ScopeServerControl"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_ScopeServerControl 实例</xhtml></documentation>
            </variable>
            <variable name="sNetId">
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="eReqState">
              <initialValue><simpleValue value="SCOPE_SERVER_IDLE"/></initialValue>
              <type><derived name="E_ScopeServerState"/></type>
            </variable>
            <variable name="sConfigFile">
              <type><string><length>80</length></string></type>
            </variable>
            <variable name="sSaveFile">
              <type><string><length>80</length></string></type>
            </variable>
            <variable name="tTimeout">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="bExternalTriggerEvent">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bDone">
              <type><BOOL/></type>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrorId">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：异常时录波。
// 价值：自动化诊断。
// 验证：触发 Start → 几秒 Stop → Scope 目录里有新波形文件。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_ScopeServerControl(
    sNetId := sNetId,
    eReqState := eReqState,
    sConfigFile := sConfigFile,
    sSaveFile := sSaveFile,
    tTimeout := tTimeout,
    bExternalTriggerEvent := bExternalTriggerEvent,
    bBusy =&gt; bBusy,
    bDone =&gt; bDone,
    bError =&gt; bError,
    nErrorId =&gt; nErrorId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
