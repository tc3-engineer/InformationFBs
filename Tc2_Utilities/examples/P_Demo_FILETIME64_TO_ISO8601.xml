  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FILETIME64_TO_ISO8601" pouType="program">
        <interface>
          <localVars>
            <variable name="rResult">
              <type><string><stringLength><value>39</value></stringLength></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FILETIME64_TO_ISO8601 的返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
            <variable name="ftIn">
              <type><derived name="T_FILETIME64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测试用本地变量</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FILETIME64_TO_ISO8601 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及类型所在依赖库 Tc2_System / Tc2_Standard）
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 观察 rResult 应为 '2024-01-01T13:00:00.000+01:00'（本地时间 +60 min）
// ============================================================

ftIn := DT_TO_FILETIME64(DT#2024-01-01-12:00:00);
IF bRun THEN
    rResult := FILETIME64_TO_ISO8601(ftIn, 60, FALSE, 3);
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
