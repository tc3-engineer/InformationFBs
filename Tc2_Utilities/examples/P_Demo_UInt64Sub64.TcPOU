<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Sub64" Id="{a8cd7429-0eaf-59a2-89ea-4dd5c010b43b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Sub64
VAR
    uliEnd      : T_ULARGE_INTEGER;; // 结束时间戳
    uliStart    : T_ULARGE_INTEGER;; // 起始时间戳
    uliDuration : T_ULARGE_INTEGER;; // 持续时间
    bCompute    : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Sub64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：算两个 64 位时间戳的差值（ts_end − ts_start），前置校验 end ≥ start 避免回绕。
// 价值：替代手写双倍长减法 + 借位；一次调用搞定。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCompute AND UInt64Cmp64(uliEnd, uliStart) >= 0 THEN
    // 前置校验避免下溢回绕到一个超大数
    uliDuration := UInt64Sub64(uliEnd, uliStart);
    bCompute := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
