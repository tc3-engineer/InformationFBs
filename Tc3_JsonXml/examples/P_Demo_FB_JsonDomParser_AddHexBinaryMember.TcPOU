<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonDomParser_AddHexBinaryMember" Id="{56ba9033-fbaa-54e8-826b-61290ab28c3f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonDomParser_AddHexBinaryMember
VAR
    fbParser : FB_JsonDomParser; // 父 FB 实例
    v : SJsonValue;
    p : PVOID;
    n : DINT;
    member : STRING(255);
    vRet : SJsonValue; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：组装 JSON 报文时往对象里加 HexBinary 类型的字段（如批次号、温度采样值、报警码等）。
// 价值：单次调用即写键值对，无需自己组字符串避免转义问题。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.AddHexBinaryMember(
        v := v,
        p := p,
        n := n,
        member := member
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
