<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_WritePersistentData" Id="{0301200b-9088-5d18-8293-02b23c7bf94d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_WritePersistentData
VAR
    fbWritePersistentData : WritePersistentData; // WritePersistentData 实例
    bWrite                : BOOL := FALSE;
    bBusy_                : BOOL;
    bErrFlag              : BOOL;
    nErrCode              : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：兼容旧项目。
// 价值：向后兼容。
// 验证：同 FB_WritePersistentData。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbWritePersistentData(
    NETID := '', PORT := 851, START := bWrite, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY => bBusy_, ERR => bErrFlag, ERRID => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
