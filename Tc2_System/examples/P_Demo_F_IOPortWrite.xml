<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_IOPortWrite Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_IOPortWrite" pouType="program">
        <interface>
          <localVars>
            <variable name="nPcSpeakerPort">
              <initialValue><simpleValue value="16#61"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PC 蜂鉣器控制端口</xhtml></documentation>
            </variable>
            <variable name="nValueToWrite">
              <initialValue><simpleValue value="16#03"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">蜂鉣器使能位（PDF 示例中的开启值）</xhtml></documentation>
            </variable>
            <variable name="bBeepRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次写入</xhtml></documentation>
            </variable>
            <variable name="bWriteOk">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = API 接受写入</xhtml></documentation>
            </variable>
            <variable name="rtBeep">
              <type><derived name="R_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿检测</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：实现简易 PC 蜂鉣器报警：通过写主板端口 0x61 控制扬声器产生短促提示音（PDF FB_Speaker 示例）。
// 价值：不用外置蜂鉣硬件，软件直接驱动 PC 主板内置蜂鉣器。
// 验证：bBeepRequest := TRUE → PC 主板蜂鉣器发出短促提示音；bWriteOk 应为 TRUE。注意：用错端口可能损坏硬件！
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 上升沿触发：避免连续写端口（连续写蜂鉣器会持续响）
// 警告：端口地址 0x61 是 PC 蜂鉣器控制；其它地址可能损坏硬件
rtBeep(CLK := bBeepRequest);
IF rtBeep.Q THEN
    bWriteOk := F_IOPortWrite(
        nAddr  := nPcSpeakerPort,
        eSize  := IOAS_BYTE,
        nValue := nValueToWrite
    );
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
