<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IOF_CAN_Layer2Command" Id="{6d6ab45b-ea97-510b-acfa-0bc06573838a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IOF_CAN_Layer2Command
VAR
    fbCanLayer2     : IOF_CAN_Layer2Command; // CAN layer-2 命令 FB
    sTargetNetId    : T_AmsNetId := ''; // 本机
    nCanDeviceId    : UDINT := 1; // CAN 主站 Device Id
    nCanNodeAddr    : WORD := 0; // 目标节点
    aCanLayer2Data  : ARRAY[1..5] OF WORD; // 10 字节 CAN layer-2 命令
    bStartCanCmd    : BOOL := FALSE; // 上升沿触发
    tCanCmdTimeout  : TIME := T#5S; // 超时
    bCanCmdBusy     : BOOL; // 工作中
    bCanCmdError    : BOOL; // 出错
    nLastCanErrCode : UDINT; // 错误号
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HILSCHER CIF3xx ISA 卡 + CANopen 现场总线：发原始 CAN 帧做诊断（如手动触发 NMT 复位）。
// 价值：维护早期老工程的诊断能力。
// 验证：⚠️ TwinCAT 3 不支持本功能；本例程仅作"代码兼容性参考"，运行时不会真正发出 CAN 报文。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 注：PDF VAR_INPUT 漏列 LEN/SRCADDR，但描述列说有；按描述列调用
fbCanLayer2(
    NETID    := sTargetNetId,
    DEVICEID := nCanDeviceId,
    BOXADDR  := nCanNodeAddr,
    START    := bStartCanCmd,
    TMOUT    := tCanCmdTimeout,
    BUSY     => bCanCmdBusy,
    ERR      => bCanCmdError,
    ERRID    => nLastCanErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
