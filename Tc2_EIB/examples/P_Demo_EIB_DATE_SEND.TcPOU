<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_DATE_SEND" Id="{cd8208fd-a8a2-5e9a-9632-ca5ff83f2b23}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_DATE_SEND
VAR
    fbSendDate  : EIB_DATE_SEND;
    stEibRec    : EIB_REC;
    stGroup     : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 0, NUMBER := 1);
    wDay        : WORD := 3;
    wMonth      : WORD := 6;
    wYear       : WORD := 2026;   // 库自动减 2000 = 26
    bSendError  : BOOL;
    iLastErrID  : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_DATE_SEND 演示程序
// ============================================================
// 场景：BMS 主时钟 PLC：把当前日期每 5 分钟广播到组 1/0/1。
// 价值：DPT 11 标准发送；零代码实现日期广播
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：登录 → BMS 接收端应每 5 分钟看到 1/0/1 出 3 byte 日期帧。
// ============================================================

fbSendDate(
    Group_Address := stGroup,
    wDay          := wDay,
    wMonth        := wMonth,
    wYear         := wYear,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
