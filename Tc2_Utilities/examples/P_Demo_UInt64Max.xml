  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Max" pouType="program">
        <interface>
          <localVars>
            <variable name="uliA">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">传感器 A 计数</xhtml></documentation>
            </variable>
            <variable name="uliB">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">传感器 B 计数</xhtml></documentation>
            </variable>
            <variable name="uliMax">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">较大者</xhtml></documentation>
            </variable>
            <variable name="bPick">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Max 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：多路温度传感器读回 64 位计数，取最大值做超温报警阈值比对。
// 价值：替代手写比较 + 选择；一次调用，可读性更高。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bPick THEN
    uliMax := UInt64Max(uliA, uliB);
    bPick := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
