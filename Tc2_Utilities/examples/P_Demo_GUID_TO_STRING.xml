  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GUID_TO_STRING" pouType="program">
        <interface>
          <localVars>
            <variable name="stGuid"><type><derived name="GUID"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：UA App ID</xhtml></documentation></variable>
            <variable name="sStr"><type><string><length>36</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">格式化字符串</xhtml></documentation></variable>
            <variable name="bFormat"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：OPC UA Application URI 写入数据库——数据库习惯无大括号 UUID；本函数直接输出可入库格式。
// 价值：替代手写 16 字节 → hex + 连字符拼接。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bFormat THEN
    sStr := GUID_TO_STRING(stIn := stGuid);
    bFormat := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
