<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARSunProtectionEx" Id="{ec066adf-270f-59c6-97bf-abc6e71bce25}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARSunProtectionEx
VAR
    fb : FB_BARSunProtectionEx;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bEnable_in : BOOL := FALSE;
    stTimeAct_in : TIMESTRUCT ;
    stBlindPositionTable_in : ST_BARBlindPositionTable ;
    uiPositioningInterval_io : UINT := 0;
    lrDegreeOfLongitude_io : LREAL := 0.0;
    lrDegreeOfLatitude_io : LREAL := 0.0;
    lrFacadeOrientation_io : LREAL := 0.0;
    lrFacadeAngle_io : LREAL := 0.0;
    uiLouvreWidth_io : UINT := 0;
    uiLouvreSpacing_io : UINT := 0;
    uiFixedShutterHeight_io : UINT := 0;
    uiMaxLightIncidence_io : UINT := 0;
    uiWindowHeight_io : UINT := 0;
    uiWindowDistanceFloor_io : UINT := 0;
    ePositioningMode_io : E_BARPOSMODE ;
    stSunblind_out : ST_BARSunblind;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARSunProtectionEx 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARSunProtectionEx.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bEnable := bEnable_in,
    stTimeAct := stTimeAct_in,
    stBlindPositionTable := stBlindPositionTable_in,
    uiPositioningInterval := uiPositioningInterval_io,
    lrDegreeOfLongitude := lrDegreeOfLongitude_io,
    lrDegreeOfLatitude := lrDegreeOfLatitude_io,
    lrFacadeOrientation := lrFacadeOrientation_io,
    lrFacadeAngle := lrFacadeAngle_io,
    uiLouvreWidth := uiLouvreWidth_io,
    uiLouvreSpacing := uiLouvreSpacing_io,
    uiFixedShutterHeight := uiFixedShutterHeight_io,
    uiMaxLightIncidence := uiMaxLightIncidence_io,
    uiWindowHeight := uiWindowHeight_io,
    uiWindowDistanceFloor := uiWindowDistanceFloor_io,
    ePositioningMode := ePositioningMode_io,
    stSunblind => stSunblind_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
