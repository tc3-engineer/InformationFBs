<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PDT_TO_DT" Id="{f1849cba-431c-5ab3-9d5d-7c228ab3b818}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PDT_TO_DT
VAR
    dtRealValue           : DT := DT#2026-05-11-12:34:56; // 模拟 wire 缓冲区中的 DT 字段
    pDTField              : POINTER TO DT; // 业务侧先算好的字段地址（ADR 或 pBase+nOff）
    bExtractField         : BOOL; // 在线置 TRUE 触发一次解析
    dtRealValue_extracted : DT; // 解析后的副本，供业务逻辑使用
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.PDT_TO_DT 演示程序（FUNCTION）
// ============================================================
// 场景：从一段二进制 wire 缓冲区里按偏移取 DT 字段（Modbus/CAN/ADS Raw）。
// 价值：替代手写 pField + nOff + ^ 指针算术；一次调用取值，少打错符号。
// 验证：在线写 dtRealValue := DT#2026-05-11-12:34:56；bExtractField := TRUE；
//       下一周期 dtRealValue_extracted 应等于 dtRealValue。
// ============================================================

// 业务代码通常已经算好字段地址（pBase + 协议偏移）；演示用 ADR 等价
pDTField := ADR(dtRealValue);

IF bExtractField AND pDTField <> 0 THEN
    // 单次完整调用：避免手写 ^ 解引用，统一风格便于和字节序转换串联
    dtRealValue_extracted := PDT_TO_DT(pDTField);
    bExtractField := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
