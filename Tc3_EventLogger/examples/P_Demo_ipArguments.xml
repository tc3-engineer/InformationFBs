<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.ipArguments Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ipArguments" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">alarm 实例（已 Create）</xhtml></documentation>
            </variable>
            <variable name="ipArgs">
              <type><derived name="I_TcArguments"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数接口</xhtml></documentation>
            </variable>
            <variable name="sMotorName">
              <initialValue><simpleValue value="'M-01'"/></initialValue>
              <type><string><length>40</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">电机名</xhtml></documentation>
            </variable>
            <variable name="rTemperature">
              <initialValue><simpleValue value="95.5"/></initialValue>
              <type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前温度</xhtml></documentation>
            </variable>
            <variable name="bAddArgs">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bAddArgsPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：给即将 Raise 的 alarm 附加电机名 + 当前温度两个参数
// 价值：文本占位符自动填充，多语言报警一次代码完成
// 验证：登录后写 bAddArgs := TRUE，触发一次 Add；再 Raise；用 RequestEventText 取回事件文本应包含参数
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// Raise 之前给 alarm 添加两个参数：电机名 + 温度
IF bAddArgs AND NOT bAddArgsPrev THEN
    ipArgs := fbAlarm.ipArguments;     // 取 getter
    IF ipArgs &amp;lt;&amp;gt; 0 THEN
        ipArgs.AddString(sValue := sMotorName);
        ipArgs.AddReal(fValue := rTemperature);
    END_IF;
END_IF;
bAddArgsPrev := bAddArgs;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
