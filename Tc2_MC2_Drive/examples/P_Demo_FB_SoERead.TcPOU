<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoERead" Id="{6fe94084-dca2-5dd3-b458-974b72cdd36b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoERead
VAR
    fbSoERead      : FB_SoERead; // SoE 读参数 FB 实例
    axisServo      : AXIS_REF; // 伺服轴轴引用；必须先在 System Manager 配好并 Link
    rtReadTrig     : R_TRIG; // 把电平转上升沿
    bReadParamReq  : BOOL := FALSE; // 在线写 TRUE 触发一次读取
    nReadIdn       : WORD; // 要读的 IDN，这里 S_0_IDNs + 33 = S-0-0033
    nReadValue     : UINT; // 读回的参数值缓冲区
    bReadBusy      : BOOL;
    bReadError     : BOOL;
    nReadAdsErr    : UINT;
    nReadSercosErr : UINT;
    nReadAttribute : DWORD;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：诊断界面要显示伺服驱动器某 SoE 参数（IDN S-0-0033）的当前值，
//       Element 16#40 表示读"值"。用 IDN 通用寻址，不必为该参数写专用 FB。
//
// 价值：1) IDN + Element 通用读任意 SoE 参数，免写一堆专用读取 FB
//       2) 通过 AXIS_REF 关联轴，不必单独管理 NetId / 从站地址
//       3) AdsErrId + SercosErrId 双错误码便于区分"通信问题"和"IDN 用法问题"
//
// 验证步骤：
//   1. System Manager 配好 NC 轴并 Link 给 axisServo，引用 Tc2_MC2_Drive
//   2. Add Existing Item (.TcPOU) 选本文件，加进 PlcTask，编译登录
//   3. 在线写 bReadParamReq := TRUE → bReadBusy 置 TRUE
//   4. 等 bReadBusy 落回 FALSE 且 bReadError = FALSE → nReadValue 即参数值，
//      nReadAttribute 为该参数属性
//   5. 若 bReadError = TRUE：先看 nReadAdsErr（通信/并行不支持），
//      再看 nReadSercosErr（IDN/Element 用法）
//   6. 把 bReadParamReq 拉回 FALSE 复位边沿，可再次触发
// =============================================================================

// 用 S_0_IDNs 基地址拼出 S-0-0033，比手填 16#0021 可读
nReadIdn := S_0_IDNs + 33;

// 用 R_TRIG 把"持续按住的 TRUE"转成真正的上升沿
rtReadTrig(CLK := bReadParamReq);

// 单次调用：pDstBuf/BufLen 配对指向 nReadValue；Axis 是 VAR_IN_OUT 必传
// 本 FB 无 Done 输出，靠 Busy 落回 FALSE 且 Error=FALSE 判成功
fbSoERead(
    NetId       := '',
    Idn         := nReadIdn,
    Element     := 16#40,
    pDstBuf     := ADR(nReadValue),
    BufLen      := SIZEOF(nReadValue),
    Execute     := rtReadTrig.Q,
    Timeout     := DEFAULT_ADS_TIMEOUT,
    Axis        := axisServo,
    Busy        => bReadBusy,
    Error       => bReadError,
    AdsErrId    => nReadAdsErr,
    SercosErrId => nReadSercosErr,
    Attribute   => nReadAttribute
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
