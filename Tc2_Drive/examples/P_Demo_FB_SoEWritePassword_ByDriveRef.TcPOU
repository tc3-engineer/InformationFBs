<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEWritePassword_ByDriveRef" Id="{4380babb-b3b7-577a-969f-66695601d644}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEWritePassword_ByDriveRef
VAR
    fbWritePassword : FB_SoEWritePassword_ByDriveRef; // 写驱动器密码 FB 实例
    rtrigWrite      : R_TRIG; // 把 bWriteReq 转成单次上升沿
    stPlcDriveRef   : ST_PlcDriveRef; // 链接到 System Manager 的驱动器过程映像
    stDriveRef      : ST_DriveRef; // 解析出的驱动器引用
    bInit           : BOOL := TRUE; // 等过程映像就绪再放行
    bWriteReq       : BOOL := FALSE; // 在线置 TRUE 触发一次写密码
    sDrivePassword  : ST_SoE_String; // Sercos 字符串口令（在线填入，勿硬编码）
    bWriteBusy      : BOOL; // 写密码执行中
    bWriteError     : BOOL; // 写密码传输出错
    iAdsErr         : UINT; // ADS 错误码
    iSercosErr      : UINT; // Sercos 错误码
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：调试 AX5000 时要修改受密码保护的厂商参数，写入前必须先用 S-0-0267 解锁。
//       把解锁动作做进 PLC，调试工程师在 HMI 输入口令即可，无需进 Drive Manager。
//
// 价值：把"向 S-0-0267 写 Sercos 字符串 + 异步状态机 + 超时"封装成一次上升沿
//       调用；口令来源（HMI/配置）与本 FB 解耦，便于不硬编码密码。
//
// 验证步骤：
//   1. 引用 Tc2_Drive 库
//   2. System Manager 里把某 AX5000 SoE 从站过程映像链接到 stPlcDriveRef
//   3. 编译、登录、运行；观察 bInit 在过程映像就绪后自动变 FALSE
//   4. 在线给 sDrivePassword 填入正确口令
//   5. 在线把 bWriteReq := TRUE
//      → bWriteBusy 短暂为 TRUE，落下后 bWriteError 应为 FALSE
//   6. 随后用 FB_SoEWrite 写一个受保护 IDN 验证已解锁；若仍报"参数受保护"
//      说明口令不对（写密码这步可能不当场报错）
// =============================================================================

// 初始化驱动器引用
IF bInit THEN
    stDriveRef.sNetId     := F_CreateAmsNetId(stPlcDriveRef.aNetId);
    stDriveRef.nSlaveAddr := stPlcDriveRef.nSlaveAddr;
    stDriveRef.nDriveNo   := stPlcDriveRef.nDriveNo;
    stDriveRef.nDriveType := stPlcDriveRef.nDriveType;
    IF (stDriveRef.sNetId <> '') AND (stDriveRef.nSlaveAddr <> 0) THEN
        bInit := FALSE;
    END_IF;
END_IF;

rtrigWrite(CLK := bWriteReq);

// 单次调用形式：所有 VAR_INPUT 显式赋值
fbWritePassword(
    stDriveRef := stDriveRef,
    bExecute   := rtrigWrite.Q AND NOT bInit,
    tTimeout   := DEFAULT_ADS_TIMEOUT,
    sPassword  := sDrivePassword,
    bBusy        => bWriteBusy,
    bError       => bWriteError,
    iAdsErrId    => iAdsErr,
    iSercosErrId => iSercosErr
);

IF NOT bWriteBusy AND NOT bInit THEN
    bWriteReq := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
