  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Int64Add64" pouType="program">
        <interface>
          <localVars>
            <variable name="liAccum">
              <type><derived name="T_LARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">累计差值</xhtml></documentation>
            </variable>
            <variable name="liDelta">
              <type><derived name="T_LARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本次差值</xhtml></documentation>
            </variable>
            <variable name="bAdd">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.Int64Add64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：累计差值（可正可负）求合，确认不会超 2⁶³ 后用本函数。
// 价值：替代手写有符号双倍长加；一行调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bAdd THEN
    liAccum := Int64Add64(liAccum, liDelta);
    bAdd := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
