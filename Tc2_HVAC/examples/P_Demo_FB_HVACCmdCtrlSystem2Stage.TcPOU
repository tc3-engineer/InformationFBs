<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACCmdCtrlSystem2Stage" Id="{509c551e-edab-5153-8f65-b1ffd9cf4ac4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACCmdCtrlSystem2Stage
VAR
    fb : FB_HVACCmdCtrlSystem2Stage;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    eCtrlModeActuator_in : E_HVACActuatorMode ;
    bExternalRequest1_in : BOOL := FALSE;
    bExternalRequest2_in : BOOL := FALSE;
    bTimeScheduler1_in : BOOL := FALSE;
    bTimeScheduler2_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    ePlantMode_io : E_HVACPlantMode ;
    eExternalRequestMode_io : E_HVACExternalRequestMode ;
    tOffDelay1_io : TIME := T#0S;
    tOffDelay2_io : TIME := T#0S;
    bOn1_out : BOOL;
    bOn2_out : BOOL;
    eStateModeActuator_out : E_HVACActuatorMode;
    bRequestScheduler1_out : BOOL;
    bRequestScheduler2_out : BOOL;
    bRequestExternal1_out : BOOL;
    bRequestExternal2_out : BOOL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACCmdCtrlSystem2Stage 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACCmdCtrlSystem2Stage.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    eCtrlModeActuator := eCtrlModeActuator_in,
    bExternalRequest1 := bExternalRequest1_in,
    bExternalRequest2 := bExternalRequest2_in,
    bTimeScheduler1 := bTimeScheduler1_in,
    bTimeScheduler2 := bTimeScheduler2_in,
    bReset := bReset_in,
    ePlantMode := ePlantMode_io,
    eExternalRequestMode := eExternalRequestMode_io,
    tOffDelay1 := tOffDelay1_io,
    tOffDelay2 := tOffDelay2_io,
    bOn1 => bOn1_out,
    bOn2 => bOn2_out,
    eStateModeActuator => eStateModeActuator_out,
    bRequestScheduler1 => bRequestScheduler1_out,
    bRequestScheduler2 => bRequestScheduler2_out,
    bRequestExternal1 => bRequestExternal1_out,
    bRequestExternal2 => bRequestExternal2_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
