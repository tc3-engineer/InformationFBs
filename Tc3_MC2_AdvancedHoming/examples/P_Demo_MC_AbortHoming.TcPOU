<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_AbortHoming" Id="{39c6ab5f-1351-5750-98f2-4095925cfc88}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_AbortHoming
VAR
    fbAbortHoming : MC_AbortHoming;
    axisHoming    : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec        : R_TRIG; // 把保持型请求位整成单次上升沿
    bAbortReq     : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam   : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    homingOptions : ST_Home_Options2; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bAbortDone    : BOOL;
    bBusy         : BOOL;
    bAborted      : BOOL;
    bError        : BOOL;
    nErrorID      : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：自定义归零序列里，前级 step 函数报错或被中止后，用本 FB 安全中止整条序列，
//       把被临时修改的 NC/驱动参数（如限矩、关掉的跟随监控）还原并切回 Standstill。
// 价值：归零失败时若不收尾，临时参数残留会让后续正常运动报跟随误差/限速异常；本 FB 防止该残留。
// 验证：模拟前级失败（bStepError := TRUE）后，在线写 bAbortReq := TRUE，观察 bAbortDone
//       短暂 TRUE，axisHoming 状态从 Homing 回到 Standstill，参数恢复原值。

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bAbortReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbAbortHoming(
    Execute        := rtExec.Q,
    Options        := homingOptions,
    Done           => bAbortDone,
    Busy           => bBusy,
    CommandAborted => bAborted,
    Error          => bError,
    ErrorID        => nErrorID,
    Axis           := axisHoming,
    Parameter      := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bAbortReq AND NOT bBusy THEN
    bAbortDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
