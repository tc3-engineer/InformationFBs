<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_BA_TimeStruct_TO_Time" Id="{589251a0-2ca7-5b32-a6d9-040576864ee8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_BA_TimeStruct_TO_Time
VAR
    argTValue                      : TIMESTRUCT                    ; // tValue
    fnReturn                       : ST_BA_Time; // 返回值
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc3_BA2_Common.F_BA_TimeStruct_TO_Time 演示程序
// =============================================================================
// 场景：只关心当前时间不需要日期的场景，如周期任务"每小时 30 分触发"判定。
//
// 价值：一行 FC 替代字段映射。
//
// 验证：登录 PLC 后，按例程内变量在线写值；监视输出 / 返回值，结合 §1 功能
//       简述的预期行为对照（详见配套 .md 文档 §7 业务场景）。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_BA2_Common（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// =============================================================================

fnReturn := F_BA_TimeStruct_TO_Time(
    tValue                   := argTValue
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
