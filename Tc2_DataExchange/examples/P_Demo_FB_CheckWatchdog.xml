<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-10T09:00:00"/>
  <contentHeader name="Tc2_DataExchange.FB_CheckWatchdog Demo" modificationDateTime="2026-05-10T09:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_CheckWatchdog" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_CheckWatchdog">
              <type><derived name="FB_CheckWatchdog"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Watchdog function blocks 实例</xhtml></documentation>
            </variable>
            <variable name="arg_bEnable">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT bEnable: 使能</xhtml></documentation>
            </variable>
            <variable name="arg_tWatchdogTime">
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT tWatchdogTime: nCnt 必须在此时长内发生变化</xhtml></documentation>
            </variable>
            <variable name="arg_nCnt">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT nCnt: watchdog 信号当前计数值</xhtml></documentation>
            </variable>
            <variable name="out_bWatchdog">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT bWatchdog: FALSE = 监视信号有效；TRUE = 超时未变化</xhtml></documentation>
            </variable>
            <variable name="out_nLastCnt">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT nLastCnt: 最近一次成功收到的计数值</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_DataExchange.FB_CheckWatchdog 演示程序
// ============================================================
// 场景：在接收侧检查另一控制器是否还活着（5 秒内必须有更新）
// 验证步骤：
//   1. 引用 Tc2_DataExchange（及其依赖：Tc2_System 等）
//   2. 编译 + 登录
//   3. 在线监视各 out_* 输出
//   4. 必要时按场景给 arg_* 输入赋值（详见 doc.md 的'使用注意'）
// ============================================================

fbFB_CheckWatchdog(
    bEnable := arg_bEnable,
    tWatchdogTime := arg_tWatchdogTime,
    nCnt := arg_nCnt,
    bWatchdog => out_bWatchdog,
    nLastCnt => out_nLastCnt
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
