<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACAnalogTo3Point" Id="{1551b229-1997-56ca-9d29-48186f344f5b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACAnalogTo3Point
VAR
    fb : FB_HVACAnalogTo3Point;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    rSetpoint_in : REAL := 0.0;
    rFeedb_in : REAL := 0.0;
    bLimitSwitchOpen_in : BOOL := FALSE;
    bLimitSwitchClose_in : BOOL := FALSE;
    bCtrlVoltage_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    tTaskCycleTime_in : TIME := T#0S;
    rMinSetpoint_io : REAL := 0.0;
    rMaxSetpoint_io : REAL := 0.0;
    rThreshold_io : REAL := 0.0;
    rTolerance_io : REAL := 0.0;
    tPauseMin_io : TIME := T#0S;
    tPauseMax_io : TIME := T#0S;
    tInterval_io : TIME := T#0S;
    tStrokeTime_io : TIME := T#0S;
    tSwitchOverDeadTime_io : TIME := T#0S;
    eReferencingMode_io : E_HVACReferencingMode ;
    bOpen_out : BOOL;
    bClose_out : BOOL;
    byState_out : BYTE;
    rPosition_out : REAL;
    bErrorGeneral_out : BOOL;
    byError_out : BYTE;
    bErrorLimitSwitch_out : BOOL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACAnalogTo3Point 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACAnalogTo3Point.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    rSetpoint := rSetpoint_in,
    rFeedb := rFeedb_in,
    bLimitSwitchOpen := bLimitSwitchOpen_in,
    bLimitSwitchClose := bLimitSwitchClose_in,
    bCtrlVoltage := bCtrlVoltage_in,
    bReset := bReset_in,
    tTaskCycleTime := tTaskCycleTime_in,
    rMinSetpoint := rMinSetpoint_io,
    rMaxSetpoint := rMaxSetpoint_io,
    rThreshold := rThreshold_io,
    rTolerance := rTolerance_io,
    tPauseMin := tPauseMin_io,
    tPauseMax := tPauseMax_io,
    tInterval := tInterval_io,
    tStrokeTime := tStrokeTime_io,
    tSwitchOverDeadTime := tSwitchOverDeadTime_io,
    eReferencingMode := eReferencingMode_io,
    bOpen => bOpen_out,
    bClose => bClose_out,
    byState => byState_out,
    rPosition => rPosition_out,
    bErrorGeneral => bErrorGeneral_out,
    byError => byError_out,
    bErrorLimitSwitch => bErrorLimitSwitch_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
