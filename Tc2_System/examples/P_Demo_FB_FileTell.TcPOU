<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_FileTell" Id="{f53b160c-f011-5ef7-9618-9b24f5e53c6f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_FileTell
VAR
    fbFileTell   : FB_FileTell; // FB_FileTell 实例
    hOpenedFile  : UINT; // 已打开句柄
    bTellRequest : BOOL; // 在线写 TRUE 触发一次查询
    nCurrentPos  : DINT; // 查询返回的当前指针偏移（出错时 = -1）
    bTellError   : BOOL; // TRUE = 查询失败
    nErrIdLast   : UDINT; // ADS 错误号
    bBusyMon     : BOOL; // ADS 通讯中
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：读完一段后查询当前文件指针位置 nCurrentPos 保存到 retain 变量，便于断电重启续读。
// 价值：替代手动跟踪偏移变量，直接从 OS 拿权威值。
// 验证：在线置 bTellRequest := TRUE → 观察 nCurrentPos 在 1-2 周期后非零；与刚读完的字节累计量一致。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileTell(
    sNetId    := '',
    hFile     := hOpenedFile,
    bExecute  := bTellRequest,
    tTimeout  := T#10S,
    bBusy     => bBusyMon,
    bError    => bTellError,
    nErrId    => nErrIdLast,
    nSeekPos => nCurrentPos
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
