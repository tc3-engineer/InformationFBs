<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_BE16_TO_HOST" Id="{ac1997d3-0391-5905-9881-b6ecffcdb20a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_BE16_TO_HOST
VAR
    bResult : WORD; // BE16_TO_HOST 的返回值
    bRun    : BOOL; // 触发一次调用
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.BE16_TO_HOST 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及依赖类型所在的库）
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 观察 bResult 应为 16#1234
// ============================================================

IF bRun THEN
    bResult := BE16_TO_HOST(16#3412);
    bRun := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
