<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.MEMSET Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_MEMSET" pouType="program">
        <interface>
          <localVars>
            <variable name="aBigBuffer">
              <type><array><dimension lower="0" upper="1023"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">1 KB 工艺缓冲区</xhtml></documentation>
            </variable>
            <variable name="bClearRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次清零</xhtml></documentation>
            </variable>
            <variable name="nBytesCleared">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际清零字节数</xhtml></documentation>
            </variable>
            <variable name="rtClear">
              <type><derived name="R_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿检测</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：设备启动时一次性清零 1 KB 工艺缓冲区，避免冷启动残留旧数据。
// 价值：一行调用替代 1024 次 FOR 赋零；快 5-10 倍。
// 验证：bClearRequest := TRUE → 观察 aBigBuffer 全部归零；nBytesCleared = 1024。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

rtClear(CLK := bClearRequest);
IF rtClear.Q THEN
    nBytesCleared := MEMSET(
        destAddr := ADR(aBigBuffer),
        fillByte := 0,
        n        := SIZEOF(aBigBuffer)
    );
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
