<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_ASI_ParameterControl" Id="{54c5a473-44d9-5117-8cac-a331d593034a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_ASI_ParameterControl
VAR
    fbAsiParamControl  : FB_ASI_ParameterControl; // ASI 库后台调度器（必须循环调用）
    stAsiParamBuffer   : ST_ParameterBuffer; // 所有 ASI FB 共享的缓冲
    stAsiInProcessImg  : ST_Parameter_IN; // ASI 主端子过程输入（链到 %I*）
    stAsiOutProcessImg : ST_Parameter_OUT; // ASI 主端子过程输出（链到 %Q*）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：任何用 ASI 库的程序：本 FB 是后台调度器，整个程序周期调用一次让其它 ASI FB 工作。
// 价值：调度集中化，业务侧异步用命令式 API。
// 验证：登录后只要 PlcTask 在跑就会调用本 FB；可观察 stAsiParamBuffer 的内部字段（vendor-specific）周期更新；如果调用其它 ASI FB 时永远停在 bBusy = TRUE，多半是本 FB 没循环调用。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 这一个 FB 是 ASI 库的中枢。
// 必须放在 PlcTask 主循环中、每个周期都调用一次。
// 没有它，其它任何 FB_ASI_* 实例都不会工作（永远卡在 bBusy = TRUE）。
fbAsiParamControl(
    stParameterBuffer := stAsiParamBuffer,
    stParameter_IN    := stAsiInProcessImg,
    stParameter_OUT   := stAsiOutProcessImg
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
