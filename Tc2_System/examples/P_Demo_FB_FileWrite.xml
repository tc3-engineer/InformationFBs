<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileWrite Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileWrite" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileWrite">
              <type><derived name="FB_FileWrite"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileWrite 实例</xhtml></documentation>
            </variable>
            <variable name="hOpenedFile">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">前置 FB_FileOpen 拿到的句柄</xhtml></documentation>
            </variable>
            <variable name="stProcessRecord">
              <type><array><dimension lower="0" upper="63"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要写入的 64 字节工艺数据</xhtml></documentation>
            </variable>
            <variable name="bWriteRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次写入</xhtml></documentation>
            </variable>
            <variable name="cbBytesWritten">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际写入字节数</xhtml></documentation>
            </variable>
            <variable name="bWriteError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 写失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把一个 64 字节的工艺参数结构追加写到已打开的 D:/log/process.csv 文件末尾。
// 价值：封装 ADS 写命令的状态机，省 30 行手写。
// 验证：在线置 bWriteRequest := TRUE → 观察 cbBytesWritten = SIZEOF(stProcessRecord)；故意改 hOpenedFile := 0 → bWriteError = TRUE 且 nErrIdLast = 0x70C。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileWrite(
    sNetId     := '',
    hFile      := hOpenedFile,
    pWriteBuff := ADR(stProcessRecord),
    cbWriteLen := SIZEOF(stProcessRecord),
    bExecute   := bWriteRequest,
    tTimeout   := T#10S,
    bBusy      =&gt; bBusyMon,
    bError     =&gt; bWriteError,
    nErrId     =&gt; nErrIdLast,
    cbWrite    =&gt; cbBytesWritten
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
