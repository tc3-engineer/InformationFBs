  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_WLEN2" pouType="program">
        <interface>
          <localVars>
            <variable name="wsBuf"><initialValue><simpleValue value="&quot;HMI text...&quot;"/></initialValue><type><wstring><length>1024</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：HMI 多语言长缓冲</xhtml></documentation></variable>
            <variable name="nLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">字符数</xhtml></documentation></variable>
            <variable name="bCheck"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI WSTRING 缓冲已写入字符数统计；下一次 `WCONCAT2` 的偏移计算。
// 价值：`Tc2_Standard.WLEN` 限 255；本函数无限制。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bCheck THEN
    nLen := WLEN2(pWSTRING := ADR(wsBuf));
    bCheck := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
