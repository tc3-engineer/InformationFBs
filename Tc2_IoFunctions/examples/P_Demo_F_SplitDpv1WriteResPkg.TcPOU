<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_SplitDpv1WriteResPkg" Id="{75b754f6-3f82-5d45-a858-5198974333f2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_SplitDpv1WriteResPkg
VAR
    aDpv1WriteResBuffer : ARRAY[1..240] OF BYTE; // DPV1 写响应帧 240 字节
    arrDpv1ReqParams    : ARRAY[1..39] OF ST_Dpv1ParamAddrEx; // 与请求相同
    arrDpv1ValueHdr     : ARRAY[1..39] OF ST_Dpv1ValueHeaderEx; // 解析输出：写状态
    bSplitWriteResPkg   : BOOL := FALSE; // 触发：解析响应
    nWriteResPkgLen     : USINT; // 响应帧实际长度
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：SINAMICS DPV1 写完后解析响应，拿到每条参数的写状态。
// 价值：封装解析。
// 验证：写 bSplitWriteResPkg := TRUE → 一周期后 nWriteResPkgLen > 0 表示解析成功；查 arrDpv1ValueHdr[k].nError 各条状态。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bSplitWriteResPkg THEN
    nWriteResPkgLen := F_SplitDpv1WriteResPkg(
        pDpv1ResData        := ADR(aDpv1WriteResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitWriteResPkg := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
