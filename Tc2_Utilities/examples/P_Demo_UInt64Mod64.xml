  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Mod64" pouType="program">
        <interface>
          <localVars>
            <variable name="uliCounter">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">累计事件计数</xhtml></documentation>
            </variable>
            <variable name="uliBufSize">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">环形缓冲区大小</xhtml></documentation>
            </variable>
            <variable name="uliIndex">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">写入索引</xhtml></documentation>
            </variable>
            <variable name="bIndex">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Mod64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：64 位累计事件计数 mod N（N = 缓冲区大小）得到环形缓冲区写指针。
// 价值：替代手写 `dividend - 商 * divisor`；一次调用避免中间变量。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

uliBufSize := ULARGE_INTEGER(0, 1024);
IF bIndex AND NOT UInt64isZero(uliBufSize) THEN
    uliIndex := UInt64Mod64(uliCounter, uliBufSize);
    bIndex := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
