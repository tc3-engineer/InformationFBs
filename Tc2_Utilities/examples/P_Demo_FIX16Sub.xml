    <pous>
      <pou name="P_Demo_FIX16Sub" pouType="program">
        <interface>
          <localVars>
            <variable name="fp8A">
              <type><derived name="T_FIX16"/></type>
            </variable>
            <variable name="fp8B">
              <type><derived name="T_FIX16"/></type>
            </variable>
            <variable name="fp8Diff">
              <type><derived name="T_FIX16"/></type>
            </variable>
            <variable name="lrResult">
              <type><LREAL/></type>
            </variable>
            <variable name="bSub">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FIX16Sub 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：读两个传感器之差用于偏差控制。
// 价值：替代手写对齐 + INT 减法。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

fp8A := LREAL_TO_FIX16(0.5,  8);
fp8B := LREAL_TO_FIX16(0.75, 8);
IF bSub THEN
    fp8Diff  := FIX16Sub(fp8A, fp8B);
    lrResult := FIX16_TO_LREAL(fp8Diff);   // 应为 -0.25
    bSub := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
