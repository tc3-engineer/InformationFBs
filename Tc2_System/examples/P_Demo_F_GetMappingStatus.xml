<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_GetMappingStatus Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetMappingStatus" pouType="program">
        <interface>
          <localVars>
            <variable name="bMonitoredInput">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">应映射的关键输入变量</xhtml></documentation>
            </variable>
            <variable name="eMapStatus">
              <type><derived name="EPlcMappingStatus"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">映射状态枚举</xhtml></documentation>
            </variable>
            <variable name="bMappingOk">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 已完全映射</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：启动时扫描一个关键 IO 输入变量的映射状态，未完全映射即告警。
// 价值：自动化映射诊断。
// 验证：未映射 → eMapStatus = MS_Unmapped；正常映射 → MS_Mapped。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

eMapStatus := F_GetMappingStatus(
    p := ADR(bMonitoredInput),
    n := SIZEOF(bMonitoredInput)
);

// 只把『完全映射』算 OK；部分映射或未映射都视为异常
bMappingOk := (eMapStatus = MS_Mapped);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
