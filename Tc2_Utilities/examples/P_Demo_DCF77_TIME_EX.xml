<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.DCF77_TIME_EX Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_DCF77_TIME_EX" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDCF77_TIME_EX">
              <type><derived name="DCF77_TIME_EX"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">DCF77_TIME_EX 实例</xhtml></documentation>
            </variable>
            <variable name="bDcfPulse">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">DCF77 接收脉冲</xhtml></documentation>
            </variable>
            <variable name="bValid">
              <type><BOOL/></type>
            </variable>
            <variable name="dtTime">
              <type><DT/></type>
            </variable>
            <variable name="bDst">
              <type><BOOL/></type>
            </variable>
            <variable name="bDstChange">
              <type><BOOL/></type>
            </variable>
            <variable name="byWeekday">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">1 = 周一 ... 7 = 周日</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：楼宇空调排程，根据 DOW 区分工作日 / 周末时段。
// 价值：DOW 直接由 DCF77 报文提供，免自算。
// 验证：观察 byWeekday 在每分钟刷新，应在 1..7 之间。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbDCF77_TIME_EX(
    DCF_INPUT := bDcfPulse,
    DCF_TIME_VALID =&gt; bValid,
    DCF_DATE_AND_TIME =&gt; dtTime,
    CDT =&gt; bDst,
    CHANGE_DT =&gt; bDstChange,
    DOW =&gt; byWeekday
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
