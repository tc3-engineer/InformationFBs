<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MBReadInputRegs" Id="{32613ed3-4b6b-593d-8bba-8ba0759654d2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MBReadInputRegs
VAR
    fbReadInputRegs: FB_MBReadInputRegs;
    sTargetIp     : STRING(15) := '192.168.1.50';   // 目标 Modbus 设备 IP（按现场改）
    bTrigger      : BOOL;          // 在线置一次上升沿触发本次访问
    bBusy         : BOOL;          // 在线 monitor：执行中为 TRUE
    bError        : BOOL;          // 出错置 TRUE
    nErrId        : UDINT;         // 出错时的 ADS/Modbus 错误码
    nReadCount    : UDINT;         // 实际读到的字节数
    arrData       : ARRAY [0..2] OF WORD;   // 读回数据落点
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ModbusSrv.FB_MBReadInputRegs 演示程序（Modbus TCP 客户端 / 主站）
// ============================================================
// 场景：读取仪表的只读输入寄存器，例如电力仪表的瞬时电流/电压/功率、传感器变送器的测量值——这些是设备侧只读的实时量。
// 价值：输入寄存器区只读，用本 FB（功能码 4）周期采集即可；与保持寄存器（功能码 3）区分开，避免误写。
// 验证：登录后在线置 bTrigger := TRUE 触发一次；观察 bBusy 在数个周期后回 FALSE，
//       bError 应为 FALSE、nErrId 应为 0；若对端不在线则 bError=TRUE 且 nErrId 含超时码。
//       本例：读 3 个输入寄存器（如 U/I/P）
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ModbusSrv（References → Add library），并确保 TF6250 Modbus TCP 已授权运行
//   3. 把 sTargetIp 改成现场 Modbus 设备 IP；编译 → 登录 → 运行
//   4. 在线脉冲 bTrigger，按上方『验证』观察输出
// ============================================================

// 单次完整调用：所有 VAR_INPUT 显式赋值；bExecute 边沿触发一次
fbReadInputRegs(
    sIPAddr   := sTargetIp,
    nTCPPort  := MODBUS_TCP_PORT,
    nUnitID   := 16#FF,
    nQuantity := 3,
    nMBAddr   := 0,
    cbLength  := SIZEOF(arrData),
    pDestAddr := ADR(arrData),
    bExecute  := bTrigger,
    tTimeout  := T#5S,
    bBUSY     => bBusy,
    bError    => bError,
    nErrId    => nErrId,
    cbRead    => nReadCount
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
