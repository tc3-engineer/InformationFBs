<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.AnalyzeExpression Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_AnalyzeExpression" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAnalyzeExpression">
              <type><derived name="AnalyzeExpression"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AnalyzeExpression 实例</xhtml></documentation>
            </variable>
            <variable name="bSensorA">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">传感器 A 到位</xhtml></documentation>
            </variable>
            <variable name="bSensorB">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">传感器 B 到位</xhtml></documentation>
            </variable>
            <variable name="bSensorC">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">传感器 C 到位</xhtml></documentation>
            </variable>
            <variable name="SFCEnableLimit">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">启用 SFC 步最大激活时间监控</xhtml></documentation>
            </variable>
            <variable name="SFCError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SFC 系统 flag：有步超时</xhtml></documentation>
            </variable>
            <variable name="SFCErrorAnalyzation">
              <type><string/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SFC 系统 flag：本 FB 写入未满足子表达式</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.AnalyzeExpression 演示程序
// ============================================================
// 场景：在 SFC POU 中启用 AnalyzeExpression 自动分析超时转换。
// 价值：编译器自动调本 FB；业务代码零侵入，HMI 直接读 SFCErrorAnalyzation。
// 验证：把本声明区拷到一个 SFC POU 里，加一个 Step（最大激活时间 1 s）+ 转换 (bSensorA AND (bSensorB OR bSensorC))。运行 1 秒未触发，SFCErrorAnalyzation 应填入未满足子表达式。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 演示用：在 SFC POU 中本 FB 会被系统自动调用，无需手动 fbXxx() 调用。
// 该例程仅展示 SFC flag 声明区的必备变量；真正功能在 SFC 流程图上体现。
;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
