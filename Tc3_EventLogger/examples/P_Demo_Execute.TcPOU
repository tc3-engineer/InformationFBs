<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Execute" Id="{629db20b-0086-51fb-9d31-3f4217f84bd6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Execute
VAR
    fbListener : FB_ListenerBase2; // listener 实例
    hr         : HRESULT; // 返回值监视
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：主程序里每周期推进事件队列
// 价值：必须周期调用以保证事件及时到达回调
// 验证：登录后 monitor hr，每周期应为 S_OK；fbListener 必须已 Subscribe
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 每周期调用一次推进事件队列
hr := fbListener.Execute();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
