  <contentHeader name="Tc2_Utilities.FB_AddRouteEntryEx Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AddRouteEntryEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_AddRouteEntryEx">
              <type><derived name="FB_AddRouteEntryEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_AddRouteEntryEx 实例</xhtml></documentation>
            </variable>
            <variable name="bAdd">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：加 Temp 路由（重启丢）做联通测试。
// 价值：比 FB_AddRouteEntry 多类型 / 加密选项。
// 验证：改 bAdd := TRUE，观察 bBusy 短暂 TRUE 后 bErr → FALSE、nErr → 0；目标机器路由表里能看到 Temp 路由；重启目标机器后路由消失。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// PDF 给出的参数命名见上方 VAR_INPUT；此处用最少必填参数演示 Temp 路由
fbFB_AddRouteEntryEx(
    bExecute := bAdd,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
