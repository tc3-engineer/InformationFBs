<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_GetDayOfWeek" Id="{d626775f-390f-56a7-a3dc-10f44f787c4d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_GetDayOfWeek
VAR
    dtNow      : DATE_AND_TIME := DT#2026-05-11-12:00:00; // 要查询的日期
    wDayOfWeek : WORD; // 1=Monday ... 7=Sunday
    bIsWeekend : BOOL; // TRUE 表示周六/周日
    bRunOnce   : BOOL; // 脉冲触发
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：排班逻辑「周末跳过维护」需要知道当前 DT 是周几
//
// 价值：1 行调用拿到 1=周一 ... 7=周日（ISO 约定），无需手写 Zeller 公式
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE 一个周期
//   4. 在线观察 wDayOfWeek 应为 1（2026-05-11 是周一）
//   5. bIsWeekend 应为 FALSE
//   6. 改 dtNow 到周六 / 周日重测
// =============================================================================
wDayOfWeek := F_GetDayOfWeek(dtNow);
bIsWeekend := (wDayOfWeek = 6) OR (wDayOfWeek = 7);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
