<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.ClearLoggedEvents Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ClearLoggedEvents" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLogger">
              <type><derived name="FB_TcEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EventLogger 实例</xhtml></documentation>
            </variable>
            <variable name="fbClearSettings">
              <type><derived name="FB_TcClearLoggedEventsSettings"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">清除过滤器实例（在线配置时间范围）</xhtml></documentation>
            </variable>
            <variable name="bDoClear">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bRequestDone">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">异步请求是否结束</xhtml></documentation>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">执行结果错误标志</xhtml></documentation>
            </variable>
            <variable name="hrErrorCode">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误码</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：按时间范围异步清除一年前的旧事件日志
// 价值：可控的事件日志清理，避免数据库膨胀
// 验证：登录后写 bDoClear := TRUE 触发；持续观察 bRequestDone 应在多个周期后变 TRUE；若 bError = TRUE 看 hrErrorCode 排错；EventLogger 日志视图应少掉对应时间段事件
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 每周期都调用本方法以推进异步状态；返回 TRUE 表示请求结束
IF bDoClear THEN
    bRequestDone := fbLogger.ClearLoggedEvents(
        ipClearSettings := fbClearSettings,
        bError =&gt; bError,
        hrErrorCode =&gt; hrErrorCode);
    IF bRequestDone THEN
        bDoClear := FALSE;                     // 流程结束，等下次触发
    END_IF;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
