<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileTell Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileTell" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileTell">
              <type><derived name="FB_FileTell"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileTell 实例</xhtml></documentation>
            </variable>
            <variable name="hOpenedFile">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已打开句柄</xhtml></documentation>
            </variable>
            <variable name="bTellRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次查询</xhtml></documentation>
            </variable>
            <variable name="nCurrentPos">
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查询返回的当前指针偏移（出错时 = -1）</xhtml></documentation>
            </variable>
            <variable name="bTellError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 查询失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读完一段后查询当前文件指针位置 nCurrentPos 保存到 retain 变量，便于断电重启续读。
// 价值：替代手动跟踪偏移变量，直接从 OS 拿权威值。
// 验证：在线置 bTellRequest := TRUE → 观察 nCurrentPos 在 1-2 周期后非零；与刚读完的字节累计量一致。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileTell(
    sNetId    := '',
    hFile     := hOpenedFile,
    bExecute  := bTellRequest,
    tTimeout  := T#10S,
    bBusy     =&gt; bBusyMon,
    bError    =&gt; bTellError,
    nErrId    =&gt; nErrIdLast,
    nSeekPos =&gt; nCurrentPos
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
