<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.WSTRING_TO_UTF8 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_WSTRING_TO_UTF8" pouType="program">
        <interface>
          <localVars>
            <variable name="wsSrc"><initialValue><simpleValue value="&quot;主泵状态&quot;"/></initialValue><type><wstring><length>128</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：HMI WSTRING 含 Unicode</xhtml></documentation></variable>
            <variable name="aUtf8"><type><array><dimension lower="0" upper="255"/><baseType><BYTE/></baseType></array></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UTF-8 输出（上云）</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">成功</xhtml></documentation></variable>
            <variable name="bConvert"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI WSTRING 数据上 OPC UA 云（UA 强制 UTF-8）。
// 价值：比 `WSTRING_TO_STRING2` + `STRING_TO_UTF8` 中转少一次转换。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bConvert THEN
    bOk := WSTRING_TO_UTF8(pDstUTF8    := ADR(aUtf8),
                           pSrcWSTRING := ADR(wsSrc),
                           nDstSize    := SIZEOF(aUtf8));
    bConvert := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
