<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Unsubscribe" Id="{d2a0fb18-e303-58ee-8e2b-1181d3af7f58}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Unsubscribe
VAR
    fbListener         : FB_ListenerBase2; // listener 实例
    bDoUnsubscribe     : BOOL := FALSE; // 上升沿触发
    bDoUnsubscribePrev : BOOL; // 边沿检测
    hr                 : HRESULT; // 返回值监视
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：模块下线前取消 listener 订阅
// 价值：规范的资源释放
// 验证：先 Subscribe；再写 bDoUnsubscribe := TRUE 触发 Unsubscribe；hr 应为 S_OK
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoUnsubscribe AND NOT bDoUnsubscribePrev THEN
    hr := fbListener.Unsubscribe();
END_IF;
bDoUnsubscribePrev := bDoUnsubscribe;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
