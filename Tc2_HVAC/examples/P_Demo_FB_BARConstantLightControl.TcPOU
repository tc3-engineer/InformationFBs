<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARConstantLightControl" Id="{96a23a27-9299-5a00-8b55-24911cc47b25}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARConstantLightControl
VAR
    fb : FB_BARConstantLightControl;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    uiLightCtrlMode_in : UINT := 0;
    bSwitch_in : BOOL := FALSE;
    bPresence_in : BOOL := FALSE;
    bCentralOn_in : BOOL := FALSE;
    bCentralOff_in : BOOL := FALSE;
    uiBrightness_in : UINT := 0;
    uiSetpoint_in : UINT := 0;
    uiSwitchOverTime_io : UINT := 0;
    uiAdjustRampTime_io : UINT := 0;
    bPresenceOnActive_io : BOOL := FALSE;
    bInitialMode_io : BOOL := FALSE;
    uiTargetRange_io : UINT := 0;
    uiControlRampTime_io : UINT := 0;
    uiOnDelay_io : UINT := 0;
    uiOffDelay_io : UINT := 0;
    lrMinDimValue_io : LREAL := 0.0;
    lrMaxDimValue_io : LREAL := 0.0;
    lrStartDimValue_io : LREAL := 0.0;
    lrManualDimValue_io : LREAL := 0.0;
    lrDimValue_out : LREAL;
    bControlActive_out : BOOL;
    bAdjustedSetpointActive_out : BOOL;
    uiAdjustedSetpoint_out : UINT;
    diActDeviation_out : DINT;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARConstantLightControl 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARConstantLightControl.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    uiLightCtrlMode := uiLightCtrlMode_in,
    bSwitch := bSwitch_in,
    bPresence := bPresence_in,
    bCentralOn := bCentralOn_in,
    bCentralOff := bCentralOff_in,
    uiBrightness := uiBrightness_in,
    uiSetpoint := uiSetpoint_in,
    uiSwitchOverTime := uiSwitchOverTime_io,
    uiAdjustRampTime := uiAdjustRampTime_io,
    bPresenceOnActive := bPresenceOnActive_io,
    bInitialMode := bInitialMode_io,
    uiTargetRange := uiTargetRange_io,
    uiControlRampTime := uiControlRampTime_io,
    uiOnDelay := uiOnDelay_io,
    uiOffDelay := uiOffDelay_io,
    lrMinDimValue := lrMinDimValue_io,
    lrMaxDimValue := lrMaxDimValue_io,
    lrStartDimValue := lrStartDimValue_io,
    lrManualDimValue := lrManualDimValue_io,
    lrDimValue => lrDimValue_out,
    bControlActive => bControlActive_out,
    bAdjustedSetpointActive => bAdjustedSetpointActive_out,
    uiAdjustedSetpoint => uiAdjustedSetpoint_out,
    diActDeviation => diActDeviation_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
