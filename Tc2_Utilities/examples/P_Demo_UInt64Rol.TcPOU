<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Rol" Id="{88df629d-1c6e-5660-b211-1896e68bc6d4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Rol
VAR
    uliHashState : T_ULARGE_INTEGER;; // 哈希中间状态
    dwShiftBits  : DWORD := 31;; // MurmurHash3 推荐值
    uliRotated   : T_ULARGE_INTEGER;
    bRotate      : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Rol 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：MurmurHash3 64-bit 实现里 `k = ROTL(k, 31)` 的混淆步骤。
// 价值：替代手写 SHL + SHR + OR 三步；一次调用语义清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bRotate AND dwShiftBits < 64 THEN
    // 必须 n < 64，否则 PDF 未定义
    uliRotated := UInt64Rol(uliHashState, dwShiftBits);
    bRotate := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
