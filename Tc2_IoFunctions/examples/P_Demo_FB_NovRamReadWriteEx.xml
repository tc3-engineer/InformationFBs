<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_NovRamReadWriteEx Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_NovRamReadWriteEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNovRamAccessEx">
              <type><derived name="FB_NovRamReadWriteEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOV-RAM 读写 Ex FB</xhtml></documentation>
            </variable>
            <variable name="nNovRamDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOVRAM 卡 Device Id</xhtml></documentation>
            </variable>
            <variable name="nProductionCountToWrite">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要写入的批次产量</xhtml></documentation>
            </variable>
            <variable name="nReadbackProduction">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读回的批次产量</xhtml></documentation>
            </variable>
            <variable name="nReadOffsetFromNov">
              <initialValue><simpleValue value="4"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读偏移（字节）</xhtml></documentation>
            </variable>
            <variable name="nWriteOffsetToNov">
              <initialValue><simpleValue value="4"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">写偏移（字节）</xhtml></documentation>
            </variable>
            <variable name="bReadFromNovRam">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿读</xhtml></documentation>
            </variable>
            <variable name="bWriteToNovRam">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿写</xhtml></documentation>
            </variable>
            <variable name="tNovRamTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bNovRamBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bNovRamErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastNovErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：CX9000 NOVRAM 按批次号偏移存"批次产量"：批次 N 的产量存在偏移 N*4 处。
// 价值：灵活偏移寻址；适应非标 NOV-RAM 硬件。
// 验证：登录后 nReadOffsetFromNov := 4 (第 1 批位置)、触发 bReadFromNovRam → bNovRamBusy 短暂 TRUE → 回 FALSE 后 nReadbackProduction 显示上次写入的批次 1 产量；改 nWriteOffsetToNov := 8 后写新批次再读验证。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNovRamAccessEx(
    nDevId     := nNovRamDeviceId,
    bRead      := bReadFromNovRam,
    bWrite     := bWriteToNovRam,
    cbSrcLen   := SIZEOF(nProductionCountToWrite),
    cbDestLen  := SIZEOF(nReadbackProduction),
    pSrcAddr   := ADR(nProductionCountToWrite),
    pDestAddr  := ADR(nReadbackProduction),
    nReadOffs  := nReadOffsetFromNov,
    nWriteOffs := nWriteOffsetToNov,
    tTimeOut   := tNovRamTimeout,
    bBusy      =&gt; bNovRamBusy,
    bErr       =&gt; bNovRamErr,
    nErrId     =&gt; nLastNovErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
