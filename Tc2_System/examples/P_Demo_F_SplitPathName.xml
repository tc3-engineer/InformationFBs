<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_SplitPathName Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_SplitPathName" pouType="program">
        <interface>
          <localVars>
            <variable name="sFullPath">
              <initialValue><simpleValue value="'D:\Recipes\Apr\BatchA.csv'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完整路径</xhtml></documentation>
            </variable>
            <variable name="sDriveOut">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><string><length>3</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">盘符输出</xhtml></documentation>
            </variable>
            <variable name="sDirOut">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目录输出</xhtml></documentation>
            </variable>
            <variable name="sFileBase">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">文件名输出</xhtml></documentation>
            </variable>
            <variable name="sFileExt">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">扩展名输出</xhtml></documentation>
            </variable>
            <variable name="bSplitOk">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 拆分成功</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读到工艺文件路径 → 拆出扩展名 .csv 走 CSV 解析分支；按目录归档到月份表。
// 价值：一行替代 15-20 行字符串扫描。
// 验证：改 sFullPath 为不同路径 → 4 个分量自动更新；非法路径 → bSplitOk = FALSE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用；VAR_IN_OUT 必须传本地变量
bSplitOk := F_SplitPathName(
    sPathName := sFullPath,
    sDrive    := sDriveOut,
    sDir      := sDirOut,
    sFileName := sFileBase,
    sExt      := sFileExt
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
