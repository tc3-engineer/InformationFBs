<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_LREAL_TO_INT64" Id="{e3493446-4572-55db-8b32-8a9e499cb987}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_LREAL_TO_INT64
VAR
    lrCmd    : LREAL := -1.5E9;
    liSteps  : T_LARGE_INTEGER;
    bConvert : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.LREAL_TO_INT64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把 PID 输出的浮点速度命令转有符号 64 位的累计步数。
// 价值：替代手写浮点→双倍长整数；一行调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert AND LrealIsFinite(lrCmd) THEN
    // 排除 NaN / Inf —— PDF 未定义这些情况
    liSteps := LREAL_TO_INT64(lrCmd);
    bConvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
