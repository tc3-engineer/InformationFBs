<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_AbortPassiveHoming" Id="{b4dda045-4941-5814-8976-e73070522b76}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_AbortPassiveHoming
VAR
    fbAbortPassiveHoming : MC_AbortPassiveHoming;
    axisHoming           : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec               : R_TRIG; // 把保持型请求位整成单次上升沿
    bAbortFlyingReq      : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingOptions        : ST_Home_Options; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bAbortFlyingDone     : BOOL;
    bBusy                : BOOL;
    bAbortFlyingActive   : BOOL;
    bAborted             : BOOL;
    bError               : BOOL;
    nErrorID             : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：收放卷设备运行中用 MC_StepReferenceFlyingSwitch 后台等待参考开关脉冲对零，
//       但本批料已走完仍未等到信号，需要撤销这次飞行归零等待以释放编码器锁存单元。
// 价值：及时取消可让 touch probe 单元空出来供其它功能使用，避免后台请求一直挂着。
// 验证：在线写 bAbortFlyingReq := TRUE，观察 bAbortFlyingDone 短暂 TRUE；对应的飞行归零 FB
//       的 CommandAborted 置位，说明等待已被取消（轴运动不受影响仍在走）。

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bAbortFlyingReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbAbortPassiveHoming(
    Execute        := rtExec.Q,
    Options        := homingOptions,
    Done           => bAbortFlyingDone,
    Busy           => bBusy,
    Active         => bAbortFlyingActive,
    CommandAborted => bAborted,
    Error          => bError,
    ErrorID        => nErrorID,
    Axis           := axisHoming);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bAbortFlyingReq AND NOT bBusy THEN
    bAbortFlyingDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
