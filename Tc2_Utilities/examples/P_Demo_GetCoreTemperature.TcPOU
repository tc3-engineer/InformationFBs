<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_GetCoreTemperature" Id="{6c28e446-fbed-5980-a3aa-2467e02d7c20}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_GetCoreTemperature
VAR
    fbCBM            : TC_CoreBoostMonitor; // TC_CoreBoostMonitor 实例
    hrResult         : HRESULT; // 方法返回的 HRESULT
    out_nCurrentTemp : UDINT; // 方法 REFERENCE TO nCurrentTemp 出参
    out_nMaxTemp     : UDINT; // 方法 REFERENCE TO nMaxTemp 出参
    out_nTempLimit   : UDINT; // 方法 REFERENCE TO nTempLimit 出参
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.TC_CoreBoostMonitor.GetCoreTemperature 演示程序（METHOD）
// ============================================================
// 注意：必须 Intel Core i 11 代+ 且 TwinCAT Core Boost 已启用
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录
//   3. 在 Real-time Settings 启用 Core Boost
//   4. 在线监视 hrResult 与 out_* 出参
// ============================================================

hrResult := fbCBM.GetCoreTemperature(out_nCurrentTemp, out_nMaxTemp, out_nTempLimit);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
