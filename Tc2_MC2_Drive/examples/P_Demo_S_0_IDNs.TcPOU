<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_S_0_IDNs" Id="{d7bd307a-45f0-5fc0-84f4-eabb20b54d02}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_S_0_IDNs
VAR
    nIdnS00033 : WORD; // 拼出的 IDN：S-0-0033
    nIdnS00432 : WORD; // 拼出的 IDN：S-0-0432（序列号）
    nIdnS10005 : WORD; // 拼出的 IDN：S-1-0005
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：用 Tc2_MC2_Drive 自带的 SoE IDN 基地址常量（S_0_IDNs / S_1_IDNs …）
//       拼出几个常用 IDN，供后续 FB_SoERead / FB_SoEWrite 的 Idn 入参使用。
//       基地址 + 十进制编号的写法比手填 16#00xx 更可读、更不易错。
//
// 价值：1) IDN 以"组 + 编号"可读形式出现，降低手算十六进制出错率
//       2) 明确参数组归属（S-0 vs S-1），不会混组
//       3) 用库自带常量，与库定义保持一致
//
// 验证步骤：
//   1. 引用 Tc2_MC2_Drive 库
//   2. Add Existing Item (.TcPOU) 选本文件，加进 PlcTask，编译登录
//   3. 在线监视 nIdnS00033 应为 16#0021（= 33）、nIdnS00432 应为 16#01B0
//      （= 432）、nIdnS10005 应为 16#1005
//   4. 把这些 Idn 传给 FB_SoERead/FB_SoEWrite 即可访问对应 Sercos 参数
// =============================================================================

// 用基地址 + 十进制组内编号拼 IDN（n 是十进制，不是十六进制）
nIdnS00033 := S_0_IDNs + 33;    // S-0 组第 33 号 = S-0-0033
nIdnS00432 := S_0_IDNs + 432;   // S-0 组第 432 号 = S-0-0432（序列号）
nIdnS10005 := S_1_IDNs + 5;     // S-1 组第 5 号 = S-1-0005
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
