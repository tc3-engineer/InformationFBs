<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEAX5000SetMotorCtrlWord_ByDriveRef" Id="{44a20292-1c85-59e0-989f-042d0894161f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEAX5000SetMotorCtrlWord_ByDriveRef
VAR
    fbSetCtrlWord     : FB_SoEAX5000SetMotorCtrlWord_ByDriveRef; // 设置 AX5000 电机控制字 FB 实例
    rtrigSet          : R_TRIG; // 把 bSetReq 转成单次上升沿
    stPlcDriveRef     : ST_PlcDriveRef; // 链接到 System Manager 的驱动器过程映像
    stDriveRef        : ST_DriveRef; // 解析出的驱动器引用
    bInit             : BOOL := TRUE; // 等过程映像就绪再放行
    bForceBrakeLock   : BOOL := FALSE; // 强制抱闸（同时置位时优先）
    bForceBrakeUnlock : BOOL := FALSE; // 强制松闸（注意垂直轴下坠风险）
    bSetReq           : BOOL := FALSE; // 在线置 TRUE 写一次控制字
    bSetBusy          : BOOL; // 写控制字执行中
    bSetError         : BOOL; // 写控制字出错
    iAdsErr           : UINT; // ADS 错误码
    iSercosErr        : UINT; // Sercos 错误码
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：维护/装配工位要在驱动器未使能时手动盘动电机轴（换工件、对刀），先强制松闸；
//       或诊断时单独控制抱闸开合确认机械动作正常。
//
// 价值：把"按位编码电机控制字 P-0-0096 + 写 SoE + 异步状态机"封装成两个布尔位
//       的一次调用，业务侧不必记 Bit 0 是 ForceLock、不必手拼控制字。
//
// 安全提醒：bForceBrakeUnlock 在未使能（无力矩保持）时松开机械刹车，垂直/悬挂
//       负载会因重力下坠。仅在确认负载安全或有外部支撑时使用！
//
// 验证步骤：
//   1. 引用 Tc2_Drive 库
//   2. System Manager 里把某 AX5000 SoE 从站过程映像链接到 stPlcDriveRef
//   3. 编译、登录、运行；观察 bInit 在过程映像就绪后自动变 FALSE
//   4. 确认负载安全后，在线置 bForceBrakeUnlock := TRUE，再置 bSetReq := TRUE
//      → bSetBusy 短暂为 TRUE，落下后 bSetError 应为 FALSE，抱闸应松开
//   5. 恢复：把两个强制位都置 FALSE 再触发一次 bSetReq，恢复"随 Enable 自动控制"
//      （调试后务必复位，否则正式运行时抱闸逻辑被覆盖）
//   6. 验证优先级：两位同时 TRUE 时再写一次，抱闸应为锁住状态（ForceLock 优先）
// =============================================================================

// 初始化驱动器引用
IF bInit THEN
    stDriveRef.sNetId     := F_CreateAmsNetId(stPlcDriveRef.aNetId);
    stDriveRef.nSlaveAddr := stPlcDriveRef.nSlaveAddr;
    stDriveRef.nDriveNo   := stPlcDriveRef.nDriveNo;
    stDriveRef.nDriveType := stPlcDriveRef.nDriveType;
    IF (stDriveRef.sNetId <> '') AND (stDriveRef.nSlaveAddr <> 0) THEN
        bInit := FALSE;
    END_IF;
END_IF;

rtrigSet(CLK := bSetReq);

// 单次调用形式：所有 VAR_INPUT 显式赋值
fbSetCtrlWord(
    stDriveRef   := stDriveRef,
    bExecute     := rtrigSet.Q AND NOT bInit,
    tTimeout     := DEFAULT_ADS_TIMEOUT,
    bForceLock   := bForceBrakeLock,
    bForceUnlock := bForceBrakeUnlock,
    bBusy        => bSetBusy,
    bError       => bSetError,
    iAdsErrId    => iAdsErr,
    iSercosErrId => iSercosErr
);

IF NOT bSetBusy AND NOT bInit THEN
    bSetReq := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
