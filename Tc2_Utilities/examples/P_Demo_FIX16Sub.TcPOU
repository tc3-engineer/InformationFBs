<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FIX16Sub" Id="{5ba2e30f-c6e4-5f76-9b13-f332237067d5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FIX16Sub
VAR
    fp8A     : T_FIX16;
    fp8B     : T_FIX16;
    fp8Diff  : T_FIX16;
    lrResult : LREAL;
    bSub     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.FIX16Sub 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：读两个传感器之差用于偏差控制。
// 价值：替代手写对齐 + INT 减法。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

fp8A := LREAL_TO_FIX16(0.5,  8);
fp8B := LREAL_TO_FIX16(0.75, 8);
IF bSub THEN
    fp8Diff  := FIX16Sub(fp8A, fp8B);
    lrResult := FIX16_TO_LREAL(fp8Diff);   // 应为 -0.25
    bSub := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
