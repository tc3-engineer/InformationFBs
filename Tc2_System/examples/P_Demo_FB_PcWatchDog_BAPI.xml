<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_PcWatchDog_BAPI Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_PcWatchDog_BAPI" pouType="program">
        <interface>
          <localVars>
            <variable name="fbPcWatchdogBapi">
              <type><derived name="FB_PcWatchDog_BAPI"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_PcWatchDog_BAPI 实例</xhtml></documentation>
            </variable>
            <variable name="bEnableSlowWatchdog">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 启用看门狗</xhtml></documentation>
            </variable>
            <variable name="nSlowWatchdogTimeSec">
              <initialValue><simpleValue value="600"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">看门狗超时 600 秒（10 分钟）</xhtml></documentation>
            </variable>
            <variable name="bBapiError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = ADS 调用失败（BIOS 可能不支持）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：慢工艺循环监护：超时设 600 秒（10 分钟），主循环每秒喂一次狗。卡死 10 分钟后 PC 自动重启。
// 价值：兼容主板更广，超时上限远超 FB_PcWatchdog。
// 验证：bEnableSlowWatchdog := TRUE → PC 正常；故意让 PLC 卡死超过 600 秒 → PC 自动重启。调试前务必 FALSE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbPcWatchdogBapi(
    sNetID         := '',
    nWatchdogTimeS := nSlowWatchdogTimeSec,
    bExecute       := bEnableSlowWatchdog,
    tTimeout       := T#5S
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
