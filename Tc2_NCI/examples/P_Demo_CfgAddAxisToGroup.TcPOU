<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_CfgAddAxisToGroup" Id="{633e0ebf-bcf4-50b9-92e9-b30e7dc4e340}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_CfgAddAxisToGroup
VAR
    fbCfgAddAxisToGroup                   : CfgAddAxisToGroup;  // 被演示 FB 实例
    rtTrig                                : R_TRIG;  // 边沿触发器，把人工『按一下』转上升沿
    bDoIt                                 : BOOL := FALSE;  // 在线写 TRUE 触发一次
    nGroupId_in                           : UDINT := 0;
    nAxisId_in                            : UDINT := 0;
    nIndex_in                             : UDINT := 0;
    tTimeOut_in                           : TIME := T#2S;  // ADS 调用超时
    bBusy_out                             : BOOL;
    bErr_out                              : BOOL;
    nErrId_out                            : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_NCI.CfgAddAxisToGroup 演示程序
// ============================================================
// 场景：定制 CNC 机床开机自检：PLC 在 System Manager 之外动态创建 NCI 3D 插补组，把 X/Y/Z 三根 PTP 轴组合起来。
// 价值：免去『改 XAE 配置 → 下载 → 重启 NC』流程，组配置在 PLC 里即时生效。
// 验证：在线写 bDoIt := TRUE 触发一次，观察 fbXxx.bBusy → TRUE → FALSE，bErr 应为 FALSE。若 bErr = TRUE，nErrId 给 NC 错误码（典型：组已存在、AxisId 不存在）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_NCI（References → Add library）
//   3. 在 System Manager 把 NCI 通道接口 Link 给 sNciToPlc_inst / sPlcToNci_inst
//      （NCTOPLC_NCICHANNEL_REF 给 AT %I*、PLCTONC_NCICHANNEL_REF 给 AT %Q*）
//   4. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 把人工按下的电平转成真正的上升沿；这是 bExecute 系列引脚的标准用法
rtTrig(CLK := bDoIt);

// 单次完整调用：所有 VAR_INPUT / VAR_IN_OUT / VAR_OUTPUT 引脚显式赋值或绑定
fbCfgAddAxisToGroup(
    bExecute := rtTrig.Q,
    nGroupId := nGroupId_in,
    nAxisId  := nAxisId_in,
    nIndex   := nIndex_in,
    tTimeOut := tTimeOut_in,
    bBusy    => bBusy_out,
    bErr     => bErr_out,
    nErrId   => nErrId_out
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
