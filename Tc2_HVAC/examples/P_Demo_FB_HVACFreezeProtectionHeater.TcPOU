<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACFreezeProtectionHeater" Id="{4a62dd6f-143f-593a-a9da-d851fc92f44f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACFreezeProtectionHeater
VAR
    fb : FB_HVACFreezeProtectionHeater;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bThermostat_in : BOOL := FALSE;
    rReturnWaterTemp_in : REAL := 0.0;
    bCtrlVoltage_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    rReturnWaterAlarmLimit_io : REAL := 0.0;
    rReturnWaterNormalLimit_io : REAL := 0.0;
    tDelayHardwareReset_io : TIME := T#0S;
    tMonitoringAfterReset_io : TIME := T#0S;
    byState_out : BYTE;
    bFrostProtecRunning_out : BOOL;
    bHardwareReset_out : BOOL;
    bErrorGeneral_out : BOOL;
    bAlarmReturnWaterTemp_out : BOOL;
    bAlarmThermostat_out : BOOL;
    byError_out : BYTE;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACFreezeProtectionHeater 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACFreezeProtectionHeater.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bThermostat := bThermostat_in,
    rReturnWaterTemp := rReturnWaterTemp_in,
    bCtrlVoltage := bCtrlVoltage_in,
    bReset := bReset_in,
    rReturnWaterAlarmLimit := rReturnWaterAlarmLimit_io,
    rReturnWaterNormalLimit := rReturnWaterNormalLimit_io,
    tDelayHardwareReset := tDelayHardwareReset_io,
    tMonitoringAfterReset := tMonitoringAfterReset_io,
    byState => byState_out,
    bFrostProtecRunning => bFrostProtecRunning_out,
    bHardwareReset => bHardwareReset_out,
    bErrorGeneral => bErrorGeneral_out,
    bAlarmReturnWaterTemp => bAlarmReturnWaterTemp_out,
    bAlarmThermostat => bAlarmThermostat_out,
    byError => byError_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
