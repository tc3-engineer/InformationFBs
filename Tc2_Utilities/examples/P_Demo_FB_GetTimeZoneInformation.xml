  <contentHeader name="Tc2_Utilities.FB_GetTimeZoneInformation Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetTimeZoneInformation" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetTimeZoneInformation">
              <type><derived name="FB_GetTimeZoneInformation"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetTimeZoneInformation 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTz">
              <type><derived name="TIME_ZONE_INFORMATION"/></type>
            </variable>
            <variable name="bDstNow">
              <type><BOOL/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读机器时区供 UTC 转换使用。
// 价值：标准 ADS 调用替代手工读注册表。
// 验证：改 bRead := TRUE，观察 stTz.Bias 与 Windows 控制面板时区一致；bDstNow 反映当前是否夏令时。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetTimeZoneInformation(
    sNetID := '', bExecute := bRead, tTimeout := DEFAULT_ADS_TIMEOUT,
    tzInfo =&gt; stTz, bDST =&gt; bDstNow,
    bBusy =&gt; bBusy_, bErr =&gt; bErrFlag, nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
