<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_AX200X_Profibus Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AX200X_Profibus" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAx2000All">
              <type><derived name="FB_AX200X_Profibus"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AX2000 综合 FB</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdIn">
              <type><derived name="ST_PZD_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 输入</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdOut">
              <type><derived name="ST_PZD_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 输出</xhtml></documentation>
            </variable>
            <variable name="bDriveInitReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿初始化</xhtml></documentation>
            </variable>
            <variable name="bUseDigitalSpeedMode">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">初始化为 Digital speed</xhtml></documentation>
            </variable>
            <variable name="iDigitalSpeedCmd">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Digital speed 指令</xhtml></documentation>
            </variable>
            <variable name="iVelocityCmd">
              <initialValue><simpleValue value="1500"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Motion 速度</xhtml></documentation>
            </variable>
            <variable name="iPositionTarget">
              <initialValue><simpleValue value="12000"/></initialValue>
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标位置</xhtml></documentation>
            </variable>
            <variable name="iRunMode">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=DS 1=MT 2=Jog 3=Cal</xhtml></documentation>
            </variable>
            <variable name="iMotionTaskNum">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">motion-task 号</xhtml></documentation>
            </variable>
            <variable name="iMotionBlockType">
              <initialValue><simpleValue value="16#2000"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">motion-task 类型</xhtml></documentation>
            </variable>
            <variable name="iJogBaseVelo">
              <initialValue><simpleValue value="100"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Jog 基础速度</xhtml></documentation>
            </variable>
            <variable name="iCalVelocity">
              <initialValue><simpleValue value="50"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Homing 速度</xhtml></documentation>
            </variable>
            <variable name="bSetRefPointReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">设置零位</xhtml></documentation>
            </variable>
            <variable name="bStartCmd">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿启动</xhtml></documentation>
            </variable>
            <variable name="bStopCmd">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿停止</xhtml></documentation>
            </variable>
            <variable name="bShortStopCmd">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">短停</xhtml></documentation>
            </variable>
            <variable name="iAx2000Station">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AX2000 站号</xhtml></documentation>
            </variable>
            <variable name="iFC310xDevId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FC310x DeviceId</xhtml></documentation>
            </variable>
            <variable name="bErrResumeReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">复位错误</xhtml></documentation>
            </variable>
            <variable name="tCmdTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：AX2000 综合控制：一个 FB 涵盖初始化 + jog + motion + homing。
// 价值：单一接口，业务代码简洁。
// 验证：登录后 bDriveInitReq := TRUE 一次完成初始化；切 iRunMode := 1 (Motiontask) + bStartCmd := TRUE → 伺服按 iPositionTarget 定位。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 必须循环调用维持 PZD 通讯
fbAx2000All(
    bInit              := bDriveInitReq,
    bMode_DigitalSpeed := bUseDigitalSpeedMode,
    iDigitalSpeed      := iDigitalSpeedCmd,
    iVelocity          := iVelocityCmd,
    iPosition          := iPositionTarget,
    iRunningMode       := iRunMode,
    imotion_tasknumber := iMotionTaskNum,
    imotion_blocktype  := iMotionBlockType,
    iJogModeBasicValue := iJogBaseVelo,
    iCalVelo           := iCalVelocity,
    bSetRefPoint       := bSetRefPointReq,
    bStart             := bStartCmd,
    bStop              := bStopCmd,
    bShortStop         := bShortStopCmd,
    iSlaveAddress      := iAx2000Station,
    iFC310xDeviceId    := iFC310xDevId,
    bErrorResume       := bErrResumeReq,
    tTimeOut           := tCmdTimeout
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
