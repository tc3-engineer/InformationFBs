<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DMXGetSoftwareVersionLabel" Id="{88aeeff4-c3d5-5477-a798-ea2ab8319528}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DMXGetSoftwareVersionLabel
VAR
    fbGetSwVersion    : FB_DMXGetSoftwareVersionLabel; // 读软件版本
    stDmxCmdBuffer    : ST_DMXCommandBuffer;          // 与通讯 FB 共用
    wTargetManufId    : WORD := 16#4241;              // 目标灯具厂商 ID
    dwTargetDeviceId  : DWORD := 16#12131415;         // 目标灯具设备 ID
    byTargetPort      : BYTE := 0;                    // 根设备通道 0
    bDoRead           : BOOL := FALSE;                // 在线给一次上升沿触发
    bBusy             : BOOL;
    bError            : BOOL;
    udiErrId          : UDINT;
    sSwVersion        : STRING;                       // 软件版本文本
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_DMX.FB_DMXGetSoftwareVersionLabel 演示程序
// ============================================================
// 场景：固件批量升级前版本核对：读出总线每盏灯固件版本文本，筛出版本过旧需升级的设备。
// 价值：把固件版本从设备直接读出，升级前能精确定位待升级设备，避免漏升或重复升。
// 验证：给 bDoRead 一次上升沿 -> bBusy 短暂 TRUE -> 回 FALSE 后 sSwVersion 即固件版本文本。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_DMX；同项目里放一个 FB_EL6851CommunicationEx 实例并共用 stDmxCmdBuffer（非 CycleMode）
//   3. 编译 → 登录 → 运行；按上方『验证』行在线给上升沿观察
// ============================================================

fbGetSwVersion(
    bStart                     := bDoRead,
    wDestinationManufacturerId := wTargetManufId,
    dwDestinationDeviceId      := dwTargetDeviceId,
    byPortId                   := byTargetPort,
    dwOptions                  := 0,
    stCommandBuffer            := stDmxCmdBuffer,
    bBusy                      => bBusy,
    bError                     => bError,
    udiErrorId                 => udiErrId,
    sSoftwareVersionLabel      => sSwVersion
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
