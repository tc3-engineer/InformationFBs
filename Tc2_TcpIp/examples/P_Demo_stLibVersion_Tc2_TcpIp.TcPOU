<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_stLibVersion_Tc2_TcpIp" Id="{1c0184b6-9344-52be-8eef-c60aae5febeb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_stLibVersion_Tc2_TcpIp
VAR
    bInit          : BOOL := TRUE;
    bLibVersionOk  : BOOL; // TRUE = 当前加载版本满足业务要求
    sActualVersion : STRING(23); // HMI 显示用：Tc2_TcpIp 实际版本字串
    iActualMajor   : INT;
    iActualMinor   : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：工程需要 TF6310 ≥ 1.5.0（才有 TLS 系列 FB）。PLC 初始化时校验
//       stLibVersion_Tc2_TcpIp，不达标就把 bLibVersionOk 留 FALSE，业务
//       代码后续依据此标志拒绝启动或退化到无 TLS 模式。
//
// 价值：演示库版本运行时校验——避免"开发期 TF6310 v1.5，部署到工厂老机器
//       v1.3 上 TLS FB 找不到符号"这种事故。
//
// 验证步骤：
//   1. 在线观察 sActualVersion 应为 '1.5.2' 或类似；iActualMajor=1, iActualMinor=5
//   2. bLibVersionOk 应为 TRUE
//   3. 如果在老版 TF6310 (例如 1.3.x) 上跑同一工程，sActualVersion='1.3.x'，
//      bLibVersionOk=FALSE，业务逻辑应阻止设备启动
// =============================================================================

IF bInit THEN
    bInit := FALSE;
    // 字串版本：HMI 直接显示
    sActualVersion := stLibVersion_Tc2_TcpIp.sVersion;
    // 整型字段：精确比较
    iActualMajor := stLibVersion_Tc2_TcpIp.iMajor;
    iActualMinor := stLibVersion_Tc2_TcpIp.iMinor;
    // 自家判断 ≥ 1.5.0（生产建议用 Tc2_System.F_CmpLibVersion 更严谨）
    bLibVersionOk := (iActualMajor > 1)
                  OR (iActualMajor = 1 AND iActualMinor >= 5);
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
