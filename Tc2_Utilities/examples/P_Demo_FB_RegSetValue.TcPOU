<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_RegSetValue" Id="{1fae7940-45d9-58ce-b70f-cac52b2b5fdd}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_RegSetValue
VAR
    fbFB_RegSetValue : FB_RegSetValue; // FB_RegSetValue 实例
    sNetId           : T_AmsNetId;
    sSubKey          : T_MaxString;
    sValName         : T_MaxString;
    eValType         : E_RegValueType;
    cbData           : UDINT;
    pData            : POINTER TO BYTE;
    bExecute         : BOOL;
    tTimeOut         : TIME := DEFAULT_ADS_TIMEOUT;
    bBusy            : BOOL;
    bError           : BOOL;
    nErrId           : UDINT;
    cbWrite          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：commissioning 配置注册表。
// 价值：脚本化。
// 验证：写一个测试键，用 FB_RegQueryValue 读回应一致。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_RegSetValue(
    sNetId := sNetId,
    sSubKey := sSubKey,
    sValName := sValName,
    eValType := eValType,
    cbData := cbData,
    pData := pData,
    bExecute := bExecute,
    tTimeOut := tTimeOut,
    bBusy => bBusy,
    bError => bError,
    nErrId => nErrId,
    cbWrite => cbWrite
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
