  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_SYSTEMTIME_TO_STRING" pouType="program">
        <interface>
          <localVars>
            <variable name="rResult">
              <type><string><stringLength><value>24</value></stringLength></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SYSTEMTIME_TO_STRING 的返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
            <variable name="stIn">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测试用本地变量</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.SYSTEMTIME_TO_STRING 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及类型所在依赖库 Tc2_System / Tc2_Standard）
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 观察 rResult 应为 '2024-01-01-12:00:00.000'
// ============================================================

stIn.wYear := 2024; stIn.wMonth := 1; stIn.wDay := 1; stIn.wHour := 12;
IF bRun THEN
    rResult := SYSTEMTIME_TO_STRING(stIn);
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
