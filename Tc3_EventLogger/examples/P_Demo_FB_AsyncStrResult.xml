<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.FB_AsyncStrResult Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AsyncStrResult" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">alarm 实例（已 Create）</xhtml></documentation>
            </variable>
            <variable name="fbResult">
              <type><derived name="FB_AsyncStrResult"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">异步结果实例</xhtml></documentation>
            </variable>
            <variable name="nLangId">
              <initialValue><simpleValue value="2052"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">简体中文 LCID</xhtml></documentation>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">处理状态属性</xhtml></documentation>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误状态属性</xhtml></documentation>
            </variable>
            <variable name="hrErrorCode">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误码</xhtml></documentation>
            </variable>
            <variable name="sEventText">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">结果文本</xhtml></documentation>
            </variable>
            <variable name="bDoReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发请求</xhtml></documentation>
            </variable>
            <variable name="bDoReqPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="bGot">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已取到结果</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Request 返回值</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：异步取事件文本演示
// 价值：异步轮询拿到本地化文本
// 验证：先 fbAlarm.RequestEventText 触发；每周期看 fbResult.bBusy 应在几周期内变 FALSE；之后 GetString 取文本
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 边沿触发发起请求
IF bDoReq AND NOT bDoReqPrev THEN
    hr := fbAlarm.RequestEventText(nLangId := nLangId, fbAsyncResult := fbResult);
    bGot := FALSE;
END_IF;
bDoReqPrev := bDoReq;

// 每周期检查异步状态
bBusy := fbResult.bBusy;
bError := fbResult.bError;
hrErrorCode := fbResult.hrErrorCode;

// 完成后取一次结果
IF NOT bBusy AND NOT bError AND NOT bGot THEN
    fbResult.GetString(sResult := sEventText);
    bGot := TRUE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
