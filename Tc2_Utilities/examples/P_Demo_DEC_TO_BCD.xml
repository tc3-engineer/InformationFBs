<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.DEC_TO_BCD Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_DEC_TO_BCD" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDEC_TO_BCD">
              <type><derived name="DEC_TO_BCD"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">DEC_TO_BCD 实例</xhtml></documentation>
            </variable>
            <variable name="decValue">
              <initialValue><simpleValue value="47"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PLC 内部十进制值</xhtml></documentation>
            </variable>
            <variable name="bcdOutput">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">送往 7 段译码模块的 BCD 字节</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把工位号 0..99 编码为 BCD 字节，输出到老式 7 段显示模块。
// 价值：封装位运算，意图清晰。
// 验证：改 decValue := 47，观察 bcdOutput 应为 16#47；改 99 应为 16#99；改 100 应为 16#60（脱离合法 BCD）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

decValue := LIMIT(0, decValue, 99);  // 工程保护：超范围会得到非法 BCD
fbDEC_TO_BCD(DECIN := decValue, BCDOUT =&gt; bcdOutput);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
