<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_GetDPRAMInfo Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetDPRAMInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetDpramInfo">
              <type><derived name="FB_GetDPRAMInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOV/DP-RAM 信息查询 FB</xhtml></documentation>
            </variable>
            <variable name="nDpramDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOVRAM 卡 Device Id</xhtml></documentation>
            </variable>
            <variable name="bGetDpramInfoReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发查询</xhtml></documentation>
            </variable>
            <variable name="tInfoQueryTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bGetInfoBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bGetInfoError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastInfoErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="stDpramAddrInfo">
              <type><derived name="ST_NovRamAddrInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOV/DP-RAM 地址 + 大小结构</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：上电时一次性查询 FC3101 卡 NOV-RAM 的地址指针，存到全局指针变量，后续业务直接通过 POINTER TO STRUCT 读写。
// 价值：拿到地址指针后访问 NOV-RAM 比走 FB 接口快得多（直接 MEMCPY，一个 PLC 周期完成）。
// 验证：登录后 nDeviceId := 1（NOVRAM 卡 ID），触发 bGetDpramInfoReq → bGetInfoBusy 短暂 TRUE → 回 FALSE 后 stDpramAddrInfo 含地址指针与大小；可在线 monitor 这些字段。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbGetDpramInfo(
    nDevId   := nDpramDeviceId,
    bExecute := bGetDpramInfoReq,
    tTimeOut := tInfoQueryTimeout,
    bBusy    =&gt; bGetInfoBusy,
    bError   =&gt; bGetInfoError,
    nErrId   =&gt; nLastInfoErrCode,
    stInfo   =&gt; stDpramAddrInfo
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
