<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_TcSourceInfo" Id="{be7034f0-4e4b-542b-aca8-6566a30361d6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_TcSourceInfo
VAR
    fbSrc      : FB_TcSourceInfo; // 自定义源信息实例
    sStationId : STRING(40) := 'Station-01'; // 工位号
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：配置自定义 SourceInfo 给后续 alarm 用，让事件能定位到具体工位
// 价值：多工位事件追溯
// 验证：登录后 fbSrc 实例存在；通过它的 setter 写入工位号；之后给 alarm 用
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 实际工程：通常在 FB_init 里配置 fbSrc 的 SourceName 字段（通过 setter）。
// 之后调用 fbAlarm.Create(..., ipSourceInfo := fbSrc); 把 fbSrc 传给 alarm。
// 本例只演示实例化：实际 setter 接口请见 I_TcSourceInfo 文档。
fbSrc.ExtendName(sExtName := sStationId);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
