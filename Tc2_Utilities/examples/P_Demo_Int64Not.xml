  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Int64Not" pouType="program">
        <interface>
          <localVars>
            <variable name="liMask">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="liInverted">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="bInvert">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.Int64Not 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：构造'除指定位以外全 1'的掩码。
// 价值：替代两次 DWORD NOT。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bInvert THEN
    liInverted := Int64Not(liMask);
    bInvert := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
