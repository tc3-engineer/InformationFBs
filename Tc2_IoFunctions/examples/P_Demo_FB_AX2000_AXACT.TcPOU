<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_AX2000_AXACT" Id="{380c6eab-4698-5f4d-8d24-d750b0890035}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_AX2000_AXACT
VAR
    fbAx2000Action        : FB_AX2000_AXACT; // AX2000 动作 FB（必须循环调用）
    stAx2000PzdIn         : ST_PZD_IN; // 驱动器 → PLC PZD（链到 %I*）
    stAx2000PzdOut        : ST_PZD_OUT; // PLC → 驱动器 PZD（链到 %Q*）
    iTargetVelocity       : DWORD := 1500; // 目标速度 μm/s
    iMotionTargetPosition : DINT := 12000; // 目标位置 μm
    iMotionTaskNum        : WORD := 0; // 存内 motion-task 号；0 表示用直接指令
    iMotionBlockType      : WORD := 16#2000; // motion-task 类型 (默认 SI 单位)
    bMotionStartReq       : BOOL := FALSE; // 上升沿启动 motion
    bMotionStopReq        : BOOL := FALSE; // 上升沿正常停车
    bMotionShortStopReq   : BOOL := FALSE; // 上升沿短停
    bMotionErrorReset     : BOOL := FALSE; // 上升沿复位 AX2000 错误
    tMotionTimeout        : TIME := T#5S; // PZD 通讯超时
    bMotionBusy           : BOOL; // 工作中
    bMotionErrFlag        : BOOL; // 驱动器故障
    bMotionTimeoutErrFlag : BOOL; // 通讯超时
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：AX2000 印刷套筒伺服：上电后位置就绪即下发位置指令 12000 μm + 速度 1500 μm/s。
// 价值：封装 PROFIDRIVE 协议状态机，避免手撸 PZD 协议。
// 验证：登录后 stAx2000PzdIn / stAx2000PzdOut 已链到 AX2000 PZD；在线写 bMotionStartReq := TRUE → fbAx2000Action.bBusy 短暂 TRUE → 驱动器开始定位；监视 stAx2000PzdIn 中位置实时反馈应趋向 iMotionTargetPosition。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 必须每周期循环调用以维持 PZD 通讯
fbAx2000Action(
    iVelocity          := iTargetVelocity,
    iPosition          := iMotionTargetPosition,
    imotion_tasknumber := iMotionTaskNum,
    imotion_blocktype  := iMotionBlockType,
    bStart             := bMotionStartReq,
    bStop              := bMotionStopReq,
    bShortStop         := bMotionShortStopReq,
    bErrorResume       := bMotionErrorReset,
    tTimeOut           := tMotionTimeout,
    stPZDIN            := stAx2000PzdIn,
    stPZDOUT           := stAx2000PzdOut,
    bBusy              => bMotionBusy,
    bError             => bMotionErrFlag,
    bTimeOutErr        => bMotionTimeoutErrFlag
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
