<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVAC3PointActuator" Id="{49c835d2-5210-505b-852f-b67ae4a2433d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVAC3PointActuator
VAR
    fb : FB_HVAC3PointActuator;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    bAutoOpen_in : BOOL := FALSE;
    bAutoClose_in : BOOL := FALSE;
    eCtrlModeActuator_in : E_HVAC3PointActuatorMode ;
    bManSwitch_in : BOOL := FALSE;
    rFeedb_in : REAL := 0.0;
    bCtrlVoltage_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    bEnableFeedbCtrl_io : BOOL := FALSE;
    rMinValueFeedb_io : REAL := 0.0;
    rMaxValueFeedb_io : REAL := 0.0;
    rHysteresisFeedb_io : REAL := 0.0;
    bOpen_out : BOOL;
    bClose_out : BOOL;
    byState_out : BYTE;
    eStateModeActuator_out : E_HVAC3PointActuatorMode;
    bErrorFeedb_out : BOOL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVAC3PointActuator 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVAC3PointActuator.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    bAutoOpen := bAutoOpen_in,
    bAutoClose := bAutoClose_in,
    eCtrlModeActuator := eCtrlModeActuator_in,
    bManSwitch := bManSwitch_in,
    rFeedb := rFeedb_in,
    bCtrlVoltage := bCtrlVoltage_in,
    bReset := bReset_in,
    bEnableFeedbCtrl := bEnableFeedbCtrl_io,
    rMinValueFeedb := rMinValueFeedb_io,
    rMaxValueFeedb := rMaxValueFeedb_io,
    rHysteresisFeedb := rHysteresisFeedb_io,
    bOpen => bOpen_out,
    bClose => bClose_out,
    byState => byState_out,
    eStateModeActuator => eStateModeActuator_out,
    bErrorFeedb => bErrorFeedb_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
