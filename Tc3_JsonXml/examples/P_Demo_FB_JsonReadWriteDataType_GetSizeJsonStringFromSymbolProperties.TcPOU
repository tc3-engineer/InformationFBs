<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonReadWriteDataType_GetSizeJsonStringFromSymbolProperties" Id="{d24fee8c-c0cf-57b0-b458-18f197fc52cf}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonReadWriteDataType_GetSizeJsonStringFromSymbolProperties
VAR
    fbParser : FB_JsonReadWriteDataType; // 父 FB 实例
    sDatatype : STRING(255);
    sProperties : STRING(255);
    hrErrorCode : HRESULT;
    vRet : UDINT; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：从已解析的 JSON DOM 中读取某字段的 SizeJsonStringFromSymbolProperties 类型值（如解析云端下发指令里的目标速度、批次号、状态码）。
// 价值：按节点直接取值，比反复扫字符串快。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.GetSizeJsonStringFromSymbolProperties(
        sDatatype := sDatatype,
        sProperties := sProperties,
        hrErrorCode => hrErrorCode
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
