<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_DATE_SEND_EX" Id="{a1e49c86-abdc-50a0-bdb8-54f5eac4fb66}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_DATE_SEND_EX
VAR
    fbSendDateEx    : EIB_DATE_SEND_EX;
    stEibRec        : EIB_REC;
    stGroup         : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 0, NUMBER := 1);
    bSendStart      : BOOL;
    iWorkMode       : INT := 1;
    tCycle          : TIME := T#1M;
    tMinSend        : TIME := T#500MS;
    wDay            : WORD := 3;
    wMonth          : WORD := 6;
    wYear           : WORD := 2026;
    bResponseRead   : BOOL := TRUE;
    bSendBusy       : BOOL;
    bSendError      : BOOL;
    iLastErrID      : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_DATE_SEND_EX 演示程序
// ============================================================
// 场景：日期每分钟广播 + 响应 BMS read 请求
// 价值：比 5 分钟节拍更灵活
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：登录 `bStart := TRUE`、`iMode := 1`、`CyclePolling := T#1M` → 每分钟出帧。
// ============================================================

fbSendDateEx(
    bStart         := bSendStart,
    iMode          := iWorkMode,
    CyclePolling   := tCycle,
    MinSendTime    := tMinSend,
    Group_Address  := stGroup,
    wDay           := wDay,
    wMonth         := wMonth,
    wYear          := wYear,
    str_Rec        := stEibRec,
    bEnableReadReq := bResponseRead,
    bBusy          => bSendBusy,
    bError         => bSendError,
    iErrorID       => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
