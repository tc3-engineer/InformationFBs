<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Min" Id="{77922ec8-6a33-5414-a7ee-6f992b0da97c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Min
VAR
    uliLineA : T_ULARGE_INTEGER;; // A 线剩余
    uliLineB : T_ULARGE_INTEGER;; // B 线剩余
    uliMin   : T_ULARGE_INTEGER;; // 瓶颈
    bPick    : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Min 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：选定两个生产线的剩余容量中较小者作为系统瓶颈。
// 价值：替代手写 IF/ELSE；一次调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bPick THEN
    uliMin := UInt64Min(uliLineA, uliLineB);
    bPick := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
