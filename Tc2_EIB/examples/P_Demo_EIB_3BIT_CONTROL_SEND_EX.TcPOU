<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_3BIT_CONTROL_SEND_EX" Id="{a090a7d0-0420-5cb0-841b-ecc0f7224c51}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_3BIT_CONTROL_SEND_EX
VAR
    fbSendDimEx        : EIB_3BIT_CONTROL_SEND_EX;
    stEibRec           : EIB_REC;
    stGroup            : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 2, NUMBER := 15);
    bSendStart         : BOOL;
    iWorkMode          : INT := 3;
    tCyclePeriod       : TIME := T#10S;
    tMinChangeInterval : TIME := T#500MS;
    bDirUp             : BOOL := TRUE;
    byStep             : BYTE := 4;
    bResponseRead      : BOOL := TRUE;
    bSendBusy          : BOOL;
    bSendError         : BOOL;
    iLastErrID         : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_3BIT_CONTROL_SEND_EX 演示程序
// ============================================================
// 场景：场景灯控制：调光命令按 OnChangePolling 模式发，确保 BMS 总能拿到最新状态；周期 10 秒心跳。
// 价值：周期心跳 + 即时变化 + 主动答查；调光复杂场景首选
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：登录 `bSendStart := TRUE`、`iWorkMode := 3` → 每 10 秒看到组 1/2/15 出帧；改 byStep 立即出帧。
// ============================================================

fbSendDimEx(
    bStart         := bSendStart,
    iMode          := iWorkMode,
    CyclePolling   := tCyclePeriod,
    MinSendTime    := tMinChangeInterval,
    Group_Address  := stGroup,
    bControl       := bDirUp,
    byRange        := byStep,
    str_Rec        := stEibRec,
    bEnableReadReq := bResponseRead,
    bBusy          => bSendBusy,
    bError         => bSendError,
    iErrorID       => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
