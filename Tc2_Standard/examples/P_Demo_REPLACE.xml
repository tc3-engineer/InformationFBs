<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T08:00:00"/>
  <contentHeader name="Tc2_Standard.REPLACE Demo" modificationDateTime="2026-05-11T08:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_REPLACE" pouType="program">
        <interface>
          <localVars>
            <variable name="sLogLine">
              <type><string><length>255</length></string></type>
              <initialValue><simpleValue value="'WARN_ Motor stalled'"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">原始日志：等级 'WARN_' + 消息体</xhtml></documentation>
            </variable>
            <variable name="sNewLevel">
              <type><string><length>255</length></string></type>
              <initialValue><simpleValue value="'ERROR'"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">升级后的等级标识</xhtml></documentation>
            </variable>
            <variable name="sResult">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">等级升级后的完整日志</xhtml></documentation>
            </variable>
            <variable name="nReplaceLen">
              <type><INT/></type>
              <initialValue><simpleValue value="5"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">被替换段长度 = 5（'WARN_' 5 字符）</xhtml></documentation>
            </variable>
            <variable name="nReplacePos">
              <type><INT/></type>
              <initialValue><simpleValue value="1"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">替换起点 = 第 1 字符</xhtml></documentation>
            </variable>
            <variable name="bUpgrade">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次等级升级</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：报警系统判定某条 WARN 级别的日志在 30 秒内累积 5 次未恢复，需要把
//       它升级为 ERROR 重发。原始日志 'WARN_ Motor stalled' 前 5 字符是等级，
//       REPLACE 一行调用就能把 'WARN_' 换成 'ERROR' 保持消息体不变。
//
// 价值：REPLACE 按位置 + 长度替换整段，结果长度可与原段不同。比 DELETE +
//       INSERT 两步合一。注意：本函数不是"模式匹配替换"，要替换所有出现
//       必须配合 FIND 写循环。
//
// 验证步骤：
//   1. 导入本文件、引用 Tc2_Standard、编译、登录、运行
//   2. 在线 monitor sResult
//   3. 在线写 bUpgrade := TRUE
//   4. 下一周期 sResult = &apos;ERROR Motor stalled&apos;（&apos;WARN_&apos; 被换成 &apos;ERROR&apos;）
//   5. 把 sNewLevel 改成 &apos;INFO&apos;（只 4 字符）+ 再触发 →
//      sResult = &apos;INFO Motor stalled&apos;（长度自动变短，验证替换段可不等长）
// =============================================================================

// 入参顺序：(STR1, STR2, L, P) — L 在 P 前，POS 从 1 起
IF bUpgrade THEN
    sResult := REPLACE(sLogLine, sNewLevel, nReplaceLen, nReplacePos);
    bUpgrade := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
