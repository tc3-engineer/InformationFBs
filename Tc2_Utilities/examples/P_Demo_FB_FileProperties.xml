  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileProperties" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_FileProperties">
              <type><derived name="FB_FileProperties"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileProperties 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="sPath">
              <initialValue><simpleValue value="'C:\\TwinCAT\\Boot\\TwinCAT.config'"/></initialValue>
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="stProps">
              <type><derived name="ST_FileProperties"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：检查配方文件 freshness。
// 价值：替代 dir。
// 验证：改 sPath := 'C:\TwinCAT\Boot\TwinCAT.config'，触发后 stProps.nFileSize &gt; 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_FileProperties(
    sNetID := '', bExecute := bRead, sPathName := sPath, ePath := PATH_GENERIC,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    stProperties =&gt; stProps, bBusy =&gt; bBusy_, bError =&gt; bErrFlag, nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
