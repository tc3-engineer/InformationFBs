<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_CmpLibVersion Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_CmpLibVersion" pouType="program">
        <interface>
          <localVars>
            <variable name="iMajorRequired">
              <initialValue><simpleValue value="3"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要求 major</xhtml></documentation>
            </variable>
            <variable name="iMinorRequired">
              <initialValue><simpleValue value="3"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要求 minor</xhtml></documentation>
            </variable>
            <variable name="iBuildRequired">
              <initialValue><simpleValue value="8"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要求 build</xhtml></documentation>
            </variable>
            <variable name="iRevisionRequired">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要求 revision</xhtml></documentation>
            </variable>
            <variable name="nCmpResult">
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">比较结果：-1 / 0 / +1</xhtml></documentation>
            </variable>
            <variable name="bSystemBlocked">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 版本不满足，拒绝启动 MAIN</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：MAIN 启动时检查 Tc2_System 是否 ≥ 3.3.8.0；低版本置位 bSystemBlocked，拒绝运行业务逻辑。
// 价值：一行守门替代 4 段 IF 链；启动早期发现版本问题。
// 验证：在线观察 nCmpResult：装的是更新版本时 = 1；改 iMajorRequired := 99 → -1 → bSystemBlocked := TRUE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 启动期一次性比较；只要 &gt;= 0 即视为满足要求
nCmpResult := F_CmpLibVersion(
    stVersion := stLibVersion_Tc2_System,
    iMajor    := iMajorRequired,
    iMinor    := iMinorRequired,
    iBuild    := iBuildRequired,
    iRevision := iRevisionRequired
);

// 版本不足直接锁住业务逻辑
bSystemBlocked := (nCmpResult &amp;lt; 0);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
