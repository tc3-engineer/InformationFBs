        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc3_EventLogger.FB_TcAlarm.Create 演示程序（OO 方法）
// ============================================================
// 验证步骤：
//   1. 引用 Tc3_EventLogger（及依赖类型所在库 Tc2_System 等）
//   2. 编译 + 登录
//   3. 在线给 arg_* 赋值（eventClass、nEventId、eSeverity、bWithConfirmation、ipSourceInfo）
//   4. 触发 Create，监视返回的 hr（S_OK 表示成功）
// ============================================================

hr := fbTcAlarm.Create(
    eventClass := arg_eventClass,
    nEventId := arg_nEventId,
    eSeverity := arg_eSeverity,
    bWithConfirmation := arg_bWithConfirmation,
    ipSourceInfo := arg_ipSourceInfo
);
</xhtml>
          </ST>
