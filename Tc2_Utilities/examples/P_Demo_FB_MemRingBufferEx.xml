        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：变长事件日志。
// 价值：支持变长。
// 验证：Add 不同长度记录，Get 取回原样。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemRingBufferEx(
    pWrite := pWrite,
    cbWrite := cbWrite,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk =&gt; bOk,
    pRead =&gt; pRead,
    cbRead =&gt; cbRead,
    nCount =&gt; nCount,
    cbSize =&gt; cbSize,
    cbFree =&gt; cbFree
);
</xhtml></ST>
        </body>
