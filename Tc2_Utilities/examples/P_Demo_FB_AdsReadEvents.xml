  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AdsReadEvents" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_AdsReadEvents">
              <type><derived name="FB_AdsReadEvents"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">[obsolete] 实例</xhtml></documentation>
            </variable>
            <variable name="arg_sNetId">
              <type><derived name="T_AMSNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT sNetId: 目标 AmsNetId（空字符串=本地）</xhtml></documentation>
            </variable>
            <variable name="arg_bReadEvents">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT bReadEvents: 使能读消息；下降沿同时复位错误输出</xhtml></documentation>
            </variable>
            <variable name="arg_nLanguageId">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT nLanguageId: Language ID（决定查哪种语言的消息文本）</xhtml></documentation>
            </variable>
            <variable name="arg_eDateAndTimeFormat">
              <type><derived name="E_DateAndTimeFormat"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT eDateAndTimeFormat: 时间戳格式（de_De / en_GB / en_US）</xhtml></documentation>
            </variable>
            <variable name="arg_tRefreshTime">
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT tRefreshTime: 消息查询周期</xhtml></documentation>
            </variable>
            <variable name="arg_tTimeout">
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT tTimeout: ADS 超时</xhtml></documentation>
            </variable>
            <variable name="out_aEvents">
              <type><derived name="ARRAY[1..80] OF ST_ReadEvent"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT aEvents: 查到的消息数组（最多 80 条）</xhtml></documentation>
            </variable>
            <variable name="out_nNumberOfEvents">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT nNumberOfEvents: 实际消息数量</xhtml></documentation>
            </variable>
            <variable name="out_bBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT bBusy: 执行中</xhtml></documentation>
            </variable>
            <variable name="out_bDone">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT bDone: 完成</xhtml></documentation>
            </variable>
            <variable name="out_bError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT bError: 出错</xhtml></documentation>
            </variable>
            <variable name="out_nErrorId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT nErrorId: 错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FB_AdsReadEvents 演示程序（已废弃 FB）
// ============================================================
// ⚠️ 本 FB 已废弃。新代码请使用 PDF 中提示的替代 FB。
// 验证步骤：
//   1. 引用 Tc2_Utilities（及依赖类型所在库）
//   2. 编译 + 登录
//   3. 按 doc.md 的输入说明给 arg_* 赋值
//   4. 监视 out_bError / out_nErrorId
// ============================================================

fbFB_AdsReadEvents(
    sNetId := arg_sNetId,
    bReadEvents := arg_bReadEvents,
    nLanguageId := arg_nLanguageId,
    eDateAndTimeFormat := arg_eDateAndTimeFormat,
    tRefreshTime := arg_tRefreshTime,
    tTimeout := arg_tTimeout,
    aEvents => out_aEvents,
    nNumberOfEvents => out_nNumberOfEvents,
    bBusy => out_bBusy,
    bDone => out_bDone,
    bError => out_bError,
    nErrorId => out_nErrorId
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
