  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Or" pouType="program">
        <interface>
          <localVars>
            <variable name="uliFaultModuleA">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模块 A 故障字</xhtml></documentation>
            </variable>
            <variable name="uliFaultModuleB">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模块 B 故障字</xhtml></documentation>
            </variable>
            <variable name="uliFaultSys">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">系统总故障字</xhtml></documentation>
            </variable>
            <variable name="bMerge">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Or 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把多个子模块的 64 位故障位合并成系统级故障字。
// 价值：替代手写两次 DWORD OR。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bMerge THEN
    uliFaultSys := UInt64Or(uliFaultModuleA, uliFaultModuleB);
    bMerge := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
