<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_ResetTaskExceedCounter" Id="{b31786f1-3528-56a0-8d09-d7ba0c98aec4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_ResetTaskExceedCounter
VAR
    fbFB_ResetTaskExceedCounter : FB_ResetTaskExceedCounter; // FB_ResetTaskExceedCounter 实例
    bResetExceedReq             : BOOL; // 在线上升沿触发清零
    nMyTaskPort                 : UINT; // 目标任务 ADS 端口
    bExceedResetting            : BOOL; // 正在写
    bExceedResetErr             : BOOL; // ADS 写错误
    nLastAdsError               : UDINT; // ADS 错误码
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.FB_ResetTaskExceedCounter 演示程序
// ============================================================
// 场景：优化任务代码后清零超限计数做新基线验证。
// 价值：一行调用替代手写 ADSWRITE + 符号句柄维护。
// 验证：登录后 nMyTaskPort 自动填充；先用 FB_ReadTaskExceedCounter 看到当前值非 0，写 bResetExceedReq := TRUE 后再读，应为 0。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 自动取本任务 ADS 端口
nMyTaskPort := TwinCAT_SystemInfoVarList._TaskInfo[GETCURTASKINDEXEX()].AdsPort;

fbFB_ResetTaskExceedCounter(
    bExecute := bResetExceedReq, nTaskAdsPort := nMyTaskPort,
    bBusy => bExceedResetting, bError => bExceedResetErr, nErrorID => nLastAdsError
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
