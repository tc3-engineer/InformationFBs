<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_CreateAmsNetId" Id="{d3079ce8-6690-52f1-8aba-0079fab4e077}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_CreateAmsNetId
VAR
    arrTargetIdBytes : T_AmsNetIdArr := [127, 16, 17, 3, 1, 1]; // 目标 NetID 字节数组（来自配置）
    sTargetNetId     : T_AmsNetId; // 拼出的字符串：'127.16.17.3.1.1'
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.F_CreateAmsNetId 演示程序
// ============================================================
// 场景：配置文件存 6 字节 NetID（省空间）；运行时拼成字符串给 ADSREAD 用。
// 价值：替代手写 6 次拼接。
// 验证：登录后看 sTargetNetId 应为 '127.16.17.3.1.1'。改 arrTargetIdBytes 元素观察字符串同步变化。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

sTargetNetId := F_CreateAmsNetId(arrTargetIdBytes);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
