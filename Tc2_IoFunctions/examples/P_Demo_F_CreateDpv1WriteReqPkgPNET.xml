<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.F_CreateDpv1WriteReqPkgPNET Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_CreateDpv1WriteReqPkgPNET" pouType="program">
        <interface>
          <localVars>
            <variable name="aDpv1WriteReqBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求缓冲</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ValueHdr">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ValueHeaderEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">值</xhtml></documentation>
            </variable>
            <variable name="iNumParamsToWrite">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数数</xhtml></documentation>
            </variable>
            <variable name="iDriveObjectId">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive A</xhtml></documentation>
            </variable>
            <variable name="bBuildWriteReqPkgPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发</xhtml></documentation>
            </variable>
            <variable name="nWriteReqPkgLenPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">长度</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Profinet SINAMICS 一次写 2 个参数。
// 价值：对称封装。
// 验证：写 bBuildWriteReqPkgPNET := TRUE → nWriteReqPkgLenPNET &gt; 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bBuildWriteReqPkgPNET THEN
    nWriteReqPkgLenPNET := F_CreateDpv1WriteReqPkgPNET(
        pDpv1ReqData        := ADR(aDpv1WriteReqBuffer),
        iNumOfParams        := iNumParamsToWrite,
        iDriveId            := iDriveObjectId,
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bBuildWriteReqPkgPNET := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
