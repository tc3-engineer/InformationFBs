  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Profiler" pouType="program">
        <interface>
          <localVars>
            <variable name="fbProfiler">
              <type><derived name="Profiler"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profiler 实例</xhtml></documentation>
            </variable>
            <variable name="START">
              <type><BOOL/></type>
            </variable>
            <variable name="RESET">
              <type><BOOL/></type>
            </variable>
            <variable name="BUSY">
              <type><BOOL/></type>
            </variable>
            <variable name="DATA">
              <type><derived name="PROFILERSTRUCT"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：优化对比。
// 价值：定位热点。
// 验证：Start → 业务代码 → Stop → 读 nElapsed 微秒值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbProfiler(
    START := START,
    RESET := RESET,
    BUSY =&gt; BUSY,
    DATA =&gt; DATA
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
