<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MemStackBuffer" Id="{d55119c0-5200-561c-bce4-a196d00bce29}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MemStackBuffer
VAR
    fbFB_MemStackBuffer : FB_MemStackBuffer; // FB_MemStackBuffer 实例
    pWrite              : POINTER TO BYTE;
    cbWrite             : UDINT;
    pRead               : POINTER TO BYTE;
    cbRead              : UDINT;
    pBuffer             : POINTER TO BYTE;
    cbBuffer            : UDINT;
    bOk                 : BOOL;
    nCount              : UDINT;
    cbSize              : UDINT;
    cbReturn            : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：Undo 栈。
// 价值：标准 LIFO。
// 验证：Push 3 个元素，Pop 3 次按相反顺序取回。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemStackBuffer(
    pWrite := pWrite,
    cbWrite := cbWrite,
    pRead := pRead,
    cbRead := cbRead,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk => bOk,
    nCount => nCount,
    cbSize => cbSize,
    cbReturn => cbReturn
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
