<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEWritePassword" Id="{65a19e58-96a3-5599-9081-4b5984b3646d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEWritePassword
VAR
    fbWritePassword : FB_SoEWritePassword; // 写驱动器密码 FB 实例
    axisServo       : AXIS_REF; // 伺服轴轴引用；必须先在 System Manager 配好并 Link
    rtPwdTrig       : R_TRIG; // 把电平转上升沿
    bWritePwdReq    : BOOL := FALSE; // 在线写 TRUE 触发一次写密码
    stDrivePassword : ST_SoE_String; // 驱动器密码（Sercos 字符串），按驱动器手册格式填
    bPwdBusy        : BOOL;
    bPwdError       : BOOL;
    nPwdAdsErr      : UINT;
    nPwdSercosErr   : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：产线换型要批量修改伺服的受保护参数。修改前必须先用本 FB 把驱动器
//       密码写进 S-0-0267 解锁，之后才能用 FB_SoEWrite 改受保护参数。
//
// 价值：1) 把"解锁驱动器"纳入 PLC 自动化流程，免人工进 DriveManager 输密码
//       2) 配合 FB_SoEWrite 实现无人工干预的受保护参数修改
//       3) 与库内其它 SoE FB 接口一致，时序统一
//
// !! 注意：FB_SoEWrite 自身的 Password 形参不起作用，解锁必须用本 FB。
//
// 验证步骤：
//   1. System Manager 配好 NC 轴并 Link 给 axisServo，引用 Tc2_MC2_Drive
//   2. Add Existing Item (.TcPOU) 选本文件，加进 PlcTask，编译登录
//   3. 在线给 stDrivePassword 填入正确的驱动器密码（按手册格式）
//   4. 写 bWritePwdReq := TRUE → bPwdBusy 置 TRUE
//   5. 等 bPwdBusy 落回 FALSE 且 bPwdError = FALSE 即解锁成功，
//      此后可用 FB_SoEWrite 改受保护参数
//   6. 若 bPwdError = TRUE：看 nPwdAdsErr（通信），nPwdSercosErr（密码错/格式）
// =============================================================================

// 用 R_TRIG 把"持续按住的 TRUE"转成真正的上升沿
rtPwdTrig(CLK := bWritePwdReq);

// 单次调用：Password 来自在线填入的 ST_SoE_String；Axis 是 VAR_IN_OUT 必传
// 本 FB 无 Done，靠 Busy 落回 FALSE 且 Error=FALSE 判成功
fbWritePassword(
    NetId       := '',
    Execute     := rtPwdTrig.Q,
    Timeout     := DEFAULT_ADS_TIMEOUT,
    Password    := stDrivePassword,
    Axis        := axisServo,
    Busy        => bPwdBusy,
    Error       => bPwdError,
    AdsErrId    => nPwdAdsErr,
    SercosErrId => nPwdSercosErr
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
