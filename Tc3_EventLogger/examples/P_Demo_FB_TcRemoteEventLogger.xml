<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.FB_TcRemoteEventLogger Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TcRemoteEventLogger" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRemoteLogger">
              <type><derived name="FB_TcRemoteEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">远程 EventLogger 视图</xhtml></documentation>
            </variable>
            <variable name="sRemoteNetId">
              <initialValue><simpleValue value="'192.168.1.10.1.1'"/></initialValue>
              <type><string><length>40</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">远程 AMS Net ID</xhtml></documentation>
            </variable>
            <variable name="nRemotePort">
              <initialValue><simpleValue value="851"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AMS Port（默认 PLC 任务为 851）</xhtml></documentation>
            </variable>
            <variable name="bConnected">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">连接状态</xhtml></documentation>
            </variable>
            <variable name="bDoConnect">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发连接</xhtml></documentation>
            </variable>
            <variable name="bDoConnectPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：远程清除某 PLC 的所有 alarm
// 价值：跨 PLC 维护操作
// 验证：需要远程 AMS 路由已配置。Connect 成功后调用 ClearAllAlarms 应让远程 EventLogger 状态变化
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 边沿触发：建立连接
IF bDoConnect AND NOT bDoConnectPrev THEN
    hr := fbRemoteLogger.Connect(sNetId := sRemoteNetId, nPort := nRemotePort);
    bConnected := SUCCEEDED(hr);
END_IF;
bDoConnectPrev := bDoConnect;

// 远程操作（示例：批量清除远程 alarm）
// IF bConnected THEN hr := fbRemoteLogger.ClearAlarms(...); END_IF;
// 流程结束：fbRemoteLogger.Disconnect();
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
