<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.TIME_TO_OTSTRUCT Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_TIME_TO_OTSTRUCT" pouType="program">
        <interface>
          <localVars>
            <variable name="tRuntime">
              <type><TIME/></type>
              <initialValue><simpleValue value="T#3d12h5m30s"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">设备累计运行时长（从 RTC 时基取）</xhtml></documentation>
            </variable>
            <variable name="otRuntime">
              <type><derived name="OTSTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">按字段拆开的运行时长（HMI 字段绑定）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 显示设备已连续运行时长「X 周 Y 天 Z 小时 W 分」便于操作员一眼看出
//
// 价值：1 行调用拆分 5 次整除取余，避免手写 6 行除法 + 余数赋值
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 otRuntime: byWeeks=0, byDays=3, byHours=12, byMinutes=5, bySeconds=30, wMilliseconds=0
//   5. TIME 上限 ~49.7 天，byWeeks 最大约 7
// =============================================================================
otRuntime := TIME_TO_OTSTRUCT(tRuntime);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
