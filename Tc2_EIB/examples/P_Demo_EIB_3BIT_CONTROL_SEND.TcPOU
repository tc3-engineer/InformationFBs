<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_3BIT_CONTROL_SEND" Id="{114f4b30-cb85-562c-b43b-3a3a82a1d7f3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_3BIT_CONTROL_SEND
VAR
    fbSendDim    : EIB_3BIT_CONTROL_SEND;
    stEibRec     : EIB_REC;
    stGroup      : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 2, NUMBER := 15);
    bDirUp       : BOOL := TRUE;
    byCurrentStep: BYTE;            // 0..7
    bSendError   : BOOL;
    iLastErrID   : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_3BIT_CONTROL_SEND 演示程序
// ============================================================
// 场景：调光面板按钮：用户按住按钮调光向上 → PLC 持续推 (TRUE, 4) 到组地址 1/2/15；松开后推 (TRUE, 0) 停止。
// 价值：替代手写 4-bit 拼装 + 变化检测；DPT 3.xxx 标准发送方式
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：按下「调光向上」按钮 → 组 1/2/15 在 BMS 监控里出现 (1, 100b) 即 0x0C；松开 → 出现 (1, 000b) 即 0x08。
// ============================================================

// 业务层只要把 byCurrentStep 改成 0..7，FB 自动发
fbSendDim(
    Group_Address := stGroup,
    bControl      := bDirUp,
    byRange       := byCurrentStep,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
