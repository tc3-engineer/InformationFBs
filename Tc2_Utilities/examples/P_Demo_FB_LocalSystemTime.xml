        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FB_LocalSystemTime 演示程序（FB 实例）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及依赖类型所在库 Tc2_System 等）
//   2. 编译 + 登录
//   3. 按 doc.md 给 arg_* 赋值
//   4. 在线监视 out_* / io_* 输出
// ============================================================

fbFB_LocalSystemTime(
    sNetID := arg_sNetID,
    bEnable := arg_bEnable,
    dwCycle := arg_dwCycle,
    dwOpt := arg_dwOpt,
    tTimeout := arg_tTimeout,
    bValid =&gt; out_bValid,
    systemTime =&gt; out_systemTime,
    tzID =&gt; out_tzID
);
</xhtml>
          </ST>
