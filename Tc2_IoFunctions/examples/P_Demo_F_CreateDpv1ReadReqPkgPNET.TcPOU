<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_CreateDpv1ReadReqPkgPNET" Id="{778128a0-4507-588f-815b-b42b1db04878}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_CreateDpv1ReadReqPkgPNET
VAR
    aDpv1ReqBuffer   : ARRAY[1..240] OF BYTE; // 请求缓冲
    arrDpv1ReqParams : ARRAY[1..39] OF ST_Dpv1ParamAddrEx; // 参数清单
    iNumParamsToRead : USINT := 3; // 参数数
    iDriveObjectId   : USINT := 2; // drive A
    bBuildReqPkgPNET : BOOL := FALSE; // 触发构造
    nReqPkgLenPNET   : USINT; // 生成长度
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：Profinet SINAMICS：构造一个读 3 个参数的 DPV1 请求帧。
// 价值：与 Profibus 版本对称。
// 验证：填好 arrDpv1ReqParams[1..3]，写 bBuildReqPkgPNET := TRUE → 一周期后 nReqPkgLenPNET > 0 表示成功。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bBuildReqPkgPNET THEN
    nReqPkgLenPNET := F_CreateDpv1ReadReqPkgPNET(
        pDpv1ReqData    := ADR(aDpv1ReqBuffer),
        iNumOfParams    := iNumParamsToRead,
        iDriveId        := iDriveObjectId,
        stDpv1Parameter := arrDpv1ReqParams
    );
    bBuildReqPkgPNET := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
