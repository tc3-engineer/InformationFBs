<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepAbsoluteSwitch" Id="{a6e5b007-2f1d-5acc-8493-bc243150ff84}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepAbsoluteSwitch
VAR
    fbStepAbsoluteSwitch : MC_StepAbsoluteSwitch;
    axisHoming           : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec               : R_TRIG; // 把保持型请求位整成单次上升沿
    bSearchReq           : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam          : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    refSignal            : MC_Ref_Signal_Ref; // 参考信号源配置（锁存单元 / 信号源 / 当前电平）
    bPosLimit            : BOOL := FALSE; // 正向硬件限位开关信号（行程内为 FALSE）；实机接 PLC 输入
    bNegLimit            : BOOL := FALSE; // 负向硬件限位开关信号（行程内为 FALSE）；实机接 PLC 输入
    homingOptions        : ST_Home_Options4; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bSearchDone          : BOOL;
    bBusy                : BOOL;
    bSearchActive        : BOOL;
    bAborted             : BOOL;
    bError               : BOOL;
    nErrorID             : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：龙门直线轴用行程中段的参考凸轮开关归零，两端有硬件限位保护。本 FB 驱动轴朝负向
//       搜索凸轮，遇限位会反向，命中凸轮上升沿后把该点定为坐标 0。
// 价值：把“搜凸轮+到限位反向+定零”封装为可拼接 step，配收尾 FB 组成完整自定义归零序列。
// 验证：先 MC_Power 使能轴；在线写 bSearchReq := TRUE，观察 bSearchActive TRUE，轴朝负向
//       移动；命中凸轮后 bSearchDone 短暂 TRUE，位置读数变 0，轴仍停在 Homing 状态（需再收尾）。

// 配置参考信号源：用驱动默认信号源 + 默认锁存单元（实机按编码器/驱动手册选 TouchProbe）
refSignal.SignalSource := SignalSource_Default;
refSignal.TouchProbe   := PlcEvent;

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bSearchReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepAbsoluteSwitch(
    Execute             := rtExec.Q,
    Direction           := mcNegativeDirection,
    SwitchMode          := mcRisingEdge,
    ReferenceSignal     := refSignal,
    Velocity            := 50.0,
    Acceleration        := 0.0,
    Deceleration        := 0.0,
    Jerk                := 0.0,
    SetPosition         := 0.0,
    TimeLimit           := T#30S,
    DistanceLimit       := 2000.0,
    TorqueLimit         := 100.0,
    PositiveLimitSwitch := bPosLimit,
    NegativeLimitSwitch := bNegLimit,
    BufferMode          := MC_Aborting,
    Options             := homingOptions,
    Done                => bSearchDone,
    Busy                => bBusy,
    Active              => bSearchActive,
    CommandAborted      => bAborted,
    Error               => bError,
    ErrorID             => nErrorID,
    Axis                := axisHoming,
    Parameter           := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bSearchReq AND NOT bBusy THEN
    bSearchDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
