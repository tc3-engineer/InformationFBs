<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_4OCTET_FLOAT_SEND" Id="{0b1dcaa4-8b97-5b0a-b7ed-bbf7e11c60b0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_4OCTET_FLOAT_SEND
VAR
    fbEIB_4OCTET_FLOAT_SEND     : EIB_4OCTET_FLOAT_SEND;
    stEibRec           : EIB_REC;
    stGroup            : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 4, NUMBER := 13);
    data               : REAL := REAL#0.0;
    bSendError         : BOOL;
    iLastErrID         : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_4OCTET_FLOAT_SEND 演示程序
// ============================================================
// 场景：PLC 测得的 瞬时功率 (W) 经 EIB 组地址 1/4/13 推送到 BMS。
// 价值：替代手写 DPT 14.xxx 编码；变化触发自动
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：改 `data` → 1 秒内 EIB 总线上 1/4/13 出新帧。
// ============================================================

// 每周期调用：只在 data 变化时下发 telegram
fbEIB_4OCTET_FLOAT_SEND(
    Group_Address := stGroup,
    rData         := data,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
