<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T08:00:00"/>
  <contentHeader name="Tc2_Standard.MID Demo" modificationDateTime="2026-05-11T08:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_MID" pouType="program">
        <interface>
          <localVars>
            <variable name="sConfig">
              <type><string><length>255</length></string></type>
              <initialValue><simpleValue value="'IP:192.168.1.10,PORT:502'"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 配置串：IP 段 + 逗号 + PORT 段</xhtml></documentation>
            </variable>
            <variable name="sIP">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">提取出的 IP 字段</xhtml></documentation>
            </variable>
            <variable name="nStart">
              <type><INT/></type>
              <initialValue><simpleValue value="4"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">IP 起点位置：'IP:' 占 3 字符 → IP 第 1 字节在第 4 位</xhtml></documentation>
            </variable>
            <variable name="nLength">
              <type><INT/></type>
              <initialValue><simpleValue value="12"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">IP 字段长度 = 12 字符（'192.168.1.10'）</xhtml></documentation>
            </variable>
            <variable name="bExtract">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次 MID</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 给 PLC 传配置串 'IP:xxx,PORT:yyy'。PLC 需要从中间段提取 IP，
//       后续传给 TCP/IP 配置 FB。位置和长度都是已知（或先 FIND 算出来的），
//       MID 一行调用即可。
//
// 价值：MID 接受"位置 + 长度"直接取任意位置的子串，不必绕 LEFT+RIGHT 双套。
//       入参顺序是 (STR, LEN, POS)——LEN 在 POS 前，是新人最容易写错的地方。
//
// 验证步骤：
//   1. 导入本文件、引用 Tc2_Standard、编译、登录、运行
//   2. 在线 monitor sIP
//   3. 在线写 bExtract := TRUE
//   4. 下一周期 sIP = &apos;192.168.1.10&apos;，bExtract 复位
//   5. 把 nLength 改成 100（超过剩余字符数）+ 再触发，观察越界行为
//      （PDF 未明确，实测一般返回从 POS 到末尾的全部字符）
// =============================================================================

// 入参顺序：STR, LEN, POS（LEN 在 POS 前！）。POS 从 1 起。
IF bExtract THEN
    sIP := MID(sConfig, nLength, nStart);
    bExtract := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
