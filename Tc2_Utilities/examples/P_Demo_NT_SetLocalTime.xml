  <contentHeader name="Tc2_Utilities.NT_SetLocalTime Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_NT_SetLocalTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNT_SetLocalTime">
              <type><derived name="NT_SetLocalTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NT_SetLocalTime 实例</xhtml></documentation>
            </variable>
            <variable name="bSet">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTimeToSet">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：开机后写入 NTP 来的时间。
// 价值：PLC 程序可控时钟。
// 验证：改 stTimeToSet 给一个具体时间，触发后桌面时钟立刻跳到该值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_SetLocalTime(
    NETID := '', START := bSet, TMOUT := DEFAULT_ADS_TIMEOUT, TIMESTR := stTimeToSet,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
