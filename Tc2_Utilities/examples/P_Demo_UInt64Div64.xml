  <contentHeader name="Tc2_Utilities.UInt64Div64 Demo" modificationDateTime="2026-05-12T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Div64" pouType="program">
        <interface>
          <localVars>
            <variable name="uliTotalBytes">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">累计字节数</xhtml></documentation>
            </variable>
            <variable name="uliCycles">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">周期数</xhtml></documentation>
            </variable>
            <variable name="uliAvgBytes">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">平均吞吐</xhtml></documentation>
            </variable>
            <variable name="bCompute">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Div64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把累计字节数 / 周期数 = 平均每周期字节数（吞吐率），用于在 HMI 显示。
// 价值：替代手写双倍长除法；一次调用直接拿商。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCompute AND NOT UInt64isZero(uliCycles) THEN
    // 除 0 校验：除数是结构体，用 UInt64isZero 不是 = 0
    uliAvgBytes := UInt64Div64(uliTotalBytes, uliCycles);
    bCompute := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
