<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.GetAlarmEx Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GetAlarmEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLogger">
              <type><derived name="FB_TcEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EventLogger 实例</xhtml></documentation>
            </variable>
            <variable name="fbAlarmRef">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查询输出</xhtml></documentation>
            </variable>
            <variable name="stEventEntry">
              <type><derived name="TcEventEntry"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查询的事件定义</xhtml></documentation>
            </variable>
            <variable name="bDoGet">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoGetPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：凭 TcEventEntry 查询本地匹配的 alarm 引用
// 价值：结构体接口适合循环遍历事件清单批量查询
// 验证：先 Create 一个 alarm，把同一 TcEventEntry 写入 stEventEntry 触发 GetAlarmEx → hr = S_OK；改 Severity → ADS_E_NOTFOUND
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoGet AND NOT bDoGetPrev THEN
    hr := fbLogger.GetAlarmEx(
        stEventEntry := stEventEntry,
        ipSourceInfo := 0,
        fbAlarm := fbAlarmRef);
    IF SUCCEEDED(hr) THEN
        ; // 拿到引用后可调用 Raise/Clear/Confirm
    END_IF;
END_IF;
bDoGetPrev := bDoGet;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
