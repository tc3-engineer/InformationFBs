<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MBUdpReadCoils" Id="{11cd7ca9-b3b6-5556-b03f-0e7810329c1c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MBUdpReadCoils
VAR
    fbUdpReadCoils: FB_MBUdpReadCoils;
    sTargetIp     : STRING(15) := '192.168.1.50';   // 目标 Modbus 设备 IP（按现场改）
    bTrigger      : BOOL;          // 在线置一次上升沿触发本次访问
    bBusy         : BOOL;          // 在线 monitor：执行中为 TRUE
    bError        : BOOL;          // 出错置 TRUE
    nErrId        : UDINT;         // 出错时的 ADS/Modbus 错误码
    nReadCount    : UDINT;         // 实际读到的字节数
    arrData       : ARRAY [0..1] OF BYTE;   // 读回数据落点
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ModbusSrv.FB_MBUdpReadCoils 演示程序（Modbus TCP 客户端 / 主站）
// ============================================================
// 场景：读取一台第三方 Modbus TCP 设备（如智能配电单元、远程 IO 模块）的线圈状态，例如 16 路继电器输出的当前通断，用于在 HMI 上回显或做联锁判断。 选用 UDP 版多见于同一控制柜/同网段、对实时性敏感且能容忍偶发丢包的场景，省去 TCP 建链开销。
// 价值：无本 FB 时要自己拼 Modbus ADU 报文、管 TCP 连接、解析功能码 1 的位打包响应；用本 FB 一次调用即可，TF6250 服务负责报文与连接。
// 验证：登录后在线置 bTrigger := TRUE 触发一次；观察 bBusy 在数个周期后回 FALSE，
//       bError 应为 FALSE、nErrId 应为 0；若对端不在线则 bError=TRUE 且 nErrId 含超时码。
//       本例：读 16 个线圈，结果打包进 2 字节
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ModbusSrv（References → Add library），并确保 TF6250 Modbus TCP 已授权运行
//   3. 把 sTargetIp 改成现场 Modbus 设备 IP；编译 → 登录 → 运行
//   4. 在线脉冲 bTrigger，按上方『验证』观察输出
// ============================================================

// 单次完整调用：所有 VAR_INPUT 显式赋值；bExecute 边沿触发一次
fbUdpReadCoils(
    sIPAddr   := sTargetIp,
    nTCPPort  := MODBUS_TCP_PORT,
    nUnitID   := 16#FF,
    nQuantity := 16,
    nMBAddr   := 0,
    cbLength  := SIZEOF(arrData),
    pDestAddr := ADR(arrData),
    bExecute  := bTrigger,
    tTimeout  := T#5S,
    bBUSY     => bBusy,
    bError    => bError,
    nErrId    => nErrId,
    cbRead    => nReadCount
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
