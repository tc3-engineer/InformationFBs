      <pou name="P_Demo_F_GetDOYOfYearMonthDay" pouType="program">
        <interface>
          <localVars>
            <variable name="rResult">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">F_GetDOYOfYearMonthDay 的返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.F_GetDOYOfYearMonthDay 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及类型所在依赖库 Tc2_System / Tc2_Standard）
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 观察 rResult 应为 61（2024 闰年，3 月 1 日是第 61 天）
// ============================================================

IF bRun THEN
    rResult := F_GetDOYOfYearMonthDay(WORD#2024, WORD#3, WORD#1);
    bRun := FALSE;
END_IF;
</xhtml>
