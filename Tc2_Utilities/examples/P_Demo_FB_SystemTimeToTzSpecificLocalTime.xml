  <contentHeader name="Tc2_Utilities.FB_SystemTimeToTzSpecificLocalTime Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_SystemTimeToTzSpecificLocalTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_SystemTimeToTzSpecificLocalTime">
              <type><derived name="FB_SystemTimeToTzSpecificLocalTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_SystemTimeToTzSpecificLocalTime 实例</xhtml></documentation>
            </variable>
            <variable name="bConvert">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTz">
              <type><derived name="TIME_ZONE_INFORMATION"/></type>
            </variable>
            <variable name="stUtc">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
            <variable name="stLocalTime">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：UTC 时间转本地时间。
// 价值：跨版本稳定。
// 验证：给 stUtc 填一个具体 UTC 时间（如 2026-05-11 12:00:00 UTC），触发后 stLocalTime 应为按时区偏移后的值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_SystemTimeToTzSpecificLocalTime(
    tzInfo := stTz, bExecute := bConvert, stUTC := stUtc,
    stLocal =&gt; stLocalTime
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
