    <pous>
      <pou name="P_Demo_FB_CSVMemBufferReader" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_CSVMemBufferReader">
              <type><derived name="FB_CSVMemBufferReader"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_CSVMemBufferReader 实例</xhtml></documentation>
            </variable>
            <variable name="eCmd">
              <initialValue><simpleValue value="eEnumCmd_First"/></initialValue>
              <type><derived name="E_EnumCmdType"/></type>
            </variable>
            <variable name="pBuffer">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbBuffer">
              <type><UDINT/></type>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
            </variable>
            <variable name="getValue">
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="pValue">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbValue">
              <type><UDINT/></type>
            </variable>
            <variable name="bCRLF">
              <type><BOOL/></type>
            </variable>
            <variable name="cbRead">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读配方 CSV。
// 价值：替代手写解析。
// 验证：先 Init 绑定缓冲，循环调 GetNextField 取每个字段。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_CSVMemBufferReader(
    eCmd := eCmd,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk =&gt; bOk,
    getValue =&gt; getValue,
    pValue =&gt; pValue,
    cbValue =&gt; cbValue,
    bCRLF =&gt; bCRLF,
    cbRead =&gt; cbRead
);
</xhtml></ST>
        </body>
      </pou>
