<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.Clear Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TcAlarm_Clear" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">电机过载报警实例</xhtml></documentation>
            </variable>
            <variable name="bCreated">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Create latch</xhtml></documentation>
            </variable>
            <variable name="rCurrent">
              <initialValue><simpleValue value="0.0"/></initialValue>
              <type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">电机电流 (A)</xhtml></documentation>
            </variable>
            <variable name="rOverLimit">
              <initialValue><simpleValue value="8.0"/></initialValue>
              <type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">过载阈值</xhtml></documentation>
            </variable>
            <variable name="bMotorOverCurrent">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">故障信号</xhtml></documentation>
            </variable>
            <variable name="bMotorOverCurrentPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
            <variable name="guidEventClass">
              <type><derived name="GUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件类 GUID</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：电机过载故障消失（电流降回安全值）的下降沿清除
// 价值：把 Clear 和 Raise 配对，让 HMI 准确反映"故障已恢复"状态
// 验证：先让 rCurrent &amp;gt; rOverLimit 触发 Raise（HMI 显示 Raised）；再写 rCurrent := 5.0 让信号回落，下降沿调用 Clear；HMI 状态变 Cleared 但若 bWithConfirmation 仍显示"等待确认"
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF NOT bCreated THEN
    hr := fbAlarm.Create(eventClass := guidEventClass, nEventId := 2001,
        eSeverity := TcEventSeverity.Error, bWithConfirmation := FALSE,
        ipSourceInfo := 0);
    bCreated := SUCCEEDED(hr);
END_IF;

bMotorOverCurrent := rCurrent &amp;gt; rOverLimit;

// 上升沿 Raise，下降沿 Clear（bRemove := FALSE 保留实例以便复用）
IF bMotorOverCurrent AND NOT bMotorOverCurrentPrev THEN
    hr := fbAlarm.Raise(nTimeStamp := 0);
END_IF;
IF NOT bMotorOverCurrent AND bMotorOverCurrentPrev THEN
    hr := fbAlarm.Clear(nTimeStamp := 0, bRemove := FALSE);
END_IF;
bMotorOverCurrentPrev := bMotorOverCurrent;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
