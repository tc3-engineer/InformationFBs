<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_ScanAmsNetIds" Id="{b079fa43-8680-50e4-836b-bc6320f52751}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_ScanAmsNetIds
VAR
    sNetIdInput    : T_AmsNetID := '127.16.17.3.1.1'; // 操作员输入或配置文件读到的 NetID 字符串
    arrParsedNetId : T_AmsNetIdArr; // 解析出的字节数组
    bParseError    : BOOL; // 解析失败标记（全 0 且输入非空）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.F_ScanAmsNetIds 演示程序
// ============================================================
// 场景：HMI 输入 NetID 字符串，PLC 解析为字节数组存档。
// 价值：替代手写 STR_TO_BYTE 循环。
// 验证：登录后 arrParsedNetId 应为 [127,16,17,3,1,1]；把 sNetIdInput 改为 'xyz.abc' 后 bParseError 应为 TRUE 且 arrParsedNetId 全为 0。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 解析 NetID 字符串为 6 字节数组
arrParsedNetId := F_ScanAmsNetIds(sNetIdInput);

// PDF 明确：若输入非空且非 '0.0.0.0.0.0' 但返回全 0，说明格式错误
bParseError := (sNetIdInput <> '') AND (sNetIdInput <> '0.0.0.0.0.0')
    AND (arrParsedNetId[0] = 0) AND (arrParsedNetId[1] = 0) AND (arrParsedNetId[2] = 0)
    AND (arrParsedNetId[3] = 0) AND (arrParsedNetId[4] = 0) AND (arrParsedNetId[5] = 0);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
