<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.AdsErr_TO_TcEventEntry Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_AdsErr_TO_TcEventEntry" pouType="program">
        <interface>
          <localVars>
            <variable name="eErrorId">
              <initialValue><simpleValue value="E_AdsErr.ADSERR_DEVICE_INVALIDPARM"/></initialValue>
              <type><derived name="E_AdsErr"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写入要转换的 ADS 错误码</xhtml></documentation>
            </variable>
            <variable name="stEventEntry">
              <type><derived name="TcEventEntry"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换输出</xhtml></documentation>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换成功标志</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：ADS 错误码 → TcEventEntry 转换演示
// 价值：一次调用完成错误码到事件定义的转换
// 验证：登录后给输入赋已知合法值；调用本 FC 后 bOk 应为 TRUE 且输出已填
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 把 ADS 错误码转成 TcEventEntry
bOk := AdsErr_TO_TcEventEntry(
    eErrorId := eErrorId,
    stEventEntry := stEventEntry);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
