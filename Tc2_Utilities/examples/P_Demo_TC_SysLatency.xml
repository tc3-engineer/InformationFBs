<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.TC_SysLatency Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_TC_SysLatency" pouType="program">
        <interface>
          <localVars>
            <variable name="fbTC_SysLatency">
              <type><derived name="TC_SysLatency"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TC_SysLatency 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="nActLat">
              <type><UDINT/></type>
            </variable>
            <variable name="nMaxLat">
              <type><UDINT/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 实时性面板。
// 价值：PLC 可读 latency。
// 验证：触发后观察 nActLat、nMaxLat（µs 单位）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbTC_SysLatency(
    NETID := '', START := bRead, TMOUT := DEFAULT_ADS_TIMEOUT,
    ACT_LATENCY =&gt; nActLat, MAX_LATENCY =&gt; nMaxLat,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
