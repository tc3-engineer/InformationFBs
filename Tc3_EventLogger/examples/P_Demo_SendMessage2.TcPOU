<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_SendMessage2" Id="{53f3d432-26e2-56a3-a9cf-63d266de2df8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_SendMessage2
VAR
    fbLogger          : FB_TcEventLogger; // EventLogger 实例
    guidEventClass    : GUID; // 事件类 GUID
    sBatchId          : STRING(64) := 'B-2026-0511-001'; // 批次号
    sJsonAttribute    : STRING(255); // 拼接好的完整 JSON
    bRecipeChange     : BOOL := FALSE; // 配方切换信号
    bRecipeChangePrev : BOOL; // 边沿检测
    hr                : HRESULT; // 返回值监视
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：配方切换审计带批次上下文
// 价值：一次调用完成事件 + JSON 附加
// 验证：登录后写 bRecipeChange := TRUE，HMI EventLogger 事件详情应能看到 JSON 字段含 batch id
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 拼接 JSON
sJsonAttribute := CONCAT('{"batch":"', CONCAT(sBatchId, '"}'));

// 边沿触发：发送 message 同时附 JSON 上下文
IF bRecipeChange AND NOT bRecipeChangePrev THEN
    hr := fbLogger.SendMessage2(
        eventClass := guidEventClass,
        nEventId := 3002,
        eSeverity := TcEventSeverity.Info,
        ipSourceInfo := 0,
        nTimeStamp := 0,
        ipArguments := 0,
        sJsonAttribute := sJsonAttribute);
END_IF;
bRecipeChangePrev := bRecipeChange;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
