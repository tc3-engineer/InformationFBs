<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_SplitDpv1ReadResPkg" Id="{680bebd9-3971-5571-bfb3-4498ac68a6d0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_SplitDpv1ReadResPkg
VAR
    aDpv1ReadResBuffer : ARRAY[1..240] OF BYTE; // DPV1 读响应帧 240 字节
    arrDpv1ReqParams   : ARRAY[1..39] OF ST_Dpv1ParamAddrEx; // 与请求相同的参数清单
    arrDpv1ValueHdr    : ARRAY[1..39] OF ST_Dpv1ValueHeaderEx; // 解析输出：每条参数值
    bSplitReadResPkg   : BOOL := FALSE; // 触发：解析响应
    nReadResPkgLen     : USINT; // 响应帧实际长度
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：DPV1 读完后调本 FC 解析响应：填回 arrDpv1ValueHdr[1..3]。
// 价值：封装 DPV1 解析 + 字节序转换。
// 验证：收到响应后写 bSplitReadResPkg := TRUE → 一周期后 nReadResPkgLen > 0 表示解析成功；可在线查看 arrDpv1ValueHdr 各字段。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bSplitReadResPkg THEN
    nReadResPkgLen := F_SplitDpv1ReadResPkg(
        pDpv1ResData        := ADR(aDpv1ReadResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitReadResPkg := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
