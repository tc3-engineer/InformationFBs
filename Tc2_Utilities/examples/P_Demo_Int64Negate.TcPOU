<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Int64Negate" Id="{606ea8c1-f555-5b46-81e0-a2e5044d2a6d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Int64Negate
VAR
    liValue   : T_LARGE_INTEGER;
    liNegated : T_LARGE_INTEGER;
    bNegate   : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.Int64Negate 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把累加器一次性'反向'应用到补偿量上：`error_sum := Int64Negate(error_sum)`。
// 价值：替代手写 NOT + Add64 两步。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bNegate THEN
    // 应保证 liValue <> INT64_MIN，否则 PDF 未定义
    liNegated := Int64Negate(liValue);
    bNegate := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
