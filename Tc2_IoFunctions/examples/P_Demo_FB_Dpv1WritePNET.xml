  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_Dpv1WritePNET" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDpv1WritePNET">
              <type><derived name="FB_Dpv1WritePNET"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profinet DPV1 写 FB</xhtml></documentation>
            </variable>
            <variable name="sProfinetMasterNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EL6632 NetId</xhtml></documentation>
            </variable>
            <variable name="iSinamicsPnetPort">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profinet port</xhtml></documentation>
            </variable>
            <variable name="iDriveObjectId">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive A</xhtml></documentation>
            </variable>
            <variable name="aDpv1ReqBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求</xhtml></documentation>
            </variable>
            <variable name="aDpv1ResBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应</xhtml></documentation>
            </variable>
            <variable name="iReqBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求长度</xhtml></documentation>
            </variable>
            <variable name="iResBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应长度</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">清单</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ValueHdr">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ValueHeaderEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">值/状态</xhtml></documentation>
            </variable>
            <variable name="iNumParamsToWrite">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数数</xhtml></documentation>
            </variable>
            <variable name="nWriteReqPkgLenPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求长度</xhtml></documentation>
            </variable>
            <variable name="nWriteResPkgLenPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应长度</xhtml></documentation>
            </variable>
            <variable name="bBuildWriteReqPkgPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发构造</xhtml></documentation>
            </variable>
            <variable name="bDpv1WriteReqPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发发送</xhtml></documentation>
            </variable>
            <variable name="bSplitWriteResPkgPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发解析</xhtml></documentation>
            </variable>
            <variable name="tDpv1WriteTimeout">
              <initialValue><simpleValue value="T#10S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bDpv1WriteBusyPNET">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="iDpv1WriteRequestRefPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">引用号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Profinet SINAMICS 写完整流程。
// 价值：对称封装。
// 验证：登录后 bBuildWriteReqPkgPNET → 帧构造；bDpv1WriteReqPNET 触发发送 → bBusy 落回 → bSplitWriteResPkgPNET 解析 → arrDpv1ValueHdr[k].nError 全 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 步骤 1：构造
IF bBuildWriteReqPkgPNET THEN
    nWriteReqPkgLenPNET := F_CreateDpv1WriteReqPkgPNET(
        pDpv1ReqData        := ADR(aDpv1ReqBuffer),
        iNumOfParams        := iNumParamsToWrite,
        iDriveId            := iDriveObjectId,
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bBuildWriteReqPkgPNET := FALSE;
END_IF;

// 步骤 2：发送
fbDpv1WritePNET(
    bExecute        := bDpv1WriteReqPNET,
    aNetId          := sProfinetMasterNetId,
    iProfinetPort   := iSinamicsPnetPort,
    iDriveId        := iDriveObjectId,
    pDpv1ReqData    := ADR(aDpv1ReqBuffer),
    iDpv1ReqDataLen := iReqBufLen,
    pDpv1ResData    := ADR(aDpv1ResBuffer),
    iDpv1ResDataLen := iResBufLen,
    tTmOut          := tDpv1WriteTimeout,
    iRequestRef     =&gt; iDpv1WriteRequestRefPNET
);
bDpv1WriteBusyPNET := fbDpv1WritePNET.bBusy;

// 步骤 3：解析
IF bSplitWriteResPkgPNET THEN
    nWriteResPkgLenPNET := F_SplitDpv1WriteResPkgPNET(
        pDpv1ResData        := ADR(aDpv1ResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitWriteResPkgPNET := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
