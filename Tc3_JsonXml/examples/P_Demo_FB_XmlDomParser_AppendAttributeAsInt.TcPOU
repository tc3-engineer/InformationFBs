<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_XmlDomParser_AppendAttributeAsInt" Id="{40d6ef2b-b2e6-5476-b359-121eff77fb2a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_XmlDomParser_AppendAttributeAsInt
VAR
    fbParser : FB_XmlDomParser; // 父 FB 实例
    n : SXmlNode;
    value : DINT;
    name : STRING(255);
    vRet : SXmlAttribute; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：在 XML 配置文件里增加新节点（如新增一台设备、加一行报警定义）。
// 价值：DOM 操作随机插入，比重建文件高效。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.AppendAttributeAsInt(
        n := n,
        value := value,
        name := name
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
