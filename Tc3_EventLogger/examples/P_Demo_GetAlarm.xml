<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.GetAlarm Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GetAlarm" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLogger">
              <type><derived name="FB_TcEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EventLogger 实例</xhtml></documentation>
            </variable>
            <variable name="fbAlarmRef">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查询输出</xhtml></documentation>
            </variable>
            <variable name="guidEventClass">
              <type><derived name="GUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查询的事件类 GUID</xhtml></documentation>
            </variable>
            <variable name="nEventId">
              <initialValue><simpleValue value="1001"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查询的事件 ID</xhtml></documentation>
            </variable>
            <variable name="bDoGet">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoGetPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：按 GUID + EventID 查询已注册的 alarm 引用，调用其 Raise 方法
// 价值：无需直接持有 alarm 实例即可操控它
// 验证：先确保有 alarm 已 Create；写 bDoGet := TRUE 触发查询；若 hr = S_OK 则 fbAlarmRef 可用，调用 Raise 应能让该 alarm 进 Raised 状态；不匹配的 GUID → hr = ADS_E_NOTFOUND
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoGet AND NOT bDoGetPrev THEN
    hr := fbLogger.GetAlarm(
        eventClass := guidEventClass,
        nEventId := nEventId,
        ipSourceInfo := 0,                     // 用默认源信息匹配
        fbAlarm := fbAlarmRef);
    IF SUCCEEDED(hr) THEN
        fbAlarmRef.Raise(nTimeStamp := 0);     // 拿到引用后即可操作
    END_IF;
END_IF;
bDoGetPrev := bDoGet;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
