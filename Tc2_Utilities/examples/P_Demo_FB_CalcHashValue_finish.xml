<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_CalcHashValue.finish Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_CalcHashValue_finish" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCalc">
              <type><derived name="FB_CalcHashValue"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Tc2_Utilities.FB_CalcHashValue 实例</xhtml></documentation>
            </variable>
            <variable name="eMode">
              <type><derived name="E_HashMode"/></type>
              <initialValue><simpleValue value="E_HashMode.HashMode_Sha512"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Hash 模式（SHA-512 → 64 字节）</xhtml></documentation>
            </variable>
            <variable name="sInput">
              <type><string><length>255</length></string></type>
              <initialValue><simpleValue value="'hello'"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输入字符串</xhtml></documentation>
            </variable>
            <variable name="aHash">
              <type>
                <array>
                  <dimension lower="0" upper="63"/>
                  <baseType><BYTE/></baseType>
                </array>
              </type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SHA-512 输出缓冲区（64 字节）</xhtml></documentation>
            </variable>
            <variable name="bStart">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">start() 返回值</xhtml></documentation>
            </variable>
            <variable name="bUpdate">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">update() 返回值</xhtml></documentation>
            </variable>
            <variable name="bFinish">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">finish() 返回值（PDF 未显式给出返回类型，按 BOOL 实例化）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FB_CalcHashValue.finish() 演示程序（METHOD）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录
//   3. 在线写值 sInput，观察 aHash 输出
//   4. 注意：aHash 缓冲区必须 &gt;= 所选模式的输出字节数
// ============================================================

bStart  := fbCalc.start(hashMode := eMode);
bUpdate := fbCalc.update(pData := ADR(sInput), nData := LEN(sInput));
bFinish := fbCalc.finish(pHash := ADR(aHash), nHash := SIZEOF(aHash));
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
