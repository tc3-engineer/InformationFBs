<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARFanCoil" Id="{cbbc9693-fd04-5bf9-8c4a-0a52da8dada6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARFanCoil
VAR
    fb : FB_BARFanCoil;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    eCtrlFct_in : E_BARCtrlFct ;
    rSetpoint_in : REAL := 0.0;
    rRoomTemp_in : REAL := 0.0;
    bStageUp_in : BOOL := FALSE;
    bStageDown_in : BOOL := FALSE;
    iStageManual_in : INT := 0;
    bReset_in : BOOL := FALSE;
    rDeviationXW_Stage01_io : REAL := 0.0;
    rDeviationXW_Stage02_io : REAL := 0.0;
    rDeviationXW_Stage03_io : REAL := 0.0;
    rHysteresisRange_io : REAL := 0.0;
    udiSecMINPowerOnTime_io : UDINT := 0;
    iFctModeFanCoil_io : INT := 0;
    udiTimePeriod_io : UDINT := 0;
    bStageOff_out : BOOL;
    bStageAuto_out : BOOL;
    bStage01_out : BOOL;
    bStage02_out : BOOL;
    bStage03_out : BOOL;
    bFanCoilActive_out : BOOL;
    bPresence_out : BOOL;
    byState_out : BYTE;
    byError_out : BYTE;
    udiSecRT_MINPowerOnTime_out : UDINT;
    udiRT_TimePeriod_out : UDINT;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARFanCoil 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARFanCoil.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    eCtrlFct := eCtrlFct_in,
    rSetpoint := rSetpoint_in,
    rRoomTemp := rRoomTemp_in,
    bStageUp := bStageUp_in,
    bStageDown := bStageDown_in,
    iStageManual := iStageManual_in,
    bReset := bReset_in,
    rDeviationXW_Stage01 := rDeviationXW_Stage01_io,
    rDeviationXW_Stage02 := rDeviationXW_Stage02_io,
    rDeviationXW_Stage03 := rDeviationXW_Stage03_io,
    rHysteresisRange := rHysteresisRange_io,
    udiSecMINPowerOnTime := udiSecMINPowerOnTime_io,
    iFctModeFanCoil := iFctModeFanCoil_io,
    udiTimePeriod := udiTimePeriod_io,
    bStageOff => bStageOff_out,
    bStageAuto => bStageAuto_out,
    bStage01 => bStage01_out,
    bStage02 => bStage02_out,
    bStage03 => bStage03_out,
    bFanCoilActive => bFanCoilActive_out,
    bPresence => bPresence_out,
    byState => byState_out,
    byError => byError_out,
    udiSecRT_MINPowerOnTime => udiSecRT_MINPowerOnTime_out,
    udiRT_TimePeriod => udiRT_TimePeriod_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
