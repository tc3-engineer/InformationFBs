<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Not" Id="{ca30905a-c34b-5f97-aaa3-38e02ada3ff1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Not
VAR
    uliBitMask  : T_ULARGE_INTEGER;; // 单 bit 掩码
    uliInverted : T_ULARGE_INTEGER;; // 取反后
    bInvert     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Not 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：构造'除了 bit0 以外全屏蔽'的掩码：先 `ULARGE_INTEGER(0,1)` 再 `UInt64Not(...)`。
// 价值：替代手写两次 DWORD NOT。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

uliBitMask := ULARGE_INTEGER(0, 1);
IF bInvert THEN
    uliInverted := UInt64Not(uliBitMask);   // 除了 bit0 之外全 1
    bInvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
