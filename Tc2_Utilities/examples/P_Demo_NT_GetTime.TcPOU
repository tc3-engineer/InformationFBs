<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_NT_GetTime" Id="{9f3c7b83-a633-51b1-bd5f-c037575f408d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_NT_GetTime
VAR
    fbNT_GetTime : NT_GetTime; // NT_GetTime 实例
    bRead        : BOOL := FALSE;
    stTimeOut    : TIMESTRUCT;
    bBusy_       : BOOL;
    bErrFlag     : BOOL;
    nErrCode     : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：一次性读 Windows 时间。
// 价值：标准 ADS 调用。
// 验证：改 bRead := TRUE，观察 stTimeOut 装载时间且与桌面时钟一致。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_GetTime(
    NETID := '', START := bRead, TMOUT := DEFAULT_ADS_TIMEOUT,
    TIMESTR => stTimeOut, BUSY => bBusy_, ERR => bErrFlag, ERRID => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
