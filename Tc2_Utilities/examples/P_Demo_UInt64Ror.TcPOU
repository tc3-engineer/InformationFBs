<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Ror" Id="{7a7546fc-525b-54d5-9f1e-c609a7c7cd22}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Ror
VAR
    uliHashState : T_ULARGE_INTEGER;
    dwShiftBits  : DWORD := 29;
    uliRotated   : T_ULARGE_INTEGER;
    bRotate      : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Ror 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：SHA-256 / SHA-512 风格哈希里的 σ₀ / σ₁ 混淆函数。
// 价值：替代 SHR+SHL+OR 三行。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bRotate AND dwShiftBits < 64 THEN
    uliRotated := UInt64Ror(uliHashState, dwShiftBits);
    bRotate := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
