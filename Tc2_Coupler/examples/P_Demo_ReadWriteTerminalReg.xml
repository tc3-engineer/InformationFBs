  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ReadWriteTerminalReg" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReadWriteTerminalReg">
              <type><derived name="ReadWriteTerminalReg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Function blocks 实例</xhtml></documentation>
            </variable>
            <variable name="arg_STATE">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT STATE: 端子通道状态字节</xhtml></documentation>
            </variable>
            <variable name="arg_DATAIN">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT DATAIN: 端子通道数据输入字</xhtml></documentation>
            </variable>
            <variable name="arg_REGNO">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT REGNO: 要读/写的寄存器号</xhtml></documentation>
            </variable>
            <variable name="arg_READ">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT READ: 上升沿触发读</xhtml></documentation>
            </variable>
            <variable name="arg_WRITE">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT WRITE: 上升沿触发写</xhtml></documentation>
            </variable>
            <variable name="arg_TMOUT">
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT TMOUT: 执行超时</xhtml></documentation>
            </variable>
            <variable name="arg_NEWREGVALUE">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT NEWREGVALUE: WRITE 时要写入的值</xhtml></documentation>
            </variable>
            <variable name="out_CTRL">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT CTRL: 端子通道控制字节</xhtml></documentation>
            </variable>
            <variable name="out_DATAOUT">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT DATAOUT: 端子通道数据输出字</xhtml></documentation>
            </variable>
            <variable name="out_BUSY">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT BUSY: FB 执行中</xhtml></documentation>
            </variable>
            <variable name="out_ERR">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT ERR: 执行出错</xhtml></documentation>
            </variable>
            <variable name="out_ERRID">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT ERRID: 错误号（ERR=TRUE 时有效）</xhtml></documentation>
            </variable>
            <variable name="out_CURREGVALUE">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT CURREGVALUE: 成功读到的寄存器值</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Coupler.ReadWriteTerminalReg 演示程序
// ============================================================
// 场景：读取/写入 KL 端子的标定寄存器（必须先在 System Manager 链接 STATE/DATAIN/CTRL/DATAOUT）
// 验证步骤：
//   1. 引用 Tc2_Coupler（及其依赖：Tc2_System 等）
//   2. 编译 + 登录
//   3. 在线监视各 out_* 输出
//   4. 必要时按场景给 arg_* 输入赋值（详见 doc.md 的'使用注意'）
// ============================================================

fbReadWriteTerminalReg(
    STATE := arg_STATE,
    DATAIN := arg_DATAIN,
    REGNO := arg_REGNO,
    READ := arg_READ,
    WRITE := arg_WRITE,
    TMOUT := arg_TMOUT,
    NEWREGVALUE := arg_NEWREGVALUE,
    CTRL => out_CTRL,
    DATAOUT => out_DATAOUT,
    BUSY => out_BUSY,
    ERR => out_ERR,
    ERRID => out_ERRID,
    CURREGVALUE => out_CURREGVALUE
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
