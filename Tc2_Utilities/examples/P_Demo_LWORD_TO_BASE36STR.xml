  <contentHeader name="Tc2_Utilities.LWORD_TO_BASE36STR Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
