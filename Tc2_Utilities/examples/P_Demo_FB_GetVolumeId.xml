  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetVolumeId" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetVolumeId">
              <type><derived name="FB_GetVolumeId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetVolumeId 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="volumeId">
              <type><derived name="GUID"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读卷 ID 用作 License 硬件指纹。
// 价值：比 SystemID 重装抗性更好。
// 验证：触发后 volumeId 装载非零值；与 Windows `vol C:` 命令显示一致。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetVolumeId(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    volumeId =&gt; volumeId,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
