<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepLimitSwitchDetection" Id="{083df37e-9cf7-5d83-9d68-865ffa3ff723}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepLimitSwitchDetection
VAR
    fbStepLimitSwitchDetection : MC_StepLimitSwitchDetection;
    axisHoming                 : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec                     : R_TRIG; // 把保持型请求位整成单次上升沿
    bLimitDetReq               : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam                : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    refSignal                  : MC_Ref_Signal_Ref; // 参考信号源配置（锁存单元 / 信号源 / 当前电平）
    homingOptions              : ST_Home_Options4; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bLimitDetDone              : BOOL;
    bBusy                      : BOOL;
    bLimitDetActive            : BOOL;
    bAborted                   : BOOL;
    bError                     : BOOL;
    nErrorID                   : UDINT;
    lrRecordedPos              : LREAL; // Detection 版返回的检测位置（轴位置本身不被改写）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：行程标定时测出负端硬件限位开关的实际触发位置以便设定软限位——本 FB 朝负向搜限位
//       开关，命中后只返回 RecordedPosition，上层据此设定软限位，不改写轴位置。
// 价值：把测限位位置与置零解耦，便于行程标定 / 软限位设定。
// 验证：先 MC_Power 使能；在线写 bLimitDetReq := TRUE，观察 bLimitDetActive TRUE，轴朝负向走；
//       命中限位开关后 bLimitDetDone TRUE，lrRecordedPos 显示限位触发位置（轴位置读数不变）。

// 配置参考信号源：用驱动默认信号源 + 默认锁存单元（实机按编码器/驱动手册选 TouchProbe）
refSignal.SignalSource := SignalSource_Default;
refSignal.TouchProbe   := PlcEvent;

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bLimitDetReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepLimitSwitchDetection(
    Execute           := rtExec.Q,
    Direction         := mcNegativeDirection,
    LimitSwitchMode   := mcRisingEdge,
    LimitSwitchSignal := refSignal,
    Velocity          := 30.0,
    Acceleration      := 0.0,
    Deceleration      := 0.0,
    Jerk              := 0.0,
    TimeLimit         := T#30S,
    DistanceLimit     := 1500.0,
    TorqueLimit       := 100.0,
    BufferMode        := MC_Aborting,
    Options           := homingOptions,
    Done              => bLimitDetDone,
    Busy              => bBusy,
    Active            => bLimitDetActive,
    CommandAborted    => bAborted,
    Error             => bError,
    ErrorID           => nErrorID,
    RecordedPosition  => lrRecordedPos,
    Axis              := axisHoming,
    Parameter         := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bLimitDetReq AND NOT bBusy THEN
    bLimitDetDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
