<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.Raise Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Raise" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">电机过载报警实例</xhtml></documentation>
            </variable>
            <variable name="bCreated">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Create() latch</xhtml></documentation>
            </variable>
            <variable name="rCurrent">
              <initialValue><simpleValue value="0.0"/></initialValue>
              <type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">电机电流 (A)，在线写值模拟</xhtml></documentation>
            </variable>
            <variable name="rOverLimit">
              <initialValue><simpleValue value="8.0"/></initialValue>
              <type><REAL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">过载阈值</xhtml></documentation>
            </variable>
            <variable name="bMotorOverCurrent">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">故障信号（rCurrent &amp;gt; rOverLimit）</xhtml></documentation>
            </variable>
            <variable name="bMotorOverCurrentPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上一周期值（边沿检测）</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Raise 返回值监视</xhtml></documentation>
            </variable>
            <variable name="guidEventClass">
              <type><derived name="GUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件类 GUID</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：电机过载故障的上升沿触发（电流瞬时超过 8A 报警）
// 价值：边沿触发一次 Raise() 即把报警写入 EventLogger 并自动分发到 HMI
// 验证：登录后写 rCurrent := 9.0，bMotorOverCurrent 在下一周期变 TRUE 并上升沿调用 Raise；HMI EventLogger 视图出现一条 Raised 记录；再次写 9.0 不会重复触发（边沿已过）
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 一次性注册
IF NOT bCreated THEN
    hr := fbAlarm.Create(eventClass := guidEventClass, nEventId := 2001,
        eSeverity := TcEventSeverity.Error, bWithConfirmation := FALSE,
        ipSourceInfo := 0);
    bCreated := SUCCEEDED(hr);
END_IF;

// 故障信号 = 电流超阈值
bMotorOverCurrent := rCurrent &amp;gt; rOverLimit;

// 上升沿调用 Raise，0 = 用当前系统时间
IF bMotorOverCurrent AND NOT bMotorOverCurrentPrev THEN
    hr := fbAlarm.Raise(nTimeStamp := 0);
END_IF;
bMotorOverCurrentPrev := bMotorOverCurrent;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
