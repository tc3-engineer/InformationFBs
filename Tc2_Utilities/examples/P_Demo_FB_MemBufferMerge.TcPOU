<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MemBufferMerge" Id="{74bd205f-a72b-5932-8f04-4d072aec778b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MemBufferMerge
VAR
    fbFB_MemBufferMerge : FB_MemBufferMerge; // FB_MemBufferMerge 实例
    eCmd                : E_EnumCmdType := eEnumCmd_First;
    pBuffer             : POINTER TO BYTE;
    cbBuffer            : UDINT;
    pSegment            : POINTER TO BYTE := 0;
    cbSegment           : UDINT := 0;
    bOk                 : BOOL;
    cbSize              : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：拼通讯协议包。
// 价值：意图清晰。
// 验证：给两段缓冲，触发合并；输出缓冲内容应为两段拼接。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemBufferMerge(
    eCmd := eCmd,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    pSegment := pSegment,
    cbSegment := cbSegment,
    bOk => bOk,
    cbSize => cbSize
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
