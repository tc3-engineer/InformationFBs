<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepReferencePulseDetection" Id="{b16ec5bd-cdc8-5aba-9ff8-6924bc5811b8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepReferencePulseDetection
VAR
    fbStepReferencePulseDetection : MC_StepReferencePulseDetection;
    axisHoming                    : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec                        : R_TRIG; // 把保持型请求位整成单次上升沿
    bPulseDetReq                  : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam                   : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    refSignal                     : MC_Ref_Signal_Ref; // 参考信号源配置（锁存单元 / 信号源 / 当前电平）
    homingOptions                 : ST_Home_Options4; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bPulseDetDone                 : BOOL;
    bBusy                         : BOOL;
    bPulseDetActive               : BOOL;
    bAborted                      : BOOL;
    bError                        : BOOL;
    nErrorID                      : UDINT;
    lrRecordedPos                 : LREAL; // Detection 版返回的检测位置（轴位置本身不被改写）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：编码器安装相位标定——本 FB 低速朝正向小范围搜编码器零脉冲，命中后只返回
//       RecordedPosition，上层据此计算编码器安装相位偏差，不改写轴位置。
// 价值：以编码器级精度测出零脉冲位置并返回，把高精度测量与置零解耦。
// 验证：先 MC_Power 使能且已粗定位到零脉冲附近；在线写 bPulseDetReq := TRUE，观察
//       bPulseDetActive TRUE，轴低速正向走命中零脉冲后 bPulseDetDone TRUE，lrRecordedPos 显示位置。

// 配置参考信号源：用驱动默认信号源 + 默认锁存单元（实机按编码器/驱动手册选 TouchProbe）
refSignal.SignalSource := SignalSource_Default;
refSignal.TouchProbe   := PlcEvent;

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bPulseDetReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepReferencePulseDetection(
    Execute          := rtExec.Q,
    Direction        := mcPositiveDirection,
    ReferenceSignal  := refSignal,
    Velocity         := 5.0,
    Acceleration     := 0.0,
    Deceleration     := 0.0,
    Jerk             := 0.0,
    TimeLimit        := T#10S,
    DistanceLimit    := 360.0,
    TorqueLimit      := 100.0,
    BufferMode       := MC_Aborting,
    Options          := homingOptions,
    Done             => bPulseDetDone,
    Busy             => bBusy,
    Active           => bPulseDetActive,
    CommandAborted   => bAborted,
    Error            => bError,
    ErrorID          => nErrorID,
    RecordedPosition => lrRecordedPos,
    Axis             := axisHoming,
    Parameter        := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bPulseDetReq AND NOT bBusy THEN
    bPulseDetDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
