<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_DRIVE_Backup Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_DRIVE_Backup" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSercosDriveBackup">
              <type><derived name="IOF_SER_DRIVE_Backup"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS drive 备份 FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nDrivePort">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive port</xhtml></documentation>
            </variable>
            <variable name="sBackupComment">
              <initialValue><simpleValue value="'Line A Drive 1 backup'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">备份文件注释</xhtml></documentation>
            </variable>
            <variable name="eBackupFilePath">
              <initialValue><simpleValue value="PATH_BOOTPATH"/></initialValue>
              <type><derived name="E_OpenPath"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">路径常量</xhtml></documentation>
            </variable>
            <variable name="sBackupFileName">
              <initialValue><simpleValue value="'DRIVEPAR_DRIVE1.BIN'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">文件名</xhtml></documentation>
            </variable>
            <variable name="bDoCheckReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CRC 校验</xhtml></documentation>
            </variable>
            <variable name="bDoBackupReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">备份</xhtml></documentation>
            </variable>
            <variable name="bDoRestoreReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">恢复</xhtml></documentation>
            </variable>
            <variable name="bEnableCRC">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">启用 CRC</xhtml></documentation>
            </variable>
            <variable name="bUseStdBackupList">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = IDN-192 可 restore</xhtml></documentation>
            </variable>
            <variable name="tBackupTimeout">
              <initialValue><simpleValue value="T#30S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时（大文件慢）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：SERCOS drive 1 参数备份到工控机 `\Boot\DRIVEPAR_DRIVE1.BIN`。
// 价值：drive 参数版本化存档。
// 验证：先确保 SERCOS 在 phase 2；填好 sBackupFileName := "DRIVEPAR_DRIVE1.BIN"、bDoBackupReq := TRUE → bBackupBusy 短暂 TRUE → 文件创建；可用 SCP 拷出文件查看。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 触发前确保 SERCOS 已在 phase 2
fbSercosDriveBackup(
    bCheck         := bDoCheckReq,
    bBackup        := bDoBackupReq,
    bRestore       := bDoRestoreReq,
    bCRCEnable     := bEnableCRC,
    bStdBackupList := bUseStdBackupList,
    sNetId         := sLocalNetId,
    nPort          := nDrivePort,
    sComment       := sBackupComment,
    ePath          := eBackupFilePath,
    sPathName      := sBackupFileName,
    tTimeout       := tBackupTimeout
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
