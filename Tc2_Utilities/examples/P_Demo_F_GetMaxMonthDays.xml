<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_GetMaxMonthDays Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetMaxMonthDays" pouType="program">
        <interface>
          <localVars>
            <variable name="wYear">
              <type><WORD/></type>
              <initialValue><simpleValue value="2024"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">年份</xhtml></documentation>
            </variable>
            <variable name="wMonth">
              <type><WORD/></type>
              <initialValue><simpleValue value="2"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">月份</xhtml></documentation>
            </variable>
            <variable name="wMaxDays">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">该月最大天数（闰年 2 月 = 29）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 用户输入(年, 月, 日)时校验 day 不超过该月最大天数
//
// 价值：1 行调用即得月长，无需「if month in {1,3,5,7,8,10,12} ...」一长串
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 wMaxDays = 29（2024 年 2 月）
//   5. wYear:=2023 重测 → wMaxDays = 28（平年 2 月）
//   6. wMonth:=0 → wMaxDays = 0（错误返回）
// =============================================================================
wMaxDays := F_GetMaxMonthDays(wYear, wMonth);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
