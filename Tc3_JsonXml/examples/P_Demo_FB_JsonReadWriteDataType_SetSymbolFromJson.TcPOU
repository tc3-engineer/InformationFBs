<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonReadWriteDataType_SetSymbolFromJson" Id="{35a730ce-4211-57b0-86c1-36bdce9dbb48}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonReadWriteDataType_SetSymbolFromJson
VAR
    fbParser : FB_JsonReadWriteDataType; // 父 FB 实例
    nData : UDINT;
    pData : PVOID;
    sJson : STRING(255);
    sDatatype : STRING(255);
    hrErrorCode : HRESULT;
    vRet : BOOL; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：修改已有 JSON 节点的 SymbolFromJson 类型值（如更新缓存的实时数据字段）。
// 价值：DOM 树本地修改不重新构造整个文档，比 GetDocument + 字符串替换效率高。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.SetSymbolFromJson(
        nData := nData,
        pData := pData,
        sJson := sJson,
        sDatatype := sDatatype,
        hrErrorCode => hrErrorCode
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
