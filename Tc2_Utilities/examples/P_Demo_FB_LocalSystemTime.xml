<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_LocalSystemTime Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_LocalSystemTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_LocalSystemTime">
              <type><derived name="FB_LocalSystemTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_LocalSystemTime 实例</xhtml></documentation>
            </variable>
            <variable name="bEnableSync">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 触发首次同步</xhtml></documentation>
            </variable>
            <variable name="stCurrentTime">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">同步出来的系统时间，monitor 此值</xhtml></documentation>
            </variable>
            <variable name="bTimeValid">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">首次同步成功后置 TRUE</xhtml></documentation>
            </variable>
            <variable name="eCurrentTz">
              <type><derived name="E_TimeZoneID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前时区标识</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：CX5020 上电后把本地 Windows 时间同步到 PLC；每 5 秒重同步并校准硬件 RTC（dwOpt = 1）。
// 价值：替代手写 NT_GetTime + RTC_EX2 + 时区查询 + 状态机约 30 行代码。
// 验证：登录后写 bEnableSync := TRUE；观察 bTimeValid 在 1-2 个 PLC 周期后变 TRUE；stCurrentTime 应与桌面时钟一致；5 秒后再次刷新。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbLocalSystemTime(
    sNetID := '',
    bEnable := bEnableSync,
    dwCycle := 5,
    dwOpt := 1,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    bValid =&gt; bTimeValid,
    systemTime =&gt; stCurrentTime,
    tzID =&gt; eCurrentTz
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
