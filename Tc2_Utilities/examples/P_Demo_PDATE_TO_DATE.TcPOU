<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PDATE_TO_DATE" Id="{728f422f-abe9-5950-8928-01d6c8457a0c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PDATE_TO_DATE
VAR
    dRealValue           : DATE := D#2026-05-11; // 模拟 wire 缓冲区中的 DATE 字段
    pDATEField           : POINTER TO DATE; // 业务侧先算好的字段地址（ADR 或 pBase+nOff）
    bExtractField        : BOOL; // 在线置 TRUE 触发一次解析
    dRealValue_extracted : DATE; // 解析后的副本，供业务逻辑使用
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.PDATE_TO_DATE 演示程序（FUNCTION）
// ============================================================
// 场景：从一段二进制 wire 缓冲区里按偏移取 DATE 字段（Modbus/CAN/ADS Raw）。
// 价值：替代手写 pField + nOff + ^ 指针算术；一次调用取值，少打错符号。
// 验证：在线写 dRealValue := D#2026-05-11；bExtractField := TRUE；
//       下一周期 dRealValue_extracted 应等于 dRealValue。
// ============================================================

// 业务代码通常已经算好字段地址（pBase + 协议偏移）；演示用 ADR 等价
pDATEField := ADR(dRealValue);

IF bExtractField AND pDATEField <> 0 THEN
    // 单次完整调用：避免手写 ^ 解引用，统一风格便于和字节序转换串联
    dRealValue_extracted := PDATE_TO_DATE(pDATEField);
    bExtractField := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
