<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FIND2 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FIND2" pouType="program">
        <interface>
          <localVars>
            <variable name="sUaNode"><initialValue><simpleValue value="'ns=2;s=Pump.State'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：OPC UA NodeId 字符串</xhtml></documentation></variable>
            <variable name="sSep"><initialValue><simpleValue value="';'"/></initialValue><type><string><length>4</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">分隔符子串</xhtml></documentation></variable>
            <variable name="nSepPos"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">分隔符位置（1 起算），0 = 未找到</xhtml></documentation></variable>
            <variable name="bParse"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发解析</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：解析 EtherCAT 配置 XML 字符串：找到 `'&lt;Device&gt;'` 标签的位置，再截取标签内容。
// 价值：比 `Tc2_Standard.FIND` + 长度判断 + MID 拆解的链条更直接；返回值 1 起算与 `MID`/`INSERT`/`DELETE` 风格一致。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bParse THEN
    nSepPos := FIND2(pSrcString  := ADR(sUaNode),
                     pFindString := ADR(sSep));
    // nSepPos &gt; 0 -&gt; 可用 MID 拆出 ns= 和 s= 两段
    bParse := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
