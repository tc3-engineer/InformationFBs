<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.SYSTEMTIME_TO_ISO8601 Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_SYSTEMTIME_TO_ISO8601" pouType="program">
        <interface>
          <localVars>
            <variable name="stMeasurement">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测量发生的时刻 (初始化通过在线手动赋值; 推荐字段：( wYear := 2026, wMonth := 5, wDay := 11, wHour := 12, wMinute := 34, wSecond := 56, wMilliseconds := 123 ))</xhtml></documentation>
            </variable>
            <variable name="nBiasMin">
              <type><INT/></type>
              <initialValue><simpleValue value="0"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UTC vs Local（分钟）；UTC 输入此值无关</xhtml></documentation>
            </variable>
            <variable name="bInputIsUTC">
              <type><BOOL/></type>
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = stMeasurement 是 UTC</xhtml></documentation>
            </variable>
            <variable name="nPrecisionDigits">
              <type><USINT/></type>
              <initialValue><simpleValue value="3"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">秒后小数位数</xhtml></documentation>
            </variable>
            <variable name="sISOTime">
              <type><string><length>39</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输出的 ISO 字符串</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：MQTT 发布生产数据，要求时间字段为 ISO 8601（Node-RED / Grafana 标准）
//
// 价值：1 行得到 ISO 8601 字符串，自动处理 TZD 和小数位
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.3.46.0）
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 sISOTime = «2026-05-11T12:34:56.123Z»
//   5. nPrecisionDigits := 6 → 「...56.123000Z」（多 3 位零填充）
// =============================================================================
sISOTime := SYSTEMTIME_TO_ISO8601(stMeasurement, nBiasMin, bInputIsUTC, nPrecisionDigits);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
