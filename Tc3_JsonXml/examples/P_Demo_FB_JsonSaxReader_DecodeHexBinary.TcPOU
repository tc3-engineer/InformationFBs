<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonSaxReader_DecodeHexBinary" Id="{a8b74e96-50b1-5ba9-92a6-0acad230f11f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonSaxReader_DecodeHexBinary
VAR
    fbParser : FB_JsonSaxReader; // 父 FB 实例
    pBytes : POINTER TO BYTE;
    nBytesRaw : DINT; // 给 nBytes 用的具名后备变量
    sHex : STRING(255);
    hrErrorCode : HRESULT;
    vRet : BOOL; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：把 base64 / hex / ISO8601 编码字符串解回二进制或时间——常见于解析外部下发的二进制 payload。
// 价值：标准工具方法，避免自己写编码转换逻辑。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.DecodeHexBinary(
        pBytes := pBytes,
        nBytes := nBytesRaw,
        sHex := sHex,
        hrErrorCode => hrErrorCode
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
