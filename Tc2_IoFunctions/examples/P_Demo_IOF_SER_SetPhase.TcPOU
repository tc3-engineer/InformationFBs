<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IOF_SER_SetPhase" Id="{453750fc-897a-5cae-ba0d-dd8b6ee37c1c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IOF_SER_SetPhase
VAR
    fbSercosSetPhase  : IOF_SER_SetPhase; // SERCOS phase 切换 FB
    sLocalNetId       : T_AmsNetId := ''; // 本机
    nSercosDeviceId   : UDINT := 1; // 主站 Device Id
    nTargetPhaseValue : BYTE := 2; // 目标 phase 值 (0..4)
    bSetPhaseReq      : BOOL := FALSE; // 上升沿触发切换
    tSetPhaseTimeout  : TIME := T#15S; // 超时（phase 切换较慢）
    bSetPhaseBusy     : BOOL; // 工作中
    bSetPhaseErr      : BOOL; // 出错
    nLastErrCode      : UDINT; // 错误号
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：调试期：HMI 按"进入调试模式"按钮 → 把 SERCOS 环切到 phase 2 让参数可访问。
// 价值：让"参数调试"成为正式工序的一部分。
// 验证：**先停所有 motion** → 写 nTargetPhaseValue := 2、bSetPhaseReq := TRUE → bSetPhaseBusy 短暂 TRUE → 回 FALSE 后用 IOF_SER_GetPhase 确认 phase = 2。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：从 phase 4 切回低 phase 会停所有 motion；先确保 drive 已 disable
fbSercosSetPhase(
    NETID    := sLocalNetId,
    DEVICEID := nSercosDeviceId,
    PHASE    := nTargetPhaseValue,
    SET      := bSetPhaseReq,
    TMOUT    := tSetPhaseTimeout,
    BUSY     => bSetPhaseBusy,
    ERR      => bSetPhaseErr,
    ERRID    => nLastErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
