<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepBlockLagBased" Id="{a62be1ab-b32f-5fe0-81a1-2ac04ca2923c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepBlockLagBased
VAR
    fbStepBlockLagBased : MC_StepBlockLagBased;
    axisHoming          : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec              : R_TRIG; // 把保持型请求位整成单次上升沿
    bLagBlockReq        : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam         : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    homingOptions       : ST_Home_Options3; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bLagBlockDone       : BOOL;
    bBusy               : BOOL;
    bLagBlockActive     : BOOL;
    bAborted            : BOOL;
    bError              : BOOL;
    nErrorID            : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：第三方驱动无可用转矩反馈，但 NC 能算跟随误差。用低速撞机械止挡 + 跟随误差判据归零，
//       跟随误差超 5 且速度持续低于阈值即判定顶到止挡，把该点定为坐标 0。
// 价值：不依赖转矩信号即可做 home-on-block，扩大适用驱动范围。
// 验证：先 MC_Power 使能；在线写 bLagBlockReq := TRUE，观察 bLagBlockActive TRUE，轴低速顶；
//       顶到止挡跟随误差升到 >5 且速度跌到 1 以下持续 200ms 后 bLagBlockDone TRUE，位置读数变 0。

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bLagBlockReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepBlockLagBased(
    Execute                := rtExec.Q,
    Direction              := mcPositiveDirection,
    Velocity               := 10.0,
    Acceleration           := 0.0,
    Deceleration           := 0.0,
    Jerk                   := 0.0,
    SetPosition            := 0.0,
    DetectionVelocityLimit := 1.0,
    DetectionVelocityTime  := T#200MS,
    TimeLimit              := T#20S,
    DistanceLimit          := 500.0,
    TorqueLimit            := 30.0,
    LagLimit               := 5.0,
    BufferMode             := MC_Aborting,
    Options                := homingOptions,
    Done                   => bLagBlockDone,
    Busy                   => bBusy,
    Active                 => bLagBlockActive,
    CommandAborted         => bAborted,
    Error                  => bError,
    ErrorID                => nErrorID,
    Axis                   := axisHoming,
    Parameter              := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bLagBlockReq AND NOT bBusy THEN
    bLagBlockDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
