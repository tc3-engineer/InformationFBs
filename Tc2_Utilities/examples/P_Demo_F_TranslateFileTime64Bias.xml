<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_TranslateFileTime64Bias Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_TranslateFileTime64Bias" pouType="program">
        <interface>
          <localVars>
            <variable name="ftUTC">
              <type><derived name="T_FILETIME64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UTC 时间戳</xhtml></documentation>
            </variable>
            <variable name="nBiasMinutes">
              <type><DINT/></type>
              <initialValue><simpleValue value="-480"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UTC vs 本地的差值，北京时区 = -480</xhtml></documentation>
            </variable>
            <variable name="bDirection">
              <type><BOOL/></type>
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FALSE = UTC → Local，TRUE = Local → UTC</xhtml></documentation>
            </variable>
            <variable name="ftLocal">
              <type><derived name="T_FILETIME64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后的本地时间</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：PLC 用 UTC 记日志避免 DST 跳点，HMI 显示需转本地时间（北京东 8 区）
//
// 价值：1 行完成时区偏移，避免手写常量 600000000 (60 × 10⁷)
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.3.44.0）
//   2. 编译 + 登录 + 运行
//   3. 先用 DT_TO_FILETIME64(DT#2026-05-11-04:00:00) 给 ftUTC 赋值
//   4. 强制 bRunOnce := TRUE
//   5. 在线观察 ftLocal，用 FILETIME64_TO_DT 转回 DT 应为 2026-05-11-12:00:00（早 8 小时）
//   6. 改 nBiasMinutes := 60 测试 CET 时区 → 应早 1 小时
// =============================================================================
ftLocal := F_TranslateFileTime64Bias(ftUTC, nBiasMinutes, bDirection);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
