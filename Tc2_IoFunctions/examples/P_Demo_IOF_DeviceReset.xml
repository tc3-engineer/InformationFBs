  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_DeviceReset" pouType="program">
        <interface>
          <localVars>
            <variable name="fbResetIoDevice">
              <type><derived name="IOF_DeviceReset"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">I/O 设备复位 FB 实例</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机用空串；远端填 AMS Net ID</xhtml></documentation>
            </variable>
            <variable name="nProfibusDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">System Manager 中 Profibus 主站的 Device Id</xhtml></documentation>
            </variable>
            <variable name="bResetProfibusReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 按钮：复位 Profibus 主站请求（上升沿触发）</xhtml></documentation>
            </variable>
            <variable name="tResetCmdTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 复位命令超时</xhtml></documentation>
            </variable>
            <variable name="bResetBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB 工作中</xhtml></documentation>
            </variable>
            <variable name="bResetErrorFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">复位命令出错</xhtml></documentation>
            </variable>
            <variable name="nLastResetErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Profibus 卡 FC3101 在长时间运行后偶发通讯故障，HMI 上按「复位 Profibus 主站」按钮触发本 FB，让总线重新走一遍上电流程。
// 价值：把 System Manager 的「在线复位」做成 PLC 接口，可被 HMI / SCADA 触发；不用工程模式登录工控机。
// 验证：登录后把 nProfibusDeviceId 设为 System Manager 显示的 Device Id（例如 1），在线写 bResetProfibusReq := TRUE → bResetBusy 短暂置 TRUE → 几百毫秒后回 FALSE，期间 Profibus 端子的输入数据会闪一下；nLastResetErrId 非 0 查 ADS Return Codes。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次调用形式：bResetProfibusReq 上升沿触发；HMI 应在 bResetBusy 落回后复位 bResetProfibusReq
fbResetIoDevice(
    NETID    := sTargetNetId,
    DEVICEID := nProfibusDeviceId,
    RESET    := bResetProfibusReq,
    TMOUT    := tResetCmdTimeout,
    BUSY     =&gt; bResetBusy,
    ERR      =&gt; bResetErrorFlag,
    ERRID    =&gt; nLastResetErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
