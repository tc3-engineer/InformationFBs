<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_RealIsNaN" Id="{8056d1a9-81b4-587d-9d88-cbca6e50fa22}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_RealIsNaN
VAR
    rSensor : REAL;
    bIsNaN  : BOOL;
    bCheck  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.RealIsNaN 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：温度传感器 32 位读回值经 1/0 计算被污染为 NaN，喂控制器前需判 NaN 后切默认值。
// 价值：替代位检测；与 LrealIsNaN 对称。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bIsNaN := RealIsNaN(rSensor);
    bCheck := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
