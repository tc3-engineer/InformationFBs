  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_GetRouterStatusInfo Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetRouterStatusInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetRouterStatusInfo">
              <type><derived name="FB_GetRouterStatusInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetRouterStatusInfo 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stRouterInfo">
              <type><derived name="ST_AmsRouterStatusInfo"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 网络诊断页每秒读 Router 状态。
// 价值：路由器级观测，比 ping 精确。
// 验证：触发后观察 stRouterInfo.nMessages 在变；正常工况 nLostMessages 应为 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetRouterStatusInfo(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    stStatusInfo =&gt; stRouterInfo,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
