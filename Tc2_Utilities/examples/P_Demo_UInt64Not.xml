  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Not" pouType="program">
        <interface>
          <localVars>
            <variable name="uliBitMask">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">单 bit 掩码</xhtml></documentation>
            </variable>
            <variable name="uliInverted">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">取反后</xhtml></documentation>
            </variable>
            <variable name="bInvert">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Not 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：构造'除了 bit0 以外全屏蔽'的掩码：先 `ULARGE_INTEGER(0,1)` 再 `UInt64Not(...)`。
// 价值：替代手写两次 DWORD NOT。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

uliBitMask := ULARGE_INTEGER(0, 1);
IF bInvert THEN
    uliInverted := UInt64Not(uliBitMask);   // 除了 bit0 之外全 1
    bInvert := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
