<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACOptimizedOff" Id="{17ee1f8d-f112-5abe-8a6d-dd88b738120c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACOptimizedOff
VAR
    fb : FB_HVACOptimizedOff;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    eCtrlFct_in : E_BARCtrlFct ;
    bEnable_in : BOOL := FALSE;
    bSchedulerOff_in : BOOL := FALSE;
    bWithAdaption_in : BOOL := FALSE;
    bDisableAdaption_in : BOOL := FALSE;
    rOutsideTemperature_in : REAL := 0.0;
    rRoomTemperature_in : REAL := 0.0;
    rRequestedTempDeviation_in : REAL := 0.0;
    uiMaxPrestopTime_io : UINT := 0;
    rAdaptionFactor_io : REAL := 0.0;
    rAdaptionTolerance_io : REAL := 0.0;
    uiPrestopTime_out : UINT;
    bPrestopActive_out : BOOL;
    udiCountdownTime_out : UDINT;
    bError_out : BOOL;
    udiErrorID_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACOptimizedOff 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACOptimizedOff.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    eCtrlFct := eCtrlFct_in,
    bEnable := bEnable_in,
    bSchedulerOff := bSchedulerOff_in,
    bWithAdaption := bWithAdaption_in,
    bDisableAdaption := bDisableAdaption_in,
    rOutsideTemperature := rOutsideTemperature_in,
    rRoomTemperature := rRoomTemperature_in,
    rRequestedTempDeviation := rRequestedTempDeviation_in,
    uiMaxPrestopTime := uiMaxPrestopTime_io,
    rAdaptionFactor := rAdaptionFactor_io,
    rAdaptionTolerance := rAdaptionTolerance_io,
    uiPrestopTime => uiPrestopTime_out,
    bPrestopActive => bPrestopActive_out,
    udiCountdownTime => udiCountdownTime_out,
    bError => bError_out,
    udiErrorID => udiErrorID_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
