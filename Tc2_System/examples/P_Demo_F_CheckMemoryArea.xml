<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_CheckMemoryArea Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_CheckMemoryArea" pouType="program">
        <interface>
          <localVars>
            <variable name="nStaticCounter">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">静态局部变量（编译期分配）</xhtml></documentation>
            </variable>
            <variable name="pDynamicValue">
              <type><pointer><baseType><LREAL/></baseType></pointer></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">动态分配指针（__NEW）</xhtml></documentation>
            </variable>
            <variable name="eAreaStatic">
              <type><derived name="E_TcMemoryArea"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">静态变量的内存区</xhtml></documentation>
            </variable>
            <variable name="eAreaDynamic">
              <type><derived name="E_TcMemoryArea"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">动态变量的内存区</xhtml></documentation>
            </variable>
            <variable name="eAreaNull">
              <type><derived name="E_TcMemoryArea"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">空指针的内存区（应为 Unknown）</xhtml></documentation>
            </variable>
            <variable name="pNull">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">空指针测试用</xhtml></documentation>
            </variable>
            <variable name="bCheckRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次诊断</xhtml></documentation>
            </variable>
            <variable name="rtCheck">
              <type><derived name="R_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿检测</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：启动时分别检查一个静态局部变量和一个 __NEW 出来的动态变量所在内存区域，演示 F_CheckMemoryArea 的诊断用法。
// 价值：替代靠崩溃 / 拷贝调试日志定位野指针的低效方法。
// 验证：bCheckRequest := TRUE 触发一次 → 观察 eAreaStatic = eTcMA_Static（或对应枚举），eAreaDynamic = eTcMA_Dynamic。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

rtCheck(CLK := bCheckRequest);
IF rtCheck.Q THEN
    // 1) 静态变量
    eAreaStatic := F_CheckMemoryArea(pData := ADR(nStaticCounter), nSize := SIZEOF(nStaticCounter));

    // 2) 动态分配；若未分配则先 __NEW
    IF pDynamicValue = 0 THEN
        pDynamicValue := __NEW(LREAL);
    END_IF;
    IF pDynamicValue &amp;lt;&amp;gt; 0 THEN
        eAreaDynamic := F_CheckMemoryArea(pData := pDynamicValue, nSize := SIZEOF(LREAL));
    END_IF;

    // 3) 空指针
    eAreaNull := F_CheckMemoryArea(pData := pNull, nSize := 1);
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
