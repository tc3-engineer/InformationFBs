          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 拼装显示字符串。
// 价值：替代多次 CONCAT。
// 验证：格式串 `'Count=%d'` + 参数 100，输出应为 `'Count=100'`。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_FormatString(
    sFormat := sFormat,
    arg1 := arg1,
    arg2 := arg2,
    arg3 := arg3,
    arg4 := arg4,
    arg5 := arg5,
    arg6 := arg6,
    arg7 := arg7,
    arg8 := arg8,
    arg9 := arg9,
    arg10 := arg10,
    bError =&gt; bError,
    nErrId =&gt; nErrId,
    sOut =&gt; sOut
);
</xhtml></ST>
        </body>
