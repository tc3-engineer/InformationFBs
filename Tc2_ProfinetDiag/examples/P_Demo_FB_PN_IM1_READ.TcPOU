<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_PN_IM1_READ" Id="{dece1dc6-be69-55f6-82eb-017e5b05f07b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_PN_IM1_READ
VAR
    fbFB_PN_IM1_READ : FB_PN_IM1_READ;        // FB_PN_IM1_READ 实例
    bReadIM       : BOOL := FALSE;            // 在线上升沿触发一次读取
    bBusy         : BOOL;
    bErr          : BOOL;
    nErrId        : UDINT;
    sTagFunction  : STRING(32);              // 功能标签
    sTagLocation  : STRING(22);              // 位置标签
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ProfinetDiag.FB_PN_IM1_READ 演示程序
// ============================================================
// 场景：读设备 I&M1 功能/位置标签（电子铭牌）。
// 价值：免手工解析 0xAFF1 帧。
// 验证：登录后 bReadIM 上升沿，sTagFunction/sTagLocation 填入。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ProfinetDiag（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 上升沿触发一次 I&M 读取；读到的数据在 bBusy 落沿后有效
fbFB_PN_IM1_READ(
    bStart := bReadIM,
    NETID  := '',
    PORT   := 16#1001,
    bBusy  => bBusy,
    st_IM_TagFunction => sTagFunction,
    st_IM_TagLocation => sTagLocation,
    bError => bErr,
    iErrorID => nErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
