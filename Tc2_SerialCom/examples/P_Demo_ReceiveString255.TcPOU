<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ReceiveString255" Id="{877c3cd0-e28f-5823-8049-9a3e06f57223}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ReceiveString255
VAR
    fbSerialLine       : SerialLineControl;     // 后台通信，填充 bufRx
    fbReceiveString255 : ReceiveString255;
    bufRx              : ComBuffer;
    bufTx              : ComBuffer;
    arrComIn           : PcComInData;
    arrComOut          : PcComOutData;
    bErrLine           : BOOL;

    sReceived          : STRING(255);           // IN_OUT：最长 255 字符
    bGotSentence       : BOOL;
    bRxTimeout         : BOOL;
    eErr               : ComError_t;
    nSentenceCount     : UDINT;                  // 监控：累计完整语句数
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：GPS 模块经 RS232 输出 NMEA 语句，如
//       "$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47\r\n"
//       一行可超过 80 字符，必须用 255 字符版本接收，否则溢出。
//
// 价值：演示 ReceiveString255 接收长文本行——前缀 '$' 过滤掉行首杂字符，
//       后缀 CR/LF 判帧；完整语句需同时无超时、无错误。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_SerialCom；把 arrComIn/arrComOut 链接到 COM 口过程映像
//   3. 编译 → 登录 → 运行；用串口助手发一条带 \r\n 结尾的 NMEA 语句
//      → bGotSentence 闪 1 个周期，sReceived 显示完整语句
//      → 每收到一条完整语句 nSentenceCount +1
// =============================================================================

// 后台通信：搬硬件字节进 bufRx
fbSerialLine(
    Mode      := ComSerialLineMode_t.SERIALLINEMODE_PC_COM_PORT,
    pComIn    := ADR(arrComIn),
    pComOut   := ADR(arrComOut),
    SizeComIn := SIZEOF(arrComIn),
    TxBuffer  := bufTx,
    RxBuffer  := bufRx,
    Error     => bErrLine
);

// 前缀 '$' 起头，后缀 CR LF 结束；长语句不会溢出（上限 255）
fbReceiveString255(
    Prefix         := '$',
    Suffix         := '$R$L',                   // CR LF
    Timeout        := T#500MS,
    Reset          := FALSE,
    ReceivedString := sReceived,
    RXBuffer       := bufRx,
    StringReceived => bGotSentence,
    busy           => ,
    Error          => eErr,
    RxTimeout      => bRxTimeout
);

IF bGotSentence AND NOT bRxTimeout AND (eErr = ComError_t.COMERROR_NOERROR) THEN
    nSentenceCount := nSentenceCount + 1;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
