<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_BIT_SEND" Id="{af166659-4731-55ca-8fdd-0af8671b638d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_BIT_SEND
VAR
    fbEIB_BIT_SEND     : EIB_BIT_SEND;
    stEibRec           : EIB_REC;
    stGroup            : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 1, NUMBER := 50);
    data               : BOOL := FALSE;
    bSendError         : BOOL;
    iLastErrID         : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_BIT_SEND 演示程序
// ============================================================
// 场景：PLC 测得的 开关命令 经 EIB 组地址 1/1/50 推送到 BMS。
// 价值：替代手写 DPT 1.xxx 编码；变化触发自动
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：改 `data` → 1 秒内 EIB 总线上 1/1/50 出新帧。
// ============================================================

// 每周期调用：只在 data 变化时下发 telegram
fbEIB_BIT_SEND(
    Group_Address := stGroup,
    bData         := data,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
