<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACBasicSequenceCtrl" Id="{66932156-33d0-5dd2-b77e-2e6624891d87}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACBasicSequenceCtrl
VAR
    fb : FB_HVACBasicSequenceCtrl;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    iNumberOfSequences_in : INT := 0;
    iMyNumberInSequence_in : INT := 0;
    rW_in : REAL := 0.0;
    rX_in : REAL := 0.0;
    tTaskCycleTime_in : TIME := T#0S;
    tCtrlCycleTime_in : TIME := T#0S;
    eCtrlMode_in : E_HVACCtrlMode ;
    rYManual_in : REAL := 0.0;
    rInitialValue_in : REAL := 0.0;
    bResetController_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    rDeadRange_io : REAL := 0.0;
    bDirection_io : BOOL := FALSE;
    rKp_io : REAL := 0.0;
    tTi_io : TIME := T#0S;
    tTv_io : TIME := T#0S;
    tTd_io : TIME := T#0S;
    rDeadBand_io : REAL := 0.0;
    rYMin_io : REAL := 0.0;
    rYMax_io : REAL := 0.0;
    iCurrentSequence_io : INT := 0;
    rY_out : REAL;
    rXW_out : REAL;
    bMaxLimit_out : BOOL;
    bMinLimit_out : BOOL;
    bActive_out : BOOL;
    bARWactive_out : BOOL;
    eState_out : E_HVACState;
    bError_out : BOOL;
    eErrorCode_out : E_HVACErrorCodes;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACBasicSequenceCtrl 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACBasicSequenceCtrl.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    iNumberOfSequences := iNumberOfSequences_in,
    iMyNumberInSequence := iMyNumberInSequence_in,
    rW := rW_in,
    rX := rX_in,
    tTaskCycleTime := tTaskCycleTime_in,
    tCtrlCycleTime := tCtrlCycleTime_in,
    eCtrlMode := eCtrlMode_in,
    rYManual := rYManual_in,
    rInitialValue := rInitialValue_in,
    bResetController := bResetController_in,
    bReset := bReset_in,
    rDeadRange := rDeadRange_io,
    bDirection := bDirection_io,
    rKp := rKp_io,
    tTi := tTi_io,
    tTv := tTv_io,
    tTd := tTd_io,
    rDeadBand := rDeadBand_io,
    rYMin := rYMin_io,
    rYMax := rYMax_io,
    iCurrentSequence := iCurrentSequence_io,
    rY => rY_out,
    rXW => rXW_out,
    bMaxLimit => bMaxLimit_out,
    bMinLimit => bMinLimit_out,
    bActive => bActive_out,
    bARWactive => bARWactive_out,
    eState => eState_out,
    bError => bError_out,
    eErrorCode => eErrorCode_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
