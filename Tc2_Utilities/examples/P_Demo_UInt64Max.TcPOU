<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Max" Id="{d5b1c6cd-d6d8-5c4c-92e9-e61f8d3b0cba}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Max
VAR
    uliA   : T_ULARGE_INTEGER;; // 传感器 A 计数
    uliB   : T_ULARGE_INTEGER;; // 传感器 B 计数
    uliMax : T_ULARGE_INTEGER;; // 较大者
    bPick  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Max 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：多路温度传感器读回 64 位计数，取最大值做超温报警阈值比对。
// 价值：替代手写比较 + 选择；一次调用，可读性更高。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bPick THEN
    uliMax := UInt64Max(uliA, uliB);
    bPick := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
