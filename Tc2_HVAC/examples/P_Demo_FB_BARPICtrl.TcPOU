<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARPICtrl" Id="{a11507d4-9e1e-5a22-b442-aac6b839dd6a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARPICtrl
VAR
    fb : FB_BARPICtrl;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    rW_in : REAL := 0.0;
    rX_in : REAL := 0.0;
    tTaskCycleTime_in : TIME := T#0S;
    uiCtrlCycleCall_in : UINT := 0;
    bSync_in : BOOL := FALSE;
    bDirection_io : BOOL := FALSE;
    rXp_io : REAL := 0.0;
    tTn_io : TIME := T#0S;
    rYMin_io : REAL := 0.0;
    rYMax_io : REAL := 0.0;
    rSyncValue_io : REAL := 0.0;
    rY_out : REAL;
    rE_out : REAL;
    bARW_out : BOOL;
    bMaxLimit_out : BOOL;
    bMinLimit_out : BOOL;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARPICtrl 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARPICtrl.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    rW := rW_in,
    rX := rX_in,
    tTaskCycleTime := tTaskCycleTime_in,
    uiCtrlCycleCall := uiCtrlCycleCall_in,
    bSync := bSync_in,
    bDirection := bDirection_io,
    rXp := rXp_io,
    tTn := tTn_io,
    rYMin := rYMin_io,
    rYMax := rYMax_io,
    rSyncValue := rSyncValue_io,
    rY => rY_out,
    rE => rE_out,
    bARW => bARW_out,
    bMaxLimit => bMaxLimit_out,
    bMinLimit => bMinLimit_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
