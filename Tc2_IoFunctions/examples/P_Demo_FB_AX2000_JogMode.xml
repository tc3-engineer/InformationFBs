<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_AX2000_JogMode Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AX2000_JogMode" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAx2000Jog">
              <type><derived name="FB_AX2000_JogMode"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AX2000 点动 FB</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdIn">
              <type><derived name="ST_PZD_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 输入</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdOut">
              <type><derived name="ST_PZD_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 输出</xhtml></documentation>
            </variable>
            <variable name="iJogBasicSpeed">
              <initialValue><simpleValue value="100"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">点动基础速度</xhtml></documentation>
            </variable>
            <variable name="bJogPositiveReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 按钮：点动正方向</xhtml></documentation>
            </variable>
            <variable name="bJogStopReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 按钮：停点动</xhtml></documentation>
            </variable>
            <variable name="tJogTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bJogBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bJogErrFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">驱动器故障</xhtml></documentation>
            </variable>
            <variable name="bJogTimeoutErrFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">通讯超时</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：AX2000 调试期间通过 HMI 手动点动伺服轴，基础速度 100。
// 价值：调试人员不用打开柜门接调试软件。
// 验证：登录后 stAx2000PzdIn / stAx2000PzdOut 已链到 PZD；按 bJogPositiveReq := TRUE → 轴开始正方向点动；松开 → 调 bJogStopReq := TRUE → 轴停止。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 循环调用以维持 PZD 通讯
fbAx2000Jog(
    bStart      := bJogPositiveReq,
    bStop       := bJogStopReq,
    iBasicVelo  := iJogBasicSpeed,
    tTimeOut    := tJogTimeout,
    stPZDIN     := stAx2000PzdIn,
    stPZDOUT    := stAx2000PzdOut,
    bBusy       =&gt; bJogBusy,
    bErr        =&gt; bJogErrFlag,
    bTimeOutErr =&gt; bJogTimeoutErrFlag
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
