<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ULARGE_TO_LWORD" Id="{692e8cd3-424c-52e5-938e-ebeb79e194de}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ULARGE_TO_LWORD
VAR
    uliStatus    : T_ULARGE_INTEGER;; // legacy 状态结构体
    lwStatusBits : LWORD;; // 转换后的位串
    bConvert     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.ULARGE_TO_LWORD 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：legacy 报文里读到的 64 位状态位转 LWORD 后直接用 IEC 原生 `AND` 屏蔽。
// 价值：替代结构体位运算；之后可用原生 `AND/OR/SHR`，代码可读性更高。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    lwStatusBits := ULARGE_TO_LWORD(uliStatus);
    bConvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
