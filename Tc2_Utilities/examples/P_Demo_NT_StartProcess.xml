  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_NT_StartProcess" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNT_StartProcess">
              <type><derived name="NT_StartProcess"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NT_StartProcess 实例</xhtml></documentation>
            </variable>
            <variable name="bStart">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="sPath">
              <initialValue><simpleValue value="'C:\Windows\notepad.exe'"/></initialValue>
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="sDir">
              <initialValue><simpleValue value="'C:\Windows'"/></initialValue>
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="sCmd">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：日终触发外部脚本生成报表。
// 价值：事件驱动，无需上位机配合。
// 验证：改 bStart := TRUE，触发后目标机器应能看到 notepad.exe 启动（或自定义脚本）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_StartProcess(
    NETID := '', START := bStart, PATHSTR := sPath, DIRNAME := sDir, COMNDLINE := sCmd,
    TMOUT := DEFAULT_ADS_TIMEOUT, BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
