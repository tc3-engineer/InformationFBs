<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_M_AcknowledgeAllWarning" Id="{7e79640a-53a1-520f-8351-dd32ea288337}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_M_AcknowledgeAllWarning
VAR
    fbAdminAlarm     : FB_PMLAdminAlarm;
    fbAdminTime      : FB_PMLAdminTime;
    stPackTagAdmin   : ST_PMLa;
    stPackTagStatus  : ST_PMLs;
    stAdminOpt       : ST_PMLAdminTimeOptions;

    stWarn1          : ST_PMLEvent := (Id := 2001, Message := 'Filter 80%', Category := 2);
    stWarn2          : ST_PMLEvent := (Id := 2002, Message := 'Oil low',    Category := 3);
    stWarn3          : ST_PMLEvent := (Id := 2003, Message := 'Temp 75C',   Category := 3);

    bBtnFireAll      : BOOL := FALSE;
    bBtnAckAll       : BOOL := FALSE;
    rtrigFire        : R_TRIG;
    rtrigAck         : R_TRIG;
    bAckOk           : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc3_PackML_V3.FB_PMLAdminAlarm.M_AcknowledgeAllWarning 演示程序
// ============================================================
// 场景：维护人员看到 HMI 上多个 warning（滤芯/油位/温度阈值），按
//       "全部确认"按钮一次性确认全部。
// 价值：V3 新增的批量方法让 HMI 一键操作免去 for 循环。注意方法名
//       末尾是 Warning 单数（不是 Warnings）。
// 验证：登录后操作：
//       1. 写 bBtnFireAll := TRUE → 观察 Warning[0..2] 都被填入，
//          三条 Trigger = TRUE。
//       2. 写 bBtnAckAll := TRUE → 观察 Warning[0..2] 的 Trigger 全部
//          变 FALSE、AckDateTime 全填；但 Id 仍是 2001/2002/2003。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_PackML_V3（References → Add library）
//   3. 编译 → 登录 → 运行；按上方"验证"指引在线写值观察
// ============================================================

fbAdminTime(stAdmin := stPackTagAdmin, stStatus := stPackTagStatus, stOptions := stAdminOpt);

rtrigFire(CLK := bBtnFireAll);
rtrigAck(CLK := bBtnAckAll);

IF rtrigFire.Q THEN
    fbAdminAlarm.M_SetWarning(stAdmin := stPackTagAdmin, stWarning := stWarn1);
    fbAdminAlarm.M_SetWarning(stAdmin := stPackTagAdmin, stWarning := stWarn2);
    fbAdminAlarm.M_SetWarning(stAdmin := stPackTagAdmin, stWarning := stWarn3);
END_IF
IF rtrigAck.Q THEN
    bAckOk := fbAdminAlarm.M_AcknowledgeAllWarning(stAdmin := stPackTagAdmin);
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
