  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_CONCAT" pouType="program">
        <interface>
          <localVars>
            <variable name="sResult">
              <type><string><stringLength><value>255</value></stringLength></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CONCAT 的返回值（监视）</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次 CONCAT 调用</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Standard.CONCAT 演示程序（FUNCTION）
// ============================================================
// 场景：把姓名前缀和实际名字拼起来
// 验证步骤：
//   1. 编译并登录目标
//   2. 强制 bRun := TRUE 一个周期
//   3. 观察 sResult = 'Mr.Smith'
//   4. bRun 自动复位
// ============================================================

IF bRun THEN
    sResult := CONCAT('Mr.','Smith');
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
