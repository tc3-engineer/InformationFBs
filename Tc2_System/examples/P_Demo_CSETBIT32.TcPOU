<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_CSETBIT32" Id="{5de3bf47-1f69-522b-934d-daf47ee9f760}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_CSETBIT32
VAR
    aDigitalInputs : ARRAY[0..31] OF BOOL; // 32 个 DI 通道
    dwPackedDi     : DWORD := 0; // 打包后的状态字
    i              : INT; // 循环变量
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：把 32 个 DI 通道实时状态打包到一个 DWORD（每位对应一通道），HMI 一次读取拿全部状态。
// 价值：替代 IF + SETBIT/CLEARBIT 二选一，代码量减半。
// 验证：aDigitalInputs[5] := TRUE → 观察 dwPackedDi bit5 = 1；TRUE → FALSE → bit5 = 0。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 每周期把 32 个 BOOL 打包到一个 DWORD
dwPackedDi := 0;
FOR i := 0 TO 31 DO
    dwPackedDi := CSETBIT32(
        inVal32 := dwPackedDi,
        bitNo   := TO_SINT(i),
        bitVal  := aDigitalInputs[i]
    );
END_FOR;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
