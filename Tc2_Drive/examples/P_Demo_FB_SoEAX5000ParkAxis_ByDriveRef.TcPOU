<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEAX5000ParkAxis_ByDriveRef" Id="{87ee0f36-b2ed-595b-9f74-512f54fffb39}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEAX5000ParkAxis_ByDriveRef
VAR
    fbParkAxis    : FB_SoEAX5000ParkAxis_ByDriveRef; // AX5000 通道停泊 FB 实例
    rtrigPark     : R_TRIG; // 把 bParkReq 转成单次上升沿
    stPlcDriveRef : ST_PlcDriveRef; // 链接到 System Manager 的驱动器过程映像
    stDriveRef    : ST_DriveRef; // 解析出的驱动器引用（nDriveNo 选通道）
    bInit         : BOOL := TRUE; // 等过程映像就绪再放行
    bDoPark       : BOOL := TRUE; // TRUE=停泊该通道, FALSE=解除停泊
    bParkReq      : BOOL := FALSE; // 在线置 TRUE 执行一次
    bParkBusy     : BOOL; // 停泊命令执行中
    bParkError    : BOOL; // 停泊命令出错
    iAdsErr       : UINT; // ADS 错误码
    iSercosErr    : UINT; // Sercos 错误码
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：同一台设备按订单选配不同数量的电机轴（柔性/模块化产线）。没接电机的 AX5000
//       通道若不处理会报反馈缺失错误，导致整机无法运行。开机时把空闲通道停泊即可
//       让整机正常起来。
//
// 价值：把"对指定通道下发停泊/解除 SoE 命令 + 异步状态机"封装成一个 bPark 布尔 +
//       触发的调用，一套配置适配多种选配，无需手写停泊 IDN 时序。
//
// 验证步骤：
//   1. 引用 Tc2_Drive 库
//   2. System Manager 里把某 AX5000 SoE 从站过程映像链接到 stPlcDriveRef
//      （stDriveRef.nDriveNo 决定停泊 A=0 还是 B=1 通道）
//   3. 编译、登录、运行；观察 bInit 在过程映像就绪后自动变 FALSE
//   4. 确认目标通道确实没接电机，保持 bDoPark := TRUE，在线置 bParkReq := TRUE
//      → bParkBusy 短暂为 TRUE，落下后 bParkError 应为 FALSE
//      → 该通道的反馈缺失错误应消失（通道进入停泊态）
//   5. 解除：把 bDoPark := FALSE 再触发一次 bParkReq；之后该通道需重新走使能链
//   6. 注意：tTimeout 必须显式给（这里给 DEFAULT_ADS_TIMEOUT），PDF 无默认值
// =============================================================================

// 初始化驱动器引用（nDriveNo 决定停泊哪个通道）
IF bInit THEN
    stDriveRef.sNetId     := F_CreateAmsNetId(stPlcDriveRef.aNetId);
    stDriveRef.nSlaveAddr := stPlcDriveRef.nSlaveAddr;
    stDriveRef.nDriveNo   := stPlcDriveRef.nDriveNo;
    stDriveRef.nDriveType := stPlcDriveRef.nDriveType;
    IF (stDriveRef.sNetId <> '') AND (stDriveRef.nSlaveAddr <> 0) THEN
        bInit := FALSE;
    END_IF;
END_IF;

rtrigPark(CLK := bParkReq);

// 单次调用形式：所有 VAR_INPUT 显式赋值；tTimeout 必须显式给（PDF 无默认值）
fbParkAxis(
    stDriveRef := stDriveRef,
    bExecute   := rtrigPark.Q AND NOT bInit,
    bPark      := bDoPark,
    tTimeout   := DEFAULT_ADS_TIMEOUT,
    bBusy        => bParkBusy,
    bError       => bParkError,
    iAdsErrId    => iAdsErr,
    iSercosErrId => iSercosErr
);

IF NOT bParkBusy AND NOT bInit THEN
    bParkReq := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
