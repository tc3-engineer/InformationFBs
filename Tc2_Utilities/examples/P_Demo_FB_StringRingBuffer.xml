  <contentHeader name="Tc2_Utilities.FB_StringRingBuffer Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_StringRingBuffer" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_StringRingBuffer">
              <type><derived name="FB_StringRingBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_StringRingBuffer 实例</xhtml></documentation>
            </variable>
            <variable name="bOverwrite">
              <type><BOOL/></type>
            </variable>
            <variable name="putValue">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="pBuffer">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbBuffer">
              <type><UDINT/></type>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
            </variable>
            <variable name="getValue">
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="nCount">
              <type><UDINT/></type>
            </variable>
            <variable name="cbSize">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 消息历史。
// 价值：字符串专用。
// 验证：Add 多条 STRING，Get 顺序取回。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_StringRingBuffer(
    bOverwrite := bOverwrite,
    putValue := putValue,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk =&gt; bOk,
    getValue =&gt; getValue,
    nCount =&gt; nCount,
    cbSize =&gt; cbSize
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
