<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IOF_GetDeviceCount" Id="{102d1c00-5354-506e-bf83-26481087b275}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IOF_GetDeviceCount
VAR
    fbReadDeviceCount   : IOF_GetDeviceCount; // IO 设备计数 FB
    sTargetNetId        : T_AmsNetId := ''; // 本机
    bRequestDeviceCount : BOOL := FALSE; // 上升沿触发
    tCountTimeout       : TIME := T#5S; // ADS 超时
    bCountBusy          : BOOL; // 工作中
    bCountError         : BOOL; // 失败
    nLastErrCode        : UDINT; // 错误号
    nActiveDeviceCount  : UDINT; // 查得设备总数
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：PLC 上电自检：列出所有现场总线 / IO 设备到诊断日志，第一步先取总数。
// 价值：为 IO 枚举循环提供准确循环上限，避免越界访问。
// 验证：登录后写 bRequestDeviceCount := TRUE → bCountBusy 短暂 TRUE → 回 FALSE 后 nActiveDeviceCount 显示工程里激活的设备数（典型 1-3）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbReadDeviceCount(
    NETID       := sTargetNetId,
    START       := bRequestDeviceCount,
    TMOUT       := tCountTimeout,
    BUSY        => bCountBusy,
    ERR         => bCountError,
    ERRID       => nLastErrCode,
    DEVICECOUNT => nActiveDeviceCount
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
