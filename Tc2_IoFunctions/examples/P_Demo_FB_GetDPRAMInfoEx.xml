<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_GetDPRAMInfoEx Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetDPRAMInfoEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetDpramInfoEx">
              <type><derived name="FB_GetDPRAMInfoEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOV/DP-RAM Ex 信息查询 FB</xhtml></documentation>
            </variable>
            <variable name="nDpramDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOVRAM 卡 Device Id</xhtml></documentation>
            </variable>
            <variable name="bGetDpramInfoExReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发查询</xhtml></documentation>
            </variable>
            <variable name="tInfoQueryTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bGetInfoExBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bGetInfoExError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastInfoExErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="stDpramAddrInfoEx">
              <type><derived name="ST_NovRamAddrInfoEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOV/DP-RAM Ex 信息结构</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：通用 NOV-RAM 访问框架：上电查访问类型 + 地址，按类型分支选用普通 / Ex 读写。
// 价值：跨硬件平台 PLC 程序复用。
// 验证：登录后 nDeviceId := 1；触发 bGetDpramInfoExReq → 完成后 stDpramAddrInfoEx 中可看到 eAccessType（BYTE/WORD/DWORD）与地址指针。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbGetDpramInfoEx(
    nDevId   := nDpramDeviceId,
    bExecute := bGetDpramInfoExReq,
    tTimeOut := tInfoQueryTimeout,
    bBusy    =&gt; bGetInfoExBusy,
    bError   =&gt; bGetInfoExError,
    nErrId   =&gt; nLastInfoExErrCode,
    stInfo   =&gt; stDpramAddrInfoEx
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
