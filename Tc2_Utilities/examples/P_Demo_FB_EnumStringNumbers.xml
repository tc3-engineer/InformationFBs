  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_EnumStringNumbers" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_EnumStringNumbers">
              <type><derived name="FB_EnumStringNumbers"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_EnumStringNumbers 实例</xhtml></documentation>
            </variable>
            <variable name="sSearch">
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="eCmd">
              <initialValue><simpleValue value="eEnumCmd_First"/></initialValue>
              <type><derived name="E_EnumCmdType"/></type>
            </variable>
            <variable name="eType">
              <initialValue><simpleValue value="eNumGroup_Float"/></initialValue>
              <type><derived name="E_NumGroupTypes"/></type>
            </variable>
            <variable name="sNumber">
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="nPos">
              <type><INT/></type>
            </variable>
            <variable name="bEOS">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：解析操作员多值输入。
// 价值：自动处理分隔符。
// 验证：输入 '5, 10, 15.5'，循环触发取出 5、10、15.5。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_EnumStringNumbers(
    sSearch := sSearch,
    eCmd := eCmd,
    eType := eType,
    sNumber =&gt; sNumber,
    nPos =&gt; nPos,
    bEOS =&gt; bEOS
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
