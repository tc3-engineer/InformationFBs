    <pous>
      <pou name="P_Demo_Int64Div64Ex" pouType="program">
        <interface>
          <localVars>
            <variable name="liDividend">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="liDivisor">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="liQuotient">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="liRemainder">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="bDivide">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.Int64Div64Ex 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：有符号 64 位测量值除以单位换算因子，同时记录余数做下次周期补偿。
// 价值：替代手写有符号除法 + 余数符号处理；一次调用搞定。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bDivide AND NOT Int64IsZero(liDivisor) THEN
    // 除 0 与 −2⁶³÷−1 边界 PDF 未定义 → 前置校验
    liQuotient := Int64Div64Ex(liDividend, liDivisor, liRemainder);
    bDivide := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
