<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.F_GetClassIdVersioned Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetClassIdVersioned" pouType="program">
        <interface>
          <localVars>
            <variable name="sLibId"><initialValue><simpleValue value="'MyCorp|PumpCtrlCpp|1.0.0.5'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：库标识</xhtml></documentation></variable>
            <variable name="clsBase"><type><derived name="CLSID"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">基础 Class ID</xhtml></documentation></variable>
            <variable name="clsVer"><type><derived name="CLSID"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">版本化 Class ID（输出）</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">成功</xhtml></documentation></variable>
            <variable name="bCalc"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：工业控制器跨版本兼容：CX5020 升级 C++ Class lib 后，PLC 用版本化 ID 加载，新版数据不会被老 PLC 解读错位。
// 价值：替代手写 GUID 派生算法；标准库提供版本化 ID 计算，确保跨版本兼容性失败时立即报错而不是数据错位。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bCalc THEN
    bOk := F_GetClassIdVersioned(sLibraryId     := sLibId,
                                 clsId          := clsBase,
                                 clsIdVersioned := clsVer);
    bCalc := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
