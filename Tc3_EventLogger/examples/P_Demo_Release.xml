<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.Release Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Release" pouType="program">
        <interface>
          <localVars>
            <variable name="pfbAlarm">
              <type><pointer><baseType><derived name="FB_TcAlarm"/></baseType></pointer></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">动态分配的 alarm 实例指针（在本例外申请）</xhtml></documentation>
            </variable>
            <variable name="bReleaseReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 触发一次释放</xhtml></documentation>
            </variable>
            <variable name="bReleaseReqPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Release 返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：动态分配的临时报警实例在用完后释放
// 价值：防止 EventLogger 槽位泄露
// 验证：登录后写 bReleaseReq := TRUE，hr 应该是 S_OK；再次 Release 会得到错误码（槽位已释放）
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 假设 pfbAlarm 已通过 __NEW(FB_TcAlarm) 分配并 Create() 完成
IF bReleaseReq AND NOT bReleaseReqPrev AND pfbAlarm &amp;lt;&amp;gt; 0 THEN
    hr := pfbAlarm^.Release();
    // 释放后建议立即把指针清零或随后 __DELETE
END_IF;
bReleaseReqPrev := bReleaseReq;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
