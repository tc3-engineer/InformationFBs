<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.INSERT2 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_INSERT2" pouType="program">
        <interface>
          <localVars>
            <variable name="sMessage"><initialValue><simpleValue value="'Pump alarm'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：原始日志消息</xhtml></documentation></variable>
            <variable name="sTimestamp"><initialValue><simpleValue value="'[2026-05-12 08:00] '"/></initialValue><type><string><length>32</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">时间戳前缀</xhtml></documentation></variable>
            <variable name="sFullLog"><type><string><length>320</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拼接后完整日志</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">成功</xhtml></documentation></variable>
            <variable name="bPrefix"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：日志行加时间戳前缀：`INSERT2(src=msg, insert=ts+' ', pos=0)` 写到完整日志缓冲。
// 价值：替代 `LEFT` + `CONCAT2` + `MID` + `CONCAT2` 的 4 步链；本函数 1 行调用。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
// 把时间戳作为前缀插入消息开头（nPos = 0 = 头部）
IF bPrefix THEN
    bOk := INSERT2(pSrcString    := ADR(sMessage),
                   pInsertString := ADR(sTimestamp),
                   pDstString    := ADR(sFullLog),
                   nDstSize      := SIZEOF(sFullLog),
                   nPos          := 0);
    bPrefix := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
