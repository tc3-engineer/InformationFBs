<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_SetTimeZoneInformation Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_SetTimeZoneInformation" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_SetTimeZoneInformation">
              <type><derived name="FB_SetTimeZoneInformation"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_SetTimeZoneInformation 实例</xhtml></documentation>
            </variable>
            <variable name="bWrite">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTzToSet">
              <type><derived name="TIME_ZONE_INFORMATION"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：commissioning 时把所有机器时区统一改成 CST。
// 价值：替代手工进控制面板。
// 验证：先用 FB_GetTimeZoneInformation 读旧时区；触发写入新时区；再读应已切换。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_SetTimeZoneInformation(
    sNetID := '', bExecute := bWrite, tzInfo := stTzToSet, tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy =&gt; bBusy_, bErr =&gt; bErrFlag, nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
