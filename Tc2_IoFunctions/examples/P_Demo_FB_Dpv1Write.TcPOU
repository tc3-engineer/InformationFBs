<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_Dpv1Write" Id="{e72148b3-8752-5dd1-8bf9-e503c383c498}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_Dpv1Write
VAR
    fbDpv1Write          : FB_Dpv1Write; // SINAMICS DPV1 写 FB
    sProfibusMasterNetId : T_AmsNetId := ''; // 主站 NetId
    iSinamicsStation     : USINT := 5; // 站号
    iDriveObjectId       : USINT := 2; // drive A
    aDpv1ReqBuffer       : ARRAY[1..240] OF BYTE; // 请求缓冲
    aDpv1ResBuffer       : ARRAY[1..240] OF BYTE; // 响应缓冲
    iReqBufLen           : UDINT := 240; // 请求缓冲长度
    iResBufLen           : UDINT := 240; // 响应缓冲长度
    arrDpv1ReqParams     : ARRAY[1..39] OF ST_Dpv1ParamAddrEx; // 参数清单
    arrDpv1ValueHdr      : ARRAY[1..39] OF ST_Dpv1ValueHeaderEx; // 值清单（写）+ 状态（解析后）
    iNumParamsToWrite    : USINT := 2; // 参数数
    nWriteReqPkgLen      : USINT; // 请求长度
    nWriteResPkgLen      : USINT; // 响应长度
    bBuildWriteReqPkg    : BOOL := FALSE; // 触发：构造写请求
    bDpv1WriteReq        : BOOL := FALSE; // 触发：发送
    bSplitWriteResPkg    : BOOL := FALSE; // 触发：解析
    tDpv1WriteTimeout    : TIME := T#10S; // 超时
    bDpv1WriteBusy       : BOOL; // 工作中
    iDpv1WriteRequestRef : USINT; // 请求引用号
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：SINAMICS S120 上电下发 2 个驱动参数。
// 价值：参数纳入 PLC 版本控制；现场无需 Starter 软件。
// 验证：登录后准备好 arrDpv1ReqParams + arrDpv1ValueHdr；bBuildWriteReqPkg → 帧构造完；bDpv1WriteReq := TRUE → bDpv1WriteBusy 短暂 TRUE → 落回后 bSplitWriteResPkg → 解析 → arrDpv1ValueHdr[k].nError 全 0 表示成功。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 步骤 1：构造写请求帧
IF bBuildWriteReqPkg THEN
    nWriteReqPkgLen := F_CreateDpv1WriteReqPkg(
        pDpv1ReqData        := ADR(aDpv1ReqBuffer),
        iNumOfParams        := iNumParamsToWrite,
        iDriveId            := iDriveObjectId,
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bBuildWriteReqPkg := FALSE;
END_IF;

// 步骤 2：发送
fbDpv1Write(
    bExecute          := bDpv1WriteReq,
    aNetId            := sProfibusMasterNetId,
    iProfibusSlaveAdr := iSinamicsStation,
    iDriveId          := iDriveObjectId,
    pDpv1ReqData      := ADR(aDpv1ReqBuffer),
    iDpv1ReqDataLen   := iReqBufLen,
    pDpv1ResData      := ADR(aDpv1ResBuffer),
    iDpv1ResDataLen   := iResBufLen,
    tTmOut            := tDpv1WriteTimeout,
    iRequestRef       => iDpv1WriteRequestRef
);

bDpv1WriteBusy := fbDpv1Write.bBusy;

// 步骤 3：bBusy 落回后解析响应
IF bSplitWriteResPkg THEN
    nWriteResPkgLen := F_SplitDpv1WriteResPkg(
        pDpv1ResData        := ADR(aDpv1ResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitWriteResPkg := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
