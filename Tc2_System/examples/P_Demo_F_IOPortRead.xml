<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_IOPortRead Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_IOPortRead" pouType="program">
        <interface>
          <localVars>
            <variable name="nLptPortAddress">
              <initialValue><simpleValue value="16#378"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">LPT1 默认 I/O 端口地址</xhtml></documentation>
            </variable>
            <variable name="nPortValue">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读到的端口值</xhtml></documentation>
            </variable>
            <variable name="bReadRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次读取</xhtml></documentation>
            </variable>
            <variable name="rtRead">
              <type><derived name="R_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿检测</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读取 LPT 端口 0x378 的当前 8 位输入状态做硬件诊断（无 EtherCAT 终端时的应急通道）。
// 价值：替代写 Windows 驱动 inp/outp，PLC 一行调用直读硬件端口。
// 验证：bReadRequest := TRUE 一次 → 观察 nPortValue 反映 LPT 引脚状态；改变并口外部输入再触发 → nPortValue 改变。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 上升沿检测，避免每周期读耗 CPU
rtRead(CLK := bReadRequest);
IF rtRead.Q THEN
    nPortValue := F_IOPortRead(
        nAddr := nLptPortAddress,
        eSize := IOAS_BYTE
    );
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
