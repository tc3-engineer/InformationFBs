<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_FinishHoming" Id="{01513378-58c0-5ee7-93d7-8598519d147f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_FinishHoming
VAR
    fbFinishHoming : MC_FinishHoming;
    axisHoming     : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec         : R_TRIG; // 把保持型请求位整成单次上升沿
    bFinishReq     : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam    : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    homingOptions  : ST_Home_Options2; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bFinishDone    : BOOL;
    bBusy          : BOOL;
    bAborted       : BOOL;
    bError         : BOOL;
    nErrorID       : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：自定义归零序列的“正常收尾”——前面用 MC_StepLimitSwitch 搜到限位开关并 Done 后，
//       调用本 FB 把临时改过的 NC/驱动参数还原、轴状态切回 Standstill，并反向退 10 个
//       单位松开限位开关，避免轴一直压在开关上。
// 价值：不用本 FB 时要手写“还原参数 + 改状态 + 退离”三段逻辑，漏还原参数会让后续运动异常。
// 验证：先让 fbStep 那侧 Done；在线写 bFinishReq := TRUE，观察 bFinishDone 短暂 TRUE，
//       axisHoming.Status 离开 Homing 进入 Standstill，轴反向移动约 10 个单位后停。

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bFinishReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbFinishHoming(
    Execute        := rtExec.Q,
    Distance       := 10.0,
    Velocity       := 0,
    Acceleration   := 0,
    Deceleration   := 0,
    Jerk           := 0,
    BufferMode     := MC_Aborting,
    Options        := homingOptions,
    Done           => bFinishDone,
    Busy           => bBusy,
    CommandAborted => bAborted,
    Error          => bError,
    ErrorID        => nErrorID,
    Axis           := axisHoming,
    Parameter      := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bFinishReq AND NOT bBusy THEN
    bFinishDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
