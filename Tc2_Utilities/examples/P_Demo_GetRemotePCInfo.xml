  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GetRemotePCInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetRemotePCInfo">
              <type><derived name="GetRemotePCInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">GetRemotePCInfo 实例</xhtml></documentation>
            </variable>
            <variable name="NETID">
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="START">
              <type><BOOL/></type>
            </variable>
            <variable name="TMOUT">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="BUSY">
              <type><BOOL/></type>
            </variable>
            <variable name="ERR">
              <type><BOOL/></type>
            </variable>
            <variable name="ERRID">
              <type><UDINT/></type>
            </variable>
            <variable name="RemotePCInfo">
              <type><derived name="REMOTEPCINFOSTRUCT"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：远程盘点。
// 价值：一次完成。
// 验证：触发后 stInfo 多个字段装载。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbGetRemotePCInfo(
    NETID := NETID,
    START := START,
    TMOUT := TMOUT,
    BUSY =&gt; BUSY,
    ERR =&gt; ERR,
    ERRID =&gt; ERRID,
    RemotePCInfo =&gt; RemotePCInfo
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
