<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ADSREAD" Id="{1d43ca84-d2d3-5464-b1ce-8c58042af5c0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ADSREAD
VAR
    fbADSREAD       : ADSREAD; // ADSREAD 实例
    bReadAxisErrReq : BOOL; // 在线上升沿触发
    dwNcAxisError   : DWORD; // 读出的 NC 轴 1 错误码
    bAdsReading     : BOOL; // 正在读
    bAdsReadErr     : BOOL; // ADS 错误
    nLastAdsError   : UDINT; // ADS 错误码
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.ADSREAD 演示程序
// ============================================================
// 场景：周期读 NC 轴 1 错误码推到 HMI 做轴诊断。
// 价值：替代 PDO 映射；动态采样无需改硬件配置。
// 验证：登录后 bReadAxisErrReq := TRUE，bAdsReading 一闪后 dwNcAxisError 装入轴 1 当前错误（正常态 = 0）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

fbADSREAD(
    NETID := '', PORT := 501, IDXGRP := 16#00004006, IDXOFFS := 1, LEN := 4, DESTADDR := ADR(dwNcAxisError), READ := bReadAxisErrReq, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY => bAdsReading, ERR => bAdsReadErr, ERRID => nLastAdsError
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
