    <pous>
      <pou name="P_Demo_LARGE_TO_ULARGE" pouType="program">
        <interface>
          <localVars>
            <variable name="liSigned">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="uliUnsigned">
              <type><derived name="T_ULARGE_INTEGER"/></type>
            </variable>
            <variable name="bConvert">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.LARGE_TO_ULARGE 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把有符号编码器累计转角（可负）按位模式塞进只接受无符号的哈希函数。
// 价值：替代手动结构体字段拷贝。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    uliUnsigned := LARGE_TO_ULARGE(liSigned);   // 位模式不变
    bConvert := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
