<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_ALL_DATA_TYPES_SEND" Id="{4bc0dbe1-3072-555d-9b47-3657c04aef4f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_ALL_DATA_TYPES_SEND
VAR
    fbSendRaw      : EIB_ALL_DATA_TYPES_SEND;
    stEibRec       : EIB_REC;
    stGroup        : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 3, NUMBER := 1);
    bSendStart     : BOOL;
    iWorkMode      : INT := 1;        // Polling
    tCycle         : TIME := T#1S;
    tMinSend       : TIME := T#500MS;
    arrPayload     : ARRAY[1..14] OF BYTE := [16#01, 16#02, 16#03, 16#04, 16#05, 16#06, 0,0,0,0,0,0,0,0];
    usLen          : USINT := 7;     // 6 byte payload → len = 7
    ePrio          : EIB_PRIORITY := EIB_PRIORITY_LOW;
    bIsReadAnswer  : BOOL := FALSE;
    bSendBusy      : BOOL;
    bSendError     : BOOL;
    iLastErrID     : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_ALL_DATA_TYPES_SEND 演示程序
// ============================================================
// 场景：非标 KNX 设备发 6 byte 自定义负载到组 1/3/1。本 demo 用 EIB_ALL_DATA_TYPES_SEND 按 Polling 模式定时下发。
// 价值：唯一支持任意长度负载 + 优先级 + read 响应的发送 FB
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：登录 `bStart := TRUE`、`iMode := 1`、`CyclePolling := T#1S` → 每秒看到组 1/3/1 出 6 byte 帧。
// ============================================================

fbSendRaw(
    bStart        := bSendStart,
    iMode         := iWorkMode,
    CyclePolling  := tCycle,
    DATA          := arrPayload,
    EIB_Data_Len  := usLen,
    PRIORITY      := ePrio,
    MinSendTime   := tMinSend,
    Group_Address := stGroup,
    str_Rec       := stEibRec,
    bReadCommand  := bIsReadAnswer,
    bBusy         => bSendBusy,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
