<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_GetDayOfWeek Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetDayOfWeek" pouType="program">
        <interface>
          <localVars>
            <variable name="dtNow">
              <type><DATE_AND_TIME/></type>
              <initialValue><simpleValue value="DT#2026-05-11-12:00:00"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查询的日期</xhtml></documentation>
            </variable>
            <variable name="wDayOfWeek">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">1=Monday ... 7=Sunday</xhtml></documentation>
            </variable>
            <variable name="bIsWeekend">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE 表示周六/周日</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：排班逻辑「周末跳过维护」需要知道当前 DT 是周几
//
// 价值：1 行调用拿到 1=周一 ... 7=周日（ISO 约定），无需手写 Zeller 公式
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE 一个周期
//   4. 在线观察 wDayOfWeek 应为 1（2026-05-11 是周一）
//   5. bIsWeekend 应为 FALSE
//   6. 改 dtNow 到周六 / 周日重测
// =============================================================================
wDayOfWeek := F_GetDayOfWeek(dtNow);
bIsWeekend := (wDayOfWeek = 6) OR (wDayOfWeek = 7);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
