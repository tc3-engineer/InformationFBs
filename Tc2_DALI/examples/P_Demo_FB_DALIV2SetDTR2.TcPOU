<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2SetDTR2" Id="{afd5e5dd-d24f-51b0-89fb-1850c6c42e18}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2SetDTR2
VAR
    fbFB_DALIV2SetDTR2        : FB_DALIV2SetDTR2;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    nLampAddr        : BYTE := 0;

    nDTR2Value       : BYTE := 25;

    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：底层写 DTR2。
//
// 价值：底层操作。
//
// 验证步骤：
//   1. 通信 FB 跑起；编译；登录。
//   2. 在线 bTrigger 一次上升沿；等 bBusy 回 FALSE。
//   3. 用 P_Demo_FB_DALIV2QueryContentDTR2 → 应读出 25。
// =============================================================================
fbFB_DALIV2SetDTR2(
    bStart           := bTrigger,
    nAddr            := nLampAddr,
    eAddrType        := eDALIV2AddrTypeShort,
    eCommandPriority := eDALIV2CommandPriorityMiddle,
    nValue           := nDTR2Value,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2SetDTR2.bBusy;
bErr   := fbFB_DALIV2SetDTR2.bError;
nErrId := fbFB_DALIV2SetDTR2.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
