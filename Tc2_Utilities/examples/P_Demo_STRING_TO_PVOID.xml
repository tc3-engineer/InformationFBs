  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_STRING_TO_PVOID" pouType="program">
        <interface>
          <localVars>
            <variable name="sAddrLit"><initialValue><simpleValue value="'16#80001000'"/></initialValue><type><string><length>32</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：硬编码内存地址（hex）</xhtml></documentation></variable>
            <variable name="pTarget"><type><pointer><baseType><BYTE/></baseType></pointer></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">解析后的指针</xhtml></documentation></variable>
            <variable name="bParse"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：从配置文件读出 `'16#80000000'` 格式的内存基址字符串 → 转 PVOID 作为某硬件寄存器映射地址。
// 价值：替代手写多进制解析；本函数自动按前缀适应。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bParse THEN
    pTarget := STRING_TO_PVOID(in := sAddrLit);
    bParse := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
