<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Int64Div64Ex" Id="{8dcee65c-1608-59cb-b74e-44c9fbb85ea0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Int64Div64Ex
VAR
    liDividend  : T_LARGE_INTEGER;
    liDivisor   : T_LARGE_INTEGER;
    liQuotient  : T_LARGE_INTEGER;
    liRemainder : T_LARGE_INTEGER;
    bDivide     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.Int64Div64Ex 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：有符号 64 位测量值除以单位换算因子，同时记录余数做下次周期补偿。
// 价值：替代手写有符号除法 + 余数符号处理；一次调用搞定。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bDivide AND NOT Int64IsZero(liDivisor) THEN
    // 除 0 与 −2⁶³÷−1 边界 PDF 未定义 → 前置校验
    liQuotient := Int64Div64Ex(liDividend, liDivisor, liRemainder);
    bDivide := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
