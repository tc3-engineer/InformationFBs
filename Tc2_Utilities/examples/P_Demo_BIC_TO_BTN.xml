  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_BIC_TO_BTN" pouType="program">
        <interface>
          <localVars>
            <variable name="sBicRaw"><initialValue><simpleValue value="1P193995SBTN0002agdw1KEL7411 Q1 2P112104020018"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模拟从 FB_EcCoEReadBIC 读出的 BIC 原始串</xhtml></documentation></variable>
            <variable name="sBtn"><type><string><length>9</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">提取出的 BTN，预期 '0002agdw'</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：产线 MES 追溯——记录每个 EtherCAT 从站的 BTN 出厂追溯号。
//       生产时调用 FB_EcCoEReadBIC 读到 BIC 字符串，本 FC 提取 BTN 写入数据库。
// 价值：替代手写 FIND + MID + RTrim 三步处理，一行解决，长度常量内置。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线 monitor sBtn -&gt; '0002agdw'
//   4. 改 sBicRaw 为不含 'SBTN' 的字符串 -&gt; sBtn 应为空串 ''
// =============================================================================

sBtn := BIC_TO_BTN(sBicRaw);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
