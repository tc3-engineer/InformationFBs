  <contentHeader name="Tc3_EventLogger.Create Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TcMessage_Create" pouType="program">
        <interface>
          <localVars>
            <variable name="fbMessage">
              <type><derived name="FB_TcMessage"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">配方切换消息实例</xhtml></documentation>
            </variable>
            <variable name="bCreated">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Create latch</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
            <variable name="guidEventClass">
              <type><derived name="GUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件类 GUID</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：MES 集成：注册「配方切换」消息事件
// 价值：一次 Create 拿到 message 槽位；后续 Send 直接复用，无需重新指定事件元数据
// 验证：登录后单步：第一周期 hr = S_OK 且 bCreated 变 TRUE；之后周期被 latch 截住不再调
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF NOT bCreated THEN
    hr := fbMessage.Create(
        eventClass := guidEventClass,
        nEventId := 2001,                  // 配方切换事件 ID
        eSeverity := TcEventSeverity.Info,
        ipSourceInfo := 0);
    bCreated := SUCCEEDED(hr);
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
