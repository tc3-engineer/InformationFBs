<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.SYSTEMTIME_TO_TOD Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_SYSTEMTIME_TO_TOD" pouType="program">
        <interface>
          <localVars>
            <variable name="stNow">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前时间 (初始化通过在线手动赋值; 推荐字段：( wYear := 2026, wMonth := 5, wDay := 11, wHour := 8, wMinute := 0, wSecond := 0, wMilliseconds := 0 ))</xhtml></documentation>
            </variable>
            <variable name="todNow">
              <type><TIME_OF_DAY/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后的一天内时刻</xhtml></documentation>
            </variable>
            <variable name="todAutoStart">
              <type><TIME_OF_DAY/></type>
              <initialValue><simpleValue value="TOD#08:00:00.000"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">自动启动阈值</xhtml></documentation>
            </variable>
            <variable name="bTriggerAutoStart">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 该启动了</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：「工作日早 8 点自动启动设备」逻辑：取当前 TIMESTRUCT → TOD → 比较 TOD#08:00
//
// 价值：1 行转 TOD，避免手写权重 3600000/60000/1000 相乘相加
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.7.3.0）
//   2. 编译 + 登录 + 运行
//   3. 在线观察 todNow = TOD#08:00:00.000
//   4. bTriggerAutoStart = TRUE
// =============================================================================
todNow := SYSTEMTIME_TO_TOD(stNow);
bTriggerAutoStart := todNow &gt;= todAutoStart;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
