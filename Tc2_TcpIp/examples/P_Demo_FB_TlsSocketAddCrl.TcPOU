<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_TlsSocketAddCrl" Id="{422fd7b0-28e0-53e6-a0c6-ec04fd0e1d8b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_TlsSocketAddCrl
VAR
    fbCreateClient : FB_TlsSocketCreate;
    fbAddCorpCa    : FB_TlsSocketAddCa;
    fbAddCrl       : FB_TlsSocketAddCrl;
    hSocket        : T_HSOCKET;
    bRequestCreate : BOOL;
    bCreateBusy    : BOOL;
    bCreateError   : BOOL;
    nCreateErrId   : UDINT;
    sCaPath        : STRING(255) := 'C:\TwinCAT\3.1\Boot\Plc\TcpIpServer\corp_ca.pem';
    bRequestCa     : BOOL;
    bCaBusy        : BOOL;
    bCaError       : BOOL;
    nCaErrId       : UDINT;
    sCrlPath       : STRING(255) := 'C:\TwinCAT\3.1\Boot\Plc\TcpIpServer\corp_ca.crl.pem';
    bRequestCrl    : BOOL;
    bCrlBusy       : BOOL;
    bCrlError      : BOOL;
    nCrlErrId      : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：能源行业 PLC 出工厂网连远程监控中心，要满足 IEC 62443，TLS 必须含
//       吊销校验。运维定期把企业 CA 最新 CRL 推送到 PLC 文件系统，PLC 启动
//       时按 Create → AddCa → AddCrl → Connect 顺序加载。
//
// 价值：演示完整 PKI 校验链装载：AddCa 提供签发链信任，AddCrl 提供吊销跟进。
//       缺 CRL 则被吊销的证书仍能通过校验，违反 IEC 62443 / ISA-99 等标准。
//
// 验证步骤：
//   1. 在线 bRequestCreate := TRUE
//   2. 在线 bRequestCa := TRUE → bCaError=FALSE
//   3. 在线 bRequestCrl := TRUE → bCrlError=FALSE
//   4. 故意把 CRL 文件改成损坏内容 → nCrlErrId=0x0000808C (TLS_CRL_INVALID)
//   5. AddCrl 必须在 Connect 之前调；Connect 之后调会报 TLS_INVALID_STATE
// =============================================================================

fbCreateClient(
    sSrvNetId := '', bListener := FALSE,
    bExecute := bRequestCreate, tTimeout := T#5S,
    bBusy => bCreateBusy, bError => bCreateError, nErrId => nCreateErrId,
    hSocket => hSocket);

// AddCa 在前（AddCrl 验签需要 CA 公钥）
fbAddCorpCa(
    sSrvNetId := '', hSocket := hSocket,
    sCaPath := sCaPath,
    bExecute := bRequestCa, tTimeout := T#5S,
    bBusy => bCaBusy, bError => bCaError, nErrId => nCaErrId);

// AddCrl 在后
fbAddCrl(
    sSrvNetId := '', hSocket := hSocket,
    sCrlPath := sCrlPath,
    bExecute := bRequestCrl, tTimeout := T#5S,
    bBusy => bCrlBusy, bError => bCrlError, nErrId => nCrlErrId);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
