<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_Dpv1Read Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_Dpv1Read" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDpv1Read">
              <type><derived name="FB_Dpv1Read"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SINAMICS DPV1 读 FB</xhtml></documentation>
            </variable>
            <variable name="sProfibusMasterNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profibus 主站 AMS Net ID</xhtml></documentation>
            </variable>
            <variable name="iSinamicsStation">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SINAMICS Profibus 站号</xhtml></documentation>
            </variable>
            <variable name="iDriveObjectId">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive A</xhtml></documentation>
            </variable>
            <variable name="aDpv1ReqBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求缓冲</xhtml></documentation>
            </variable>
            <variable name="aDpv1ResBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应缓冲</xhtml></documentation>
            </variable>
            <variable name="iReqBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求缓冲最大长度</xhtml></documentation>
            </variable>
            <variable name="iResBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应缓冲最大长度</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数清单</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ValueHdr">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ValueHeaderEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">解析输出</xhtml></documentation>
            </variable>
            <variable name="iNumParamsToRead">
              <initialValue><simpleValue value="3"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读 3 个参数</xhtml></documentation>
            </variable>
            <variable name="nReqPkgLen">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求帧长度</xhtml></documentation>
            </variable>
            <variable name="nReadResPkgLen">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应帧长度</xhtml></documentation>
            </variable>
            <variable name="bBuildReqPkg">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：构造请求</xhtml></documentation>
            </variable>
            <variable name="bDpv1ReadReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：发送</xhtml></documentation>
            </variable>
            <variable name="bSplitReadResPkg">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：解析</xhtml></documentation>
            </variable>
            <variable name="tDpv1ReadTimeout">
              <initialValue><simpleValue value="T#10S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 超时</xhtml></documentation>
            </variable>
            <variable name="bDpv1ReadBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="iDpv1ReadRequestRef">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求引用号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：SINAMICS S120 周期读 3 个参数：先 F_CreateDpv1ReadReqPkg 准备帧 → bExecute 触发 FB_Dpv1Read → bBusy 落回后 F_SplitDpv1ReadResPkg 解析。
// 价值：完整异步流程封装。
// 验证：登录后 sProfibusMasterNetId 设为 FC310x 主卡 NetId，iSinamicsStation := 5；先 bBuildReqPkg 触发 F_CreateDpv1ReadReqPkg → nReqPkgLen &gt; 0；再 bDpv1ReadReq := TRUE → bDpv1ReadBusy 短暂 TRUE → 落回后 bSplitReadResPkg := TRUE 解析 → arrDpv1ValueHdr 含读到的参数值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 步骤 1：构造 DPV1 读请求帧
IF bBuildReqPkg THEN
    nReqPkgLen := F_CreateDpv1ReadReqPkg(
        pDpv1ReqData    := ADR(aDpv1ReqBuffer),
        iNumOfParams    := iNumParamsToRead,
        iDriveId        := iDriveObjectId,
        stDpv1Parameter := arrDpv1ReqParams
    );
    bBuildReqPkg := FALSE;
END_IF;

// 步骤 2：bDpv1ReadReq 上升沿发出请求（请求帧必须先构造好）
fbDpv1Read(
    bExecute          := bDpv1ReadReq,
    aNetId            := sProfibusMasterNetId,
    iProfibusSlaveAdr := iSinamicsStation,
    iDriveId          := iDriveObjectId,
    pDpv1ReqData      := ADR(aDpv1ReqBuffer),
    iDpv1ReqDataLen   := iReqBufLen,
    pDpv1ResData      := ADR(aDpv1ResBuffer),
    iDpv1ResDataLen   := iResBufLen,
    tTmOut            := tDpv1ReadTimeout,
    iRequestRef       =&gt; iDpv1ReadRequestRef
);

// 跟踪 bBusy 用 R_TRIG 等监测下降沿
bDpv1ReadBusy := fbDpv1Read.bBusy;

// 步骤 3：bBusy 落回后解析响应（业务侧做下降沿监测后置 bSplitReadResPkg）
IF bSplitReadResPkg THEN
    nReadResPkgLen := F_SplitDpv1ReadResPkg(
        pDpv1ResData        := ADR(aDpv1ResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitReadResPkg := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
