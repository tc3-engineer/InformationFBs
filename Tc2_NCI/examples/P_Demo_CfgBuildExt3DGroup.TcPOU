<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_CfgBuildExt3DGroup" Id="{182c8263-478d-5974-9b89-a5a1769efc16}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_CfgBuildExt3DGroup
VAR
    fbCfgBuildExt3DGroup                  : CfgBuildExt3DGroup;  // 被演示 FB 实例
    rtTrig                                : R_TRIG;  // 边沿触发器，把人工『按一下』转上升沿
    bDoIt                                 : BOOL := FALSE;  // 在线写 TRUE 触发一次
    nGroupId_in                           : UDINT := 0;
    nXAxisId_in                           : UDINT := 0;
    nYAxisId_in                           : UDINT := 0;
    nZAxisId_in                           : UDINT := 0;
    nQ1AxisId_in                          : UDINT := 0;
    nQ2AxisId_in                          : UDINT := 0;
    nQ3AxisId_in                          : UDINT := 0;
    nQ4AxisId_in                          : UDINT := 0;
    nQ5AxisId_in                          : UDINT := 0;
    tTimeOut_in                           : TIME := T#2S;  // ADS 调用超时
    bBusy_out                             : BOOL;
    bErr_out                              : BOOL;
    nErrId_out                            : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_NCI.CfgBuildExt3DGroup 演示程序
// ============================================================
// 场景：定制 CNC 机床开机自检：PLC 在 System Manager 之外动态创建 NCI 3D 插补组，把 X/Y/Z 三根 PTP 轴组合起来。
// 价值：免去『改 XAE 配置 → 下载 → 重启 NC』流程，组配置在 PLC 里即时生效。
// 验证：在线写 bDoIt := TRUE 触发一次，观察 fbXxx.bBusy → TRUE → FALSE，bErr 应为 FALSE。若 bErr = TRUE，nErrId 给 NC 错误码（典型：组已存在、AxisId 不存在）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_NCI（References → Add library）
//   3. 在 System Manager 把 NCI 通道接口 Link 给 sNciToPlc_inst / sPlcToNci_inst
//      （NCTOPLC_NCICHANNEL_REF 给 AT %I*、PLCTONC_NCICHANNEL_REF 给 AT %Q*）
//   4. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 把人工按下的电平转成真正的上升沿；这是 bExecute 系列引脚的标准用法
rtTrig(CLK := bDoIt);

// 单次完整调用：所有 VAR_INPUT / VAR_IN_OUT / VAR_OUTPUT 引脚显式赋值或绑定
fbCfgBuildExt3DGroup(
    bExecute  := rtTrig.Q,
    nGroupId  := nGroupId_in,
    nXAxisId  := nXAxisId_in,
    nYAxisId  := nYAxisId_in,
    nZAxisId  := nZAxisId_in,
    nQ1AxisId := nQ1AxisId_in,
    nQ2AxisId := nQ2AxisId_in,
    nQ3AxisId := nQ3AxisId_in,
    nQ4AxisId := nQ4AxisId_in,
    nQ5AxisId := nQ5AxisId_in,
    tTimeOut  := tTimeOut_in,
    bBusy     => bBusy_out,
    bErr      => bErr_out,
    nErrId    => nErrId_out
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
