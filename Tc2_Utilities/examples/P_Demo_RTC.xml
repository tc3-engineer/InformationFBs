<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.RTC Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_RTC" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRTC">
              <type><derived name="RTC"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RTC 实例</xhtml></documentation>
            </variable>
            <variable name="bEnable">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿装载起点；电平保持推进</xhtml></documentation>
            </variable>
            <variable name="dtStart">
              <initialValue><simpleValue value="DT#2026-01-01-00:00:00"/></initialValue>
              <type><DT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">起始时间</xhtml></documentation>
            </variable>
            <variable name="dtActual">
              <type><DT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前 RTC 输出</xhtml></documentation>
            </variable>
            <variable name="bDst">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">夏令时（基础版恒 FALSE）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：设备出厂硬编码起点 DT#2026-01-01-00:00:00，使能后内部自走作为粗略时间戳源。
// 价值：替代自写 TON + DT_ADD。
// 验证：在线写 bEnable := TRUE，观察 dtActual 每秒 +1；改 bEnable := FALSE 停推进；再 TRUE 会重新跳回 dtStart。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbRTC(EN := bEnable, PDT := dtStart, ACT_TIME =&gt; dtActual, CDT =&gt; bDst);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
