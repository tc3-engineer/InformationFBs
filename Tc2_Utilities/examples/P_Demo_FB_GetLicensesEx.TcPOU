<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_GetLicensesEx" Id="{0add7d06-1d6c-5d5b-8763-8565059c10db}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_GetLicensesEx
VAR
    fbFB_GetLicensesEx : FB_GetLicensesEx; // FB_GetLicensesEx 实例
    bExec              : BOOL := FALSE;
    bBusy_             : BOOL;
    bErrFlag           : BOOL;
    nErrCode           : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：合规审计。
// 价值：更详细元数据。
// 验证：触发后观察 bDone / bErr，错误号 nErrId 反映 ADS Return Codes。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetLicensesEx(
    bExecute := bExec, tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy => bBusy_, bError => bErrFlag, nErrorId => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
