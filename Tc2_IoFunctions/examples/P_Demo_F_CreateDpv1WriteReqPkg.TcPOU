<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_CreateDpv1WriteReqPkg" Id="{99545ea7-13d9-58eb-92ea-8b8f18773e0d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_CreateDpv1WriteReqPkg
VAR
    aDpv1WriteReqBuffer : ARRAY[1..240] OF BYTE; // DPV1 写请求帧 240 字节
    arrDpv1ReqParams    : ARRAY[1..39] OF ST_Dpv1ParamAddrEx; // 参数清单
    arrDpv1ValueHdr     : ARRAY[1..39] OF ST_Dpv1ValueHeaderEx; // 要写入的值清单
    iNumParamsToWrite   : USINT := 2; // 参数数
    iDriveObjectId      : USINT := 2; // drive A
    bBuildWriteReqPkg   : BOOL := FALSE; // 触发：构造写请求帧
    nWriteReqPkgLen     : USINT; // 生成的帧长度
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：SINAMICS S120 上电写驱动参数：一次写入 2 个参数（速度限值 + 加速度）到 drive A。
// 价值：封装 DPV1 写帧编码与字节序转换。
// 验证：填好 arrDpv1ReqParams[1..2] + arrDpv1ValueHdr[1..2]，写 bBuildWriteReqPkg := TRUE → 一周期后 nWriteReqPkgLen > 0 表示帧已构造。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bBuildWriteReqPkg THEN
    nWriteReqPkgLen := F_CreateDpv1WriteReqPkg(
        pDpv1ReqData        := ADR(aDpv1WriteReqBuffer),
        iNumOfParams        := iNumParamsToWrite,
        iDriveId            := iDriveObjectId,
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bBuildWriteReqPkg := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
