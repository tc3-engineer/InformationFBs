<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.RequestEventClassName Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_RequestEventClassName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">alarm 实例（已 Create）</xhtml></documentation>
            </variable>
            <variable name="fbAsync">
              <type><derived name="FB_AsyncStrResult"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">异步结果句柄</xhtml></documentation>
            </variable>
            <variable name="nLangId">
              <initialValue><simpleValue value="2052"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">简体中文 LCID</xhtml></documentation>
            </variable>
            <variable name="bReqClassName">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发请求</xhtml></documentation>
            </variable>
            <variable name="bReqClassNamePrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="sClassName">
              <type><string><length>80</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拿到的事件类名</xhtml></documentation>
            </variable>
            <variable name="bDone">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完成状态</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 异步取报警的事件类名做本地化显示
// 价值：非阻塞获取多语言文本
// 验证：登录后写 bReqClassName := TRUE，下一周期 fbAsync.IsCompleted() 应在几周期内变 TRUE，sClassName 拿到字符串
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 边沿触发：发起一次异步请求
IF bReqClassName AND NOT bReqClassNamePrev THEN
    hr := fbAlarm.RequestEventClassName(
        nLangId := nLangId,
        fbAsyncResult := fbAsync);
END_IF;
bReqClassNamePrev := bReqClassName;

// 每周期检查异步是否完成
bDone := fbAsync.IsCompleted();
IF bDone THEN
    fbAsync.GetResult(sValue := sClassName);
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
