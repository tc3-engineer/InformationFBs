<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_YearIsLeapYear Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_YearIsLeapYear" pouType="program">
        <interface>
          <localVars>
            <variable name="wYear">
              <type><WORD/></type>
              <initialValue><simpleValue value="2024"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要判断的年份</xhtml></documentation>
            </variable>
            <variable name="bIsLeapYear">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 闰年</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 让用户输入日期时需校验 2 月 29 日是否合法
//
// 价值：1 行调用避免手写 100/400 三段判定，最容易漏的是「能被 100 整除但不被 400 整除非闰年」
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 bIsLeapYear = TRUE（2024 是闰年）
//   5. wYear:=1900 → FALSE（100 整除但 400 不整除）
//   6. wYear:=2000 → TRUE（400 整除）
// =============================================================================
bIsLeapYear := F_YearIsLeapYear(wYear);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
