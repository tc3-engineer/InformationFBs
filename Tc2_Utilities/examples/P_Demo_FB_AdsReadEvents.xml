<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_AdsReadEvents Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AdsReadEvents" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAdsReadEvents">
              <type><derived name="FB_AdsReadEvents"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB 实例（已弃用；新代码用 Tc3_EventLogger）</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <type><derived name="T_AMSNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">空串 = 本机</xhtml></documentation>
            </variable>
            <variable name="bEnableEventQuery">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线 TRUE 启动周期查询</xhtml></documentation>
            </variable>
            <variable name="nLanguageId">
              <type><DWORD/></type>
              <initialValue><simpleValue value="1033"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">语言 ID（1033 = en_US）</xhtml></documentation>
            </variable>
            <variable name="eTimeFormat">
              <type><derived name="E_DateAndTimeFormat"/></type>
              <initialValue><simpleValue value="E_DateAndTimeFormat.en_US"/></initialValue>
            </variable>
            <variable name="tRefreshPeriod">
              <type><TIME/></type>
              <initialValue><simpleValue value="T#1S"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查询周期，建议 ≥ 500ms</xhtml></documentation>
            </variable>
            <variable name="tAdsTimeout">
              <type><TIME/></type>
              <initialValue><simpleValue value="T#5S"/></initialValue>
            </variable>
            <variable name="aActiveEvents">
              <type><array><dimension lower="1" upper="80"/><baseType><derived name="ST_ReadEvent"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">活动消息数组，最多 80 条</xhtml></documentation>
            </variable>
            <variable name="nReportedEvents">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际活动消息条数</xhtml></documentation>
            </variable>
            <variable name="bQueryBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bQueryDone">
              <type><BOOL/></type>
            </variable>
            <variable name="bQueryError">
              <type><BOOL/></type>
            </variable>
            <variable name="nQueryErrorId">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.FB_AdsReadEvents 演示程序（已弃用 FB）
// ============================================================
// 场景：维护一个 TwinCAT 3.1 Build 4022 的旧产线，HMI 用一个 Event Table
//       控件显示当前活动报警。本 FB 是把控制器 EventLogger 里的活动消息
//       拉到 PLC 端的标准接口——尽管已弃用，旧工程仍要继续维护。
// 价值：保留旧工程的事件展示功能。如果是新工程，请改用 Tc3_EventLogger
//       的 FB_TcAlarm + FB_TcEventLogger 订阅机制。
// 验证：
//   1. 引用 Tc2_Utilities，编译 + 登录
//   2. 在线写 bEnableEventQuery := TRUE 启动周期查询
//   3. 观察 bQueryBusy 周期翻 TRUE/FALSE；bQueryDone 在首次完成后保持 TRUE
//   4. 触发一个测试报警（用旧版 ADSLOG 调用） → nReportedEvents 在 1-2 个
//      tRefreshPeriod 内 +1
//   5. 撤销 bEnableEventQuery → bQueryError / nQueryErrorId 复位为 0（PDF
//      明确：下降沿复位错误）
// ============================================================

fbAdsReadEvents(
    sNetId             := sLocalNetId,
    bReadEvents        := bEnableEventQuery,
    nLanguageId        := nLanguageId,
    eDateAndTimeFormat := eTimeFormat,
    tRefreshTime       := tRefreshPeriod,
    tTimeout           := tAdsTimeout,
    aEvents            => aActiveEvents,
    nNumberOfEvents    => nReportedEvents,
    bBusy              => bQueryBusy,
    bDone              => bQueryDone,
    bError             => bQueryError,
    nErrorId           => nQueryErrorId
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
