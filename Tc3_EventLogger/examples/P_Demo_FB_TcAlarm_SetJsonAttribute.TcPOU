<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_TcAlarm_SetJsonAttribute" Id="{ce7ffb5f-dfbb-5ef9-a6cf-0d99c1b9ad90}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_TcAlarm_SetJsonAttribute
VAR
    fbAlarm        : FB_TcAlarm; // alarm 实例（应已 Create 完成）
    bSetAttr       : BOOL := FALSE; // 上升沿触发设置属性
    bSetAttrPrev   : BOOL; // 边沿检测
    sBatchId       : STRING(64) := 'B-2026-0511-001'; // 批次号
    sJsonAttribute : STRING(255); // 拼接好的完整 JSON
    hr             : HRESULT; // 返回值监视
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：包装机 alarm 附加批次追溯信息（batch id + 操作员）
// 价值：一句 SetJsonAttribute 把工艺上下文绑到 alarm 上，MES 拉取时一并到位
// 验证：登录后写 bSetAttr := TRUE 触发一次设置；EventLogger 的事件详情面板（或 ADS 工具查事件）应能看到 JSON 字段；改写 sBatchId := 'B-002' 后再次触发会覆盖前一次
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 拼接完整 JSON（包含批次号 + 操作员）。注意 STRING 容量要够装下整段 JSON。
sJsonAttribute := CONCAT('{"batch":"',
                        CONCAT(sBatchId,
                        CONCAT('","operator":"', '"WangWu"}')));

// 边沿触发：在 Raise 之前调一次 SetJsonAttribute；该 JSON 会随后续 Raise/Clear/Confirm 一起广播
IF bSetAttr AND NOT bSetAttrPrev THEN
    hr := fbAlarm.SetJsonAttribute(sJsonAttribute := sJsonAttribute);
END_IF;
bSetAttrPrev := bSetAttr;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
