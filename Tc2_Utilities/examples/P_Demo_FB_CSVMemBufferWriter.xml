  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_CSVMemBufferWriter" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_CSVMemBufferWriter">
              <type><derived name="FB_CSVMemBufferWriter"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_CSVMemBufferWriter 实例</xhtml></documentation>
            </variable>
            <variable name="eCmd">
              <initialValue><simpleValue value="eEnumCmd_First"/></initialValue>
              <type><derived name="E_EnumCmdType"/></type>
            </variable>
            <variable name="putValue">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="pValue">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbValue">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
            </variable>
            <variable name="bCRLF">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="pBuffer">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbBuffer">
              <type><UDINT/></type>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
            </variable>
            <variable name="cbSize">
              <type><UDINT/></type>
            </variable>
            <variable name="cbFree">
              <type><UDINT/></type>
            </variable>
            <variable name="nFields">
              <type><UDINT/></type>
            </variable>
            <variable name="nRecords">
              <type><UDINT/></type>
            </variable>
            <variable name="cbWrite">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：生成日报 CSV。
// 价值：自动处理转义。
// 验证：按 WriteField 顺序追加多列，最后 WriteNewLine 换行。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_CSVMemBufferWriter(
    eCmd := eCmd,
    putValue := putValue,
    pValue := pValue,
    cbValue := cbValue,
    bCRLF := bCRLF,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk =&gt; bOk,
    cbSize =&gt; cbSize,
    cbFree =&gt; cbFree,
    nFields =&gt; nFields,
    nRecords =&gt; nRecords,
    cbWrite =&gt; cbWrite
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
