<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_8BIT_SIGN_SEND" Id="{dd8b5bc5-07d5-541a-a964-e00e28b5ba79}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_8BIT_SIGN_SEND
VAR
    fbSendBri   : EIB_8BIT_SIGN_SEND;
    stEibRec    : EIB_REC;
    stGroup     : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 2, NUMBER := 20);
    iBrightnessPct : INT := 50;
    iScaleMode  : INT := 0;       // 0 = 0..100%
    bSendError  : BOOL;
    iLastErrID  : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_8BIT_SIGN_SEND 演示程序
// ============================================================
// 场景：调光器把当前亮度（百分比）经组地址 1/2/20 推送到 BMS。
// 价值：替代手写 byte 缩放 + 变化检测；DPT 5 标准发送
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：改 `iBrightnessPct := 50` → 总线出 raw 128 (0x80)；改 `iBrightnessPct := 100` → 出 raw 255 (0xFF)。
// ============================================================

fbSendBri(
    Group_Address := stGroup,
    iData         := iBrightnessPct,
    Scaling_Mode  := iScaleMode,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
