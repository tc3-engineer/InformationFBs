  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.TcEventEntry_TO_HRESULTAdsErr Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_TcEventEntry_TO_HRESULTAdsErr" pouType="program">
        <interface>
          <localVars>
            <variable name="stEventEntry">
              <type><derived name="TcEventEntry"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要转换的事件定义</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="E_HRESULTAdsErr"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">反向输出 HRESULT</xhtml></documentation>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">成功标志</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：TcEventEntry → HRESULT ADS 错误反向转换
// 价值：HRESULT 体系兼容
// 验证：登录后给输入赋已知合法值；调用本 FC 后 bOk 应为 TRUE 且输出已填
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

bOk := TcEventEntry_TO_HRESULTAdsErr(
    stEventEntry := stEventEntry,
    hr := hr);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
