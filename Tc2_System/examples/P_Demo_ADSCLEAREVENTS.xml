<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.ADSCLEAREVENTS Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ADSCLEAREVENTS" pouType="program">
        <interface>
          <localVars>
            <variable name="fbADSCLEAREVENTS">
              <type><derived name="ADSCLEAREVENTS"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADSCLEAREVENTS 实例</xhtml></documentation>
            </variable>
            <variable name="bClearEventsReq">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发清除</xhtml></documentation>
            </variable>
            <variable name="nClearMode">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">清除模式（来自 E_TcEventClearModes）</xhtml></documentation>
            </variable>
            <variable name="bClearing">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">正在清</xhtml></documentation>
            </variable>
            <variable name="bClearErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">清错误</xhtml></documentation>
            </variable>
            <variable name="nLastAdsError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误码</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.ADSCLEAREVENTS 演示程序
// ============================================================
// 场景：每日维护把 EventLogger 清空准备新一轮告警监控。
// 价值：替代逐条 ADSWRITE，单调用按模式批清。
// 验证：先用 ADSLOGEVENT 推几个事件，再写 bClearEventsReq := TRUE；System Manager 报警面板里的事件应在 1 秒内消失。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

fbADSCLEAREVENTS(
    NETID := '', bClear := bClearEventsReq, iMode := nClearMode, tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy =&gt; bClearing, bErr =&gt; bClearErr, iErrId =&gt; nLastAdsError
);

</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
