<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_LcomplexIsNaN" Id="{1a83ba68-4995-5694-9c1c-4ab4fce1cd46}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_LcomplexIsNaN
VAR
    lcCurrent : LCOMPLEX;; // d-q 反变换电流
    bHasNaN   : BOOL;
    bCheck    : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.LcomplexIsNaN 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：矢量控制 d-q 反变换后，电流复数若含 NaN 必须切回上一周期值以保险。
// 价值：替代手写 `LrealIsNaN(Z.re) OR LrealIsNaN(Z.im)`；一次调用语义清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bHasNaN := LcomplexIsNaN(lcCurrent);
    bCheck := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
