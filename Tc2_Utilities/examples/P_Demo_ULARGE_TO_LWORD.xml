    <pous>
      <pou name="P_Demo_ULARGE_TO_LWORD" pouType="program">
        <interface>
          <localVars>
            <variable name="rResult">
              <type><LWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ULARGE_TO_LWORD 返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
            <variable name="tu">
              <type><derived name="T_ULARGE_INTEGER"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测试用本地变量</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.ULARGE_TO_LWORD 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 在线监视 rResult
// ============================================================

tu := ULARGE_INTEGER(0, 100);
IF bRun THEN
    rResult := ULARGE_TO_LWORD(tu);
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
