<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2StepDown" Id="{120a0dc8-26eb-58a5-a228-a078f3dafdf1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2StepDown
VAR
    fbFB_DALIV2StepDown        : FB_DALIV2StepDown;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    nLampAddr        : BYTE := 0;


    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：面板长按减亮按钮：PLC 检测按钮持续按下，每 100 ms 调一次本 FB；松开停止。...
//
// 价值：DALI 协议标准命令的轻量封装。
//
// 验证步骤：
//   1. 通信 FB 跑起；编译；登录。
//   2. 在线 bTrigger 一次上升沿；等 bBusy 回 FALSE。
//   3. 观察 short addr 0 灯的物理亮度变化是否符合本命令描述。
// =============================================================================
fbFB_DALIV2StepDown(
    bStart           := bTrigger,
    nAddr            := nLampAddr,
    eAddrType        := eDALIV2AddrTypeShort,
    eCommandPriority := eDALIV2CommandPriorityMiddle,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2StepDown.bBusy;
bErr   := fbFB_DALIV2StepDown.bError;
nErrId := fbFB_DALIV2StepDown.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
