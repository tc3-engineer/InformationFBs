  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_WORD_TO_FIX16" pouType="program">
        <interface>
          <localVars>
            <variable name="wFromSdo">
              <type><WORD/></type>
              <initialValue><simpleValue value="2#0000110010000000;"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PDF 示例值 = 12.5 in Q8</xhtml></documentation>
            </variable>
            <variable name="fp8Decoded">
              <type><derived name="T_FIX16"/></type>
            </variable>
            <variable name="lrCheck">
              <type><LREAL/></type>
            </variable>
            <variable name="bDecode">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.WORD_TO_FIX16 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：EtherCAT SDO 读回 16 位字，重新解读为 Q8 定点。
// 价值：替代 `INT_TO_FIX16(WORD_TO_INT(...), n)` 两层转换。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bDecode THEN
    fp8Decoded := WORD_TO_FIX16(wFromSdo, 8);
    lrCheck    := FIX16_TO_LREAL(fp8Decoded);   // 应为 12.5
    bDecode := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
