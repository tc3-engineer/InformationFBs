<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FIX16_TO_WORD" Id="{ace9a9f3-7e83-56ba-b7a5-8391241bcf22}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FIX16_TO_WORD
VAR
    fp8Kp    : T_FIX16;
    wSdoData : WORD;; // 写入 SDO 的 16 位字
    bPack    : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.FIX16_TO_WORD 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把 PID 比例系数（定点）写入 EtherCAT SDO 16 位字段。
// 价值：替代 `INT_TO_WORD` 显式转换；语义上更明确（来源是定点而非普通整数）。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

// 假设上游已用 LREAL_TO_FIX16(0.5, 8) 得到 fp8Kp
fp8Kp := LREAL_TO_FIX16(0.5, 8);
IF bPack THEN
    wSdoData := FIX16_TO_WORD(fp8Kp);   // 写到 SDO
    bPack := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
