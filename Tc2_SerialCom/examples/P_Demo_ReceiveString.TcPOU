<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ReceiveString" Id="{00e9a6d3-7c88-5827-8e64-c83fa7e6e21b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ReceiveString
VAR
    fbSerialLine    : SerialLineControl;        // 后台通信，填充 bufRx
    fbReceiveString : ReceiveString;
    bufRx           : ComBuffer;
    bufTx           : ComBuffer;
    arrComIn        : PcComInData;
    arrComOut       : PcComOutData;
    bErrLine        : BOOL;

    sReceived       : STRING;                   // IN_OUT：收到的命令行
    bGotLine        : BOOL;
    bRxTimeout      : BOOL;
    eErr            : ComError_t;
    nLineCount      : UDINT;                      // 监控：累计完整行数
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HMI 调试口或上位机通过 RS232 发文本命令行，每行以 LF 结束，PLC 要按行
//       取出完整字符串再解析(如 "START\n"、"STOP\n")。
//
// 价值：演示用 ReceiveString 以"后缀=LF + 超时兜底"直接拿 IEC STRING，省去
//       逐字节拼帧；完整行需同时满足 StringReceived 且无超时无错误。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_SerialCom；把 arrComIn/arrComOut 链接到 COM 口过程映像
//   3. 编译 → 登录 → 运行；用串口助手发 "START\n"
//      → bGotLine 闪 1 个周期，sReceived = 'START$L'（含 LF）
//      → 每收到一条完整行 nLineCount +1
// =============================================================================

// 后台通信：搬硬件字节进 bufRx
fbSerialLine(
    Mode      := ComSerialLineMode_t.SERIALLINEMODE_PC_COM_PORT,
    pComIn    := ADR(arrComIn),
    pComOut   := ADR(arrComOut),
    SizeComIn := SIZEOF(arrComIn),
    TxBuffer  := bufTx,
    RxBuffer  := bufRx,
    Error     => bErrLine
);

// 后缀 '$L' = LF；Timeout 兜底防半行卡 busy
fbReceiveString(
    Prefix         := '',                       // 无前缀
    Suffix         := '$L',                     // LF 行结束符
    Timeout        := T#500MS,
    Reset          := FALSE,
    ReceivedString := sReceived,
    RXBuffer       := bufRx,
    StringReceived => bGotLine,
    busy           => ,
    Error          => eErr,
    RxTimeout      => bRxTimeout
);

// 只有真正匹配到 LF（无超时、无错误）才算一条可信命令行
IF bGotLine AND NOT bRxTimeout AND (eErr = ComError_t.COMERROR_NOERROR) THEN
    nLineCount := nLineCount + 1;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
