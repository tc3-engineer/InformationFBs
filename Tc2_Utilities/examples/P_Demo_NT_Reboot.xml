<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.NT_Reboot Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_NT_Reboot" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNT_Reboot">
              <type><derived name="NT_Reboot"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NT_Reboot 实例</xhtml></documentation>
            </variable>
            <variable name="bReboot">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="tDelaySec">
              <initialValue><simpleValue value="T#30S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">延迟 30 秒</xhtml></documentation>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：远程升级后自动重启。
// 价值：PLC 可触发系统重启。
// 验证：改 bReboot := TRUE 触发；30 秒后目标机器自动重启（验证前先确认非生产环境）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_Reboot(
    NETID := '', START := bReboot, DELAY := UDINT_TO_DWORD(TIME_TO_UDINT(tDelaySec) / 1000),
    TMOUT := DEFAULT_ADS_TIMEOUT, BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
