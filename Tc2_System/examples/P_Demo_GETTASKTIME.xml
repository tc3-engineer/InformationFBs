<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.GETTASKTIME Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GETTASKTIME" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetTaskTime">
              <type><derived name="GETTASKTIME"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">废弃 FB 实例（仅演示）</xhtml></documentation>
            </variable>
            <variable name="nTaskTimeLo">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">低 32 位</xhtml></documentation>
            </variable>
            <variable name="nTaskTimeHi">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">高 32 位</xhtml></documentation>
            </variable>
            <variable name="ulTaskStartOld">
              <type><ULINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拼装的 64 位任务启动时刻</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：对照演示：调用废弃 GETTASKTIME 与现代写法，两者拼出的任务启动时间戳应一致。
// 价值：提醒切换到现代写法。
// 验证：观察 ulTaskStartOld 与 ulTaskStartNew 应当一致。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 废弃方式
fbGetTaskTime(
    timeLoDW =&gt; nTaskTimeLo,
    timeHiDW =&gt; nTaskTimeHi
);
ulTaskStartOld := SHL(TO_ULINT(nTaskTimeHi), 32) OR TO_ULINT(nTaskTimeLo);

// 现代写法：ulTaskStartNew := F_GetTaskTime();
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
