<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_GearInPos_BkPlcMc" Id="{40ad1fb4-65b8-596d-919a-011c0c93be22}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_GearInPos_BkPlcMc
VAR
    fbFlyingShearCut    : MC_GearInPos_BkPlcMc;
    axHydConveyorBelt   : AXIS_REF_BkPlcMc;            // 主轴 — 传送带
    axHydFlyingShearKnife : AXIS_REF_BkPlcMc;          // 从轴 — 飞剪刀
    rtFlySyncTrig       : R_TRIG;
    bRequestFlyingSync  : BOOL := FALSE;
    bStartSync          : BOOL;                        // 追赶阶段进行中
    bFullyInSync        : BOOL;                        // 完全同步
    bSyncBusy           : BOOL;
    bSyncActive         : BOOL;
    bSyncAborted        : BOOL;
    bSyncError          : BOOL;
    nSyncErrorID        : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：纸张包装线"飞剪"应用。传送带不停以 500 mm/s 持续移动，切刀
//       必须在标签位置经过切刀下方时（主轴位置 = 1000 mm）以同样速
//       度同步切断（齿比 1:1）。本 FB 触发后从轴在主轴 200 mm 距离
//       内追上速度，到达切点时正好同步进入耦合。
// 价值：手写飞行同步算法极其复杂（速度规划 / 位置预测 / 同步判定），
//       液压轴本身响应慢更难做；本 FB 提供 PLCopen 标准接口一行调用
//       完成全部时序计算。
// 验证：① 前置：主轴 axHydConveyorBelt 已在 MoveVelocity 中以 500 mm/s
//       持续运动；从轴 axHydFlyingShearKnife 静止；
//       ② bRequestFlyingSync := TRUE 触发；
//       ③ bSyncBusy 立即变 TRUE；
//       ④ 当主轴位置接近 1000 - 200 = 800 时，从轴开始加速，
//       bStartSync := TRUE；
//       ⑤ 主轴到达 1000 时从轴正好到 SlaveSyncPosition 且速度匹配，
//       bFullyInSync := TRUE；
//       ⑥ 此后从轴跟随主轴；要解耦发 MC_GearOut_BkPlcMc。
// 注意：MasterStartDistance = 200 是经验值；如果从轴加速度不够大可能
//       追不上目标速度（InSync 推迟），需要按
//       "v × v_target / (2 × a)"算并加余量。
// =============================================================================

rtFlySyncTrig(CLK := bRequestFlyingSync);

fbFlyingShearCut(
    Execute            := rtFlySyncTrig.Q,
    RatioNumerator     := 1,
    RatioDenominator   := 1,                            // 1:1 同速
    MasterSyncPosition := 1000.0,                       // 主轴切刀点
    SlaveSyncPosition  := 0.0,                          // 从轴零点对齐
    SyncMode           := 0,                            // 当前不支持
    MasterStartDistance := 200.0,                       // 200 mm 内追上
    Acceleration       := 5000.0,                       // 飞剪需要大加速度
    Deceleration       := 5000.0,
    Jerk               := 0.0,
    BufferMode         := Aborting_BkPlcMc,
    Master             := axHydConveyorBelt,
    Slave              := axHydFlyingShearKnife,
    StartSync          => bStartSync,
    InSync             => bFullyInSync,
    Busy               => bSyncBusy,
    Active             => bSyncActive,
    CommandAborted     => bSyncAborted,
    Error              => bSyncError,
    ErrorID            => nSyncErrorID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
