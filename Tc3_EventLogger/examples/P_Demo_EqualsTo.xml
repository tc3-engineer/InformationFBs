<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.EqualsTo Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_EqualsTo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarmA">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件 A</xhtml></documentation>
            </variable>
            <variable name="fbAlarmB">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件 B</xhtml></documentation>
            </variable>
            <variable name="ipEvent">
              <type><derived name="I_TcEvent"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件 B 的接口</xhtml></documentation>
            </variable>
            <variable name="bSame">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">比较结果</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：判断刚收到的 alarm 是否与上一条完全相同（含参数）以做去重
// 价值：一次调用替代多字段手写比较
// 验证：需要两条事件实例。可以新建两个 FB_TcAlarm，分别 Create 不同 EventID 后比较 → 应为 FALSE；同 EventID + 同参数 → TRUE
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 假定两个 FB_TcAlarm 已 Create()。完整比较（含 Arguments）
ipEvent := fbAlarmB;
IF ipEvent &amp;lt;&amp;gt; 0 THEN
    bSame := fbAlarmA.EqualsTo(ipEvent := ipEvent);
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
