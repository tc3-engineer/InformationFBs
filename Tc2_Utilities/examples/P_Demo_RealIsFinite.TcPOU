<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_RealIsFinite" Id="{1af2680f-be19-5756-b4b4-26738d4a0aa8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_RealIsFinite
VAR
    rAdcSample : REAL;
    bFinite    : BOOL;
    bCheck     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.RealIsFinite 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：32 位 ADC 采样转 REAL 后，过滤掉因传感器开路 / 短路造成的 ±Inf 异常值。
// 价值：替代手写位检测；与 LrealIsFinite 对称。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bFinite := RealIsFinite(rAdcSample);
    bCheck := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
