<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_INT64_TO_LREAL" Id="{71189bae-8189-5bf4-bfad-b640a9935d9f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_INT64_TO_LREAL
VAR
    liTorqueInt  : T_LARGE_INTEGER;; // 有符号 64 位扭矩积分
    lrTorqueDisp : LREAL;; // HMI 显示
    bConvert     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.INT64_TO_LREAL 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把 64 位有符号扭矩积分（可正可负）转 LREAL 在 HMI 显示。
// 价值：替代手写有符号双倍长转浮点；一行调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    lrTorqueDisp := INT64_TO_LREAL(liTorqueInt);
    bConvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
