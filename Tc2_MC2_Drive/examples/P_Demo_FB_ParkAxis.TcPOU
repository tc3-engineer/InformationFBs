<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_ParkAxis" Id="{dacee8c2-76c2-54e4-9563-092c2c4262da}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_ParkAxis
VAR
    fbParkAxis         : FB_ParkAxis; // 驻留/释放轴 FB 实例
    axisOptionStation  : AXIS_REF; // 可选工位轴引用；未装电机的通道
    rtParkTrig         : R_TRIG; // 把电平转上升沿
    bParkReq           : BOOL := FALSE; // 在线写 TRUE 触发一次驻留/释放
    eRequestedParkMode : E_ParkMode; // 在线选 eParkMode_Park / eParkMode_Release
    bParkBusy          : BOOL;
    bParkError         : BOOL;
    nParkErrorID       : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：模块化包装机的某个可选贴标工位本批次没装电机。若不处理，该通道会因
//       缺反馈报 feedback error 导致整机起不来。开机时把该通道驻留掉，机器
//       即可在缺配置下正常运行；后续装上电机再释放。
//
// 价值：1) 缺电机的通道驻留后不报反馈错误，无需为每种配置维护单独 NC 工程
//       2) 硬件无关：AX5000/AX8000/MD8xxx 自动选通道
//       3) 运行期动态驻留/释放，比静态配置灵活
//
// !! 安全：对多通道设备，驻留/激活某通道前必须先关闭该设备所有通道的控制器
//          使能（PDF NOTICE），否则其它通道的轴会被意外停掉。
//
// 验证步骤：
//   1. System Manager 配好 NC 轴并 Link 给 axisOptionStation，引用 Tc2_MC2_Drive
//   2. 确认 TwinCAT ≥ 4024.60/4026.8 且库 ≥ V3.3.41.0（否则本 FB 不可用）
//   3. 对该设备所有通道先 MC_Power(Enable := FALSE) 关使能
//   4. Add Existing Item (.TcPOU) 选本文件，加进 PlcTask，编译登录
//   5. 在线把 eRequestedParkMode 设为 eParkMode_Park，写 bParkReq := TRUE
//   6. 等 bParkBusy 落回 FALSE 且 bParkError = FALSE 即驻留成功
//   7. 装上电机后把 eRequestedParkMode 改为 eParkMode_Release，再触发一次
//   8. 若 bParkError = TRUE，看 nParkErrorID 对照 ADS Return Codes 表
// =============================================================================

// 用 R_TRIG 把"持续按住的 TRUE"转成真正的上升沿
rtParkTrig(CLK := bParkReq);

// 单次调用：Mode 来自在线选择；Axis 是 VAR_IN_OUT 必传
// 本 FB 无 Done 输出，靠 Busy 落回 FALSE 且 Error=FALSE 判成功
fbParkAxis(
    Execute := rtParkTrig.Q,
    Mode    := eRequestedParkMode,
    Axis    := axisOptionStation,
    Busy    => bParkBusy,
    Error   => bParkError,
    ErrorID => nParkErrorID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
