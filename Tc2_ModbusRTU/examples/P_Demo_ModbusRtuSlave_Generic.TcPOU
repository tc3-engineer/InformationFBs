<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ModbusRtuSlave_Generic" Id="{2fc8f120-29f1-5274-85bc-d5d887540c5c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ModbusRtuSlave_Generic
VAR
    fbModbusSlave : ModbusRtuSlave_Generic;          // 硬件无关从站
    stRxBuffer    : ComBuffer;                        // Tc2_SerialCom 收发缓冲（跨周期稳定实例）
    stTxBuffer    : ComBuffer;
    aInputs   : ARRAY[0..7] OF WORD;                  // 输入区（主站只读）偏移 16#0
    aOutputs  : ARRAY[0..7] OF WORD;                  // 输出区（主站读写）偏移 16#800
    aMemory   : ARRAY[0..7] OF WORD;                  // 存储区（主站读写）偏移 16#4000
    eErrId    : MODBUS_ERRORS;
    nHeartbeat : WORD;                                 // 演示：心跳计数放输入区供主站监测在线
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：被测主站只能经虚拟 COM 口（如 USB 转串口）连接，标准 KL6x/PC COM 从站接
//       不上，用 Generic 从站经 Tc2_SerialCom 后台串口块对接，并把一个心跳计数
//       放到输入区让主站监测本机是否在线。
//
// 价值：演示硬件无关从站的特殊用法——RxBuffer/TxBuffer 作为 VAR_IN_OUT 传入，
//       FB 只解析/组帧，物理收发由 Tc2_SerialCom 后台搬运。这是唯一能走虚拟
//       COM 口的 Modbus RTU 从站。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs → Add → Existing Item → 选本 .TcPOU
//   2. References → Add library → Tc2_ModbusRTU 和 Tc2_SerialCom；需 TF6340 license
//   3. 另外建立并每周期调用 Tc2_SerialCom 的 SerialLineControl(ADS) 块，把
//      stRxBuffer/stTxBuffer 与虚拟 COM 口绑定（本 demo 聚焦从站，未含该块）
//   4. 编译 → 登录 → 运行；用主站以站地址 1 周期读输入寄存器、地址 16#0
//      → 读到的心跳值持续变化（说明从站在线且串口链路通）
//      → 若漏调串口块：主站收不到应答（心跳读不到）
// =============================================================================

// 业务侧：心跳计数放输入区第 0 个字，供主站轮询判断本机在线
nHeartbeat := nHeartbeat + 1;
aInputs[0] := nHeartbeat;

// 每周期调用一次从站；RxBuffer/TxBuffer 必须作为 in-out 传入
fbModbusSlave(
    UnitID          := 1,
    AdrInputs       := ADR(aInputs),
    SizeInputBytes  := SIZEOF(aInputs),
    AdrOutputs      := ADR(aOutputs),
    SizeOutputBytes := SIZEOF(aOutputs),
    AdrMemory       := ADR(aMemory),
    SizeMemoryBytes := SIZEOF(aMemory),
    RxBuffer        := stRxBuffer,
    TxBuffer        := stTxBuffer,
    ErrorId         => eErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
