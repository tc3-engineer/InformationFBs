<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_ReadMotionFunction" Id="{df70a8f7-a969-5bba-971a-6ea1501906e8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_ReadMotionFunction
VAR
    fbReadCamShape  : MC_ReadMotionFunction;
    stCamTableRef   : MC_CAM_REF;
    arrCamPointBuf  : ARRAY[0..63] OF MC_MotionFunctionPoint;
    nActiveCamId    : MC_CAM_ID;
    bRequestBackup  : BOOL := FALSE;
    rtBackupTrig    : R_TRIG;
    bBackupDone     : BOOL;
    bBackupBusy     : BOOL;
    bBackupError    : BOOL;
    nBackupErrorID  : UDINT;
    nPointsBackedUp : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：包装机已经通过 MC_CamTableSelect + MC_CamIn 把"标准料厚"凸轮表激活
//       并在跑；现在操作员准备切换到"加厚料"凸轮，切换前要把当前生效的
//       凸轮形状备份到 PLC 数组里，方便回滚 / HMI 显示对比 / 工艺审计。
// 价值：不用切回 XAE 离线工具读 cam 文件——那个文件可能与运行时形状已
//       不一致（之前可能被 MC_WriteMotionFunction 改过）。本 FB 直接从
//       NC 内核回读当下真正生效的曲线点列，是运行时真实状态的唯一来源。
// 验证步骤：
//   1) 编译后登录，确认 nActiveCamId 已被外部模块（MC_CamTableSelect 的 Done
//      流程）赋值为有效 ID；本例为最小演示，假设上游已填好。
//   2) 把 stCamTableRef.pArray 指到本地缓冲：在 PLC 内联中赋值或在
//      MAIN 程序的初始化段里执行（见下方初始化注释）。
//   3) 在线 bRequestBackup := TRUE → R_TRIG 上升沿触发 Execute；
//      观察 bBackupBusy 立即变 TRUE，1-N 个 PLC 周期后 bBackupDone := TRUE。
//   4) Watch arrCamPointBuf[0..nPointsBackedUp-1]，应能看到 master/slave 位
//      置成对的点数据；nPointsBackedUp 应等于该 cam 表实际点数（MFsize）。
//   5) 异常路径：把 nActiveCamId 改成一个不存在的 ID 重试，应观察到
//      bBackupError := TRUE 且 nBackupErrorID 非零（具体码参见 NC 错误表）。
// =============================================================================
// 初始化（演示用，工程里通常在 FB_init 或一个一次性初始化段）：
//   把 MC_CAM_REF 描述结构指到本地数组缓冲。NumPoints := 0 即整表读，
//   FB 会按 MFsize 自动填充并把实际点数返回到 nPointsBackedUp。

IF stCamTableRef.pArray = 0 THEN
    stCamTableRef.pArray     := ADR(arrCamPointBuf);
    stCamTableRef.nArraySize := SIZEOF(arrCamPointBuf);
END_IF;

rtBackupTrig(CLK := bRequestBackup);

// 单次完整调用：上升沿 Execute、CamTableID 来自上游 CamTableSelect、
// PointID = 0 表内第一点、NumPoints = 0 整表填满。
fbReadCamShape(
    Execute       := rtBackupTrig.Q,
    CamTableID    := nActiveCamId,
    PointID       := 0,
    NumPoints     := 0,
    CamTable      := stCamTableRef,
    Done          => bBackupDone,
    Busy          => bBackupBusy,
    Error         => bBackupError,
    ErrorID       => nBackupErrorID,
    NumPointsRead => nPointsBackedUp
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
