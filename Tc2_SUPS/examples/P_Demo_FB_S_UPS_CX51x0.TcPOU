<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_S_UPS_CX51x0" Id="{0f9313fe-1577-54dc-9e26-8f6a9943ec4f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_S_UPS_CX51x0
VAR
    fbSUPS           : FB_S_UPS_CX51x0; // CX51x0 平台 1-second UPS 管家
    sOrderIdRetain   : STRING(40); // 当前订单号；工程里加 VAR RETAIN
    nDoneCountRetain : UDINT; // 该订单已完成件数；工程里加 VAR RETAIN
    bPowerFailNow    : BOOL; // 实时电源标志：掉电中 = TRUE
    eUpsState        : E_S_UPS_State; // 在线 monitor 观察应急流程当前阶段
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：某 CX5140 控制器跑装配线主程序，掉电时要保留当前订单号 sOrderIdRetain
//       和该订单已完成件数 nDoneCountRetain，重启后无需人工补录直接接着干。
//
// 价值：CX51x0 的 UPS 状态在 ADS 端口 16#588（与 CX50x0 的 16#4A8 不同）。
//       不用本 FB 要自己写 ADS 客户端 + 端口读 + SPDM_2PASS 触发 + QuickShutdown
//       调度。本 FB 全包，业务侧只看 eUpsState 进度。约省 70-90 行手写。
//
// 验证步骤：
//   1. 引用 Tc2_SUPS（含依赖 Tc2_System）
//   2. 在 PLC 项目中右键 → Add Existing Item (.TcPOU) → 选本文件 → OK
//   3. 工程里把 sOrderIdRetain / nDoneCountRetain 改为 VAR RETAIN
//   4. Windows Embedded 7P：打开 EWF/FBWF 并把 TwinCAT\Boot 排除在写过滤外
//   5. Properties → PLC → Router Memory 调到 retain 总量的 1.5-2 倍
//   6. 编译、登录、运行
//   7. 在线把 sOrderIdRetain 写成 'ORDER-123'、nDoneCountRetain 写成 47
//   8. 模拟掉电（仅台架拔 24V）→ 观察 eUpsState 走 eSUPS_PowerFailure →
//      eSUPS_WritePersistentData → eSUPS_QuickShutdown → 系统重启
//   9. 上电后再连接 → 验证两个 retain 仍是掉电前的值
// =============================================================================

// 单次调用形式：所有 VAR_INPUT 显式赋值
// iUPSPort 走 CX51x0 平台默认 16#588（不要套用 CX50x0 的 16#4A8）
fbSUPS(
    sNetID           := '',
    iPLCPort         := 0,
    iUPSPort         := 16#588,
    tTimeout         := DEFAULT_ADS_TIMEOUT,
    eUpsMode         := eSUPS_WrPersistData_Shutdown,
    ePersistentMode  := SPDM_2PASS,
    tRecoverTime     := T#10S,
    bPowerFailDetect => bPowerFailNow,
    eState           => eUpsState
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
