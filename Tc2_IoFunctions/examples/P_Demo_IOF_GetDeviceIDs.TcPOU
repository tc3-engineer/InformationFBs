<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IOF_GetDeviceIDs" Id="{2fad2a77-5a9f-5244-84a1-0050d49d3984}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IOF_GetDeviceIDs
VAR
    fbReadAllDeviceIds : IOF_GetDeviceIDs; // FB：一次性读所有 IO 设备 ID
    sTargetNetId       : T_AmsNetId := ''; // 本机
    aDeviceIdBuffer    : ARRAY[1..201] OF WORD; // ID 缓冲（最多 200 设备）
    bStartReadAllIds   : BOOL := FALSE; // 上升沿触发
    tReadTimeout       : TIME := T#5S; // 超时
    bReadBusy          : BOOL; // 工作中
    bReadError         : BOOL; // 失败
    nLastErrCode       : UDINT; // 错误号
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：上电自检：一次性读出所有现场总线 / IO 设备的 ID，后续 for 循环遍历做巡检。
// 价值：减少 ADS 调用次数，从 N 次降到 1 次。
// 验证：登录后写 bStartReadAllIds := TRUE → bReadBusy 短暂 TRUE → 回 FALSE 后 aDeviceIdBuffer[1] 是数量，aDeviceIdBuffer[2..] 是各 ID。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// LEN 用 SIZEOF 自动算字节数；DESTADDR 用 ADR(数组)
fbReadAllDeviceIds(
    NETID    := sTargetNetId,
    LEN      := SIZEOF(aDeviceIdBuffer),
    DESTADDR := ADR(aDeviceIdBuffer),
    START    := bStartReadAllIds,
    TMOUT    := tReadTimeout,
    BUSY     => bReadBusy,
    ERR      => bReadError,
    ERRID    => nLastErrCode
);

// 完成后 aDeviceIdBuffer[1] = 数量，aDeviceIdBuffer[2..] 是各 ID（必须等 bReadBusy 落回再读结果）
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
