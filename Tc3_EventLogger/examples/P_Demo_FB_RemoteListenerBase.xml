  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RemoteListenerBase" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRemoteListener">
              <type><derived name="FB_RemoteListenerBase"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际工程声明子类</xhtml></documentation>
            </variable>
            <variable name="bSubscribed">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">订阅 latch</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：订阅远程 PLC 的事件
// 价值：跨 PLC 集中监控
// 验证：需要先在 XAE 路由表配置远程 AMS Net ID。继承 FB_RemoteListenerBase 后 OVERRIDE OnXxx 回调；Subscribe 时传远程节点信息；触发远程 PLC 的 alarm 应能看到本端回调
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 远程订阅需要先调 Subscribe 传远程节点 AMS Net ID + Port（具体接口随库版本，参考 InfoSys）。
// 之后周期 Execute 推进事件队列，与本地 listener 用法一致。
hr := fbRemoteListener.Execute();
</xhtml></ST>
        </body>
      </pou>
    </pous>
