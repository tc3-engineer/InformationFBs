<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IOF_GetDeviceType" Id="{feb6b076-7743-5ca7-9650-6e5c39cfd70e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IOF_GetDeviceType
VAR
    fbGetDeviceType : IOF_GetDeviceType; // 设备类型查询 FB
    sTargetNetId    : T_AmsNetId := ''; // 本机
    nLookupDeviceId : UDINT := 1; // 目标 Device Id
    bStartReadType  : BOOL := FALSE; // 上升沿触发
    tReadTimeout    : TIME := T#5S; // 超时
    bReadBusy       : BOOL; // 工作中
    bReadError      : BOOL; // 失败
    nLastErrCode    : UDINT; // 错误号
    eDeviceTypeOut  : IODEVICETYPES; // 设备类型枚举
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：IO 巡检：循环遍历 Device Id，对每个 ID 判断是 Profibus / EtherCAT / KL coupler 决定下一步诊断分支。
// 价值：通用诊断脚本支持多总线。
// 验证：登录后 nLookupDeviceId := 1，在线写 bStartReadType := TRUE → 回 FALSE 后 eDeviceTypeOut 显示枚举值（与 PDF 中 IODEVICETYPES 表对照）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbGetDeviceType(
    NETID        := sTargetNetId,
    DEVICEID     := nLookupDeviceId,
    START        := bStartReadType,
    TMOUT        := tReadTimeout,
    BUSY         => bReadBusy,
    ERR          => bReadError,
    ERRID        => nLastErrCode,
    IODeviceType => eDeviceTypeOut
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
