  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AmsLogger" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_AmsLogger">
              <type><derived name="FB_AmsLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_AmsLogger 实例</xhtml></documentation>
            </variable>
            <variable name="sNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="eMode">
              <initialValue><simpleValue value="AMSLOGGER_RUN"/></initialValue>
              <type><derived name="E_AmsLoggerMode"/></type>
            </variable>
            <variable name="sCfgFilePath">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="bExecute">
              <type><BOOL/></type>
            </variable>
            <variable name="tTimeout">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrId">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：老项目日志。
// 价值：兼容。
// 验证：调用 Add 加日志条目，目标日志服务应收到。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_AmsLogger(
    sNetId := sNetId,
    eMode := eMode,
    sCfgFilePath := sCfgFilePath,
    bExecute := bExecute,
    tTimeout := tTimeout,
    bBusy =&gt; bBusy,
    bError =&gt; bError,
    nErrId =&gt; nErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
