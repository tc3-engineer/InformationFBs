  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_MemRingBuffer" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_MemRingBuffer">
              <type><derived name="FB_MemRingBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_MemRingBuffer 实例</xhtml></documentation>
            </variable>
            <variable name="pWrite">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbWrite">
              <type><UDINT/></type>
            </variable>
            <variable name="pRead">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbRead">
              <type><UDINT/></type>
            </variable>
            <variable name="pBuffer">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbBuffer">
              <type><UDINT/></type>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
            </variable>
            <variable name="nCount">
              <type><UDINT/></type>
            </variable>
            <variable name="cbSize">
              <type><UDINT/></type>
            </variable>
            <variable name="cbReturn">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 趋势 1000 点。
// 价值：库提供。
// 验证：Init 容量 N，连续 Add N+1 个值，第一个被覆盖。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemRingBuffer(
    pWrite := pWrite,
    cbWrite := cbWrite,
    pRead := pRead,
    cbRead := cbRead,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk =&gt; bOk,
    nCount =&gt; nCount,
    cbSize =&gt; cbSize,
    cbReturn =&gt; cbReturn
);
</xhtml></ST>
        </body>
      </pou>
