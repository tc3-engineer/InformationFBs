  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.PVOID_TO_STRING Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_PVOID_TO_STRING" pouType="program">
        <interface>
          <localVars>
            <variable name="pSomeRef"><type><pointer><baseType><BYTE/></baseType></pointer></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：要诊断的指针</xhtml></documentation></variable>
            <variable name="sAddrStr"><type><string><length>32</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">诊断字符串</xhtml></documentation></variable>
            <variable name="bDiag"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：排查内存泄漏：把疑似无效指针的值 dump 到日志，对比已知地址区间。
// 价值：替代手写 hex 格式化 + 平台 if 分支；本函数自动按位宽适应。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bDiag THEN
    sAddrStr := PVOID_TO_STRING(in := pSomeRef);
    bDiag := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
