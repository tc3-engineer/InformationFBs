<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARLightActuator" Id="{1295bc37-f01d-5fd9-baca-bb7dd79f0b28}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARLightActuator
VAR
    fb : FB_BARLightActuator;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    lrTargetValue_in : LREAL := 0.0;
    usiSelectedScene_in : USINT := 0;
    bCallScene_in : BOOL := FALSE;
    bStopScene_in : BOOL := FALSE;
    bSaveScene_in : BOOL := FALSE;
    uiSecDimTime_io : UINT := 0;
    arrLightScenes_io : ARRAY[0..20] OF LREAL ;
    lrDimValue_out : LREAL;
    iDimValue_out : INT;
    bOn_out : BOOL;
    bSceneMode_out : BOOL;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARLightActuator 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARLightActuator.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    lrTargetValue := lrTargetValue_in,
    usiSelectedScene := usiSelectedScene_in,
    bCallScene := bCallScene_in,
    bStopScene := bStopScene_in,
    bSaveScene := bSaveScene_in,
    uiSecDimTime := uiSecDimTime_io,
    arrLightScenes := arrLightScenes_io,
    lrDimValue => lrDimValue_out,
    iDimValue => iDimValue_out,
    bOn => bOn_out,
    bSceneMode => bSceneMode_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
