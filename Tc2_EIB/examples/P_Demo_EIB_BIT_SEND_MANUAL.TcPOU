<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_BIT_SEND_MANUAL" Id="{c566a87e-2f52-5a70-a92c-012ce224cba6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_BIT_SEND_MANUAL
VAR
    fbSendManual    : EIB_BIT_SEND_MANUAL;
    stEibRec        : EIB_REC;
    stGroup         : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 1, NUMBER := 55);
    bTriggerResend  : BOOL;       // 业务上拉高一个周期触发
    bCurrentLamp    : BOOL := TRUE;
    bSendBusy       : BOOL;
    bSendError      : BOOL;
    iLastErrID      : EIB_ERROR_CODE;
    fbHeartbeat     : TON;
    rTrigHeartbeat  : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_BIT_SEND_MANUAL 演示程序
// ============================================================
// 场景：心跳重发：业务上每 30 秒主动重发开关状态到组 1/1/55，避免 BMS 因网络问题失同步。
// 价值：强制重发同一值；BMS 失同步保险
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：改 `bData := TRUE`、置 `bSend := TRUE` 一个周期 → BMS 应看到 1/1/55 出 TRUE 帧；再置 `bSend := TRUE`（不改 bData）→ 又出一帧（即使值没变）。
// ============================================================

// 每 30 秒触发一次重发
fbHeartbeat(IN := NOT fbHeartbeat.Q, PT := T#30S);
rTrigHeartbeat(CLK := fbHeartbeat.Q);
bTriggerResend := rTrigHeartbeat.Q;

fbSendManual(
    Group_Address := stGroup,
    bSend         := bTriggerResend,
    bData         := bCurrentLamp,
    str_Rec       := stEibRec,
    bBusy         => bSendBusy,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
