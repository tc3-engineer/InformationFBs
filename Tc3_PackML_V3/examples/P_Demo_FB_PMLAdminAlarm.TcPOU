<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_PMLAdminAlarm" Id="{2b71f7c0-cc2c-55df-8bac-0268a413f97c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_PMLAdminAlarm
VAR
    fbAdminAlarm     : FB_PMLAdminAlarm;
    fbAdminTime      : FB_PMLAdminTime;             // 必须周期调用以填 PlcDateTime
    stPackTagAdmin   : ST_PMLa;                      // 模拟 PackTags.Admin
    stPackTagStatus  : ST_PMLs;                      // 模拟 PackTags.Status
    stAdminOpt       : ST_PMLAdminTimeOptions;       // AdminTime 选项（默认零结构）

    // —— HMI 按钮 ——
    bBtnFireAlarm    : BOOL := FALSE;                // 在线置 TRUE 触发一条新 alarm
    bBtnAckAll       : BOOL := FALSE;                // 在线置 TRUE 一键确认全部 alarm
    bBtnClearAll     : BOOL := FALSE;                // 在线置 TRUE 一键清除全部 alarm

    // —— 上升沿检测 ——
    rtrigFire        : R_TRIG;
    rtrigAck         : R_TRIG;
    rtrigClear       : R_TRIG;

    // —— alarm 事件结构 ——
    stTempHighAlarm  : ST_PMLEvent := (Id := 1001, Value := 90, Message := 'Outlet temperature > 85C', Category := 1);

    // —— 状态查询（在线观察） ——
    bAlarmPending    : BOOL;
    nHighestCategory : DINT;
    bSetOk           : BOOL;
    bAckOk           : BOOL;
    bClearOk         : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc3_PackML_V3.FB_PMLAdminAlarm 演示程序
// ============================================================
// 场景：模拟灌装机出料温度超 85°C 触发高温 alarm；HMI 上"全部确认"
//       "全部清除"按钮一键操作；状态机根据 M_HasAlarm 判断能否切到 Idle。
// 价值：V3 比 V2 多了 All/Has/Get 系列方法，HMI 一键全清/全确认免去 for
//       循环；M_HasAlarm 让状态机条件判断一行解决。OMAC 标准的 PackTags
//       直接被 MES 通过 OPC UA 消费。
// 验证：登录后顺序操作：
//       1. 写 bBtnFireAlarm := TRUE → 观察 bAlarmPending 变 TRUE、
//          nHighestCategory = 1、PackTagAdmin.Alarm[0].Trigger = TRUE
//          + DateTime 已填、Message = 'Outlet temperature > 85C'。
//       2. 写 bBtnAckAll := TRUE → 观察 Alarm[0].Trigger 仍 TRUE
//          (Ack 不删除)，AckDateTime 已填。
//       3. 写 bBtnClearAll := TRUE → 观察 Alarm[0] 被搬入 AlarmHistory[0]，
//          bAlarmPending 变 FALSE。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_PackML_V3（References → Add library）
//   3. 编译 → 登录 → 运行；按上方"验证"指引在线写值观察
// ============================================================

(* 先调用 AdminTime 周期填充 PlcDateTime，否则所有 alarm 时间戳为 0 *)
fbAdminTime(stAdmin := stPackTagAdmin, stStatus := stPackTagStatus, stOptions := stAdminOpt);

(* 上升沿触发——避免每周期重复 set/ack/clear *)
rtrigFire(CLK := bBtnFireAlarm);
rtrigAck(CLK := bBtnAckAll);
rtrigClear(CLK := bBtnClearAll);

(* 写入 alarm：上升沿一次性调用 *)
IF rtrigFire.Q THEN
    bSetOk := fbAdminAlarm.M_SetAlarm(stAdmin := stPackTagAdmin, stAlarm := stTempHighAlarm);
END_IF

(* HMI 全部确认 *)
IF rtrigAck.Q THEN
    bAckOk := fbAdminAlarm.M_AcknowledgeAllAlarms(stAdmin := stPackTagAdmin);
END_IF

(* HMI 全部清除 *)
IF rtrigClear.Q THEN
    bClearOk := fbAdminAlarm.M_ClearAllAlarms(stAdmin := stPackTagAdmin);
END_IF

(* 状态机查询：V3 新增的 Has/Get 方法每周期查 *)
bAlarmPending    := fbAdminAlarm.M_HasAlarm(stAdmin := stPackTagAdmin);
nHighestCategory := fbAdminAlarm.M_GetAlarmCategory(stAdmin := stPackTagAdmin);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
