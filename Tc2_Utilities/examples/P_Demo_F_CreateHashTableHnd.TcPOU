<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_CreateHashTableHnd" Id="{62e77640-35bb-5c57-8c09-83a388f67777}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_CreateHashTableHnd
VAR
    aEntries : ARRAY[0..63] OF T_HashTableEntry; // 工业语义：64 槽位静态哈希表
    hTable   : T_HHASHTABLE; // 哈希表句柄
    bOk      : BOOL; // 初始化成功
    bInit    : BOOL; // 在线触发（实际工程在启动 OB / Init 阶段调用一次）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：工业 OPC 标签字典：~1000 个 OPC 节点名 → 内部地址的映射；启动时一次 `F_CreateHashTableHnd`，运行时 O(1) 查找。
// 价值：替代线性扫描 / 自写哈希函数；标准库提供哈希查找语义（平均 O(1)），用于大 dict 替代 `ARRAY OF STRUCT` 的 O(N) 顺序查找。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

// 启动时一次性初始化哈希表句柄
IF bInit THEN
    bOk := F_CreateHashTableHnd(pEntries  := ADR(aEntries),
                                cbEntries := SIZEOF(aEntries),
                                hTable    := hTable);
    // bOk = TRUE -> 后续可用 FB_HashTableCtrl 操作 hTable
    bInit := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
