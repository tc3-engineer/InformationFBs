<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_FormatString" Id="{27cea484-64c0-5461-80e0-e1382cdd50b4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_FormatString
VAR
    fbFB_FormatString : FB_FormatString; // FB_FormatString 实例
    sFormat           : T_MaxString;
    arg1              : T_Arg;
    arg2              : T_Arg;
    arg3              : T_Arg;
    arg4              : T_Arg;
    arg5              : T_Arg;
    arg6              : T_Arg;
    arg7              : T_Arg;
    arg8              : T_Arg;
    arg9              : T_Arg;
    arg10             : T_Arg;
    bError            : BOOL;
    nErrId            : UDINT;
    sOut              : T_MaxString;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HMI 拼装显示字符串。
// 价值：替代多次 CONCAT。
// 验证：格式串 `'Count=%d'` + 参数 100，输出应为 `'Count=100'`。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_FormatString(
    sFormat := sFormat,
    arg1 := arg1,
    arg2 := arg2,
    arg3 := arg3,
    arg4 := arg4,
    arg5 := arg5,
    arg6 := arg6,
    arg7 := arg7,
    arg8 := arg8,
    arg9 := arg9,
    arg10 := arg10,
    bError => bError,
    nErrId => nErrId,
    sOut => sOut
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
