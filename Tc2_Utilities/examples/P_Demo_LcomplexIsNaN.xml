  <contentHeader name="Tc2_Utilities.LcomplexIsNaN Demo" modificationDateTime="2026-05-12T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LcomplexIsNaN" pouType="program">
        <interface>
          <localVars>
            <variable name="lcCurrent">
              <type><derived name="LCOMPLEX;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">d-q 反变换电流</xhtml></documentation>
            </variable>
            <variable name="bHasNaN">
              <type><BOOL/></type>
            </variable>
            <variable name="bCheck">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.LcomplexIsNaN 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：矢量控制 d-q 反变换后，电流复数若含 NaN 必须切回上一周期值以保险。
// 价值：替代手写 `LrealIsNaN(Z.re) OR LrealIsNaN(Z.im)`；一次调用语义清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bHasNaN := LcomplexIsNaN(lcCurrent);
    bCheck := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
