<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_LB_BreakLocationTest Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_LB_BreakLocationTest" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLightbusBreakTest">
              <type><derived name="IOF_LB_BreakLocationTest"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Lightbus 断纤定位 FB</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nLightbusDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Lightbus 主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="bStartBreakTest">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发测试</xhtml></documentation>
            </variable>
            <variable name="tBreakTestTimeout">
              <initialValue><simpleValue value="T#10S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 超时（光纤环大时给足）</xhtml></documentation>
            </variable>
            <variable name="bBreakTestBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bBreakTestErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="bBreakDetected">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">断纤标志</xhtml></documentation>
            </variable>
            <variable name="nLastModuleNo">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模块号 / 总数</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Lightbus 通讯故障：HMI 按钮触发断纤定位，BOXNO 显示断点位置帮助现场人员快速找到问题模块。
// 价值：把断纤定位做成 HMI 一键操作。
// 验证：登录后 nLightbusDeviceId := 系统中 Lightbus 主站 DeviceId；写 bStartBreakTest := TRUE → bBreakTestBusy 短暂 TRUE → 回 FALSE 后 bBreakDetected 表示是否有断纤；正常时 nLastModuleNo 应等于工程配置的 Lightbus 模块总数。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbLightbusBreakTest(
    NETID    := sTargetNetId,
    DEVICEID := nLightbusDeviceId,
    START    := bStartBreakTest,
    TMOUT    := tBreakTestTimeout,
    BUSY     =&gt; bBreakTestBusy,
    ERR      =&gt; bBreakTestErr,
    ERRID    =&gt; nLastErrCode,
    BREAK    =&gt; bBreakDetected,
    BOXNO    =&gt; nLastModuleNo
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
