  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ULARGE_TO_ULINT" pouType="program">
        <interface>
          <localVars>
            <variable name="uliFromAds">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 报文里读到的字段</xhtml></documentation>
            </variable>
            <variable name="ulNative">
              <type><derived name="ULINT;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">业务侧原生 64 位</xhtml></documentation>
            </variable>
            <variable name="bConvert">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.ULARGE_TO_ULINT 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：ADS Raw 报文里读到一个 T_ULARGE_INTEGER 字段，业务逻辑全用 ULINT 算术，需要一步转换。
// 价值：替代手写位移 + 加法；一行调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    ulNative := ULARGE_TO_ULINT(uliFromAds);   // 转换后即可参与 IEC 算术
    bConvert := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
