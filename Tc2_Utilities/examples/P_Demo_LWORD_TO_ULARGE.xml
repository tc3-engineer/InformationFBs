  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LWORD_TO_ULARGE" pouType="program">
        <interface>
          <localVars>
            <variable name="lwTickCount">
              <type><LWORD/></type>
              <initialValue><simpleValue value="16#FEDCBA9876543210;"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">硬件计数器读回值</xhtml></documentation>
            </variable>
            <variable name="uliResult">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">重打包后的结构体</xhtml></documentation>
            </variable>
            <variable name="bRepack">
              <type><derived name="BOOL;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.LWORD_TO_ULARGE 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把硬件计数器累计值（64 位寄存器读回的 LWORD）写入一个按 T_ULARGE_INTEGER 定义的报警阈值结构体里。
// 价值：替代手写两次位移与 DWORD 强转；函数语义清晰，单元测试覆盖一行就够。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bRepack THEN
    // 数值不变只换表示形式，无须额外校验
    uliResult := LWORD_TO_ULARGE(lwTickCount);
    bRepack := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
