<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_ReadInput_analog Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_ReadInput_analog" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAsiAnalogRead">
              <type><derived name="FB_ReadInput_analog"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 模拟输入 FB</xhtml></documentation>
            </variable>
            <variable name="fbAsiParamControl">
              <type><derived name="FB_ASI_ParameterControl"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">后台调度</xhtml></documentation>
            </variable>
            <variable name="stAsiParamBuffer">
              <type><derived name="ST_ParameterBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">共享缓冲</xhtml></documentation>
            </variable>
            <variable name="stAsiInProcessImg">
              <type><derived name="ST_Parameter_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链到 %I*</xhtml></documentation>
            </variable>
            <variable name="stAsiOutProcessImg">
              <type><derived name="ST_Parameter_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链到 %Q*</xhtml></documentation>
            </variable>
            <variable name="iAsiAnalogSlaveAddr">
              <initialValue><simpleValue value="14"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 slave 地址</xhtml></documentation>
            </variable>
            <variable name="iAnalogChannelNo">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">通道号</xhtml></documentation>
            </variable>
            <variable name="bEnableCyclicRead">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=单次 1=循环</xhtml></documentation>
            </variable>
            <variable name="bStartAnalogRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bAnalogValueValid">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读得值是否有效</xhtml></documentation>
            </variable>
            <variable name="bOverRangeFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超量程标志</xhtml></documentation>
            </variable>
            <variable name="iAnalogReadValue">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模拟读值</xhtml></documentation>
            </variable>
            <variable name="nAsiCmdError">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：ASI slave 14 是温度变送器，通道 0 是温度，HMI 显示需要循环读。
// 价值：把 ASI 模拟值做成可读的 PLC 变量。
// 验证：登录后 iAsiAnalogSlaveAddr := 14、iAnalogChannelNo := 0、bEnableCyclicRead := TRUE、bStartAnalogRead := TRUE → bAnalogValueValid 在 slave 在线时应为 TRUE，iAnalogReadValue 实时显示传感器值；断开 slave 模拟 → bAnalogValueValid 落到 FALSE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbAsiParamControl(
    stParameterBuffer := stAsiParamBuffer,
    stParameter_IN    := stAsiInProcessImg,
    stParameter_OUT   := stAsiOutProcessImg
);

fbAsiAnalogRead(
    iSlaveaddress     := iAsiAnalogSlaveAddr,
    iChannel          := iAnalogChannelNo,
    bCycleMode        := bEnableCyclicRead,
    bStart            := bStartAnalogRead,
    stParameterBuffer := stAsiParamBuffer,
    bValid            =&gt; bAnalogValueValid,
    bOverflow         =&gt; bOverRangeFlag,
    iReadValue        =&gt; iAnalogReadValue,
    iErrornumber      =&gt; nAsiCmdError
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
