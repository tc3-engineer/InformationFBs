<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Int64Add64Ex" Id="{618d4201-b95f-53c8-9ef1-d83b8a8d653b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Int64Add64Ex
VAR
    liAccum   : T_LARGE_INTEGER;
    liDelta   : T_LARGE_INTEGER;
    bOverflow : BOOL;
    bAdd      : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.Int64Add64Ex 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：工业计量场景里有符号差值累加，溢出代表传感器故障要报警。
// 价值：替代手写符号位检测；一次调用同时拿和与溢出位。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

bOverflow := FALSE;                                    // 每周期先清
IF bAdd THEN
    liAccum := Int64Add64Ex(liAccum, liDelta, bOverflow);
    IF bOverflow THEN
        ;   // 业务层报警与饱和
    END_IF;
    bAdd := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
