<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DMXSetDMX512StartAddress" Id="{c6c78fe4-8cb6-526e-83a0-bf1ca43ade48}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DMXSetDMX512StartAddress
VAR
    fbSetStartAddr    : FB_DMXSetDMX512StartAddress;  // 设起始地址
    stDmxCmdBuffer    : ST_DMXCommandBuffer;          // 与通讯 FB 共用
    wTargetManufId    : WORD := 16#4241;              // 目标灯具厂商 ID
    dwTargetDeviceId  : DWORD := 16#12131415;         // 目标灯具设备 ID
    byTargetPort      : BYTE := 0;                    // 根设备通道 0
    iNewStartAddr     : INT := 45;                    // 目标起始地址(图纸指定第 45 通道)
    bDoSet            : BOOL := FALSE;                // 在线给一次上升沿触发
    bBusy             : BOOL;
    bError            : BOOL;
    udiErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_DMX.FB_DMXSetDMX512StartAddress 演示程序
// ============================================================
// 场景：新装/更换灯具后手动编址：按图纸给某盏灯设定 DMX 帧起始通道(如第 45 通道)。
// 价值：把单台设备 DMX512 编址做成一次 PLC 调用，配合回读实现可验证的地址配置，免去进菜单手拨。
// 验证：设 iNewStartAddr:=45（须在 1-512），给 bDoSet 一次上升沿 -> bBusy 短暂 TRUE -> 回 FALSE 后用 FB_DMXGetDMX512StartAddress 回读应为 45；越界则 bError 且 udiErrId=0x800B。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_DMX；同项目里放一个 FB_EL6851CommunicationEx 实例并共用 stDmxCmdBuffer（非 CycleMode）
//   3. 编译 → 登录 → 运行；按上方『验证』行在线给上升沿观察
// ============================================================

// 注意：目标地址形参为德式拼写 iDMX512Startadresse（PDF/库中实际命名）
fbSetStartAddr(
    bStart                     := bDoSet,
    wDestinationManufacturerId := wTargetManufId,
    dwDestinationDeviceId      := dwTargetDeviceId,
    byPortId                   := byTargetPort,
    iDMX512Startadresse        := iNewStartAddr,
    dwOptions                  := 0,
    stCommandBuffer            := stDmxCmdBuffer,
    bBusy                      => bBusy,
    bError                     => bError,
    udiErrorId                 => udiErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
