<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IOF_SER_GetPhase" Id="{a0c76225-929f-565f-90f4-3fb1b6742955}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IOF_SER_GetPhase
VAR
    fbGetSercosPhase    : IOF_SER_GetPhase; // SERCOS phase 查询 FB
    sLocalNetId         : T_AmsNetId := ''; // 本机
    nSercosDeviceId     : UDINT := 1; // SERCOS 主站 Device Id
    bGetCurrentPhase    : BOOL := FALSE; // 上升沿触发
    tPhaseTimeout       : TIME := T#5S; // 超时
    bGetPhaseBusy       : BOOL; // 工作中
    bGetPhaseErr        : BOOL; // 出错
    nGetPhaseErrId      : UDINT; // 错误号
    nCurrentSercosPhase : BYTE; // 当前 phase 0..4
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：SERCOS 启动期诊断：周期读 phase，phase = 4 才允许程序进入运行模式。
// 价值：避免对未就绪的 drive 发 motion 指令。
// 验证：登录后 nSercosDeviceId 设为 SERCOS 主站 Device Id；写 bGetCurrentPhase := TRUE → bGetPhaseBusy 短暂 TRUE → 回 FALSE 后 nCurrentSercosPhase 显示当前 phase（正常运行时应 = 4）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbGetSercosPhase(
    NETID    := sLocalNetId,
    DEVICEID := nSercosDeviceId,
    GET      := bGetCurrentPhase,
    TMOUT    := tPhaseTimeout,
    BUSY     => bGetPhaseBusy,
    ERR      => bGetPhaseErr,
    ERRID    => nGetPhaseErrId,
    PHASE    => nCurrentSercosPhase
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
