  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ULINT_TO_ULARGE" pouType="program">
        <interface>
          <localVars>
            <variable name="nNativeU64"><initialValue><simpleValue value="12345678901234"/></initialValue><type><ULINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：TwinCAT 3 原生计数器</xhtml></documentation></variable>
            <variable name="stLegacy"><type><derived name="T_ULARGE_INTEGER"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TwinCAT 2 旧格式</xhtml></documentation></variable>
            <variable name="bConvert"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把 TwinCAT 3 的高精度计数器（`ULINT`）传给老 BC2000 接口（接受 `T_ULARGE_INTEGER`）。
// 价值：替代手写 SHR / AND / 拆位的 5 行代码。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bConvert THEN
    stLegacy := ULINT_TO_ULARGE(in := nNativeU64);
    bConvert := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
