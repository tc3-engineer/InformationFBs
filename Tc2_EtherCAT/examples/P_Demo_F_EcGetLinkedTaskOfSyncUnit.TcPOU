<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_EcGetLinkedTaskOfSyncUnit" Id="{2ee2497f-340c-504e-b899-a0a5aa46eae1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_EcGetLinkedTaskOfSyncUnit
VAR
    bDoCheckOnce        : BOOL := FALSE;
    nMotionSyncUnitOid  : OTCID;            // 在线赋 XAE 中要查的 SU OID
    sLinkedTaskName     : STRING(80);
    nLinkedTaskOid      : OTCID;
    hrResult            : HRESULT;
    bSuccess            : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc2_EtherCAT.F_EcGetLinkedTaskOfSyncUnit 演示程序
// =============================================================================
// 场景：工程师接手陌生工程含多 Sync Unit。需要列出"哪个 SU 挂在哪个 task"
//       做工程结构梳理。本 FC 作为脚本主体：传入 SU OID 即拿到 task 名与
//       OID，全自动归档免去右键查 properties。
//
// 价值：把工程拓扑结构变可程序化访问，给"自动化文档生成"工具链奠基。
//
// 验证步骤：
//   1. Import 本文件，编译 → 登录；TwinCAT v3.1.4024.22+，Tc2_EtherCAT 3.3.17.0+
//   2. XAE 主站 → Process Image，找到目标 SU 的 OTCID，在线把
//      nMotionSyncUnitOid 设为该值
//   3. 在线脉冲 bDoCheckOnce := TRUE 触发一次（同步 FC，立即返回）
//        - bSuccess 应为 TRUE
//        - sLinkedTaskName 应填入 task 名（如 "PlcTask"）
//        - nLinkedTaskOid 应为非 0
// =============================================================================

IF bDoCheckOnce THEN
    bDoCheckOnce := FALSE;
    hrResult := F_EcGetLinkedTaskOfSyncUnit(
        oidSyncUnit   := nMotionSyncUnitOid,
        sLinkedTask   => sLinkedTaskName,
        oidLinkedTask => nLinkedTaskOid
    );
    bSuccess := SUCCEEDED(hrResult);
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
