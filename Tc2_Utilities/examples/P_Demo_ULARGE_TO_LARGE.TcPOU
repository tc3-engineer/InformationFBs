<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ULARGE_TO_LARGE" Id="{9762815d-4680-54e5-abce-ecd9200a7995}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ULARGE_TO_LARGE
VAR
    uliRaw   : T_ULARGE_INTEGER;
    liSigned : T_LARGE_INTEGER;
    bConvert : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.ULARGE_TO_LARGE 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：无符号读回的位串希望按有符号显示（比如负温度的差值表示）。
// 价值：替代字段复制。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    liSigned := ULARGE_TO_LARGE(uliRaw);
    bConvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
