<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_LicFileDelete" Id="{d818ba5e-0695-5d23-b71e-29bba03c5791}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_LicFileDelete
VAR
    fbFB_LicFileDelete : FB_LicFileDelete; // FB_LicFileDelete 实例
    bExec              : BOOL := FALSE;
    bBusy_             : BOOL;
    bErrFlag           : BOOL;
    nErrCode           : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：清理过期 License。
// 价值：脚本化清理。
// 验证：触发后观察 bDone / bErr，错误号 nErrId 反映 ADS Return Codes。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_LicFileDelete(
    bExecute := bExec, tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy => bBusy_, bError => bErrFlag, nErrorId => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
