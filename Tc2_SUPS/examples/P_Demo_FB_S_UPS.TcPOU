<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_S_UPS" Id="{9715e1af-840e-5e74-9125-ed196eb4db6b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_S_UPS
VAR
    fbSUPS              : FB_S_UPS; // CX50x0 平台 1-second UPS 管家
    nProductCountRetain : UDINT; // 本班次产量计数；工程里应声明为 VAR RETAIN
    iStepNoRetain       : INT; // 当前工序号；工程里应声明为 VAR RETAIN
    bPowerFailNow       : BOOL; // 实时电源标志：掉电中 = TRUE
    eUpsState           : E_S_UPS_State; // 在线 monitor 观察应急流程当前阶段
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：某 CX5020 嵌入式控制器跑 PLC + HMI，掉电时要保住班次产量与当前工序号
//       两个 retain 变量。1-second UPS 给我们 ~2 秒在掉电后完成写盘 + 关机。
//
// 价值：CX50x0 上 UPS 状态来自 ADS 端口 16#4A8。不用本 FB 要自己写 ADS 客户端
//       → 读端口 → 解析状态字 → 触发 SPDM_2PASS → 等回执 → 调用
//       FB_NT_QuickShutdown → 处理超时回退。封装后业务只看 eUpsState 走向。
//
// 验证步骤：
//   1. 引用 Tc2_SUPS（含依赖 Tc2_System）
//   2. 在 PLC 项目中右键 → Add Existing Item (.TcPOU) → 选本文件 → OK
//   3. 把 nProductCountRetain / iStepNoRetain 在 GVL 里改为 VAR RETAIN（演示
//      文件这里保留普通 VAR 以便携；实际工程必须 RETAIN 才会被存盘）
//   4. 若运行在 Windows Embedded Standard 7P：打开 EWF 或 FBWF，确保
//      TwinCAT\Boot 在不受写过滤保护的分区/Exclusion 中
//   5. Properties → PLC → Router Memory 调到 retain 总量的 1.5-2 倍
//   6. 编译、登录、运行
//   7. 在线把 nProductCountRetain 改到非零；模拟掉电（拔 24V，仅台架无负载）
//   8. 观察 bPowerFailNow 立即变 TRUE，eUpsState 走过 eSUPS_PowerFailure →
//      eSUPS_WritePersistentData → eSUPS_QuickShutdown → 系统重启
//   9. 上电后再连接，确认 nProductCountRetain / iStepNoRetain 仍是掉电前的值
// =============================================================================

// 单次调用形式：所有 VAR_INPUT 显式赋值；输出端用 => 截获
// 全部 PDF 推荐默认；CX50x0 上不应改动（iUPSPort = 16#4A8 是平台默认）
fbSUPS(
    sNetID           := '',
    iPLCPort         := 0,
    iUPSPort         := 16#4A8,
    tTimeout         := DEFAULT_ADS_TIMEOUT,
    eUpsMode         := eSUPS_WrPersistData_Shutdown,
    ePersistentMode  := SPDM_2PASS,
    tRecoverTime     := T#10S,
    bPowerFailDetect => bPowerFailNow,
    eState           => eUpsState
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
