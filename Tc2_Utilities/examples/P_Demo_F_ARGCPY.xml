  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_ARGCPY" pouType="program">
        <interface>
          <localVars>
            <variable name="fAlarmTempLive"><type><LREAL/></type>
              <initialValue><simpleValue value="0.0"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实时温度（持续变化）</xhtml></documentation>
            </variable>
            <variable name="fAlarmTempSnapshot"><type><LREAL/></type>
              <initialValue><simpleValue value="0.0"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">快照缓冲（独立内存）</xhtml></documentation>
            </variable>
            <variable name="argLive"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">指向实时温度的 T_Arg</xhtml></documentation>
            </variable>
            <variable name="argSnapshot"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">指向快照缓冲的 T_Arg</xhtml></documentation>
            </variable>
            <variable name="nBytesCopied"><type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拷贝字节数（应等于 SIZEOF(LREAL) = 8）</xhtml></documentation>
            </variable>
            <variable name="bUseTypeSafeCopy"><type><BOOL/></type>
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">是否类型安全拷贝</xhtml></documentation>
            </variable>
            <variable name="bSnapshot"><type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 触发一次快照拷贝</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.F_ARGCPY 演示程序
// ============================================================
// 场景：报警温度快照——原变量在下一周期会被新值覆盖，但日志要保留首次瞬时值。
// 价值：dest := src 是浅拷（pData 仍指原变量），F_ARGCPY 才是深拷（独立内存）。
// 验证：在线 fAlarmTempLive := 95.0、bSnapshot := TRUE；再改 fAlarmTempLive := 25.0；
//       fAlarmTempSnapshot 应仍为 95.0；nBytesCopied 应为 8。
// ============================================================

// 先把 src/dest 都绑定到各自的本地稳定内存
argLive     := F_LREAL(fAlarmTempLive);
argSnapshot := F_LREAL(fAlarmTempSnapshot);

IF bSnapshot THEN
    // 深拷：把 argLive.pData^ 的 8 字节复制到 argSnapshot.pData^（即 fAlarmTempSnapshot）
    nBytesCopied := F_ARGCPY(typeSafe := bUseTypeSafeCopy,
                             dest := argSnapshot,
                             src  := argLive);
    bSnapshot := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
