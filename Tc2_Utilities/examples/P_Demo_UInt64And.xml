  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64And" pouType="program">
        <interface>
          <localVars>
            <variable name="uliStatus">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">状态寄存器（64 位）</xhtml></documentation>
            </variable>
            <variable name="uliMask">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">掩码：低 16 位</xhtml></documentation>
            </variable>
            <variable name="uliFaultCode">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">屏蔽后的故障码</xhtml></documentation>
            </variable>
            <variable name="bMaskNow">
              <type><derived name="BOOL;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发屏蔽</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64And 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：ADS Raw 报文里把状态寄存器的 64 位状态位按掩码取出特定子位段（如故障码低 16 位）。
// 价值：替代分别 AND 高低 DWORD 两行；语义更清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

uliMask := ULARGE_INTEGER(0, 16#0000FFFF);   // 取低 16 位的掩码
IF bMaskNow THEN
    uliFaultCode := UInt64And(uliStatus, uliMask);
    bMaskNow := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
