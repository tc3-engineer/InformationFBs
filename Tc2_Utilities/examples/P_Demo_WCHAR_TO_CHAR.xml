    <pous>
      <pou name="P_Demo_WCHAR_TO_CHAR" pouType="program">
        <interface>
          <localVars>
            <variable name="sTextIn"><initialValue><simpleValue value="&quot;A&quot;"/></initialValue><type><wstring><length>1</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输入单字符 WSTRING(1)</xhtml></documentation></variable>
            <variable name="sOut"><type><string><length>1</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换得到的 STRING(1)</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 把 WSTRING 字符变量复制到只支持 STRING 的旧 ADS 接口。
// 价值：单字符场景比 `WSTRING_TO_STRING2`（整串）省事。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
sOut := WCHAR_TO_CHAR(sTextIn);</xhtml></ST>
        </body>
      </pou>
