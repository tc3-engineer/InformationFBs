<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2QueryRandomAddress" Id="{72bab4c6-d2af-5f2c-89ee-164bd7fb93f1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2QueryRandomAddress
VAR
    fbFB_DALIV2QueryRandomAddress        : FB_DALIV2QueryRandomAddress;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    nLampAddr        : BYTE := 0;

    wQueryGroups     : WORD;

    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：巡检读取 short addr 0 的 查询灯具 `RANDOM ADDRESS` 寄存器（24-bit 随机地址，寻址过程用）。
//
// 价值：HMI 实时显示 / 上线批量校验用。
//
// 验证步骤：
//   1. 通信 FB 跑起；编译；登录。
//   2. 在线 bTrigger 一次上升沿；等 bBusy 回 FALSE。
//   3. 观察 fbFB_DALIV2QueryRandomAddress.dwQueryData 应为预期值（参考本 FB 文档 §4 描述）。
// =============================================================================
fbFB_DALIV2QueryRandomAddress(
    bStart           := bTrigger,
    nAddr            := nLampAddr,
    eAddrType        := eDALIV2AddrTypeShort,
    eCommandPriority := eDALIV2CommandPriorityLow,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2QueryRandomAddress.bBusy;
bErr   := fbFB_DALIV2QueryRandomAddress.bError;
nErrId := fbFB_DALIV2QueryRandomAddress.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
