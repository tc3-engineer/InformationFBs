<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACSummerNightCooling" Id="{c1fd3ef5-a914-5e45-a1db-c1f3617caec4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACSummerNightCooling
VAR
    fb : FB_HVACSummerNightCooling;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    rOutsideTemp_in : REAL := 0.0;
    rRoomTemp_in : REAL := 0.0;
    rSetpointRoomTemp_in : REAL := 0.0;
    dtSystemTime_in : DT ;
    bReset_in : BOOL := FALSE;
    rMinimumOutsideTemp_io : REAL := 0.0;
    rDifferOutsideRoomTempOn_io : REAL := 0.0;
    rDifferOutsideRoomTempOff_io : REAL := 0.0;
    rDifferRoomSetpointTemp_io : REAL := 0.0;
    todStartTime_io : TOD ;
    tMaxRuntime_io : TIME := T#0S;
    bOn_out : BOOL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACSummerNightCooling 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACSummerNightCooling.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    rOutsideTemp := rOutsideTemp_in,
    rRoomTemp := rRoomTemp_in,
    rSetpointRoomTemp := rSetpointRoomTemp_in,
    dtSystemTime := dtSystemTime_in,
    bReset := bReset_in,
    rMinimumOutsideTemp := rMinimumOutsideTemp_io,
    rDifferOutsideRoomTempOn := rDifferOutsideRoomTempOn_io,
    rDifferOutsideRoomTempOff := rDifferOutsideRoomTempOff_io,
    rDifferRoomSetpointTemp := rDifferRoomSetpointTemp_io,
    todStartTime := todStartTime_io,
    tMaxRuntime := tMaxRuntime_io,
    bOn => bOn_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
