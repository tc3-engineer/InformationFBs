<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_CSVMemBufferReader" Id="{19a95cde-71da-5114-b157-3e1426b821df}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_CSVMemBufferReader
VAR
    fbFB_CSVMemBufferReader : FB_CSVMemBufferReader; // FB_CSVMemBufferReader 实例
    eCmd                    : E_EnumCmdType := eEnumCmd_First;
    pBuffer                 : POINTER TO BYTE;
    cbBuffer                : UDINT;
    bOk                     : BOOL;
    getValue                : T_MaxString;
    pValue                  : POINTER TO BYTE;
    cbValue                 : UDINT;
    bCRLF                   : BOOL;
    cbRead                  : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：读配方 CSV。
// 价值：替代手写解析。
// 验证：先 Init 绑定缓冲，循环调 GetNextField 取每个字段。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_CSVMemBufferReader(
    eCmd := eCmd,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk => bOk,
    getValue => getValue,
    pValue => pValue,
    cbValue => cbValue,
    bCRLF => bCRLF,
    cbRead => cbRead
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
