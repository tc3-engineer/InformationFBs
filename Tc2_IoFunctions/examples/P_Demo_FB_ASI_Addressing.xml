<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_ASI_Addressing Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_ASI_Addressing" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAsiAddressing">
              <type><derived name="FB_ASI_Addressing"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 编址 FB</xhtml></documentation>
            </variable>
            <variable name="fbAsiParamControl">
              <type><derived name="FB_ASI_ParameterControl"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 后台调度 FB（必须循环调用）</xhtml></documentation>
            </variable>
            <variable name="stAsiParamBuffer">
              <type><derived name="ST_ParameterBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">所有 ASI FB 共享的后台缓冲</xhtml></documentation>
            </variable>
            <variable name="stAsiInProcessImg">
              <type><derived name="ST_Parameter_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 主端子输入过程数据（链到 %I*）</xhtml></documentation>
            </variable>
            <variable name="stAsiOutProcessImg">
              <type><derived name="ST_Parameter_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 主端子输出过程数据（链到 %Q*）</xhtml></documentation>
            </variable>
            <variable name="iCurrentAddr">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前地址（新出厂默认 0）</xhtml></documentation>
            </variable>
            <variable name="iAddressToAssign">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要分配的新地址</xhtml></documentation>
            </variable>
            <variable name="bStartAddressing">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发一次编址</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：线上替换故障 ASI 流量计：新设备出厂地址 0，需要在线把它编址为故障 slave 原来的地址 5。
// 价值：完全在 PLC 程序里完成现场设备替换，不用 ASI 手持工具。
// 验证：登录前确认 stAsiInProcessImg / stAsiOutProcessImg 已链到 ASI 主端子；fbAsiParamControl 已加入 PlcTask 循环；在线写 iCurrentAddr := 0、iAddressToAssign := 5、bStartAddressing := TRUE → fbAsiAddressing.bBusy 短暂 TRUE → 回 FALSE 后看 fbAsiAddressing.bErr：FALSE 表示编址成功；用 FB_ASI_SlaveDiag 在地址 5 上读应能查到该 slave。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 后台调度 FB 必须每周期调用 — 这是所有 ASI FB 工作的前提
fbAsiParamControl(
    stParameterBuffer := stAsiParamBuffer,
    stParameter_IN    := stAsiInProcessImg,
    stParameter_OUT   := stAsiOutProcessImg
);

// 单次调用形式：bStartAddressing 上升沿触发
fbAsiAddressing(
    iOldAddress       := iCurrentAddr,
    iNewAddress       := iAddressToAssign,
    bStart            := bStartAddressing,
    stParameterBuffer := stAsiParamBuffer
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
