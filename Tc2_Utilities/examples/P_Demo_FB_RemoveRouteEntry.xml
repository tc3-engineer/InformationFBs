  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RemoveRouteEntry" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_RemoveRouteEntry">
              <type><derived name="FB_RemoveRouteEntry"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_RemoveRouteEntry 实例</xhtml></documentation>
            </variable>
            <variable name="bRemove">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发删除</xhtml></documentation>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：批量清理 retrofit 后的旧路由条目。
// 价值：替代手动删除。
// 验证：先用 FB_EnumRouteEntry 看路由表，确认目标条目存在；写 bRemove := TRUE 触发删除；再次 Enum 应看不到该条目。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_RemoveRouteEntry(
    sNetID := '',
    bExecute := bRemove,
    sRemoteName := 'CX-OldLine',
    sRemoteRouteName := 'AutoRoute-OldLine',
    tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
