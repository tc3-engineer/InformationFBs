<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_GetDayOfMonthEx Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetDayOfMonthEx" pouType="program">
        <interface>
          <localVars>
            <variable name="wYear">
              <type><WORD/></type>
              <initialValue><simpleValue value="2026"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标年份</xhtml></documentation>
            </variable>
            <variable name="wMonth">
              <type><WORD/></type>
              <initialValue><simpleValue value="5"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标月份</xhtml></documentation>
            </variable>
            <variable name="wWOM">
              <type><WORD/></type>
              <initialValue><simpleValue value="2"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">月内第几周（1~5，5=最后一周）</xhtml></documentation>
            </variable>
            <variable name="wDOW">
              <type><WORD/></type>
              <initialValue><simpleValue value="1"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">星期几（0=周日 ... 6=周六，本例周一=1）</xhtml></documentation>
            </variable>
            <variable name="wMeetingDay">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">算出的开会日期（该月的日）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：排产规则「每月第 2 个周一开例会」运行时需算出本月该日期
//
// 价值：1 行调用得到日期，不必循环遍历该月每天找匹配星期
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE 一个周期
//   4. 在线观察 wMeetingDay 应为 11（2026 年 5 月第 2 个周一是 11 号）
//   5. wWOM := 5 重测 → 26（5 月最后一个周一）
// =============================================================================
wMeetingDay := F_GetDayOfMonthEx(wYear, wMonth, wWOM, wDOW);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
