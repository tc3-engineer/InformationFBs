<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_GetMonthOfDOY Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetMonthOfDOY" pouType="program">
        <interface>
          <localVars>
            <variable name="wYear">
              <type><WORD/></type>
              <initialValue><simpleValue value="2024"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">年份</xhtml></documentation>
            </variable>
            <variable name="wDOY">
              <type><WORD/></type>
              <initialValue><simpleValue value="60"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">年内第几天</xhtml></documentation>
            </variable>
            <variable name="wMonth">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">算出的月份（1~12）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：气象数据用 DOY 紧凑存档，读取时需反查回月份做月度报表
//
// 价值：1 行反查避免手写 12 个月累计减法 + 闰年判定
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 wMonth = 2（2024 年第 60 天是 2 月 29 日）
//   5. wDOY:=131 → wMonth = 5
//   6. wDOY:=366; wYear:=2023 → wMonth = 0（平年无 366 天）
// =============================================================================
wMonth := F_GetMonthOfDOY(wYear, wDOY);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
