  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GETCPUCOUNTER" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGETCPUCOUNTER">
              <type><derived name="GETCPUCOUNTER"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">GETCPUCOUNTER 实例</xhtml></documentation>
            </variable>
            <variable name="udwCntLo">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">64-bit 低 32 位</xhtml></documentation>
            </variable>
            <variable name="udwCntHi">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">64-bit 高 32 位</xhtml></documentation>
            </variable>
            <variable name="ulCntCombined">
              <type><ULINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拼成 64-bit</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.GETCPUCOUNTER 演示程序
// ============================================================
// 场景：给工件打 100 ns 精度时间戳；24h 连续运行用 64-bit 不回卷。
// 价值：替代 F_GetSystemTime（NTP 同步会跳）。
// 验证：登录后 ulCntCombined 应持续单调递增，每个 PLC 周期增长约 (任务周期 / 100ns)。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

fbGETCPUCOUNTER(cpuCntLoDW =&gt; udwCntLo, cpuCntHiDW =&gt; udwCntHi);

// 拼成 64-bit
ulCntCombined := SHL(TO_ULINT(udwCntHi), 32) OR TO_ULINT(udwCntLo);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
