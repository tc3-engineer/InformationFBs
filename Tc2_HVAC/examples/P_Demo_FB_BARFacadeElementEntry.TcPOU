<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARFacadeElementEntry" Id="{51d1761b-6fc6-531c-9920-8afbdadb478a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARFacadeElementEntry
VAR
    fb : FB_BARFacadeElementEntry;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    iColumn_in : INT := 0;
    iRow_in : INT := 0;
    bWrite_in : BOOL := FALSE;
    bRead_in : BOOL := FALSE;
    usiGroup_in : USINT := 0;
    lrCorner1X_in : LREAL := 0.0;
    lrCorner1Y_in : LREAL := 0.0;
    lrWindowWidth_in : LREAL := 0.0;
    lrWindowHeight_in : LREAL := 0.0;
    arrFacadeElement_io : ARRAY[1..iColumnsPerFacade, 1..iRowsPerFacade] OF ST_BARFacadeElement ;
    lrCorner2X_out : LREAL;
    lrCorner2Y_out : LREAL;
    lrCorner3X_out : LREAL;
    lrCorner3Y_out : LREAL;
    lrCorner4X_out : LREAL;
    lrCorner4Y_out : LREAL;
    bValid_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARFacadeElementEntry 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARFacadeElementEntry.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    iColumn := iColumn_in,
    iRow := iRow_in,
    bWrite := bWrite_in,
    bRead := bRead_in,
    usiGroup := usiGroup_in,
    lrCorner1X := lrCorner1X_in,
    lrCorner1Y := lrCorner1Y_in,
    lrWindowWidth := lrWindowWidth_in,
    lrWindowHeight := lrWindowHeight_in,
    arrFacadeElement := arrFacadeElement_io,
    lrCorner2X => lrCorner2X_out,
    lrCorner2Y => lrCorner2Y_out,
    lrCorner3X => lrCorner3X_out,
    lrCorner3Y => lrCorner3Y_out,
    lrCorner4X => lrCorner4X_out,
    lrCorner4Y => lrCorner4Y_out,
    bValid => bValid_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
