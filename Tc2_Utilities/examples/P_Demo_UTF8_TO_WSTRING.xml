  <contentHeader name="Tc2_Utilities.UTF8_TO_WSTRING Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UTF8_TO_WSTRING" pouType="program">
        <interface>
          <localVars>
            <variable name="aUtf8"><type><array><dimension lower="0" upper="63"/><baseType><BYTE/></baseType></array></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：UTF-8 输入</xhtml></documentation></variable>
            <variable name="wsOut"><type><wstring><length>64</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 WSTRING（保留 Unicode）</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换成功</xhtml></documentation></variable>
            <variable name="nDstLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标字符数</xhtml></documentation></variable>
            <variable name="bConvert"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 显示模块用 WSTRING；从 OPC UA Server 收到的 UTF-8 文本需先转 WSTRING 才能送到 HMI。
// 价值：比 `UTF8_TO_STRING` 保真度高——Unicode 全字符集；适合多语言 HMI。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bConvert THEN
    aUtf8[0] := 16#48; aUtf8[1] := 16#69; aUtf8[2] := 16#00;
    bOk := UTF8_TO_WSTRING(pDstWSTRING := ADR(wsOut),
                           pSrcUTF8    := ADR(aUtf8),
                           nDstSize    := SIZEOF(wsOut),
                           nDstLen     => nDstLen);
    bConvert := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
