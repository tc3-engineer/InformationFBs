  <contentHeader name="Tc2_Utilities.FB_WritePersistentData Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_WritePersistentData" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_WritePersistentData">
              <type><derived name="FB_WritePersistentData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_WritePersistentData 实例</xhtml></documentation>
            </variable>
            <variable name="bWrite">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：配置变更后强制写文件。
// 价值：时机可控。
// 验证：变更 persistent 变量后触发；观察对应 `.bootdata` 文件被更新。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_WritePersistentData(
    NETID := '', PORT := 851, START := bWrite, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
