<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_CreateGUID Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_CreateGUID" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_CreateGUID">
              <type><derived name="FB_CreateGUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_CreateGUID 实例</xhtml></documentation>
            </variable>
            <variable name="bGenGuidReq">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿一次生成一批 GUID</xhtml></documentation>
            </variable>
            <variable name="arrGuidPool">
              <type><array><dimension lower="0" upper="9"/><baseType><derived name="GUID"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">一次生成 10 个 GUID 的池</xhtml></documentation>
            </variable>
            <variable name="bGenGuidBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">生成中</xhtml></documentation>
            </variable>
            <variable name="bGenGuidErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误</xhtml></documentation>
            </variable>
            <variable name="nLastAdsError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误码</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.FB_CreateGUID 演示程序
// ============================================================
// 场景：包装线给每件出箱品分配 GUID 写二维码做追溯。
// 价值：替代手写时间戳+计数器伪 GUID；本 FB 调系统服务生成 RFC4122 标准 GUID。
// 验证：在线写 bGenGuidReq := TRUE，bGenGuidBusy 一闪后 arrGuidPool 全部 10 元素装入互不相同的 GUID（每个 16 字节）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

fbFB_CreateGUID(
    bExecute := bGenGuidReq, sNetId := '', tTimeout := DEFAULT_ADS_TIMEOUT, pGuidBuffer := ADR(arrGuidPool), nGuidBufferSize := SIZEOF(arrGuidPool),
    bBusy =&gt; bGenGuidBusy, bError =&gt; bGenGuidErr, nErrorId =&gt; nLastAdsError
);

</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
