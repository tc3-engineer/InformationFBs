<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-10T09:00:00"/>
  <contentHeader name="Tc2_Coupler.CouplerReset Demo" modificationDateTime="2026-05-10T09:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_CouplerReset" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCouplerReset">
              <type><derived name="CouplerReset"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Function blocks 实例</xhtml></documentation>
            </variable>
            <variable name="arg_STATE">
              <type><derived name="PLCINTFSTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT STATE: 2-byte PLC interface 状态字（链接到 IO）</xhtml></documentation>
            </variable>
            <variable name="arg_START">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT START: 上升沿触发复位</xhtml></documentation>
            </variable>
            <variable name="arg_TMOUT">
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT TMOUT: 执行超时</xhtml></documentation>
            </variable>
            <variable name="out_CONTROL">
              <type><derived name="PLCINTFSTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT CONTROL: 2-byte PLC interface 控制字（链接到 IO）</xhtml></documentation>
            </variable>
            <variable name="out_BUSY">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT BUSY: 执行中</xhtml></documentation>
            </variable>
            <variable name="out_ERR">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT ERR: 执行出错</xhtml></documentation>
            </variable>
            <variable name="out_ERRID">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT ERRID: 错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Coupler.CouplerReset 演示程序
// ============================================================
// 场景：K-bus 异常时通过 PLC 远程复位耦合器
// 验证步骤：
//   1. 引用 Tc2_Coupler（及其依赖：Tc2_System 等）
//   2. 编译 + 登录
//   3. 在线监视各 out_* 输出
//   4. 必要时按场景给 arg_* 输入赋值（详见 doc.md 的'使用注意'）
// ============================================================

fbCouplerReset(
    STATE := arg_STATE,
    START := arg_START,
    TMOUT := arg_TMOUT,
    CONTROL => out_CONTROL,
    BUSY => out_BUSY,
    ERR => out_ERR,
    ERRID => out_ERRID
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
