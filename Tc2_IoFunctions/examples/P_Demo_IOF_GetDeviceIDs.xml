<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_GetDeviceIDs Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_GetDeviceIDs" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReadAllDeviceIds">
              <type><derived name="IOF_GetDeviceIDs"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB：一次性读所有 IO 设备 ID</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="aDeviceIdBuffer">
              <type><array><dimension lower="1" upper="201"/><baseType><WORD/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ID 缓冲（最多 200 设备）</xhtml></documentation>
            </variable>
            <variable name="bStartReadAllIds">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tReadTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bReadBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bReadError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：上电自检：一次性读出所有现场总线 / IO 设备的 ID，后续 for 循环遍历做巡检。
// 价值：减少 ADS 调用次数，从 N 次降到 1 次。
// 验证：登录后写 bStartReadAllIds := TRUE → bReadBusy 短暂 TRUE → 回 FALSE 后 aDeviceIdBuffer[1] 是数量，aDeviceIdBuffer[2..] 是各 ID。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// LEN 用 SIZEOF 自动算字节数；DESTADDR 用 ADR(数组)
fbReadAllDeviceIds(
    NETID    := sTargetNetId,
    LEN      := SIZEOF(aDeviceIdBuffer),
    DESTADDR := ADR(aDeviceIdBuffer),
    START    := bStartReadAllIds,
    TMOUT    := tReadTimeout,
    BUSY     =&gt; bReadBusy,
    ERR      =&gt; bReadError,
    ERRID    =&gt; nLastErrCode
);

// 完成后 aDeviceIdBuffer[1] = 数量，aDeviceIdBuffer[2..] 是各 ID（必须等 bReadBusy 落回再读结果）
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
