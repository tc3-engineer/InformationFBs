<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_CoEEL72xxSetPositionOffset" Id="{8b89dc79-1bbe-5a32-ab30-7c72dc2ee512}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_CoEEL72xxSetPositionOffset
VAR
    fbEL72xxSetOffset   : FB_CoEEL72xxSetPositionOffset; // EL72xx 写位置偏置 FB 实例
    axisServo           : AXIS_REF; // EL72xx 伺服轴轴引用；必须先在 System Manager 配好并 Link
    rtSetTrig           : R_TRIG; // 把电平转上升沿
    bSetOffsetReq       : BOOL := FALSE; // 在线写 TRUE 触发一次写偏置
    lrNewActualPosition : LREAL := 0.0; // 把当前点设为的新实际位置；0 = 设零点
    bSetBusy            : BOOL;
    bSetError           : BOOL;
    nSetErrorID         : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：EL72xx 端子伺服驱动的轴手动回到机械参考挡块后，把当前位置设为绝对
//       零点（Position=0, Relative=FALSE），偏置存进驱动器内存，PLC 重启不丢。
//
// 价值：1) 偏置常驻 EL72xx 驱动器内存，PLC 重启/工程下载不用重新找零
//       2) EL72xx 专用接口直达（也可用硬件无关的 FB_SetPositionOffset）
//       3) 绝对/相对两种语义覆盖"设零"和"微调"
//
// !! 注意：EL72xx 当前不支持把偏置存进编码器铭牌，Memory 必须选 _Drive。
//          轴静止时写。本 FB 没有 NetId/Timeout 输入。
//
// 验证步骤：
//   1. System Manager 配好 EL72xx NC 轴并 Link 给 axisServo，引用 Tc2_MC2_Drive
//   2. Add Existing Item (.TcPOU) 选本文件，加进 PlcTask，编译登录
//   3. 手动把轴开到机械参考挡块，确认已静止
//   4. 在线写 bSetOffsetReq := TRUE → bSetBusy 置 TRUE
//   5. 等 bSetBusy 落回 FALSE 且 bSetError = FALSE 即写入成功，ActPos 应变 0
//   6. 若 bSetError = TRUE，看 nSetErrorID 对照 ADS Return Codes 表
// =============================================================================

// 用 R_TRIG 把"持续按住的 TRUE"转成真正的上升沿
rtSetTrig(CLK := bSetOffsetReq);

// 单次调用：绝对模式把当前点设为 lrNewActualPosition，Memory 必须 _Drive
// Axis 是 VAR_IN_OUT 必传；本 FB 无 Done，靠 Busy 落回 FALSE 判成功
fbEL72xxSetOffset(
    Execute  := rtSetTrig.Q,
    Position := lrNewActualPosition,
    Relative := FALSE,
    Feedback := ePositionOffsetFeedback1,
    Memory   := ePositionOffsetMemory_Drive,
    Axis     := axisServo,
    Busy     => bSetBusy,
    Error    => bSetError,
    ErrorID  => nSetErrorID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
