<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_DRIVE_BackupEx Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_DRIVE_BackupEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSercosDriveBackupEx">
              <type><derived name="IOF_SER_DRIVE_BackupEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS drive 备份 Ex FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nDrivePort">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive port</xhtml></documentation>
            </variable>
            <variable name="sBackupComment">
              <initialValue><simpleValue value="'Drive 1 Ex backup'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">注释</xhtml></documentation>
            </variable>
            <variable name="eBackupFilePath">
              <initialValue><simpleValue value="PATH_BOOTPATH"/></initialValue>
              <type><derived name="E_OpenPath"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">路径</xhtml></documentation>
            </variable>
            <variable name="sBackupFileName">
              <initialValue><simpleValue value="'DRIVEPAR_EX.BIN'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">文件名</xhtml></documentation>
            </variable>
            <variable name="bDoCheckReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CRC</xhtml></documentation>
            </variable>
            <variable name="bDoBackupReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">备份</xhtml></documentation>
            </variable>
            <variable name="bDoRestoreReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">恢复</xhtml></documentation>
            </variable>
            <variable name="bEnableCRC">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CRC</xhtml></documentation>
            </variable>
            <variable name="bUseStdBackupList">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">IDN-192</xhtml></documentation>
            </variable>
            <variable name="bUseUserBackupList">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">用户清单</xhtml></documentation>
            </variable>
            <variable name="bIgnoreReadErrors">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">跳过不可读参数</xhtml></documentation>
            </variable>
            <variable name="tBackupTimeout">
              <initialValue><simpleValue value="T#30S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：只备份 drive 1 的 motion 关键参数（自定义清单）；备份遇错不中止。
// 价值：更精细控制。
// 验证：⚠️ PDF VAR 区未列 `arrList`；按 PDF 正文配置自定义清单后触发 bDoBackupReq；遇错可看 `bIgnoreParamErr` 是否生效。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// ⚠️ 完整 arrList 接口字段在 PDF VAR 区未列；按 PDF 正文与 drive 手册补充
fbSercosDriveBackupEx(
    bCheck          := bDoCheckReq,
    bBackup         := bDoBackupReq,
    bRestore        := bDoRestoreReq,
    bCRCEnable      := bEnableCRC,
    bStdBackupList  := bUseStdBackupList,
    bUserBackupList := bUseUserBackupList,
    sNetId          := sLocalNetId,
    nPort           := nDrivePort,
    sComment        := sBackupComment,
    ePath           := eBackupFilePath,
    sPathName       := sBackupFileName,
    tTimeout        := tBackupTimeout,
    bIgnoreParamErr := bIgnoreReadErrors
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
