<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_4OCTET_SIGN_SEND" Id="{fdc32e29-2be9-5eea-819b-04943bf2c1c8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_4OCTET_SIGN_SEND
VAR
    fbSendEnergy : EIB_4OCTET_SIGN_SEND;
    stEibRec     : EIB_REC;
    stGroup      : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 4, NUMBER := 14);
    data         : DINT := 0;
    bSendError   : BOOL;
    iLastErrID   : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_4OCTET_SIGN_SEND 演示程序
// ============================================================
// 场景：PLC 累计电能（DINT）发送到组 1/4/14。
// 价值：替代手写 DPT 13 编码；变化触发自动
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：改 `data` → 1 秒内 1/4/14 出新帧。
// ============================================================

fbSendEnergy(
    Group_Address := stGroup,
    iData         := data,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
