<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_KL1501Config Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_KL1501Config" pouType="program">
        <interface>
          <localVars>
            <variable name="fbKl1501">
              <type><derived name="FB_KL1501Config"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">KL1501 配置 FB</xhtml></documentation>
            </variable>
            <variable name="stKl1501InProcessImg">
              <type><derived name="ST_KL1501InData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">KL1501 输入过程映像（链到 %I*）</xhtml></documentation>
            </variable>
            <variable name="stKl1501OutProcessImg">
              <type><derived name="ST_KL1501OutData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">KL1501 输出过程映像（链到 %Q*）</xhtml></documentation>
            </variable>
            <variable name="bDoKl1501Configure">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿写配置</xhtml></documentation>
            </variable>
            <variable name="bDoKl1501ReadConfig">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿只读配置</xhtml></documentation>
            </variable>
            <variable name="iCounterTypeSelected">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=32 上下 1=2×16 上 2/3=门控</xhtml></documentation>
            </variable>
            <variable name="bReverseCountDir">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">反向计数</xhtml></documentation>
            </variable>
            <variable name="tKl1501ConfigTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">配置超时</xhtml></documentation>
            </variable>
            <variable name="bKl1501Busy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bKl1501Error">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="iLastKl1501Error">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="iKl1501State">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">状态字节</xhtml></documentation>
            </variable>
            <variable name="iCount0">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">通道 0 计数</xhtml></documentation>
            </variable>
            <variable name="iCount1">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">通道 1 计数</xhtml></documentation>
            </variable>
            <variable name="iCurrentCountValue">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">32 bit 组合计数值</xhtml></documentation>
            </variable>
            <variable name="iKl1501TerminalCode">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">端子型号编码</xhtml></documentation>
            </variable>
            <variable name="iKl1501SpecialVer">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">端子特殊版本</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：上电时把 KL1501 配为 32 bit 上下计数器，不反向；运行后读端子计数值进行设备速度计算。
// 价值：端子配置纳入 PLC 程序版本控制。
// 验证：登录确认 stKl1501InProcessImg / stKl1501OutProcessImg 已链到端子；在线写 bDoKl1501Configure := TRUE → fbKl1501.bBusy 短暂 TRUE → 回 FALSE 后 iLastKl1501Error = 0 表示成功；iCurrentCountValue 应反映编码器旋转。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbKl1501(
    bConfigurate         := bDoKl1501Configure,
    bReadConfig          := bDoKl1501ReadConfig,
    iSetCounterType      := iCounterTypeSelected,
    bSetBackwardCounting := bReverseCountDir,
    tTimeout             := tKl1501ConfigTimeout,
    stInData             := stKl1501InProcessImg,
    stOutData            := stKl1501OutProcessImg,
    bBusy                =&gt; bKl1501Busy,
    bError               =&gt; bKl1501Error,
    iErrorId             =&gt; iLastKl1501Error,
    iState               =&gt; iKl1501State,
    iDataIn0             =&gt; iCount0,
    iDataIn1             =&gt; iCount1,
    iDataIn              =&gt; iCurrentCountValue,
    iTerminalType        =&gt; iKl1501TerminalCode,
    iSpecialType         =&gt; iKl1501SpecialVer
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
