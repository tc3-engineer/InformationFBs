  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Int64Cmp64" pouType="program">
        <interface>
          <localVars>
            <variable name="liA">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="liB">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="diResult">
              <type><DINT/></type>
            </variable>
            <variable name="bCompare">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.Int64Cmp64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：对一组有符号扭矩误差排序。
// 价值：替代手写有符号比较；一行 DINT 比较一目了然。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCompare THEN
    diResult := Int64Cmp64(liA, liB);
    bCompare := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
