<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EqualsToEventEntryEx" Id="{02db033e-258d-56ec-8bbb-6e3d4e943ffa}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EqualsToEventEntryEx
VAR
    fbAlarm             : FB_TcAlarm; // alarm 实例
    stKnown             : TcEventEntry; // 预期事件定义
    bExpectConfirmation : BOOL := TRUE; // 预期确认要求
    bMatch              : BOOL; // 比较结果
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：判断现有 alarm 是否与新事件 + 确认要求组合相同
// 价值：一次比较覆盖 4 字段
// 验证：改 bWithConfirmation 单一字段即可让 bMatch 翻转
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

bMatch := fbAlarm.EqualsToEventEntryEx(
    stEventEntry := stKnown,
    bWithConfirmation := bExpectConfirmation);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
