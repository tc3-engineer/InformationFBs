    <pous>
      <pou name="P_Demo_FB_GetRtPerformanceData" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetRtPerformanceData">
              <type><derived name="FB_GetRtPerformanceData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetRtPerformanceData 实例</xhtml></documentation>
            </variable>
            <variable name="bExecute">
              <type><BOOL/></type>
            </variable>
            <variable name="bReset">
              <type><BOOL/></type>
            </variable>
            <variable name="tTimeout">
              <type><TIME/></type>
            </variable>
            <variable name="sNetId">
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrorId">
              <type><UDINT/></type>
            </variable>
            <variable name="nUsedCpuCount">
              <type><UDINT/></type>
            </variable>
            <variable name="stRtPerformanceData">
              <type><array><dimension lower="1" upper="nMaxCpuCount"/><baseType><derived name="ST_RtPerformanceData"/></baseType></array></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：深度性能分析。
// 价值：综合字段。
// 验证：触发后 stPerf 装载多个字段。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_GetRtPerformanceData(
    bExecute := bExecute,
    bReset := bReset,
    tTimeout := tTimeout,
    sNetId := sNetId,
    bBusy := bBusy,
    bError := bError,
    nErrorId := nErrorId,
    nUsedCpuCount := nUsedCpuCount,
    stRtPerformanceData := stRtPerformanceData
);
</xhtml></ST>
        </body>
      </pou>
