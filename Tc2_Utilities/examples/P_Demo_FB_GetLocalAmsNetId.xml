  <contentHeader name="Tc2_Utilities.FB_GetLocalAmsNetId Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetLocalAmsNetId" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetLocalAmsNetId">
              <type><derived name="FB_GetLocalAmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetLocalAmsNetId 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="sLocalNetId">
              <type><derived name="T_AmsNetID"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：开机后读一次本机 NetId 保存到 GVL。
// 价值：跨 TwinCAT 版本稳定，免手动配置。
// 验证：改 bRead := TRUE，观察 sLocalNetId 装载 `n.n.n.n.n.n` 形式字符串，与 SystemTray 里看到的 AmsNetId 一致。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetLocalAmsNetId(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    sNetID =&gt; sLocalNetId,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
