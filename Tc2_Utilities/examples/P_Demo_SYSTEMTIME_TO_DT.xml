<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.SYSTEMTIME_TO_DT Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_SYSTEMTIME_TO_DT" pouType="program">
        <interface>
          <localVars>
            <variable name="stOpcTime">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">OPC UA 收到的时间结构 (初始化通过在线手动赋值; 推荐字段：( wYear := 2026, wMonth := 5, wDay := 11, wHour := 12, wMinute := 34, wSecond := 56, wMilliseconds := 500 ))</xhtml></documentation>
            </variable>
            <variable name="dtFromOpc">
              <type><DATE_AND_TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转成 DT 后可参与 - 减法</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：OPC UA 收到 TIMESTRUCT，PLC 内部用 DT 做时间差减法更方便
//
// 价值：1 行完成结构体到 DT 折算，自动处理毫秒舍入策略
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE一次
//   4. 在线观察 dtFromOpc = DT#2026-05-11-12:34:57（500ms 进位）
//   5. 在线把 wMilliseconds := 0 重测 → DT#2026-05-11-12:34:56
// =============================================================================
dtFromOpc := SYSTEMTIME_TO_DT(stOpcTime);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
