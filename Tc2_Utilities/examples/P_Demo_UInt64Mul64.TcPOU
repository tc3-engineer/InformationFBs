<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UInt64Mul64" Id="{3766f2de-de62-55f3-be4d-ec12e7102a12}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UInt64Mul64
VAR
    uliA       : T_ULARGE_INTEGER;; // 操作数
    uliB       : T_ULARGE_INTEGER;; // 操作数
    uliProduct : T_ULARGE_INTEGER;; // 乘积
    bMultiply  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.UInt64Mul64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：低位 32 位以下的两个计数器相乘（确认不会溢出）求合并指标。
// 价值：替代 Ex 版本在已知安全的快路径上节省一个 VAR_IN_OUT 参数。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bMultiply THEN
    // 调用方已确保不溢出 → 跳过 Ex 版本的检测开销
    uliProduct := UInt64Mul64(uliA, uliB);
    bMultiply := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
