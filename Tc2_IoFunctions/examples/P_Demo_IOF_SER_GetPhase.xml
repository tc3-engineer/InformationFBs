<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_GetPhase Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_GetPhase" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetSercosPhase">
              <type><derived name="IOF_SER_GetPhase"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS phase 查询 FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nSercosDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS 主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="bGetCurrentPhase">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tPhaseTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bGetPhaseBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bGetPhaseErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nGetPhaseErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="nCurrentSercosPhase">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前 phase 0..4</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：SERCOS 启动期诊断：周期读 phase，phase = 4 才允许程序进入运行模式。
// 价值：避免对未就绪的 drive 发 motion 指令。
// 验证：登录后 nSercosDeviceId 设为 SERCOS 主站 Device Id；写 bGetCurrentPhase := TRUE → bGetPhaseBusy 短暂 TRUE → 回 FALSE 后 nCurrentSercosPhase 显示当前 phase（正常运行时应 = 4）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbGetSercosPhase(
    NETID    := sLocalNetId,
    DEVICEID := nSercosDeviceId,
    GET      := bGetCurrentPhase,
    TMOUT    := tPhaseTimeout,
    BUSY     =&gt; bGetPhaseBusy,
    ERR      =&gt; bGetPhaseErr,
    ERRID    =&gt; nGetPhaseErrId,
    PHASE    =&gt; nCurrentSercosPhase
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
