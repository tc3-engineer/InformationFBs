<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_FileLoad" Id="{08e9817b-dbc2-578c-a03f-092b87a48847}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_FileLoad
VAR
    fbFileLoad    : FB_FileLoad; // FB_FileLoad 实例
    sRecipePath   : T_MaxString := 'D:/config/recipe.bin'; // 配方文件路径
    aRecipeBuffer : ARRAY[0..255] OF BYTE; // 本地缓冲区
    bLoadRequest  : BOOL; // 在线写 TRUE 触发一次读取
    cbBytesLoaded : UDINT; // 实际读到字节数
    bLoadError    : BOOL; // TRUE = 读失败
    nErrIdLast    : UDINT; // ADS 错误号
    bBusyMon      : BOOL; // ADS 通讯中
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：启动时从 D:/config/recipe.bin 把整份配方（≤ 256 字节）一次性读入本地缓冲区。
// 价值：封装 3 个 FB 的状态机，省 25 行。
// 验证：在线置 bLoadRequest := TRUE → 观察 cbBytesLoaded ≈ 真实文件大小；故意指向不存在的文件 → bLoadError = TRUE 且 nErrIdLast = 0x70C。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileLoad(
    sNetId    := '',
    sPathName := sRecipePath,
    pReadBuff := ADR(aRecipeBuffer),
    cbReadLen := SIZEOF(aRecipeBuffer),
    bExecute  := bLoadRequest,
    tTimeout  := T#10S,
    bBusy     => bBusyMon,
    bError    => bLoadError,
    nErrId    => nErrIdLast,
    cbRead    => cbBytesLoaded
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
