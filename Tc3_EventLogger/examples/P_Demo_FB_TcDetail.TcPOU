<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_TcDetail" Id="{6df825a1-f197-5a21-bffc-711cd9d12442}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_TcDetail
VAR
    fbReq    : FB_RequestEventClassDetails; // 上游请求 FB
    fbDetail : FB_TcDetail; // 承载详情子项
    sName    : STRING(80); // name 字段
    sText    : STRING(255); // text 字段
    sComment : STRING(255); // comment 字段
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：循环读取事件详情列表的所有项
// 价值：结构化访问详情字段
// 验证：先有完成的 FB_RequestEventClassDetails；调 Get 填充本 FB；读各字段
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

fbReq.Get(nIndex := 0, fbResult := fbDetail);
fbDetail.GetName(sResult := sName);
fbDetail.GetText(sResult := sText);
fbDetail.GetComment(sResult := sComment);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
