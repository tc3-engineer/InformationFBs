    <pous>
      <pou name="P_Demo_FB_CheckOemLicense" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_CheckOemLicense">
              <type><derived name="FB_CheckOemLicense"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_CheckOemLicense 实例</xhtml></documentation>
            </variable>
            <variable name="bExecute">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="tTimeout">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="sNetId">
              <initialValue><simpleValue value="&#x27;&#x27;"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="stOemId">
              <initialValue><simpleValue value="GUID#{00000000-0000-0000-0000-000000000000}"/></initialValue>
              <type><derived name="GUID"/></type>
            </variable>
            <variable name="stLicenseId">
              <initialValue><simpleValue value="GUID#{00000000-0000-0000-0000-000000000000}"/></initialValue>
              <type><derived name="GUID"/></type>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrId">
              <type><UDINT/></type>
            </variable>
            <variable name="stCheckLicense">
              <type><derived name="ST_CheckLicense"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：FB_CheckOemLicense 的最小可编译演示——所有 VAR_INPUT 均以 doc/PDF 中真实引脚名调用。
//       业务侧请在线 monitor / 在线写值触发对应输入，看输出端 monitor 结果。
//
// 价值：保证示例 ST 代码所有引脚名与 FB_CheckOemLicense 的 VAR_INPUT/VAR_OUTPUT 一致，
//       Import PLCopenXML → 编译 → 登录 流程能跑通，作为 hand-curated 例程
//       的脚手架。
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（及其依赖 Tc2_System）
//   2. 右键 PLC 项目 → Import PLCopenXML → 选本文件 → OK → 编译、登录
//   3. 在线对 VAR_INPUT 写入合适触发值（典型 bExecute / RUN / START 上升沿）
//   4. 在线 monitor VAR_OUTPUT 观察 FB 反应
// =============================================================================

fbFB_CheckOemLicense(
    bExecute := bExecute,
    tTimeout := tTimeout,
    sNetId := sNetId,
    stOemId := stOemId,
    stLicenseId := stLicenseId,
    bBusy =&gt; bBusy,
    bError =&gt; bError,
    nErrId =&gt; nErrId,
    stCheckLicense =&gt; stCheckLicense
);
</xhtml></ST>
