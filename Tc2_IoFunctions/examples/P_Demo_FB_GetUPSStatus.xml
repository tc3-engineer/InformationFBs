<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_GetUPSStatus Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetUPSStatus" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReadUpsStatus">
              <type><derived name="FB_GetUPSStatus"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UPS 状态读 FB（电平触发）</xhtml></documentation>
            </variable>
            <variable name="sUpsTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机空串</xhtml></documentation>
            </variable>
            <variable name="nUpsAdsPort">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><derived name="T_AmsPort"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0 = Windows UPS Service</xhtml></documentation>
            </variable>
            <variable name="bEnableUpsMonitor">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">电平使能：TRUE 即开始监控</xhtml></documentation>
            </variable>
            <variable name="bUpsStatusValid">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">数据是否有效</xhtml></documentation>
            </variable>
            <variable name="bUpsReadError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读 UPS 出错</xhtml></documentation>
            </variable>
            <variable name="nUpsReadErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="stUpsStatus">
              <type><derived name="ST_UPSStatus"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UPS 状态结构</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：CX 工控机配 CB3011 UPS：周期读 UPS 状态；检测到 UPS 在用电池且剩余 &lt; 30 秒 → 触发关键数据写盘 + 报警。
// 价值：掉电保护：让 PLC 程序提前 1-2 秒响应即将断电。
// 验证：登录后 bEnableUpsMonitor := TRUE → 1-5 秒后 bUpsStatusValid 应为 TRUE，stUpsStatus 各字段（如 PowerStatus / BatteryFlag）有值；模拟断电（拔市电插头）→ 1-5 秒内 stUpsStatus 显示电池模式。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 电平触发：bEnable = TRUE 即周期读，不需要上升沿
fbReadUpsStatus(
    sNetId   := sUpsTargetNetId,
    nPort    := nUpsAdsPort,
    bEnable  := bEnableUpsMonitor,
    bValid   =&gt; bUpsStatusValid,
    bError   =&gt; bUpsReadError,
    nErrId   =&gt; nUpsReadErrId,
    stStatus =&gt; stUpsStatus
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
