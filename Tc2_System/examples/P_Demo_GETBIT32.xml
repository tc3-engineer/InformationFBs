<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.GETBIT32 Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GETBIT32" pouType="program">
        <interface>
          <localVars>
            <variable name="dwCommandWord">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 写入的命令字</xhtml></documentation>
            </variable>
            <variable name="bCmdStart">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">bit0 = 启动</xhtml></documentation>
            </variable>
            <variable name="bCmdStop">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">bit1 = 停止</xhtml></documentation>
            </variable>
            <variable name="bCmdReset">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">bit2 = 复位</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：解码 HMI 命令字：DWORD 中 bit0=启动 / bit1=停止 / bit2=复位，逐位提取成 BOOL 喂给业务状态机。
// 价值：比 AND + 移位 + 比较可读得多。
// 验证：在线写 dwCommandWord := 1 → bCmdStart = TRUE；写 5（bit0+bit2）→ bCmdStart + bCmdReset = TRUE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 每周期解码命令字
bCmdStart := GETBIT32(inVal32 := dwCommandWord, bitNo := 0);
bCmdStop  := GETBIT32(inVal32 := dwCommandWord, bitNo := 1);
bCmdReset := GETBIT32(inVal32 := dwCommandWord, bitNo := 2);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
