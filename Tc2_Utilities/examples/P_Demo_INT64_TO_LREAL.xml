  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_INT64_TO_LREAL" pouType="program">
        <interface>
          <localVars>
            <variable name="liTorqueInt">
              <type><derived name="T_LARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">有符号 64 位扭矩积分</xhtml></documentation>
            </variable>
            <variable name="lrTorqueDisp">
              <type><derived name="LREAL;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 显示</xhtml></documentation>
            </variable>
            <variable name="bConvert">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.INT64_TO_LREAL 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把 64 位有符号扭矩积分（可正可负）转 LREAL 在 HMI 显示。
// 价值：替代手写有符号双倍长转浮点；一行调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    lrTorqueDisp := INT64_TO_LREAL(liTorqueInt);
    bConvert := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
