          <localVars>
            <variable name="fbFB_MemBufferSplit">
              <type><derived name="FB_MemBufferSplit"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_MemBufferSplit 实例</xhtml></documentation>
            </variable>
            <variable name="eCmd">
