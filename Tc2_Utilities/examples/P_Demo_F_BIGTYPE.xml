  <types>
    <dataTypes>
      <dataType name="ST_Recipe">
        <baseType>
          <struct>
            <variable name="nRecipeId"><type><UDINT/></type></variable>
            <variable name="fTargetTempC"><type><LREAL/></type></variable>
            <variable name="tHoldDuration"><type><TIME/></type></variable>
