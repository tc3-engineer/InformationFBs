<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_StateCommandToString" Id="{8048c9f6-bf26-5c5c-8760-0d058f17d0c4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_StateCommandToString
VAR
    eCmd      : E_PMLCommand := E_PMLCommand.ePMLCommand_Start;
    sCmdName  : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc3_PackML_V2.F_StateCommandToString 演示程序
// ============================================================
// 场景：HMI 报警日志要记录 操作员发了 Start 命令，把 E_PMLCommand 数值转可读字符串。
// 价值：枚举↔字符串标准映射封装，HMI 显示文本一致性保证。
// 验证：eCmd := ePMLCommand_Start 时 sCmdName 应为 'Start' 或类似字面值。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_PackML_V2（References → Add library）
//   3. 编译 → 登录 → 运行；按上方"验证"指引在线写值观察
// ============================================================

sCmdName := F_StateCommandToString(eStateCommand := eCmd);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
