<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_ReadTaskExceedCounter Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_ReadTaskExceedCounter" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_ReadTaskExceedCounter">
              <type><derived name="FB_ReadTaskExceedCounter"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_ReadTaskExceedCounter 实例</xhtml></documentation>
            </variable>
            <variable name="bReadExceedReq">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线上升沿触发读取</xhtml></documentation>
            </variable>
            <variable name="nMyTaskPort">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标任务 ADS 端口（运行时填充）</xhtml></documentation>
            </variable>
            <variable name="bExceedReading">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">正在读</xhtml></documentation>
            </variable>
            <variable name="bExceedReadErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 读错误</xhtml></documentation>
            </variable>
            <variable name="nLastAdsError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误码</xhtml></documentation>
            </variable>
            <variable name="nCurrentExceedCount">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前 Exceed Counter 累计</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.FB_ReadTaskExceedCounter 演示程序
// ============================================================
// 场景：CX 上 1ms 任务偶发卡顿，量化每分钟超限次数。
// 价值：替代登录 System Manager 翻 Task 属性窗口，FB 直接把 Exceed Counter 拿到 PLC 变量便于趋势化。
// 验证：登录后 nMyTaskPort 自动取当前任务端口；写 bReadExceedReq := TRUE，bExceedReading 一闪后 nCurrentExceedCount 装入数值。若 PLC 实时性正常应保持 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 自动取本任务 ADS 端口
nMyTaskPort := TwinCAT_SystemInfoVarList._TaskInfo[GETCURTASKINDEXEX()].AdsPort;

fbFB_ReadTaskExceedCounter(
    bExecute := bReadExceedReq, nTaskAdsPort := nMyTaskPort,
    bBusy =&gt; bExceedReading, bError =&gt; bExceedReadErr, nErrorID =&gt; nLastAdsError, nExceedCounter =&gt; nCurrentExceedCount
);

</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
