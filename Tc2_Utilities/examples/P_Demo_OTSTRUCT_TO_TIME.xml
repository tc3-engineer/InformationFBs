<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.OTSTRUCT_TO_TIME Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_OTSTRUCT_TO_TIME" pouType="program">
        <interface>
          <localVars>
            <variable name="otDryingTime">
              <type><derived name="OTSTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI 输入的多字段时间结构</xhtml></documentation>
            </variable>
            <variable name="tDryingDelay">
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PLC 内部用的 TIME 值（喂给 TON.PT）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 上让操作员拨「时」「分」「秒」三个轮子设置烘干时间，PLC 需合并喂给 TON
//
// 价值：1 行合并多字段，避免手写 BYTE_TO_TIME 后多次相乘
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线给 otDryingTime.byHours:=2, byMinutes:=30, bySeconds:=0
//   4. 强制 bRunOnce := TRUE
//   5. 在线观察 tDryingDelay = T#2h30m
// =============================================================================
tDryingDelay := OTSTRUCT_TO_TIME(otDryingTime);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
