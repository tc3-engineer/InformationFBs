<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.FILETIME64_TO_TOD Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FILETIME64_TO_TOD" pouType="program">
        <interface>
          <localVars>
            <variable name="ftNow">
              <type><derived name="T_FILETIME64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前 T_FILETIME64（从 F_GetCurDateTime 或 F_GetSystemTime 拿）</xhtml></documentation>
            </variable>
            <variable name="todNow">
              <type><TIME_OF_DAY/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">一天内的时刻（不含日期）</xhtml></documentation>
            </variable>
            <variable name="todLightOff">
              <type><TIME_OF_DAY/></type>
              <initialValue><simpleValue value="TOD#22:00:00.000"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">照明关闭阈值</xhtml></documentation>
            </variable>
            <variable name="bShouldLightOff">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 该关灯了</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：「每天 22:00 自动关闭照明」逻辑：取当前 T_FILETIME64 → TOD → 与 TOD#22:00 比较
//
// 价值：1 行调用避免手写「* 3600000 + ... + wMilliseconds」拼装 TOD 公式
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.7.3.0）
//   2. 编译 + 登录 + 运行
//   3. 通过 DT_TO_FILETIME64(DT#2026-05-11-22:30:00) 给 ftNow 赋值
//   4. 在线观察 todNow = TOD#22:30:00.000
//   5. bShouldLightOff = TRUE
// =============================================================================
todNow := FILETIME64_TO_TOD(ftNow);
bShouldLightOff := todNow &gt;= todLightOff;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
