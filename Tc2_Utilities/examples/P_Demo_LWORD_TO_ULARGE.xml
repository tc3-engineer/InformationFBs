  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LWORD_TO_ULARGE" pouType="program">
        <interface>
          <localVars>
            <variable name="rResult">
              <type><derived name="T_ULARGE_INTEGER"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">LWORD_TO_ULARGE 返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
            <variable name="lw">
              <type><LWORD/></type>
              <initialValue><simpleValue value="16#123456789ABCDEF0"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测试用本地变量</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.LWORD_TO_ULARGE 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 在线监视 rResult
// ============================================================

IF bRun THEN
    rResult := LWORD_TO_ULARGE(lw);
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
