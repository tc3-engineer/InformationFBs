            <variable name="arg_sResult">
              <type><reference><baseType><derived name="STRING"/></baseType></reference></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT sResult</xhtml></documentation>
            </variable>
            <variable name="arg_nResultSize">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT nResultSize</xhtml></documentation>
            </variable>
            <variable name="out_bError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT bError</xhtml></documentation>
            </variable>
            <variable name="out_hrErrorCode">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_OUTPUT hrErrorCode</xhtml></documentation>
            </variable>
          </localVars>
