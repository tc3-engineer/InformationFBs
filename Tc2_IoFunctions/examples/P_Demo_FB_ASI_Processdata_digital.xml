<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_ASI_Processdata_digital Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_ASI_Processdata_digital" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAsiProcessDataDigital">
              <type><derived name="FB_ASI_Processdata_digital"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 数字过程数据 FB</xhtml></documentation>
            </variable>
            <variable name="fbAsiParamControl">
              <type><derived name="FB_ASI_ParameterControl"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">后台调度</xhtml></documentation>
            </variable>
            <variable name="stAsiParamBuffer">
              <type><derived name="ST_ParameterBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">共享缓冲</xhtml></documentation>
            </variable>
            <variable name="stAsiInProcessImg">
              <type><derived name="ST_Parameter_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链到 %I*</xhtml></documentation>
            </variable>
            <variable name="stAsiOutProcessImg">
              <type><derived name="ST_Parameter_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链到 %Q*</xhtml></documentation>
            </variable>
            <variable name="iTargetAsiSlaveAddr">
              <initialValue><simpleValue value="7"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">slave 地址</xhtml></documentation>
            </variable>
            <variable name="iValueToWrite">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">写入数据（4 bit 有效）</xhtml></documentation>
            </variable>
            <variable name="bIsWriteMode">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=读 1=写</xhtml></documentation>
            </variable>
            <variable name="bEnableCyclicMode">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=单次 1=连续</xhtml></documentation>
            </variable>
            <variable name="bMaskedAccess">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=普通 1=屏蔽访问</xhtml></documentation>
            </variable>
            <variable name="bStartTransfer">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="iReadbackDataNibble">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读得数据</xhtml></documentation>
            </variable>
            <variable name="iParamGroupInfo">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数分组</xhtml></documentation>
            </variable>
            <variable name="nAsiCmdError">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：ASI slave 7 是 4 路数字输入；按需读取这 4 个状态而不占用永久过程映像。
// 价值：节省 PLC 过程映像；按需访问。
// 验证：登录后 iTargetAsiSlaveAddr := 7、bIsWriteMode := FALSE、bEnableCyclicMode := FALSE、bStartTransfer := TRUE → 回 FALSE 后 iReadbackDataNibble 显示该 slave 4 个数字输入状态（低 4 bit）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbAsiParamControl(
    stParameterBuffer := stAsiParamBuffer,
    stParameter_IN    := stAsiInProcessImg,
    stParameter_OUT   := stAsiOutProcessImg
);

// bCommMode 与 bRegComm 在当前固件中必须保持 FALSE（PDF: currently always 0）
fbAsiProcessDataDigital(
    iSlaveaddress     := iTargetAsiSlaveAddr,
    iSlavevalue       := iValueToWrite,
    bParametermode    := bIsWriteMode,
    bCycleMode        := bEnableCyclicMode,
    bCommMode         := FALSE,
    bRegComm          := FALSE,
    bmaskAccess       := bMaskedAccess,
    bStart            := bStartTransfer,
    stParameterBuffer := stAsiParamBuffer,
    iReadValue        =&gt; iReadbackDataNibble,
    iParametergroup   =&gt; iParamGroupInfo,
    iErrornumber      =&gt; nAsiCmdError
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
