<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PBOOL_TO_BOOL" Id="{841ed86e-0695-5a1d-8ec4-5f62137ee525}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PBOOL_TO_BOOL
VAR
    xRealValue           : BOOL := TRUE; // 模拟 wire 缓冲区中的 BOOL 字段
    pBOOLField           : POINTER TO BOOL; // 业务侧先算好的字段地址（ADR 或 pBase+nOff）
    bExtractField        : BOOL; // 在线置 TRUE 触发一次解析
    xRealValue_extracted : BOOL; // 解析后的副本，供业务逻辑使用
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.PBOOL_TO_BOOL 演示程序（FUNCTION）
// ============================================================
// 场景：从一段二进制 wire 缓冲区里按偏移取 BOOL 字段（Modbus/CAN/ADS Raw）。
// 价值：替代手写 pField + nOff + ^ 指针算术；一次调用取值，少打错符号。
// 验证：在线写 xRealValue := TRUE；bExtractField := TRUE；
//       下一周期 xRealValue_extracted 应等于 xRealValue。
// ============================================================

// 业务代码通常已经算好字段地址（pBase + 协议偏移）；演示用 ADR 等价
pBOOLField := ADR(xRealValue);

IF bExtractField AND pBOOLField <> 0 THEN
    // 单次完整调用：避免手写 ^ 解引用，统一风格便于和字节序转换串联
    xRealValue_extracted := PBOOL_TO_BOOL(pBOOLField);
    bExtractField := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
