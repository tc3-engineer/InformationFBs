<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FindAndReplace Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FindAndReplace" pouType="program">
        <interface>
          <localVars>
            <variable name="sTemplate"><initialValue><simpleValue value="'[{ts}] Pump alarm'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：日志模板含占位符 {ts}</xhtml></documentation></variable>
            <variable name="sPlaceholder"><initialValue><simpleValue value="'{ts}'"/></initialValue><type><string><length>16</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">占位符</xhtml></documentation></variable>
            <variable name="sTimestamp"><initialValue><simpleValue value="'2026-05-12T08:00:00'"/></initialValue><type><string><length>32</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际时间戳值</xhtml></documentation></variable>
            <variable name="sLogLine"><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">替换后日志</xhtml></documentation></variable>
            <variable name="nReplaced"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">替换次数</xhtml></documentation></variable>
            <variable name="bRender"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把日志中的占位符 `'{ts}'`、`'{level}'`、`'{msg}'` 替换为实际值。
// 价值：替代 `STRING_TO_UTF8` + 字节级 MEMCPY 替换的 30 行循环；本函数 1 行解决。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bRender THEN
    nReplaced := FindAndReplace(pSrcString    := ADR(sTemplate),
                                pDeleteString := ADR(sPlaceholder),
                                pInsertString := ADR(sTimestamp),
                                pDstString    := ADR(sLogLine),
                                nDstSize      := SIZEOF(sLogLine));
    bRender := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
