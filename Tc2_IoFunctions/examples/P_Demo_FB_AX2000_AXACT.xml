<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_AX2000_AXACT Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AX2000_AXACT" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAx2000Action">
              <type><derived name="FB_AX2000_AXACT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AX2000 动作 FB（必须循环调用）</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdIn">
              <type><derived name="ST_PZD_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">驱动器 → PLC PZD（链到 %I*）</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdOut">
              <type><derived name="ST_PZD_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PLC → 驱动器 PZD（链到 %Q*）</xhtml></documentation>
            </variable>
            <variable name="iTargetVelocity">
              <initialValue><simpleValue value="1500"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标速度 μm/s</xhtml></documentation>
            </variable>
            <variable name="iMotionTargetPosition">
              <initialValue><simpleValue value="12000"/></initialValue>
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标位置 μm</xhtml></documentation>
            </variable>
            <variable name="iMotionTaskNum">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">存内 motion-task 号；0 表示用直接指令</xhtml></documentation>
            </variable>
            <variable name="iMotionBlockType">
              <initialValue><simpleValue value="16#2000"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">motion-task 类型 (默认 SI 单位)</xhtml></documentation>
            </variable>
            <variable name="bMotionStartReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿启动 motion</xhtml></documentation>
            </variable>
            <variable name="bMotionStopReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿正常停车</xhtml></documentation>
            </variable>
            <variable name="bMotionShortStopReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿短停</xhtml></documentation>
            </variable>
            <variable name="bMotionErrorReset">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿复位 AX2000 错误</xhtml></documentation>
            </variable>
            <variable name="tMotionTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 通讯超时</xhtml></documentation>
            </variable>
            <variable name="bMotionBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bMotionErrFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">驱动器故障</xhtml></documentation>
            </variable>
            <variable name="bMotionTimeoutErrFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">通讯超时</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：AX2000 印刷套筒伺服：上电后位置就绪即下发位置指令 12000 μm + 速度 1500 μm/s。
// 价值：封装 PROFIDRIVE 协议状态机，避免手撸 PZD 协议。
// 验证：登录后 stAx2000PzdIn / stAx2000PzdOut 已链到 AX2000 PZD；在线写 bMotionStartReq := TRUE → fbAx2000Action.bBusy 短暂 TRUE → 驱动器开始定位；监视 stAx2000PzdIn 中位置实时反馈应趋向 iMotionTargetPosition。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 必须每周期循环调用以维持 PZD 通讯
fbAx2000Action(
    iVelocity          := iTargetVelocity,
    iPosition          := iMotionTargetPosition,
    imotion_tasknumber := iMotionTaskNum,
    imotion_blocktype  := iMotionBlockType,
    bStart             := bMotionStartReq,
    bStop              := bMotionStopReq,
    bShortStop         := bMotionShortStopReq,
    bErrorResume       := bMotionErrorReset,
    tTimeOut           := tMotionTimeout,
    stPZDIN            := stAx2000PzdIn,
    stPZDOUT           := stAx2000PzdOut,
    bBusy              =&gt; bMotionBusy,
    bError             =&gt; bMotionErrFlag,
    bTimeOutErr        =&gt; bMotionTimeoutErrFlag
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
