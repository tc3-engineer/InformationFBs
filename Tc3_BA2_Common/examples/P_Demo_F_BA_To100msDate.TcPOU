<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_BA_To100msDate" Id="{55eb0dd6-94b7-5aba-be9c-8872cc7ebd02}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_BA_To100msDate
VAR
    argStBACnetDate                : ST_BA_Date                    ; // stBACnetDate
    fnReturn                       : UDINT; // 返回值
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc3_BA2_Common.F_BA_To100msDate 演示程序
// =============================================================================
// 场景：把日期序列化为定长 32-bit 整数以便存到磁盘 / 网络传输。
//
// 价值：统一时间戳格式：节省 struct 的多字段反序列化开销。
//
// 验证：登录 PLC 后，按例程内变量在线写值；监视输出 / 返回值，结合 §1 功能
//       简述的预期行为对照（详见配套 .md 文档 §7 业务场景）。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_BA2_Common（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// =============================================================================

fnReturn := F_BA_To100msDate(
    stBACnetDate             := argStBACnetDate
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
