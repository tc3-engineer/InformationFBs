<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_RemoveDir Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RemoveDir" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRemoveDir">
              <type><derived name="FB_RemoveDir"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_RemoveDir 实例</xhtml></documentation>
            </variable>
            <variable name="sDirToRemove">
              <initialValue><simpleValue value="'D:/log/tmp_archive'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要删除的（空）目录路径</xhtml></documentation>
            </variable>
            <variable name="bRemoveDirRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次删除</xhtml></documentation>
            </variable>
            <variable name="bRemoveDirError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 删除失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS / OS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：月底归档完成后清理空临时目录 'D:/log/tmp_archive'。
// 价值：一次调用即可。
// 验证：目录为空时调用 → 目录消失；目录非空 → bRemoveDirError = TRUE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbRemoveDir(
    sNetId    := '',
    sPathName := sDirToRemove,
    ePath     := PATH_GENERIC,
    bExecute  := bRemoveDirRequest,
    tTimeout  := T#10S,
    bBusy     =&gt; bBusyMon,
    bError    =&gt; bRemoveDirError,
    nErrId    =&gt; nErrIdLast
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
