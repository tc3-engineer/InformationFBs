<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-10T08:00:00"/>
  <contentHeader name="Tc2_Standard.CTD Demo" modificationDateTime="2026-05-10T08:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_CTD" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCTD">
              <type><derived name="CTD"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Counter 实例</xhtml></documentation>
            </variable>
            <variable name="bLoad">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲一次：把 CV 装入 5</xhtml></documentation>
            </variable>
            <variable name="bCountDown">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">每给一次上升沿 CV 减 1</xhtml></documentation>
            </variable>
            <variable name="bDone">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CV 减到 0 时 TRUE</xhtml></documentation>
            </variable>
            <variable name="nCV">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前剩余计数（监视）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Standard.CTD 演示程序
// ============================================================
// 场景：倒计时 5 个产品后置位完成位
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译并登录目标
//   1. 强制 bLoad := TRUE 一个周期 → nCV 变成 5
//   2. 重复给 bCountDown FALSE → TRUE → FALSE 五次 → nCV 减到 0
//   3. nCV = 0 时观察 bDone 为 TRUE
// ============================================================

fbCTD(
    CD   := bCountDown,
    LOAD := bLoad,
    PV   := WORD#5,
    Q    =&gt; bDone,
    CV   =&gt; nCV
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
</project>
