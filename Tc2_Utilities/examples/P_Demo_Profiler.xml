          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.Profiler 演示程序（FB 实例）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities（及依赖类型所在库 Tc2_System 等）
//   2. 编译 + 登录
//   3. 按 doc.md 给 arg_* 赋值
//   4. 在线监视 out_* / io_* 输出
// ============================================================

fbProfiler(
    START := arg_START,
    RESET := arg_RESET,
    BUSY =&gt; out_BUSY,
    DATA =&gt; out_DATA
);
</xhtml>
