<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_GetVersionTcIoFunctions" Id="{df644318-cdf5-5303-bc18-855df56eb74b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_GetVersionTcIoFunctions
VAR
    nMajorVersion     : UINT := 0; // 主版本号
    nMinorVersion     : UINT := 0; // 次版本号
    nRevisionVersion  : UINT := 0; // 修订号
    bReadVersionField : BOOL := FALSE; // 触发读取（一次性）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：旧工程的版本读取代码兼容性参考；新工程不要用。
// 价值：⚠️ 仅向后兼容，不推荐使用。
// 验证：登录后写 bReadVersionField := TRUE → 一周期后 nMajorVersion / nMinorVersion / nRevisionVersion 显示库版本各字段。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：本 FC 已废弃。新工程直接读 stLibVersion_Tc2_IoFunctions.iMajor 等
IF bReadVersionField THEN
    nMajorVersion    := F_GetVersionTcIoFunctions(nVersionElement := 1);
    nMinorVersion    := F_GetVersionTcIoFunctions(nVersionElement := 2);
    nRevisionVersion := F_GetVersionTcIoFunctions(nVersionElement := 3);
    bReadVersionField := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
