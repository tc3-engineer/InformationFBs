  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_TC_Config" pouType="program">
        <interface>
          <localVars>
            <variable name="fbTC_Config">
              <type><derived name="TC_Config"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TC_Config 实例</xhtml></documentation>
            </variable>
            <variable name="bExec">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：远程切 Config 做维护。
// 价值：脚本化运维。
// 验证：改 bExec := TRUE 触发；观察目标机器 SystemService 切到 Config 模式（XAE 图标变蓝）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbTC_Config(
    NETID := '', START := bExec, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
