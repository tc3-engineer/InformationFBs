<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_WritePersistentData" Id="{338ec4cb-40e9-5b34-8fb6-16d15db8f5b2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_WritePersistentData
VAR
    fbFB_WritePersistentData : FB_WritePersistentData; // FB_WritePersistentData 实例
    bWrite                   : BOOL := FALSE;
    bBusy_                   : BOOL;
    bErrFlag                 : BOOL;
    nErrCode                 : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：配置变更后强制写文件。
// 价值：时机可控。
// 验证：变更 persistent 变量后触发；观察对应 `.bootdata` 文件被更新。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_WritePersistentData(
    NETID := '', PORT := 851, START := bWrite, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY => bBusy_, ERR => bErrFlag, ERRID => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
