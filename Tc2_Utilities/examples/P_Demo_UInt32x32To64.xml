<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T12:00:00"/>
  <contentHeader name="Tc2_Utilities.UInt32x32To64 Demo" modificationDateTime="2026-05-12T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt32x32To64" pouType="program">
        <interface>
          <localVars>
            <variable name="dwCycleCount">
              <type><DWORD/></type>
              <initialValue><simpleValue value="16#FFFFFFFF;"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">接近 32 位上限的周期数</xhtml></documentation>
            </variable>
            <variable name="dwPerCycle">
              <type><DWORD/></type>
              <initialValue><simpleValue value="100;"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">每周期事件数</xhtml></documentation>
            </variable>
            <variable name="uliTotal">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">64 位乘积</xhtml></documentation>
            </variable>
            <variable name="bCompute">
              <type><derived name="BOOL;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发计算</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt32x32To64 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：计算两个 32 位计数器（如周期计数 × 单周期事件数）相乘后的总事件数，可能超过 32 位上限。
// 价值：替代手写 32×32 → 64 位的双倍长乘法；一行调用，性能等同于硬件单指令。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCompute THEN
    // 上升沿触发：避免反复算（PLC 周期内只调用一次）
    uliTotal := UInt32x32To64(dwCycleCount, dwPerCycle);
    bCompute := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
