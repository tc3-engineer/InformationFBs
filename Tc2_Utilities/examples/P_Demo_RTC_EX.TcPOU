<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_RTC_EX" Id="{22b2dca7-a636-5a2a-9cb9-c569c1b080f9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_RTC_EX
VAR
    fbRTC_EX : RTC_EX; // RTC_EX 实例
    EN       : BOOL := FALSE;
    PDT      : DATE_AND_TIME := DT#1970-01-01-00:00:00;
    PMSEK    : DWORD := 0;
    Q        : BOOL;
    CDT      : DATE_AND_TIME;
    CMSEK    : DWORD;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：RTC_EX 的最小可编译演示——所有 VAR_INPUT 均以 doc/PDF 中真实引脚名调用。
//       业务侧请在线 monitor / 在线写值触发对应输入，看输出端 monitor 结果。
//
// 价值：保证示例 ST 代码所有引脚名与 RTC_EX 的 VAR_INPUT/VAR_OUTPUT 一致，
//       Add Existing Item (.TcPOU) → 编译 → 登录 流程能跑通，作为 hand-curated 例程
//       的脚手架。
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（及其依赖 Tc2_System）
//   2. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件 → OK → 编译、登录
//   3. 在线对 VAR_INPUT 写入合适触发值（典型 bExecute / RUN / START 上升沿）
//   4. 在线 monitor VAR_OUTPUT 观察 FB 反应
// =============================================================================

fbRTC_EX(
    EN := EN,
    PDT := PDT,
    PMSEK := PMSEK,
    Q => Q,
    CDT => CDT,
    CMSEK => CMSEK
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
