<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_WriteMotionFunction" Id="{61756981-5b5e-5dc7-bcaf-92b296b8bbdd}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_WriteMotionFunction
VAR
    fbWriteBottleWidthCam : MC_WriteMotionFunction;
    stNewCamTableRef      : MC_CAM_REF;
    arrNewBottleProfile   : ARRAY[0..31] OF MC_MotionFunctionPoint;
    stWriteOpts           : ST_WriteMotionFunctionOptions;
    nActiveCamId          : MC_CAM_ID;
    nBottleProfilePoints  : UDINT := 32;
    bSwitchToBigBottle    : BOOL := FALSE;
    rtSwitchTrig          : R_TRIG;
    bWriteDone            : BOOL;
    bWriteBusy            : BOOL;
    bWriteError           : BOOL;
    nWriteErrorID         : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：包装线来料瓶宽从 250mm 切到 330mm — 推送臂的凸轮曲线需要相应整体
//       拉宽。新瓶宽配方对应的 32 点 cam 已经由配方模块算好放在
//       arrNewBottleProfile 里，现在要把它写到当前生效的凸轮表里。
// 价值：传统做法停机切到 XAE 重下 cam 文件 → 停机 5-10 分钟；用本 FB
//       配合 MC_SetCamOnlineChangeMode 的"延迟到主轴下次到换型位置生效"
//       模式，可以 0 停机切配方；本例为最小演示，使用调用方已配置的激活模式。
// 验证步骤：
//   1) 编译登录。确认上游已用 MC_CamTableSelect 加载 cam、把 ID 放在
//      nActiveCamId；MC_SetCamOnlineChangeMode 已配好（本例不重复配置）。
//   2) 在 arrNewBottleProfile 里准备好 32 个 MC_MotionFunctionPoint（实际工程
//      由配方模块或工艺算法填，本例只演示写入框架）。
//   3) 在线 bSwitchToBigBottle := TRUE → R_TRIG 上升沿触发 Execute；
//      观察 bWriteBusy 立 TRUE，1-N 周期后 bWriteDone := TRUE。
//   4) 用 MC_ReadMotionFunction 回读同一张表，应能看到新的点位数据。
//      若 ChangeMode 是延迟激活，还需 watch Axis.Status.CamDataQueued
//      要等其变 FALSE 才算机械上真的切了。
//   5) 故障路径：把 nBottleProfilePoints 改成大于 NC 表容量的数（如 1000），
//      触发，应观察 bWriteError := TRUE 且 nWriteErrorID 非零。
// =============================================================================
// 初始化：把 MC_CAM_REF 指到本地新配方缓冲；Options 用默认（异步访问）。

IF stNewCamTableRef.pArray = 0 THEN
    stNewCamTableRef.pArray     := ADR(arrNewBottleProfile);
    stNewCamTableRef.nArraySize := SIZEOF(arrNewBottleProfile);
END_IF;

rtSwitchTrig(CLK := bSwitchToBigBottle);

// 单次完整调用：从表头（PointID = 0）开始整体覆盖 nBottleProfilePoints 个点。
// Options 默认不启用 SynchronousAccess（异步走 ADS，不抢 NC 高优周期）。
fbWriteBottleWidthCam(
    Execute    := rtSwitchTrig.Q,
    CamTableID := nActiveCamId,
    PointID    := 0,
    NumPoints  := nBottleProfilePoints,
    CamTable   := stNewCamTableRef,
    Options    := stWriteOpts,
    Done       => bWriteDone,
    Busy       => bWriteBusy,
    Error      => bWriteError,
    ErrorID    => nWriteErrorID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
