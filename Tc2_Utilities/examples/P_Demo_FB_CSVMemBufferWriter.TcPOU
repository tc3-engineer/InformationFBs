<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_CSVMemBufferWriter" Id="{44967d1c-7056-57bb-a707-1269971b7ca3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_CSVMemBufferWriter
VAR
    fbFB_CSVMemBufferWriter : FB_CSVMemBufferWriter; // FB_CSVMemBufferWriter 实例
    eCmd                    : E_EnumCmdType := eEnumCmd_First;
    putValue                : T_MaxString := '';
    pValue                  : POINTER TO BYTE := 0;
    cbValue                 : UDINT := 0;
    bCRLF                   : BOOL := FALSE;
    pBuffer                 : POINTER TO BYTE;
    cbBuffer                : UDINT;
    bOk                     : BOOL;
    cbSize                  : UDINT;
    cbFree                  : UDINT;
    nFields                 : UDINT;
    nRecords                : UDINT;
    cbWrite                 : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：生成日报 CSV。
// 价值：自动处理转义。
// 验证：按 WriteField 顺序追加多列，最后 WriteNewLine 换行。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_CSVMemBufferWriter(
    eCmd := eCmd,
    putValue := putValue,
    pValue := pValue,
    cbValue := cbValue,
    bCRLF := bCRLF,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk => bOk,
    cbSize => cbSize,
    cbFree => cbFree,
    nFields => nFields,
    nRecords => nRecords,
    cbWrite => cbWrite
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
