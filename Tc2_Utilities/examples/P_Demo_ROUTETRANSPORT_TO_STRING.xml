  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ROUTETRANSPORT_TO_STRING" pouType="program">
        <interface>
          <localVars>
            <variable name="eTpType"><type><derived name="E_RouteTransportType"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：从 ADS 路由查询拿到的传输层</xhtml></documentation></variable>
            <variable name="sTpName"><type><string><length>32</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">可读字符串</xhtml></documentation></variable>
            <variable name="bRender"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 显示 ADS 路由表：每行路由的传输层标识用本函数转为可读字符串。
// 价值：替代手写枚举 → 字符串 switch 表；统一与 Beckhoff 工具的命名风格。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bRender THEN
    sTpName := ROUTETRANSPORT_TO_STRING(eType := eTpType);
    bRender := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
