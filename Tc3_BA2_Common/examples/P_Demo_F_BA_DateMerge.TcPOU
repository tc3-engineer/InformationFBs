<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_BA_DateMerge" Id="{9d62c075-441a-51e7-bdcf-da5bc74fecd8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_BA_DateMerge
VAR
    argStDate1                     : ST_BA_Date                    ; // stDate1
    argStDate2                     : ST_BA_Date                    ; // stDate2
    fnReturn                       : ST_BA_Date; // 返回值
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc3_BA2_Common.F_BA_DateMerge 演示程序
// =============================================================================
// 场景：日期来自日历控件、时间来自时间选择控件，业务侧合并成完整时间戳。
//
// 价值：一行替代逐字段赋值。
//
// 验证：登录 PLC 后，按例程内变量在线写值；监视输出 / 返回值，结合 §1 功能
//       简述的预期行为对照（详见配套 .md 文档 §7 业务场景）。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_BA2_Common（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// =============================================================================

fnReturn := F_BA_DateMerge(
    stDate1                  := argStDate1,
    stDate2                  := argStDate2
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
