    <pous>
      <pou name="P_Demo_F_SplitBIC" pouType="program">
        <interface>
          <localVars>
            <variable name="sBicRaw"><initialValue><simpleValue value="1P193995SBTN0002agdw1KEL7411 Q1 2P112104020018"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完整的 BIC 原始串；在线写值替换</xhtml></documentation></variable>
            <variable name="stSplit"><type><derived name="ST_SplittedBIC"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拆分结果；展开查看每个子字段</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：产线 MES 追溯——一次性拆出物料号、BTN、订单号、序列号等多字段。
// 价值：替代多次 BIC_TO_BTN + 自写其他段提取，单次调用拿到全部结构化字段。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线展开 stSplit 看各字段填充情况
//   4. 改 sBicRaw 加入未知段 -&gt; 验证 stSplit.sUndefined 非空
// =============================================================================

stSplit := F_SplitBIC(sBicRaw);</xhtml></ST>
        </body>
      </pou>
