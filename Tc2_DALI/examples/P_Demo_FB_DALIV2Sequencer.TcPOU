<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2Sequencer" Id="{c0eacfff-2570-52d9-98f0-667fcb0a747f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2Sequencer
VAR
    fbFB_DALIV2Sequencer        : FB_DALIV2Sequencer;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    bSeqToggle       : BOOL;
    bSeqRestart      : BOOL;
    stSeqTable       : ST_DALIV2SequenceTable;
    nGroupAddr       : BYTE := 1;
    nMasterShortAddr : BYTE := 0;
    bSeqRunning      : BOOL;
    nStep            : BYTE;

    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：店铺橱窗序列灯效（需在 stSeqTable 配置具体步）。
//
// 价值：序列灯效数据驱动配置。
//
// 验证步骤：
//   1. 通信 FB 跑起；编译；登录。
//   2. 在 stSeqTable 配置：nSteps := 3 / arrLevel := [50, 200, 0] / arrTime := [T#5S, T#10S, T#3S]。
//   3. 在线 bSeqToggle 一次上升沿。
//   4. bSeqRunning 应 TRUE，灯组应按序：50 亮 5 秒 → 200 亮 10 秒 → 0（关）3 秒 → 停。
//   5. nStep 应同步显示当前步号 0..2。
// =============================================================================
fbFB_DALIV2Sequencer(
    bToggle                     := bSeqToggle,
    bRestart                    := bSeqRestart,
    tCycleActualLevelMasterDev  := T#2S,
    nMasterDevAddr              := nMasterShortAddr,
    nAddr                       := nGroupAddr,
    eAddrType                   := eDALIV2AddrTypeGroup,
    nOptions                    := 0,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2Sequencer.bBusy;
bErr   := fbFB_DALIV2Sequencer.bError;
nErrId := fbFB_DALIV2Sequencer.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
