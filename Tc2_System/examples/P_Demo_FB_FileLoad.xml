<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileLoad Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileLoad" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileLoad">
              <type><derived name="FB_FileLoad"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileLoad 实例</xhtml></documentation>
            </variable>
            <variable name="sRecipePath">
              <initialValue><simpleValue value="'D:/config/recipe.bin'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">配方文件路径</xhtml></documentation>
            </variable>
            <variable name="aRecipeBuffer">
              <type><array><dimension lower="0" upper="255"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本地缓冲区</xhtml></documentation>
            </variable>
            <variable name="bLoadRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次读取</xhtml></documentation>
            </variable>
            <variable name="cbBytesLoaded">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际读到字节数</xhtml></documentation>
            </variable>
            <variable name="bLoadError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 读失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：启动时从 D:/config/recipe.bin 把整份配方（≤ 256 字节）一次性读入本地缓冲区。
// 价值：封装 3 个 FB 的状态机，省 25 行。
// 验证：在线置 bLoadRequest := TRUE → 观察 cbBytesLoaded ≈ 真实文件大小；故意指向不存在的文件 → bLoadError = TRUE 且 nErrIdLast = 0x70C。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileLoad(
    sNetId    := '',
    sPathName := sRecipePath,
    pReadBuff := ADR(aRecipeBuffer),
    cbReadLen := SIZEOF(aRecipeBuffer),
    bExecute  := bLoadRequest,
    tTimeout  := T#10S,
    bBusy     =&gt; bBusyMon,
    bError    =&gt; bLoadError,
    nErrId    =&gt; nErrIdLast,
    cbRead    =&gt; cbBytesLoaded
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
