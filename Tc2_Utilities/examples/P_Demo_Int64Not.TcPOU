<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Int64Not" Id="{8aaeb8fd-ee96-5bc1-8ba0-d49be4a3786d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Int64Not
VAR
    liMask     : T_LARGE_INTEGER;
    liInverted : T_LARGE_INTEGER;
    bInvert    : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.Int64Not 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：构造'除指定位以外全 1'的掩码。
// 价值：替代两次 DWORD NOT。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bInvert THEN
    liInverted := Int64Not(liMask);
    bInvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
