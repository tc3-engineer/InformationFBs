<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PLC_ReadSymInfoByNameEx" Id="{896430d9-83c0-5d19-a99c-a6fec2113866}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PLC_ReadSymInfoByNameEx
VAR
    fbPLC_ReadSymInfoByNameEx : PLC_ReadSymInfoByNameEx; // PLC_ReadSymInfoByNameEx 实例
    NETID                     : T_AmsNetId;
    PORT                      : T_AmsPort;
    SYMNAME                   : T_MaxString;
    START                     : BOOL;
    TMOUT                     : TIME := DEFAULT_ADS_TIMEOUT;
    BUSY                      : BOOL;
    ERR                       : BOOL;
    ERRID                     : UDINT;
    SymInfo                   : SYMINFOSTRUCT;
    OVTYPE                    : BOOL;
    OVCOMMENT                 : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：强类型绑定。
// 价值：扩展字段。
// 验证：读符号后看注释 / 类型字段。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbPLC_ReadSymInfoByNameEx(
    NETID := NETID,
    PORT := PORT,
    SYMNAME := SYMNAME,
    START := START,
    TMOUT := TMOUT,
    BUSY => BUSY,
    ERR => ERR,
    ERRID => ERRID,
    SymInfo => SymInfo,
    OVTYPE => OVTYPE,
    OVCOMMENT => OVCOMMENT
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
