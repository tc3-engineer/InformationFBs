<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.STRNCPY Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_STRNCPY" pouType="program">
        <interface>
          <localVars>
            <variable name="sSrc"><initialValue><simpleValue value="'Recipe alpha description'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：源 STRING</xhtml></documentation></variable>
            <variable name="sDst"><type><string><length>64</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标缓冲（故意短于源以验证截断）</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完整复制</xhtml></documentation></variable>
            <variable name="nSrcLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">源字符数</xhtml></documentation></variable>
            <variable name="nDstLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标字符数（截断时 &amp;lt; 源长）</xhtml></documentation></variable>
            <variable name="bCopy"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：从动态数组 `ARRAY OF STRING(N)` 中按索引复制一行到固定 buffer——索引可能越界，需要边界保护的 `STRNCPY` 比 `:=` 更安全。
// 价值：替代 `:=` + 自写长度检查；返回值 + 长度输出便于诊断越界场景。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bCopy THEN
    bOk := STRNCPY(pDst     := ADR(sDst),
                   pSrc     := ADR(sSrc),
                   nDstSize := SIZEOF(sDst),
                   nSrcLen  => nSrcLen,
                   nDstLen  => nDstLen);
    // bOk = FALSE -&gt; 截断；用 nSrcLen vs nDstLen 量化丢失字符数
    bCopy := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
