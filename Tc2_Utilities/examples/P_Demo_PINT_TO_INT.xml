    <pous>
      <pou name="P_Demo_PINT_TO_INT" pouType="program">
        <interface>
          <localVars>
            <variable name="rResult">
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PINT_TO_INT 返回值</xhtml></documentation>
            </variable>
            <variable name="bRun">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发一次调用</xhtml></documentation>
            </variable>
            <variable name="v">
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">测试用本地变量（取址）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.PINT_TO_INT 演示程序（FUNCTION）
// ============================================================
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录
//   3. 强制 bRun := TRUE 一个周期
//   4. 在线监视 rResult 应等于 v 的当前值
// ============================================================

IF bRun THEN
    rResult := PINT_TO_INT(ADR(v));
    bRun := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
