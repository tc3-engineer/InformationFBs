<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_Dpv1WritePNET" Id="{8388633a-35a2-5dee-abe2-1789fed16f9e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_Dpv1WritePNET
VAR
    fbDpv1WritePNET          : FB_Dpv1WritePNET; // Profinet DPV1 写 FB
    sProfinetMasterNetId     : T_AmsNetId := ''; // EL6632 NetId
    iSinamicsPnetPort        : UINT := 1; // Profinet port
    iDriveObjectId           : USINT := 2; // drive A
    aDpv1ReqBuffer           : ARRAY[1..240] OF BYTE; // 请求
    aDpv1ResBuffer           : ARRAY[1..240] OF BYTE; // 响应
    iReqBufLen               : UDINT := 240; // 请求长度
    iResBufLen               : UDINT := 240; // 响应长度
    arrDpv1ReqParams         : ARRAY[1..39] OF ST_Dpv1ParamAddrEx; // 清单
    arrDpv1ValueHdr          : ARRAY[1..39] OF ST_Dpv1ValueHeaderEx; // 值/状态
    iNumParamsToWrite        : USINT := 2; // 参数数
    nWriteReqPkgLenPNET      : USINT; // 请求长度
    nWriteResPkgLenPNET      : USINT; // 响应长度
    bBuildWriteReqPkgPNET    : BOOL := FALSE; // 触发构造
    bDpv1WriteReqPNET        : BOOL := FALSE; // 触发发送
    bSplitWriteResPkgPNET    : BOOL := FALSE; // 触发解析
    tDpv1WriteTimeout        : TIME := T#10S; // 超时
    bDpv1WriteBusyPNET       : BOOL; // 工作中
    iDpv1WriteRequestRefPNET : USINT; // 引用号
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：Profinet SINAMICS 写完整流程。
// 价值：对称封装。
// 验证：登录后 bBuildWriteReqPkgPNET → 帧构造；bDpv1WriteReqPNET 触发发送 → bBusy 落回 → bSplitWriteResPkgPNET 解析 → arrDpv1ValueHdr[k].nError 全 0。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 步骤 1：构造
IF bBuildWriteReqPkgPNET THEN
    nWriteReqPkgLenPNET := F_CreateDpv1WriteReqPkgPNET(
        pDpv1ReqData        := ADR(aDpv1ReqBuffer),
        iNumOfParams        := iNumParamsToWrite,
        iDriveId            := iDriveObjectId,
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bBuildWriteReqPkgPNET := FALSE;
END_IF;

// 步骤 2：发送
fbDpv1WritePNET(
    bExecute        := bDpv1WriteReqPNET,
    aNetId          := sProfinetMasterNetId,
    iProfinetPort   := iSinamicsPnetPort,
    iDriveId        := iDriveObjectId,
    pDpv1ReqData    := ADR(aDpv1ReqBuffer),
    iDpv1ReqDataLen := iReqBufLen,
    pDpv1ResData    := ADR(aDpv1ResBuffer),
    iDpv1ResDataLen := iResBufLen,
    tTmOut          := tDpv1WriteTimeout,
    iRequestRef     => iDpv1WriteRequestRefPNET
);
bDpv1WriteBusyPNET := fbDpv1WritePNET.bBusy;

// 步骤 3：解析
IF bSplitWriteResPkgPNET THEN
    nWriteResPkgLenPNET := F_SplitDpv1WriteResPkgPNET(
        pDpv1ResData        := ADR(aDpv1ResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitWriteResPkgPNET := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
