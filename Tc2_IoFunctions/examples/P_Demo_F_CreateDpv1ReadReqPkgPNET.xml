<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.F_CreateDpv1ReadReqPkgPNET Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_CreateDpv1ReadReqPkgPNET" pouType="program">
        <interface>
          <localVars>
            <variable name="aDpv1ReqBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求缓冲</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数清单</xhtml></documentation>
            </variable>
            <variable name="iNumParamsToRead">
              <initialValue><simpleValue value="3"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数数</xhtml></documentation>
            </variable>
            <variable name="iDriveObjectId">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive A</xhtml></documentation>
            </variable>
            <variable name="bBuildReqPkgPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发构造</xhtml></documentation>
            </variable>
            <variable name="nReqPkgLenPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">生成长度</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Profinet SINAMICS：构造一个读 3 个参数的 DPV1 请求帧。
// 价值：与 Profibus 版本对称。
// 验证：填好 arrDpv1ReqParams[1..3]，写 bBuildReqPkgPNET := TRUE → 一周期后 nReqPkgLenPNET &gt; 0 表示成功。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bBuildReqPkgPNET THEN
    nReqPkgLenPNET := F_CreateDpv1ReadReqPkgPNET(
        pDpv1ReqData    := ADR(aDpv1ReqBuffer),
        iNumOfParams    := iNumParamsToRead,
        iDriveId        := iDriveObjectId,
        stDpv1Parameter := arrDpv1ReqParams
    );
    bBuildReqPkgPNET := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
