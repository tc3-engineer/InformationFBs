<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MEMCPY" Id="{c9c21b5f-b268-54d3-b075-ea02c9480f4a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MEMCPY
VAR
    aRawBuffer      : ARRAY[0..255] OF BYTE; // FB_FileRead 已填充的源缓冲区
    stProcessParams : ARRAY[0..255] OF BYTE; // 目标缓冲区（业务上是工艺参数结构体）
    bCopyRequest    : BOOL; // 在线写 TRUE 触发一次拷贝
    nBytesCopied    : UDINT; // 实际复制字节数；与 SIZEOF 一致才算成功
    rtCopy          : R_TRIG; // 上升沿检测，避免每周期都拷
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：把 FB_FileRead 读到的 256 字节 ARRAY 整块拷到工艺参数结构体；避免逐字段赋值。
// 价值：一行调用替代 256 次手写赋值；约快 5-10 倍。
// 验证：在线触发 bCopyRequest := TRUE → 观察 nBytesCopied = SIZEOF(stProcessParams)；故意把 pSrc 设 0 → nBytesCopied = 0。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 用 R_TRIG 限定为上升沿触发一次，避免每个 PLC 周期都做无效拷贝
rtCopy(CLK := bCopyRequest);
IF rtCopy.Q THEN
    nBytesCopied := MEMCPY(
        destAddr := ADR(stProcessParams),
        srcAddr  := ADR(aRawBuffer),
        n        := SIZEOF(stProcessParams)
    );
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
