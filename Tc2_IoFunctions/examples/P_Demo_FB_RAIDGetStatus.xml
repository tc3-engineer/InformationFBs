<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_RAIDGetStatus Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RAIDGetStatus" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetRaidStatus">
              <type><derived name="FB_RAIDGetStatus"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RAID 状态读 FB（≤ 每秒一次）</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="stRaidStatusReq">
              <type><derived name="ST_RAIDConfigReq"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求：(控制器 ID, RAID 集索引)</xhtml></documentation>
            </variable>
            <variable name="bDoGetRaidStatus">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发（最多每秒一次）</xhtml></documentation>
            </variable>
            <variable name="tRaidQueryTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="stRaidStatusOut">
              <type><derived name="ST_RAIDStatusRes"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RAID 状态结果</xhtml></documentation>
            </variable>
            <variable name="nRaidBytesRead">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回字节数</xhtml></documentation>
            </variable>
            <variable name="bStatusBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bStatusError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nStatusErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：工业服务器 RAID 健康监控：每秒读 RAID 0 集的状态，盘状态变化即报警。
// 价值：硬盘故障第一时间被感知。
// 验证：填好 stRaidStatusReq.nCntlrID := 0、.iRAIDIndex := 0（首集），写 bDoGetRaidStatus := TRUE → bStatusBusy 短暂 TRUE → 回 FALSE 后 stRaidStatusOut 显示 RAID 类型 + 各盘状态；拔一块盘模拟故障后再读 → stRaidStatusOut 中对应盘状态会变。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// PDF NOTICE：每秒最多一次！业务侧需要把 bDoGetRaidStatus 触发限制在 1 Hz。
fbGetRaidStatus(
    sNETID          := sLocalNetId,
    bWrtRd          := bDoGetRaidStatus,
    stRAIDConfigReq := stRaidStatusReq,
    tTimeOut        := tRaidQueryTimeout,
    stRAIDStatusRes =&gt; stRaidStatusOut,
    nBytesRead      =&gt; nRaidBytesRead,
    bBusy           =&gt; bStatusBusy,
    bError          =&gt; bStatusError,
    nErrorID        =&gt; nStatusErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
