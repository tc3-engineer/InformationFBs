<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_M_HasStopReason" Id="{f830e39a-3b62-5278-80b3-099cf7ef1764}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_M_HasStopReason
VAR
    fbAdminAlarm     : FB_PMLAdminAlarm;
    fbAdminTime      : FB_PMLAdminTime;
    stPackTagAdmin   : ST_PMLa;
    stPackTagStatus  : ST_PMLs;
    stAdminOpt       : ST_PMLAdminTimeOptions;

    stFaultReason    : ST_PMLEvent := (Id := 3, Message := 'Critical fault', Category := 1);

    bBtnSet          : BOOL := FALSE;
    bBtnAck          : BOOL := FALSE;
    rtrigSet         : R_TRIG;
    rtrigAck         : R_TRIG;

    bHasStop         : BOOL;        // 在线观察
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc3_PackML_V3.FB_PMLAdminAlarm.M_HasStopReason 演示程序
// ============================================================
// 场景：状态机判断"是否所有事件已处理"准备从 Stopped 切到 Idle——
//       必须先确认无未处理 alarm/warning/stopReason。本方法每周期
//       返回 StopReason 状态。HMI 指示灯也用同样调用。
// 价值：V3 新增方法把"是否有未确认 StopReason"封装好。
// 验证：登录后操作：
//       1. 默认 bHasStop = FALSE。
//       2. 写 bBtnSet := TRUE → 写入故障停机原因 → 观察 bHasStop = TRUE。
//       3. 写 bBtnAck := TRUE → 确认停机原因 → 观察 bHasStop = FALSE
//          （因为 Ack 把 Trigger 置 FALSE）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_PackML_V3（References → Add library）
//   3. 编译 → 登录 → 运行；按上方"验证"指引在线写值观察
// ============================================================

fbAdminTime(stAdmin := stPackTagAdmin, stStatus := stPackTagStatus, stOptions := stAdminOpt);

rtrigSet(CLK := bBtnSet);
rtrigAck(CLK := bBtnAck);

IF rtrigSet.Q THEN
    fbAdminAlarm.M_SetStopReason(stAdmin := stPackTagAdmin, stStopReason := stFaultReason);
END_IF
IF rtrigAck.Q THEN
    fbAdminAlarm.M_AcknowledgeStopReason(stAdmin := stPackTagAdmin);
END_IF

(* 每周期查询——开销忽略 *)
bHasStop := fbAdminAlarm.M_HasStopReason(stAdmin := stPackTagAdmin);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
