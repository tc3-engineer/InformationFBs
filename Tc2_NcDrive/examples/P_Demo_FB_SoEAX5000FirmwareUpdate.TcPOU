<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEAX5000FirmwareUpdate" Id="{4fb9412a-8733-5700-b1e4-6ff7464293a8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEAX5000FirmwareUpdate
VAR
    fbFwUpdate     : FB_SoEAX5000FirmwareUpdate;
    NcToPlcAxis    : NCTOPLC_AXIS_REF; // NC 轴过程映像（实际工程映射到 %I*）
    bStartUpdate   : BOOL; // 在线置 TRUE 触发一次固件检查/更新
    rtStart        : R_TRIG;
    sTargetVersion : STRING(20) := v1.05_b0009; // 目标固件版本字符串
    sFwPool        : T_MaxString := C:\TwinCAT\Io\TcDriveManager\FirmwarePool; // 固件池路径
    eState         : E_FwUpdateState; // 监视：更新状态机
    iProgress      : INT; // 监视：更新进度百分比
    sSelectedFile  : STRING(255);
    bBusy          : BOOL;
    bError         : BOOL;
    iAdsErr        : UINT;
    iSercosErr     : UINT;
    iDiag          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_NcDrive.FB_SoEAX5000FirmwareUpdate 演示程序
// ============================================================
// 场景：产线批量上线前统一把 AX5000 固件刷到指定版本，避免各站固件不一致
//       引发偶发问题。用 PLC 程序自动完成"识别→比对→更新→切状态"。
// 价值：不用本 FB 时需手动用 TcDriveManager 逐台点更新，无法批量自动化；
//       本 FB 封装成一个 bExecute 边沿并带进度/状态反馈，可无人值守升级。
// 验证：登录后置 bStartUpdate := TRUE，观察 bBusy 变 TRUE；监视 eState 经
//       eFwU_FwUpdateInProgress（此时 iProgress 0→100）到 eFwU_FwUpdateDone；
//       若本就不需更新则直接 eFwU_NoFwUpdateRequired。更新期间严禁断电/断网/停 TwinCAT。
// ============================================================

// 上升沿：一次触发只启动一次更新流程
rtStart(CLK := bStartUpdate);

// 单次完整调用：tTimeout 是单个内部 ADS 实例的超时，给宽一点
fbFwUpdate(
    Axis             := NcToPlcAxis,
    sNetId           := '',
    bExecute         := rtStart.Q,
    sFirmwareVersion := sTargetVersion,
    sFirmwarePath    := sFwPool,
    iReqEcState      := EC_DEVICE_STATE_OP,
    tTimeout         := T#15S,
    bBusy                 => bBusy,
    bError                => bError,
    iAdsErrId             => iAdsErr,
    iSercosErrId          => iSercosErr,
    iDiagNumber           => iDiag,
    eFwUpdateState        => eState,
    iLoadProgress         => iProgress,
    sSelectedFirmwareFile => sSelectedFile
);

// 完成后复位触发信号，准备下一次
IF NOT bBusy THEN
    bStartUpdate := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
