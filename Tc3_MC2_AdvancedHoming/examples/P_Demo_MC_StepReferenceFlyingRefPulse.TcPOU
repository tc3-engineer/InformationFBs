<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepReferenceFlyingRefPulse" Id="{e22f1d0c-545e-5cb2-af65-ff82cc6e1a3e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepReferenceFlyingRefPulse
VAR
    fbStepReferenceFlyingRefPulse : MC_StepReferenceFlyingRefPulse;
    axisHoming                    : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec                        : R_TRIG; // 把保持型请求位整成单次上升沿
    bFlyingRefReq                 : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    refSignal                     : MC_Ref_Signal_Ref; // 参考信号源配置（锁存单元 / 信号源 / 当前电平）
    homingOptions                 : ST_Home_Options; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bFlyingRefDone                : BOOL;
    bBusy                         : BOOL;
    bFlyingRefActive              : BOOL;
    bAborted                      : BOOL;
    bError                        : BOOL;
    nErrorID                      : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：连续运转的转台不停机，用编码器每转一次的零脉冲在线重新对零，消除累积漂移。
//       本 FB 只后台监听，转台由别的 Move 命令持续旋转。
// 价值：归零与生产并行无需停机；零脉冲精度高于普通接近开关。
// 验证：保证转台正在转（别的 Move 在动）；在线写 bFlyingRefReq := TRUE，观察 bFlyingRefActive
//       TRUE；转过一个零脉冲后 bFlyingRefDone 短暂 TRUE，轴位置读数被设为 0。5 秒没抓到则 bAborted。

// 配置参考信号源：用驱动默认信号源 + 默认锁存单元（实机按编码器/驱动手册选 TouchProbe）
refSignal.SignalSource := SignalSource_Default;
refSignal.TouchProbe   := PlcEvent;

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bFlyingRefReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepReferenceFlyingRefPulse(
    Execute         := rtExec.Q,
    ReferenceSignal := refSignal,
    SetPosition     := 0.0,
    TimeLimit       := T#5S,
    DistanceLimit   := 360.0,
    BufferMode      := MC_Aborting,
    Options         := homingOptions,
    Done            => bFlyingRefDone,
    Busy            => bBusy,
    Active          => bFlyingRefActive,
    CommandAborted  => bAborted,
    Error           => bError,
    ErrorID         => nErrorID,
    Axis            := axisHoming);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bFlyingRefReq AND NOT bBusy THEN
    bFlyingRefDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
