<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.STRING_TO_SYSTEMTIME Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_STRING_TO_SYSTEMTIME" pouType="program">
        <interface>
          <localVars>
            <variable name="sScheduleTime">
              <type><string><length>23</length></string></type>
              <initialValue><simpleValue value="'2026-05-11-12:34:56.789'"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上位机下发的计划时间字符串</xhtml></documentation>
            </variable>
            <variable name="stScheduleTime">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">解析后的系统时间</xhtml></documentation>
            </variable>
            <variable name="bLengthOk">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">长度校验：必须 23 字节</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：上位机通过 ADS 字符串协议下发计划维护时间「2026-05-11-12:34:56.789」
//
// 价值：1 行调用完成 23 字节字符串到 8 字段结构体的解析，省去手写 7 次 STRING_TO_INT
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE一次
//   4. 在线观察 stScheduleTime.wYear=2026, wMonth=5, wDay=11, ...wMilliseconds=789
//   5. 改 sScheduleTime 长度后会得到不可预测结果（PDF 未规定错误行为）
// =============================================================================
bLengthOk := LEN(sScheduleTime) = 23;
IF bLengthOk THEN
    stScheduleTime := STRING_TO_SYSTEMTIME(sScheduleTime);
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
