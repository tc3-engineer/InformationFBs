<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_LocalSystemTime" Id="{877f6530-b367-58ab-80b0-9042a8a6dd49}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_LocalSystemTime
VAR
    fbFB_LocalSystemTime : FB_LocalSystemTime; // FB_LocalSystemTime 实例
    bEnableSync          : BOOL := FALSE; // 在线置 TRUE 触发首次同步
    stCurrentTime        : TIMESTRUCT; // 同步出来的系统时间，monitor 此值
    bTimeValid           : BOOL; // 首次同步成功后置 TRUE
    eCurrentTz           : E_TimeZoneID; // 当前时区标识
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：CX5020 上电后把本地 Windows 时间同步到 PLC；每 5 秒重同步并校准硬件 RTC（dwOpt = 1）。
// 价值：替代手写 NT_GetTime + RTC_EX2 + 时区查询 + 状态机约 30 行代码。
// 验证：登录后写 bEnableSync := TRUE；观察 bTimeValid 在 1-2 个 PLC 周期后变 TRUE；stCurrentTime 应与桌面时钟一致；5 秒后再次刷新。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbLocalSystemTime(
    sNetID := '',
    bEnable := bEnableSync,
    dwCycle := 5,
    dwOpt := 1,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    bValid => bTimeValid,
    systemTime => stCurrentTime,
    tzID => eCurrentTz
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
