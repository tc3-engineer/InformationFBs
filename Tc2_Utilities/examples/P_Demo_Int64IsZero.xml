    <pous>
      <pou name="P_Demo_Int64IsZero" pouType="program">
        <interface>
          <localVars>
            <variable name="liDivisor">
              <type><derived name="T_LARGE_INTEGER"/></type>
            </variable>
            <variable name="bIsZero">
              <type><BOOL/></type>
            </variable>
            <variable name="bCheck">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.Int64IsZero 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：除法 / 模运算前的除数校验。
// 价值：替代结构体 `=` 比较。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bIsZero := Int64IsZero(liDivisor);
    bCheck := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
