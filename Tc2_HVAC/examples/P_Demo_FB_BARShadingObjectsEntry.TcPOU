<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARShadingObjectsEntry" Id="{fe6d4b9b-44b5-5974-b2b4-3c4b041f9c5d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARShadingObjectsEntry
VAR
    fb : FB_BARShadingObjectsEntry;                            // 被演示 FB 实例
    iId_in : INT := 0;
    bRead_in : BOOL := FALSE;
    bWrite_in : BOOL := FALSE;
    lrP1x_in : LREAL := 0.0;
    lrP1y_in : LREAL := 0.0;
    lrP1z_in : LREAL := 0.0;
    lrP2y_in : LREAL := 0.0;
    lrP3x_in : LREAL := 0.0;
    lrP3y_in : LREAL := 0.0;
    lrP3z_in : LREAL := 0.0;
    lrMx_in : LREAL := 0.0;
    lrMy_in : LREAL := 0.0;
    lrMz_in : LREAL := 0.0;
    lrRadius_in : LREAL := 0.0;
    usiBeginMonth_in : USINT := 0;
    usiEndMonth_in : USINT := 0;
    eType_in : E_BARShadingObjectType ;
    arrShadingObject_io : ARRAY[1..iShadingObjects] OF ST_BARShadingObject ;
    lrP2x_out : LREAL;
    lrP2z_out : LREAL;
    lrP4x_out : LREAL;
    lrP4y_out : LREAL;
    lrP4z_out : LREAL;
    bValid_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARShadingObjectsEntry 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARShadingObjectsEntry.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    iId := iId_in,
    bRead := bRead_in,
    bWrite := bWrite_in,
    lrP1x := lrP1x_in,
    lrP1y := lrP1y_in,
    lrP1z := lrP1z_in,
    lrP2y := lrP2y_in,
    lrP3x := lrP3x_in,
    lrP3y := lrP3y_in,
    lrP3z := lrP3z_in,
    lrMx := lrMx_in,
    lrMy := lrMy_in,
    lrMz := lrMz_in,
    lrRadius := lrRadius_in,
    usiBeginMonth := usiBeginMonth_in,
    usiEndMonth := usiEndMonth_in,
    eType := eType_in,
    arrShadingObject := arrShadingObject_io,
    lrP2x => lrP2x_out,
    lrP2z => lrP2z_out,
    lrP4x => lrP4x_out,
    lrP4y => lrP4y_out,
    lrP4z => lrP4z_out,
    bValid => bValid_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
