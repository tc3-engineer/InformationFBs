<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PLC_ReadSymInfo" Id="{f64d2a81-3991-5f29-af84-debad344049d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PLC_ReadSymInfo
VAR
    fbPLC_ReadSymInfo : PLC_ReadSymInfo; // PLC_ReadSymInfo 实例
    NETID             : T_AmsNetId;
    PORT              : T_AmsPort;
    START             : BOOL;
    TMOUT             : TIME := DEFAULT_ADS_TIMEOUT;
    BUSY              : BOOL;
    ERR               : BOOL;
    ERRID             : UDINT;
    SYMCOUNT          : UDINT;
    SYMSIZE           : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：自动发现 PLC 变量。
// 价值：自动。
// 验证：循环增加 nIndex 触发，能依次读出本机所有符号。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbPLC_ReadSymInfo(
    NETID := NETID,
    PORT := PORT,
    START := START,
    TMOUT := TMOUT,
    BUSY => BUSY,
    ERR => ERR,
    ERRID => ERRID,
    SYMCOUNT => SYMCOUNT,
    SYMSIZE => SYMSIZE
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
