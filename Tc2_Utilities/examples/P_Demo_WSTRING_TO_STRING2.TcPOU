<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_WSTRING_TO_STRING2" Id="{d30ba360-dd13-5d1d-87f2-88caf4aa4aab}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_WSTRING_TO_STRING2
VAR
    wsSrc    : WSTRING(1024) := "HMI long text"; // 工业语义：长 WSTRING
    sOut     : STRING(1024); // 转换后 STRING
    bOk      : BOOL; // 完整转换
    bConvert : BOOL; // 在线触发
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：UI 输入 WSTRING（多语言）→ 写入只支持 STRING 的旧设备。
// 价值：无限长度；`Tc2_Standard` 限 255。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bConvert THEN
    bOk := WSTRING_TO_STRING2(pDstString  := ADR(sOut),
                              pSrcWString := ADR(wsSrc),
                              nDstSize    := SIZEOF(sOut));
    bConvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
