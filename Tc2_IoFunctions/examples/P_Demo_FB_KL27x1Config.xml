<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_KL27x1Config Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_KL27x1Config" pouType="program">
        <interface>
          <localVars>
            <variable name="fbKl27x1">
              <type><derived name="FB_KL27x1Config"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">KL2751/2761 配置 FB</xhtml></documentation>
            </variable>
            <variable name="stKl27x1InProcessImg">
              <type><derived name="ST_KL27x1InData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输入过程映像</xhtml></documentation>
            </variable>
            <variable name="stKl27x1OutProcessImg">
              <type><derived name="ST_KL27x1OutData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输出过程映像</xhtml></documentation>
            </variable>
            <variable name="bDoConfigure">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿写配置</xhtml></documentation>
            </variable>
            <variable name="bDoReadConfig">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿只读</xhtml></documentation>
            </variable>
            <variable name="bUseAbsoluteRamp">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 每步固定时间</xhtml></documentation>
            </variable>
            <variable name="iRampTimeSetting">
              <initialValue><simpleValue value="100"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">斜坡时间</xhtml></documentation>
            </variable>
            <variable name="bDisableWatchdog">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">关闭看门狗</xhtml></documentation>
            </variable>
            <variable name="iWatchdogTimeoutMs10">
              <initialValue><simpleValue value="20"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">看门狗超时 × 10 ms (= 200 ms)</xhtml></documentation>
            </variable>
            <variable name="iFailSafeOnValue">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">fail-safe 时数据&gt;0 的亮度</xhtml></documentation>
            </variable>
            <variable name="iFailSafeOffValue">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">fail-safe 时数据=0 的亮度</xhtml></documentation>
            </variable>
            <variable name="iDimMode">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">调光模式（具体表见 PDF）</xhtml></documentation>
            </variable>
            <variable name="bAutoOnAfterShortCircuit">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">短路恢复后自动亮</xhtml></documentation>
            </variable>
            <variable name="bUse60HzMains">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">60Hz 还是 50Hz</xhtml></documentation>
            </variable>
            <variable name="tKl27x1ConfigTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bKl27x1Busy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bKl27x1Error">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="iLastError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：剧院调光系统：上电时把 KL2751 配为绝对斜坡 100、50 Hz、短路恢复后亮、fail-safe = 0。
// 价值：端子配置纳入 PLC 程序版本控制；现场更换端子无需重新拨码。
// 验证：登录确认 stKl27x1InProcessImg / OutProcessImg 已链；写 bDoConfigure := TRUE → fbKl27x1.bBusy 短暂 TRUE → 回 FALSE 后 iLastError = 0 表示成功。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbKl27x1(
    bConfigurate            := bDoConfigure,
    bReadConfig             := bDoReadConfig,
    bSetDimRampAbsolute     := bUseAbsoluteRamp,
    iSetRampTime            := iRampTimeSetting,
    bSetWatchdogDisable     := bDisableWatchdog,
    iSetWatchdogTimeout     := iWatchdogTimeoutMs10,
    iSetTimeoutOnValue      := iFailSafeOnValue,
    iSetTimeoutOffValue     := iFailSafeOffValue,
    iSetDimmerMode          := iDimMode,
    bSetOnAfterShortCircuit := bAutoOnAfterShortCircuit,
    bSetLineFrequency60Hz   := bUse60HzMains,
    tTimeout                := tKl27x1ConfigTimeout,
    bBusy                   =&gt; bKl27x1Busy,
    bError                  =&gt; bKl27x1Error,
    iErrorId                =&gt; iLastError
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
