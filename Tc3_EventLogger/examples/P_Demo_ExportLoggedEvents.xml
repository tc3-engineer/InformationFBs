<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.ExportLoggedEvents Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ExportLoggedEvents" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLogger">
              <type><derived name="FB_TcEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EventLogger 实例</xhtml></documentation>
            </variable>
            <variable name="fbExportSettings">
              <type><derived name="FB_TcEventCsvExportSettings"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">导出过滤器实例</xhtml></documentation>
            </variable>
            <variable name="sFileName">
              <initialValue><simpleValue value="'C:\Temp\events_2026-05-11.csv'"/></initialValue>
              <type><string><length>120</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">导出文件路径</xhtml></documentation>
            </variable>
            <variable name="bDoExport">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bExportDone">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完成标志</xhtml></documentation>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误标志</xhtml></documentation>
            </variable>
            <variable name="hrErrorCode">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误码</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：每日 23:00 触发的事件归档导出（输出文件名含当日日期）
// 价值：非阻塞异步导出，PLC 主流程不卡顿
// 验证：登录后写 bDoExport := TRUE 触发；持续监视 bExportDone 应在几秒内变 TRUE；C:\Temp 下出现 CSV 文件
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 每周期都调用以推进异步状态；返回 TRUE 表示导出结束
IF bDoExport THEN
    bExportDone := fbLogger.ExportLoggedEvents(
        sFileName := sFileName,
        ipExportSettings := fbExportSettings,
        bError =&gt; bError,
        hrErrorCode =&gt; hrErrorCode);
    IF bExportDone THEN
        bDoExport := FALSE;                    // 流程结束
    END_IF;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
