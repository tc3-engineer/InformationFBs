<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileRead Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileRead" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileRead">
              <type><derived name="FB_FileRead"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileRead 实例</xhtml></documentation>
            </variable>
            <variable name="hOpenedFile">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">前置 FB_FileOpen 拿到的句柄</xhtml></documentation>
            </variable>
            <variable name="aReadBuffer">
              <type><array><dimension lower="0" upper="255"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本地读入缓冲区（256 字节）</xhtml></documentation>
            </variable>
            <variable name="bReadRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次读取</xhtml></documentation>
            </variable>
            <variable name="cbBytesRead">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本次实际读到的字节数</xhtml></documentation>
            </variable>
            <variable name="bEofReached">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 已到 EOF</xhtml></documentation>
            </variable>
            <variable name="bReadError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 读失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：从 D:/log/process.csv 末尾段每次读 256 字节到本地缓冲区，作为离线分析的预读窗口。
// 价值：不用本 FB 需要自己拼 ADS 读命令 + 跟 ADS 应答字节解析。
// 验证：在线置 bReadRequest := TRUE → 观察 cbBytesRead 在 1-2 PLC 周期后非零；多次触发后到 EOF → bEofReached := TRUE 且 cbBytesRead = 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用：读 256 字节到 aReadBuffer
fbFileRead(
    sNetId    := '',
    hFile     := hOpenedFile,
    pReadBuff := ADR(aReadBuffer),
    cbReadLen := SIZEOF(aReadBuffer),
    bExecute  := bReadRequest,
    tTimeout  := T#10S,
    bBusy     =&gt; bBusyMon,
    bError    =&gt; bReadError,
    nErrId    =&gt; nErrIdLast,
    cbRead    =&gt; cbBytesRead,
    bEOF      =&gt; bEofReached
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
