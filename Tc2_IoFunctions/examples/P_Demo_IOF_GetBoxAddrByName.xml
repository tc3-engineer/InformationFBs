<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_GetBoxAddrByName Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_GetBoxAddrByName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbResolveBoxAddr">
              <type><derived name="IOF_GetBoxAddrByName"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">box 名字 → 现场总线地址 FB 实例</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机空串</xhtml></documentation>
            </variable>
            <variable name="nProfibusDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profibus 主站的 Device Id</xhtml></documentation>
            </variable>
            <variable name="sQueryBoxName">
              <initialValue><simpleValue value="'Drive3'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查的 box 名（与 System Manager 配置一致，区分大小写）</xhtml></documentation>
            </variable>
            <variable name="bStartLookup">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发查询</xhtml></documentation>
            </variable>
            <variable name="tLookupTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 超时</xhtml></documentation>
            </variable>
            <variable name="bLookupBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB 工作中</xhtml></documentation>
            </variable>
            <variable name="bLookupError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查询失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="nResolvedBoxAddr">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查得的现场总线站地址</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：调试期间 Profibus 现场总线下挂 6 台变频器 (Drive1..Drive6)，运维要在 PLC 启动时核对每台的站号，与工程图纸做比对存档。
// 价值：查表逻辑封装在一次调用里：业务代码只关心名字，不必读 System Manager 配置。
// 验证：登录后 sQueryBoxName 写 "Drive3" → 在线写 bStartLookup := TRUE → 观察 bLookupBusy 短暂 TRUE → 回 FALSE 后 nResolvedBoxAddr 显示 Drive3 的 Profibus 站号；若 bLookupError = TRUE，nLastErrCode 给出错误号（常见 0x6 = 名字找不到）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次调用形式，bStartLookup 上升沿触发
fbResolveBoxAddr(
    NETID    := sTargetNetId,
    DEVICEID := nProfibusDeviceId,
    BOXNAME  := sQueryBoxName,
    START    := bStartLookup,
    TMOUT    := tLookupTimeout,
    BUSY     =&gt; bLookupBusy,
    ERR      =&gt; bLookupError,
    ERRID    =&gt; nLastErrCode,
    BOXADDR  =&gt; nResolvedBoxAddr
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
