<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_AmsLogger" Id="{233d6542-057c-5127-88ea-7d12fead89ef}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_AmsLogger
VAR
    fbFB_AmsLogger : FB_AmsLogger; // FB_AmsLogger 实例
    sNetId         : T_AmsNetId := '';
    eMode          : E_AmsLoggerMode := AMSLOGGER_RUN;
    sCfgFilePath   : T_MaxString := '';
    bExecute       : BOOL;
    tTimeout       : TIME := DEFAULT_ADS_TIMEOUT;
    bBusy          : BOOL;
    bError         : BOOL;
    nErrId         : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：老项目日志。
// 价值：兼容。
// 验证：调用 Add 加日志条目，目标日志服务应收到。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_AmsLogger(
    sNetId := sNetId,
    eMode := eMode,
    sCfgFilePath := sCfgFilePath,
    bExecute := bExecute,
    tTimeout := tTimeout,
    bBusy => bBusy,
    bError => bError,
    nErrId => nErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
