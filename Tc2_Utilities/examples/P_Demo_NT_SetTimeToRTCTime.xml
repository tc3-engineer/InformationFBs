  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_NT_SetTimeToRTCTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNT_SetTimeToRTCTime">
              <type><derived name="NT_SetTimeToRTCTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NT_SetTimeToRTCTime 实例</xhtml></documentation>
            </variable>
            <variable name="bRevert">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：NTP 失败时退回硬件 RTC。
// 价值：提供时间源回退。
// 验证：触发后桌面时钟应与硬件 RTC（在 BIOS 看）一致。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_SetTimeToRTCTime(
    NETID := '', START := bRevert, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
