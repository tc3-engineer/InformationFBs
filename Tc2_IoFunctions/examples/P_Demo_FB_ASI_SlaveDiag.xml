<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_ASI_SlaveDiag Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_ASI_SlaveDiag" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAsiSlaveDiag">
              <type><derived name="FB_ASI_SlaveDiag"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI slave 诊断 FB</xhtml></documentation>
            </variable>
            <variable name="fbAsiParamControl">
              <type><derived name="FB_ASI_ParameterControl"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">后台调度（必须循环调用）</xhtml></documentation>
            </variable>
            <variable name="stAsiParamBuffer">
              <type><derived name="ST_ParameterBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">共享缓冲</xhtml></documentation>
            </variable>
            <variable name="stAsiInProcessImg">
              <type><derived name="ST_Parameter_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链到 %I*</xhtml></documentation>
            </variable>
            <variable name="stAsiOutProcessImg">
              <type><derived name="ST_Parameter_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链到 %Q*</xhtml></documentation>
            </variable>
            <variable name="iTargetAsiSlaveAddr">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 slave 地址</xhtml></documentation>
            </variable>
            <variable name="iSelectedCounterType">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">1=PhysicalFault 2=Timeout 3=Response 4=LeaveDX 5=DXFailed</xhtml></documentation>
            </variable>
            <variable name="bReadIdentifiedList">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读 LES</xhtml></documentation>
            </variable>
            <variable name="bReadActivatedList">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读 LAS</xhtml></documentation>
            </variable>
            <variable name="bEnableCyclicRead">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=单次读 1=连续读 (PDF: bCyleMode)</xhtml></documentation>
            </variable>
            <variable name="bStartDiag">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="iLatestCounterValue">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">最新计数器值</xhtml></documentation>
            </variable>
            <variable name="iActiveSlaveBitmap">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">LES / LAS 位图</xhtml></documentation>
            </variable>
            <variable name="nAsiCmdError">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ASI 主端子错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：ASI 总线下挂 8 台 slave，运维要求 PLC 周期读 slave 5 的物理错计数器，超过 100 时报警；并定期读 LAS 确认所有 slave 在通讯。
// 价值：让 SCADA 能拿到 ASI 主端子的内部诊断字段，做趋势 + 报警。
// 验证：登录后 iTargetAsiSlaveAddr := 5、iSelectedCounterType := 1（物理错计数器）、bEnableCyclicRead := TRUE（连续读模式）、bStartDiag := TRUE，观察 iLatestCounterValue 实时刷新；切 bReadActivatedList := TRUE、bReadIdentifiedList := FALSE 时 iActiveSlaveBitmap 显示当前激活 slave 位图。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 后台调度必须循环调用
fbAsiParamControl(
    stParameterBuffer := stAsiParamBuffer,
    stParameter_IN    := stAsiInProcessImg,
    stParameter_OUT   := stAsiOutProcessImg
);

// PDF VAR 名是 bCyleMode（拼写错误），保持原名调用
fbAsiSlaveDiag(
    iSlaveaddress     := iTargetAsiSlaveAddr,
    iCounter          := iSelectedCounterType,
    bReadLES          := bReadIdentifiedList,
    bReadLAS          := bReadActivatedList,
    bCyleMode         := bEnableCyclicRead,
    bStart            := bStartDiag,
    stParameterBuffer := stAsiParamBuffer,
    iCounterValue     =&gt; iLatestCounterValue,
    iErrornumber      =&gt; nAsiCmdError,
    iSlaveList        =&gt; iActiveSlaveBitmap
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
