<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ipSourceInfo" Id="{19e5f692-ab2b-515d-a48b-0ab7c6a73e44}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ipSourceInfo
VAR
    fbAlarm     : FB_TcAlarm; // alarm 实例（已 Create）
    ipSrc       : I_TcSourceInfo; // 源信息接口
    sSourceName : STRING(80); // 拿到的 SourceName
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：读取 alarm 的源信息用于日志归档
// 价值：一次调用拿到 SourceInfo 接口供后续读 SourceName/SourceID
// 验证：登录后 monitor ipSrc，应能拿到非 0 接口；调用 ipSrc 上的 getter 能读出 SourceName 字符串
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

ipSrc := fbAlarm.ipSourceInfo;
IF ipSrc &lt;&gt; 0 THEN
    sSourceName := ipSrc.sSourceName;     // I_TcSourceInfo 的属性
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
