<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_SYSTEMTIME_TO_ISO8601" Id="{c1891b51-73cd-5e1b-bb07-6be0e1ab18f6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_SYSTEMTIME_TO_ISO8601
VAR
    stMeasurement    : TIMESTRUCT; // 测量发生的时刻 (初始化通过在线手动赋值; 推荐字段：( wYear := 2026, wMonth := 5, wDay := 11, wHour := 12, wMinute := 34, wSecond := 56, wMilliseconds := 123 ))
    nBiasMin         : INT := 0; // UTC vs Local（分钟）；UTC 输入此值无关
    bInputIsUTC      : BOOL := TRUE; // TRUE = stMeasurement 是 UTC
    nPrecisionDigits : USINT := 3; // 秒后小数位数
    sISOTime         : STRING(39); // 输出的 ISO 字符串
    bRunOnce         : BOOL; // 脉冲触发
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：MQTT 发布生产数据，要求时间字段为 ISO 8601（Node-RED / Grafana 标准）
//
// 价值：1 行得到 ISO 8601 字符串，自动处理 TZD 和小数位
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.3.46.0）
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 sISOTime = «2026-05-11T12:34:56.123Z»
//   5. nPrecisionDigits := 6 → 「...56.123000Z」（多 3 位零填充）
// =============================================================================
sISOTime := SYSTEMTIME_TO_ISO8601(stMeasurement, nBiasMin, bInputIsUTC, nPrecisionDigits);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
