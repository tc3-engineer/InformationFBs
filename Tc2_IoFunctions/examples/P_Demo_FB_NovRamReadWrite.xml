<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_NovRamReadWrite Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_NovRamReadWrite" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNovRamAccess">
              <type><derived name="FB_NovRamReadWrite"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOV-RAM 读写 FB（老接口）</xhtml></documentation>
            </variable>
            <variable name="nNovRamDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NOVRAM 卡 Device Id</xhtml></documentation>
            </variable>
            <variable name="stMachineStateToNov">
              <type><array><dimension lower="1" upper="32"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要写入 NOV 的状态结构（32 字节）</xhtml></documentation>
            </variable>
            <variable name="stMachineStateFromNov">
              <type><array><dimension lower="1" upper="32"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">从 NOV 读出的状态结构</xhtml></documentation>
            </variable>
            <variable name="bReadFromNovRam">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发读</xhtml></documentation>
            </variable>
            <variable name="bWriteToNovRam">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发写</xhtml></documentation>
            </variable>
            <variable name="tNovRamTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bNovRamBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bNovRamErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastNovErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：早期 FC3101-0002 卡 NOV-RAM 存"机器姿态"结构（坐标 + 工件计数 + 当前模式）；上电读出恢复，关机前写入。
// 价值：掉电不丢工艺状态。
// 验证：登录后 nDeviceId 设为 FC3101 的 ID；触发 bReadFromNovRam → bNovRamBusy 短暂 TRUE → 回 FALSE 后 stMachineStateFromNov 含上次写入的内容；修改 stMachineStateToNov 后触发 bWriteToNovRam → 重新读应得到新值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// pSrcAddr / pDestAddr 用 ADR() 取地址；cbXxxLen 用 SIZEOF 自动算字节数
fbNovRamAccess(
    nDevId    := nNovRamDeviceId,
    bRead     := bReadFromNovRam,
    bWrite    := bWriteToNovRam,
    cbSrcLen  := SIZEOF(stMachineStateToNov),
    cbDestLen := SIZEOF(stMachineStateFromNov),
    pSrcAddr  := ADR(stMachineStateToNov),
    pDestAddr := ADR(stMachineStateFromNov),
    tTimeOut  := tNovRamTimeout,
    bBusy     =&gt; bNovRamBusy,
    bErr      =&gt; bNovRamErr,
    nErrId    =&gt; nLastNovErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
