            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc3_EventLogger.ClearLoggedEvents 演示程序（FB 实例）
// ============================================================
// 验证步骤：
//   1. 引用 Tc3_EventLogger（及依赖类型所在库 Tc2_System 等）
//   2. 编译 + 登录
//   3. 按 doc.md 给 arg_* 赋值
//   4. 在线监视 out_* / io_* 输出
// ============================================================

fbClearLoggedEvents(
    ipClearSettings := arg_ipClearSettings,
    bError =&gt; out_bError,
    hrErrorCode =&gt; out_hrErrorCode
);
</xhtml>
