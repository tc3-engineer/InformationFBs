<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_IsEmpty" Id="{edbdc6b1-5641-5aa0-a6da-68712421bf71}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_IsEmpty
VAR
    fbAlarm : FB_TcAlarm; // alarm 实例（已 Create）
    ipArgs  : I_TcArguments; // 参数列表接口
    bEmpty  : BOOL; // 参数表状态
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：Raise 前检查参数表残留
// 价值：一次调用获取状态
// 验证：登录后 monitor bEmpty；调用 Add 前应为 TRUE，Add 后为 FALSE
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

ipArgs := fbAlarm.ipArguments;
IF ipArgs &lt;&gt; 0 THEN
    bEmpty := ipArgs.IsEmpty();
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
