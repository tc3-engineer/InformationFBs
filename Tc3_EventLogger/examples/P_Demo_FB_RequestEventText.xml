<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.FB_RequestEventText Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RequestEventText" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReq">
              <type><derived name="FB_RequestEventText"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求 FB 实例</xhtml></documentation>
            </variable>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">提供 fbEventBase 参考的事件源</xhtml></documentation>
            </variable>
            <variable name="nLangId">
              <initialValue><simpleValue value="2052"/></initialValue>
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 LangId（中文）</xhtml></documentation>
            </variable>
            <variable name="bDoReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoReqPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">状态</xhtml></documentation>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误</xhtml></documentation>
            </variable>
            <variable name="hrErrorCode">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误码</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Request 返回值</xhtml></documentation>
            </variable>
            <variable name="sResult">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">结果文本</xhtml></documentation>
            </variable>
            <variable name="bGot">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已取到结果</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：异步取事件本地化文本
// 价值：异步取本地化资源
// 验证：登录后写 bDoReq := TRUE 触发；几周期后 bBusy 变 FALSE 且 bError 应为 FALSE；之后取结果
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoReq AND NOT bDoReqPrev THEN
    fbReq.Clear();                            // 清理上次结果
    hr := fbReq.Request(nLangId := nLangId, fbEventBase := fbAlarm);
    bGot := FALSE;
END_IF;
bDoReqPrev := bDoReq;

bBusy := fbReq.bBusy;
bError := fbReq.bError;
hrErrorCode := fbReq.hrErrorCode;

IF NOT bBusy AND NOT bError AND NOT bGot THEN
    fbReq.GetString(sResult := sResult);
    bGot := TRUE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
