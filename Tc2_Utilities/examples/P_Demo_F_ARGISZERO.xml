<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.F_ARGISZERO Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_ARGISZERO" pouType="program">
        <interface>
          <localVars>
            <variable name="nLiveValue"><type><INT/></type>
              <initialValue><simpleValue value="42"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">业务值</xhtml></documentation>
            </variable>
            <variable name="argInUse"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">会被 F_INT 绑定的槽位</xhtml></documentation>
            </variable>
            <variable name="argUnused"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">不绑定，模拟空槽位</xhtml></documentation>
            </variable>
            <variable name="bInUseIsEmpty"><type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">期望 FALSE</xhtml></documentation>
            </variable>
            <variable name="bUnusedIsEmpty"><type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">期望 TRUE</xhtml></documentation>
            </variable>
            <variable name="bCheck"><type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 触发一次检查</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.F_ARGISZERO 演示程序
// ============================================================
// 场景：遍历 T_ArgList 时跳过未填的空槽位，避免 deref pData=0 崩溃。
// 价值：一行替代 IF a.pData = 0 OR a.cbLen = 0 OR a.eType = 0 THEN 三段判空。
// 验证：bCheck := TRUE；bInUseIsEmpty 应为 FALSE，bUnusedIsEmpty 应为 TRUE。
// ============================================================

// 只绑定 argInUse；argUnused 保持默认（三字段都为 0）
argInUse := F_INT(nLiveValue);

IF bCheck THEN
    bInUseIsEmpty  := F_ARGISZERO(arg := argInUse);
    bUnusedIsEmpty := F_ARGISZERO(arg := argUnused);
    bCheck := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
