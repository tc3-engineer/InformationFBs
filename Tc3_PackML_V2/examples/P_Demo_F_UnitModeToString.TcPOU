<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_UnitModeToString" Id="{1aad5ce4-ed52-56f2-a97b-545b61888137}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_UnitModeToString
VAR
    eMode     : DINT := 1;        // 1=Production / 2=Maintenance / 3=Manual
    sModeName : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc3_PackML_V2.F_UnitModeToString 演示程序
// ============================================================
// 场景：HMI 显示当前模式 Production——把 DINT 模式编号转字符串。
// 价值：支持基础模式 1-3 硬编码 + 自定义模式 4-31 查 PML_UnitModeConfig.sName。
// 验证：eMode := 1 应得 sModeName = 'Production'；eMode := 2 应得 'Maintenance'。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_PackML_V2（References → Add library）
//   3. 编译 → 登录 → 运行；按上方"验证"指引在线写值观察
// ============================================================

sModeName := F_UnitModeToString(eMode := eMode);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
