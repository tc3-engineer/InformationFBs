<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.FB_TcCauseRemedy Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TcCauseRemedy" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReq">
              <type><derived name="FB_RequestCauseRemedy"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上游请求 FB（应已完成）</xhtml></documentation>
            </variable>
            <variable name="fbCauseRemedy">
              <type><derived name="FB_TcCauseRemedy"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">承载子项</xhtml></documentation>
            </variable>
            <variable name="sCause">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">原因文本</xhtml></documentation>
            </variable>
            <variable name="sRemedy">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">补救文本</xhtml></documentation>
            </variable>
            <variable name="bGot">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已读取标志</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读取通过 FB_RequestCauseRemedy.Get 填充的子项字段
// 价值：结构化访问承载子项
// 验证：先有完成的 FB_RequestCauseRemedy；调 Get 填充本 FB；再读 GetCause/GetRemedy
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 从上游请求里取第 0 项填充本 FB
fbReq.Get(nIndex := 0, fbResult := fbCauseRemedy);

// 读字段（Get 系列方法的 sResult 参数是 VAR_IN_OUT STRING）
fbCauseRemedy.GetCause(sResult := sCause);
fbCauseRemedy.GetRemedy(sResult := sRemedy);
bGot := LEN(sCause) &amp;gt; 0;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
