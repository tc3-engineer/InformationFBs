  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RegQueryValue" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_RegQueryValue">
              <type><derived name="FB_RegQueryValue"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_RegQueryValue 实例</xhtml></documentation>
            </variable>
            <variable name="sNetId">
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="sSubKey">
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="sValName">
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="cbData">
              <type><UDINT/></type>
            </variable>
            <variable name="pData">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="bExecute">
              <type><BOOL/></type>
            </variable>
            <variable name="tTimeOut">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrId">
              <type><UDINT/></type>
            </variable>
            <variable name="cbRead">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读注册表。
// 价值：替代 Shell。
// 验证：读 `HKLM\SOFTWARE\Beckhoff` 任一键应非空。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_RegQueryValue(
    sNetId := sNetId,
    sSubKey := sSubKey,
    sValName := sValName,
    cbData := cbData,
    pData := pData,
    bExecute := bExecute,
    tTimeOut := tTimeOut,
    bBusy =&gt; bBusy,
    bError =&gt; bError,
    nErrId =&gt; nErrId,
    cbRead =&gt; cbRead
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
