<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.F_CreateMacAddr Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_CreateMacAddr" pouType="program">
        <interface>
          <localVars>
            <variable name="aMacBytes">
              <initialValue><simpleValue value="[16#1C, 16#2C, 16#3C, 16#4C, 16#5C, 16#6C]"/></initialValue>
              <type><derived name="T_MacAddrArr"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">6 字节 MAC 地址</xhtml></documentation>
            </variable>
            <variable name="sSeparatorChar">
              <initialValue><simpleValue value="'-'"/></initialValue>
              <type><string><length>1</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">分隔符：'-' 或 ':'</xhtml></documentation>
            </variable>
            <variable name="bUseLowerCase">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE 用小写</xhtml></documentation>
            </variable>
            <variable name="sMacDisplay">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_MacAddr"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">格式化后的 MAC 字符串</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 显示本机网卡 MAC：从 ADS 读取 6 字节 MAC 转 '1C-2C-3C-4C-5C-6C' 字符串。
// 价值：替代手写 6 次 hex 转换 + 5 次拼接 8-10 行。
// 验证：改 aMacBytes 任一字节 → sMacDisplay 跟着变；bUseLowerCase := TRUE → 输出转小写。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 每周期格式化一次
sMacDisplay := F_CreateMacAddr(
    aMacAddr   := aMacBytes,
    sSeparator := sSeparatorChar,
    bLoCase    := bUseLowerCase
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
