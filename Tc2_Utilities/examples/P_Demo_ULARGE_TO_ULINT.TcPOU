<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_ULARGE_TO_ULINT" Id="{90fd478b-b668-5b58-baa9-ddd4797df094}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_ULARGE_TO_ULINT
VAR
    uliFromAds : T_ULARGE_INTEGER;; // ADS 报文里读到的字段
    ulNative   : ULINT;; // 业务侧原生 64 位
    bConvert   : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.ULARGE_TO_ULINT 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：ADS Raw 报文里读到一个 T_ULARGE_INTEGER 字段，业务逻辑全用 ULINT 算术，需要一步转换。
// 价值：替代手写位移 + 加法；一行调用。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    ulNative := ULARGE_TO_ULINT(uliFromAds);   // 转换后即可参与 IEC 算术
    bConvert := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
