<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HashTableCtrl" Id="{d7f86534-bdce-59f0-ae86-6a419c811b23}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HashTableCtrl
VAR
    fbFB_HashTableCtrl : FB_HashTableCtrl; // FB_HashTableCtrl 实例
    key                : DWORD := 0;
    putValue           : PVOID := 0;
    putPosPtr          : POINTER TO T_HashTableEntry := 0;
    bOk                : BOOL;
    getValue           : PVOID;
    getPosPtr          : POINTER TO T_HashTableEntry;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HMI 标签到 PLC ID 映射。
// 价值：O(1) 查找。
// 验证：Add 100 个键值，Find 随机键应秒查。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_HashTableCtrl(
    key := key,
    putValue := putValue,
    putPosPtr := putPosPtr,
    bOk => bOk,
    getValue => getValue,
    getPosPtr => getPosPtr
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
