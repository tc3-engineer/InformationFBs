<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MemBufferSplit" Id="{799990bd-09d6-510a-a3af-a83d619d3988}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MemBufferSplit
VAR
    fbFB_MemBufferSplit : FB_MemBufferSplit; // FB_MemBufferSplit 实例
    eCmd                : E_EnumCmdType := eEnumCmd_First;
    pBuffer             : POINTER TO BYTE;
    cbBuffer            : UDINT;
    cbSize              : UDINT;
    bOk                 : BOOL;
    pSegment            : POINTER TO BYTE;
    cbSegment           : UDINT;
    bEOS                : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：拆通讯协议包。
// 价值：意图清晰。
// 验证：给一段缓冲 + 拆分位置 N，触发后前 N 字节进段 1，剩余进段 2。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemBufferSplit(
    eCmd := eCmd,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    cbSize := cbSize,
    bOk => bOk,
    pSegment => pSegment,
    cbSegment => cbSegment,
    bEOS => bEOS
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
