<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MemRingBufferEx" Id="{0ba08248-65f8-5998-8690-8d7fcf391357}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MemRingBufferEx
VAR
    fbFB_MemRingBufferEx : FB_MemRingBufferEx; // FB_MemRingBufferEx 实例
    pWrite               : POINTER TO BYTE;
    cbWrite              : UDINT;
    pBuffer              : POINTER TO BYTE;
    cbBuffer             : UDINT;
    bOk                  : BOOL;
    pRead                : POINTER TO BYTE;
    cbRead               : UDINT;
    nCount               : UDINT;
    cbSize               : UDINT;
    cbFree               : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：变长事件日志。
// 价值：支持变长。
// 验证：Add 不同长度记录，Get 取回原样。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemRingBufferEx(
    pWrite := pWrite,
    cbWrite := cbWrite,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk => bOk,
    pRead => pRead,
    cbRead => cbRead,
    nCount => nCount,
    cbSize => cbSize,
    cbFree => cbFree
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
