<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_stLibVersion_Tc2_Standard" Id="{6976ee20-f995-5829-a7a0-570d1f7403c3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_stLibVersion_Tc2_Standard
VAR
    stMyVer    : ST_LibVersion; // 本地副本，在线 monitor 用
    bVersionOk : BOOL; // 版本校验结果：TRUE = 库版本 >= 1.3.4
    bFault     : BOOL; // 系统 fault 输出：版本不达标时置 TRUE 触发上游报警
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：工程启动时校验 Tc2_Standard 库版本 >= 1.3.4。某些客户工厂用的是
//       TwinCAT 老版本，自带的 Tc2_Standard 可能停留在 1.2.x，本工程依赖
//       LTON / LTOF / LTP（这些 LTIME 定时器是 1.3.x 才加入）。如果库版本
//       不达标必须立刻让 PLC 进 fault 状态，避免后续运行时 LTON 实例化失败。
//
// 价值：用全局常量 + F_CmpLibVersion 做运行时版本守卫，比靠工程师记住
//       "这个工程必须用 TwinCAT 4024.x 以上" 靠谱得多。换工程师交接时不会
//       因为环境差异 silently failed。
//
// 前置：工程必须同时引用 Tc2_Standard 与 Tc2_System（提供 ST_LibVersion 类型
//       和 F_CmpLibVersion / E_CmpLibVersion）。
//
// 验证步骤：
//   1. 在 References 加入 Tc2_Standard + Tc2_System
//   2. 导入本文件、编译、登录、运行
//   3. 在线 monitor stMyVer → 显示 iMajor=1, iMinor=3, iBuild=4 之类
//   4. 在线 monitor bVersionOk → 应为 TRUE
//   5. 在线 monitor bFault → 应为 FALSE
//   6. 把代码里 iMinor := 3 临时改为 iMinor := 99 重新登录 →
//      bVersionOk = FALSE, bFault = TRUE（模拟版本不达标场景）
// =============================================================================

// 第 1 步：把全局常量复制到本地，便于 XAE 在线监视
stMyVer := stLibVersion_Tc2_Standard;

// 第 2 步：调用 Tc2_System.F_CmpLibVersion 做 >= 1.3.4 比较
//          E_CmpLibVersion.GreaterOrEqual 是"实际版本 >= 期望版本"的语义
bVersionOk := F_CmpLibVersion(
    stLibVersion := stLibVersion_Tc2_Standard,
    iMajor       := 1,
    iMinor       := 3,
    iBuild       := 4,
    iRevision    := 0,
    nCmpType     := E_CmpLibVersion.GreaterOrEqual);

// 第 3 步：版本不达标 → 业务侧置 fault 触发上游报警
bFault := NOT bVersionOk;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
