<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_GetDeviceType Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_GetDeviceType" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetDeviceType">
              <type><derived name="IOF_GetDeviceType"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">设备类型查询 FB</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nLookupDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 Device Id</xhtml></documentation>
            </variable>
            <variable name="bStartReadType">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tReadTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bReadBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bReadError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="eDeviceTypeOut">
              <type><derived name="IODEVICETYPES"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">设备类型枚举</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：IO 巡检：循环遍历 Device Id，对每个 ID 判断是 Profibus / EtherCAT / KL coupler 决定下一步诊断分支。
// 价值：通用诊断脚本支持多总线。
// 验证：登录后 nLookupDeviceId := 1，在线写 bStartReadType := TRUE → 回 FALSE 后 eDeviceTypeOut 显示枚举值（与 PDF 中 IODEVICETYPES 表对照）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbGetDeviceType(
    NETID        := sTargetNetId,
    DEVICEID     := nLookupDeviceId,
    START        := bStartReadType,
    TMOUT        := tReadTimeout,
    BUSY         =&gt; bReadBusy,
    ERR          =&gt; bReadError,
    ERRID        =&gt; nLastErrCode,
    IODeviceType =&gt; eDeviceTypeOut
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
