<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_BIT_CONTROL_SEND_EX" Id="{b5ad36a1-e8cd-57c2-89eb-9caa622392d2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_BIT_CONTROL_SEND_EX
VAR
    fbSendEmergencyEx  : EIB_BIT_CONTROL_SEND_EX;
    stEibRec           : EIB_REC;
    stGroup            : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 1, NUMBER := 40);
    bSendStart         : BOOL;
    iWorkMode          : INT := 3;
    tCycle             : TIME := T#10S;
    tMinSend           : TIME := T#500MS;
    bForced            : BOOL;
    bValueOn           : BOOL;
    bResponseRead      : BOOL := TRUE;
    bSendBusy          : BOOL;
    bSendError         : BOOL;
    iLastErrID         : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_BIT_CONTROL_SEND_EX 演示程序
// ============================================================
// 场景：应急状态按 OnChangePolling 心跳 10 秒，确保 BMS 即使错过即时变化也能同步当前应急状态。
// 价值：DPT 2.xxx + 周期心跳 + 即时变化 + 答查；安全工程首选
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：登录 `bStart := TRUE`、`iMode := 3` → 每 10 秒看到组 1/1/40 出帧。
// ============================================================

fbSendEmergencyEx(
    bStart         := bSendStart,
    iMode          := iWorkMode,
    CyclePolling   := tCycle,
    MinSendTime    := tMinSend,
    Group_Address  := stGroup,
    bControl       := bForced,
    bValue         := bValueOn,
    str_Rec        := stEibRec,
    bEnableReadReq := bResponseRead,
    bBusy          => bSendBusy,
    bError         => bSendError,
    iErrorID       => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
