<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACPersistent_XX" Id="{39ac89e5-22fc-5444-832a-51261b53ddc5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACPersistent_XX
VAR
    fb : FB_HVACPersistent_XX;                            // 被演示 FB 实例
    bSetDefault_in : BOOL := FALSE;
    byVar_Default_in : BYTE := 0;
    byVar_io : BYTE := 0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACPersistent_XX 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACPersistent_XX.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    bSetDefault := bSetDefault_in,
    byVar_Default := byVar_Default_in,
    byVar := byVar_io
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
