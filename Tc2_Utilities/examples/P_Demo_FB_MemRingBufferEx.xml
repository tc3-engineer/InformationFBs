      <pou name="P_Demo_FB_MemRingBufferEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_MemRingBufferEx">
              <type><derived name="FB_MemRingBufferEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_MemRingBufferEx 实例</xhtml></documentation>
            </variable>
            <variable name="pWrite">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbWrite">
              <type><UDINT/></type>
            </variable>
            <variable name="pBuffer">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbBuffer">
              <type><UDINT/></type>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
            </variable>
            <variable name="pRead">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbRead">
              <type><UDINT/></type>
            </variable>
            <variable name="nCount">
