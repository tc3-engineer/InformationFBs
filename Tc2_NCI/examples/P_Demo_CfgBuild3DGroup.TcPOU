<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_CfgBuild3DGroup" Id="{c2028261-25f1-52f8-a899-2e96bb38e44f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_CfgBuild3DGroup
VAR
    fbCfgBuild3DGroup                     : CfgBuild3DGroup;  // 被演示 FB 实例
    rtTrig                                : R_TRIG;  // 边沿触发器，把人工『按一下』转上升沿
    bDoIt                                 : BOOL := FALSE;  // 在线写 TRUE 触发一次
    nGroupId_in                           : UDINT := 0;
    nXAxisId_in                           : UDINT := 0;
    nYAxisId_in                           : UDINT := 0;
    nZAxisId_in                           : UDINT := 0;
    tTimeOut_in                           : TIME := T#2S;  // ADS 调用超时
    bBusy_out                             : BOOL;
    bErr_out                              : BOOL;
    nErrId_out                            : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_NCI.CfgBuild3DGroup 演示程序
// ============================================================
// 场景：CNC 雕刻机开机自检：System Manager 里把 X/Y/Z 配成 3 根独立 PTP 轴，开机由本 FB 把它们绑成 GroupId=1 的 NCI 3D 组，让解释器可以发 G-Code。
// 价值：免去『进 XAE 配组 → 下载 → 重启 NC』流程；同一 PLC 程序可适配不同的轴组合（在线传不同 AxisId）。
// 验证：在 System Manager 配好 3 根 PTP 轴（AxisId 1/2/3）+ NCI 通道（ChannelId 1，GroupId 1，类型 Interpreter）。在线写 bDoIt := TRUE 触发一次，观察 fbCfgBuild3DGroup.bBusy → TRUE → FALSE，bErr 应为 FALSE。完成后 NCI 通道里 GroupId=1 已是 3D 组，下一步可 ItpLoadProgEx 加载 .nc 程序。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_NCI（References → Add library）
//   3. 在 System Manager 把 NCI 通道接口 Link 给 sNciToPlc_inst / sPlcToNci_inst
//      （NCTOPLC_NCICHANNEL_REF 给 AT %I*、PLCTONC_NCICHANNEL_REF 给 AT %Q*）
//   4. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 把人工按下的电平转成真正的上升沿；这是 bExecute 系列引脚的标准用法
rtTrig(CLK := bDoIt);

// 单次完整调用：所有 VAR_INPUT / VAR_IN_OUT / VAR_OUTPUT 引脚显式赋值或绑定
fbCfgBuild3DGroup(
    bExecute := rtTrig.Q,
    nGroupId := nGroupId_in,
    nXAxisId := nXAxisId_in,
    nYAxisId := nYAxisId_in,
    nZAxisId := nZAxisId_in,
    tTimeOut := tTimeOut_in,
    bBusy    => bBusy_out,
    bErr     => bErr_out,
    nErrId   => nErrId_out
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
