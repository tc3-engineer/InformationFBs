<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_RAIDGetInfo Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RAIDGetInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbGetRaidInfo">
              <type><derived name="FB_RAIDGetInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RAID 控制器元信息 FB（仅一次）</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nTargetRaidCtlrId">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查的 RAID 控制器 ID</xhtml></documentation>
            </variable>
            <variable name="bDoGetRaidInfo">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发（仅一次）</xhtml></documentation>
            </variable>
            <variable name="tRaidQueryTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="stRaidInfoOut">
              <type><derived name="ST_RAIDInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RAID 元信息</xhtml></documentation>
            </variable>
            <variable name="nRaidBytesRead">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回字节数</xhtml></documentation>
            </variable>
            <variable name="bRaidInfoBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bRaidInfoError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nRaidInfoErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：已知 RAID 控制器 ID = 0，查它管几组 RAID 阵列。
// 价值：RAID 拓扑可程序化监控。
// 验证：登录后 nTargetRaidCtlrId := 0，bDoGetRaidInfo := TRUE → bRaidInfoBusy 短暂 TRUE → 回 FALSE 后 stRaidInfoOut 含集数与盘数信息。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：不能循环调用！
fbGetRaidInfo(
    sNETID       := sLocalNetId,
    bWrtRd       := bDoGetRaidInfo,
    nRAIDCntlrID := nTargetRaidCtlrId,
    tTimeOut     := tRaidQueryTimeout,
    stRAIDInfo   =&gt; stRaidInfoOut,
    nBytesRead   =&gt; nRaidBytesRead,
    bBusy        =&gt; bRaidInfoBusy,
    bError       =&gt; bRaidInfoError,
    nErrorID     =&gt; nRaidInfoErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
