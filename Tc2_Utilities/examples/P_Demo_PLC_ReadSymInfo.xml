  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_PLC_ReadSymInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbPLC_ReadSymInfo">
              <type><derived name="PLC_ReadSymInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PLC_ReadSymInfo 实例</xhtml></documentation>
            </variable>
            <variable name="NETID">
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="PORT">
              <type><derived name="T_AmsPort"/></type>
            </variable>
            <variable name="START">
              <type><BOOL/></type>
            </variable>
            <variable name="TMOUT">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="BUSY">
              <type><BOOL/></type>
            </variable>
            <variable name="ERR">
              <type><BOOL/></type>
            </variable>
            <variable name="ERRID">
              <type><UDINT/></type>
            </variable>
            <variable name="SYMCOUNT">
              <type><UDINT/></type>
            </variable>
            <variable name="SYMSIZE">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：自动发现 PLC 变量。
// 价值：自动。
// 验证：循环增加 nIndex 触发，能依次读出本机所有符号。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbPLC_ReadSymInfo(
    NETID := NETID,
    PORT := PORT,
    START := START,
    TMOUT := TMOUT,
    BUSY =&gt; BUSY,
    ERR =&gt; ERR,
    ERRID =&gt; ERRID,
    SYMCOUNT =&gt; SYMCOUNT,
    SYMSIZE =&gt; SYMSIZE
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
