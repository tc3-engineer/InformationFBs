<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARSunblindActuatorEx" Id="{3d4fd110-27cc-59db-9816-ddaed2b70647}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARSunblindActuatorEx
VAR
    fb : FB_BARSunblindActuatorEx;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bEnable_in : BOOL := FALSE;
    stSunblind_in : ST_BARSunblind ;
    uiBacklashTimeUp_io : UINT := 0;
    uiBacklashTimeDown_io : UINT := 0;
    uiTurningTimeUp_io : UINT := 0;
    uiTurningTimeDown_io : UINT := 0;
    udiTotalTimeUp_io : UDINT := 0;
    udiTotalTimeDown_io : UDINT := 0;
    uiBlindHeight_io : UINT := 0;
    iAngleLimitUp_io : INT := 0;
    iAngleLimitDown_io : INT := 0;
    bBlindUp_out : BOOL;
    bBlindDown_out : BOOL;
    uiActPosition_out : UINT;
    uiActAngle_out : UINT;
    bReferencing_out : BOOL;
    bBusy_out : BOOL;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARSunblindActuatorEx 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARSunblindActuatorEx.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bEnable := bEnable_in,
    stSunblind := stSunblind_in,
    uiBacklashTimeUp := uiBacklashTimeUp_io,
    uiBacklashTimeDown := uiBacklashTimeDown_io,
    uiTurningTimeUp := uiTurningTimeUp_io,
    uiTurningTimeDown := uiTurningTimeDown_io,
    udiTotalTimeUp := udiTotalTimeUp_io,
    udiTotalTimeDown := udiTotalTimeDown_io,
    uiBlindHeight := uiBlindHeight_io,
    iAngleLimitUp := iAngleLimitUp_io,
    iAngleLimitDown := iAngleLimitDown_io,
    bBlindUp => bBlindUp_out,
    bBlindDown => bBlindDown_out,
    uiActPosition => uiActPosition_out,
    uiActAngle => uiActAngle_out,
    bReferencing => bReferencing_out,
    bBusy => bBusy_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
