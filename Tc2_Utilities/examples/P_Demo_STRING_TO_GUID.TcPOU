<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_STRING_TO_GUID" Id="{135daf41-983f-5e5a-b179-606623672811}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_STRING_TO_GUID
VAR
    sUuid  : STRING(36) := '12345678-1234-5678-9ABC-123456789ABC'; // 工业语义：UUID 字符串
    stGuid : GUID; // 解析输出
    bParse : BOOL; // 在线触发
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：从数据库 `uuid` 列读出 36 字符 GUID 字符串 → 解析为 PLC GUID 结构 → 与本地缓存比对。
// 价值：替代手写 hex 解析 + 段切分。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bParse THEN
    stGuid := STRING_TO_GUID(in := sUuid);
    bParse := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
