<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MemRingBuffer" Id="{9ae9b01a-b982-5d0e-a842-76c32e955fc2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MemRingBuffer
VAR
    fbFB_MemRingBuffer : FB_MemRingBuffer; // FB_MemRingBuffer 实例
    pWrite             : POINTER TO BYTE;
    cbWrite            : UDINT;
    pRead              : POINTER TO BYTE;
    cbRead             : UDINT;
    pBuffer            : POINTER TO BYTE;
    cbBuffer           : UDINT;
    bOk                : BOOL;
    nCount             : UDINT;
    cbSize             : UDINT;
    cbReturn           : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HMI 趋势 1000 点。
// 价值：库提供。
// 验证：Init 容量 N，连续 Add N+1 个值，第一个被覆盖。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemRingBuffer(
    pWrite := pWrite,
    cbWrite := cbWrite,
    pRead := pRead,
    cbRead := cbRead,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk => bOk,
    nCount => nCount,
    cbSize => cbSize,
    cbReturn => cbReturn
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
