<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_GetBoxCount Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_GetBoxCount" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReadBoxCount">
              <type><derived name="IOF_GetBoxCount"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读现场总线 box 计数</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nProfibusDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profibus 主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="bRequestBoxCount">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发计数请求</xhtml></documentation>
            </variable>
            <variable name="tCountTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 超时</xhtml></documentation>
            </variable>
            <variable name="nExpectedBoxCount">
              <initialValue><simpleValue value="12"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工程配置的目标节点数</xhtml></documentation>
            </variable>
            <variable name="bCountBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB 工作中</xhtml></documentation>
            </variable>
            <variable name="bCountError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="nActiveBoxCount">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查得的在线节点数</xhtml></documentation>
            </variable>
            <variable name="bNodeMissingAlarm">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线节点数不足报警</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：上电自检阶段，PLC 程序需要确认 Profibus 总线下挂 12 台设备全部在线，否则拒绝进入"运行"状态。
// 价值：把"在线节点数核对"做成 30 行自检脚本里的一行调用。
// 验证：登录后写 bRequestBoxCount := TRUE → bCountBusy 短暂 TRUE → 回 FALSE 后 nActiveBoxCount 显示实际在线节点数；与工程配置数 nExpectedBoxCount 对比，nActiveBoxCount &lt; nExpectedBoxCount 时 bNodeMissingAlarm 置 TRUE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbReadBoxCount(
    NETID    := sTargetNetId,
    DEVICEID := nProfibusDeviceId,
    START    := bRequestBoxCount,
    TMOUT    := tCountTimeout,
    BUSY     =&gt; bCountBusy,
    ERR      =&gt; bCountError,
    ERRID    =&gt; nLastErrCode,
    BOXCOUNT =&gt; nActiveBoxCount
);

// 完成后核对：在线节点不足即报警（必须在 FB 调用之后用其输出）
IF NOT bCountBusy AND NOT bCountError THEN
    bNodeMissingAlarm := nActiveBoxCount &amp;lt; nExpectedBoxCount;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
