  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_MemBufferMerge" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_MemBufferMerge">
              <type><derived name="FB_MemBufferMerge"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_MemBufferMerge 实例</xhtml></documentation>
            </variable>
            <variable name="eCmd">
              <initialValue><simpleValue value="eEnumCmd_First"/></initialValue>
              <type><derived name="E_EnumCmdType"/></type>
            </variable>
            <variable name="pBuffer">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbBuffer">
              <type><UDINT/></type>
            </variable>
            <variable name="pSegment">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbSegment">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
            </variable>
            <variable name="bOk">
              <type><BOOL/></type>
            </variable>
            <variable name="cbSize">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：拼通讯协议包。
// 价值：意图清晰。
// 验证：给两段缓冲，触发合并；输出缓冲内容应为两段拼接。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemBufferMerge(
    eCmd := eCmd,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    pSegment := pSegment,
    cbSegment := cbSegment,
    bOk =&gt; bOk,
    cbSize =&gt; cbSize
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
