  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_R_TRIG" pouType="program">
        <interface>
          <localVars>
            <variable name="fbR_TRIG">
              <type><derived name="R_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Trigger 实例</xhtml></documentation>
            </variable>
            <variable name="bButton">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">按钮输入</xhtml></documentation>
            </variable>
            <variable name="bPress">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">按钮按下沿（单周期脉冲）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Standard.R_TRIG 演示程序
// ============================================================
// 场景：按钮按下（上升沿）时触发计数 +1
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译并登录目标
//   1. bButton := FALSE 保持 → bPress 始终 FALSE
//   2. bButton := TRUE → bPress 在该周期为 TRUE，下一周期回 FALSE
//   3. bButton 持续 TRUE → bPress 不再触发，必须先 FALSE 再 TRUE
// ============================================================

fbR_TRIG(
    CLK := bButton,
    Q   =&gt; bPress
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
