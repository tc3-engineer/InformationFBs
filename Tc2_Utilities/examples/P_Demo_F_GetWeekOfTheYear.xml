<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.F_GetWeekOfTheYear Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetWeekOfTheYear" pouType="program">
        <interface>
          <localVars>
            <variable name="dtProduction">
              <type><DATE_AND_TIME/></type>
              <initialValue><simpleValue value="DT#2026-05-11-08:00:00"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">投产日期</xhtml></documentation>
            </variable>
            <variable name="wCalendarWeek">
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ISO 8601 周编号（1~53）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：与 MES 系统对接，按 ISO 周编号下发周生产计划「CW19 投产 A 型号」
//
// 价值：1 行得到 ISO 周编号，自动处理跨年情形（12/29 可能属于下年第 1 周）
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE
//   4. 在线观察 wCalendarWeek = 20（2026-05-11 是 CW20）
//   5. dtProduction := DT#2027-01-01 → wCalendarWeek = 53（属于 2026 第 53 周，跨年规则）
// =============================================================================
wCalendarWeek := F_GetWeekOfTheYear(dtProduction);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
