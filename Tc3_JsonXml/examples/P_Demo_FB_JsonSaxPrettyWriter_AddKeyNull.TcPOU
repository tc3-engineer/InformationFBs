<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonSaxPrettyWriter_AddKeyNull" Id="{3737ab50-3287-5b8c-96bd-23f6d7c260c2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonSaxPrettyWriter_AddKeyNull
VAR
    fbParser : FB_JsonSaxPrettyWriter; // 父 FB 实例
    key : STRING(255);
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：SAX 流式生成 JSON 时追加 Null 类型的值/键值对。
// 价值：无 DOM 中间态，内存最省、速度最快。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    fbParser.AddKeyNull(
        key := key
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
