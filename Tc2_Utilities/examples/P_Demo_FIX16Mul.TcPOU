<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FIX16Mul" Id="{5ec8e642-53fe-540c-8249-7b6862e1f84f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FIX16Mul
VAR
    fp8A     : T_FIX16;
    fp8B     : T_FIX16;
    fp8Prod  : T_FIX16;
    lrResult : LREAL;
    bMul     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.FIX16Mul 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：把 PID 的比例系数（定点）× 误差（定点）= 输出（定点）。
// 价值：替代手写对齐 + INT 乘法。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

fp8A := LREAL_TO_FIX16(0.25, 8);
fp8B := LREAL_TO_FIX16(10.0, 8);
IF bMul THEN
    fp8Prod  := FIX16Mul(fp8A, fp8B);
    lrResult := FIX16_TO_LREAL(fp8Prod);   // 应为 2.5
    bMul := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
