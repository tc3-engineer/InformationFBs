<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UA_NodeReleaseHandle" Id="{4a7a6d76-8427-538e-b98a-9c8afb52bb16}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UA_NodeReleaseHandle
VAR
    fbReleaseTankLvl  : UA_NodeReleaseHandle;     // 释放 hTankLevelNode

    bRequestRelease   : BOOL := FALSE;            // 在线置 TRUE 触发释放
    hMesConnection    : DWORD;                    // 会话句柄（由 UA_Connect 设置）
    hTankLevelNode    : DWORD;                    // 要释放的节点句柄（由 UA_NodeGetHandle 设置）
    tReleaseTimeout   : TIME := T#3S;

    // —— 输出 ——
    bReleaseDone      : BOOL;
    bReleaseBusy      : BOOL;
    bReleaseError     : BOOL;
    nReleaseErrorId   : DWORD;

    bNodeReleased     : BOOL;                     // 业务锁存：句柄已确认释放
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：业务停机流程中需要把上电时取得的 OPC UA 节点句柄 hTankLevelNode 还
//       给 Server，再调 UA_Disconnect 关会话。如果直接 Disconnect 不显式释放，
//       Server 端会兜底清理但 PLC 端 hTankLevelNode 变量残留陈旧值——下一次
//       PLC 程序启动若复用该值，第一次 UA_Read 会拿 UAC_E_INVAL_NODE_HDL。
//
// 价值：演示「规范停机」中 NodeHdl 的显式释放 + PLC 端句柄变量清零，避免「幽
//       灵节点句柄」造成下一轮启动失败。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU
//   2. 引用 Tc3_PLCopen_OpcUa
//   3. 先用 P_Demo_UA_Connect + P_Demo_UA_GetNamespaceIndex + P_Demo_UA_NodeGetHandle
//      跑通到拿到 hTankLevelNode；把 ConnectionHdl / NodeHdl 抄到本程序
//   4. 编译 → 登录 → 运行
//   5. 在线脉冲 bRequestRelease := TRUE：100-200 ms 后 bReleaseDone = TRUE，
//      bNodeReleased → TRUE；hTankLevelNode 被业务侧清零（见 IF 块）
//   6. 再次脉冲 bRequestRelease（句柄已经 0）：可能报 0xE4DD0116 (UAC_E_INVAL_NODE_HDL)，
//      视为已清理，业务忽略此错误继续走 Disconnect 即可
// =============================================================================

// 单次调用：所有 VAR_INPUT 显式赋值
fbReleaseTankLvl(
    Execute       := bRequestRelease,
    ConnectionHdl := hMesConnection,
    NodeHdl       := hTankLevelNode,
    Timeout       := tReleaseTimeout,
    Done          => bReleaseDone,
    Busy          => bReleaseBusy,
    Error         => bReleaseError,
    ErrorID       => nReleaseErrorId
);

// 释放成功后立即把 PLC 端句柄变量清零，避免后续代码误用
IF bReleaseDone AND NOT bReleaseError THEN
    hTankLevelNode := 0;
    bNodeReleased  := TRUE;
END_IF;

// 工程化提醒：生产代码停机流程通常是：业务 Stop → 等若干周期 → 循环
// UA_NodeReleaseHandle（或一次 List 版本）→ UA_MethodReleaseHandle →
// UA_Disconnect → 把所有句柄变量清零。本 demo 仅演示单节点释放。
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
