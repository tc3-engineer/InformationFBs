<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_FileRename" Id="{d2e067f9-4034-5ecc-898f-bb85d8ea115b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_FileRename
VAR
    fbFileRename   : FB_FileRename; // FB_FileRename 实例
    sSourceName    : T_MaxString := 'D:/log/process.csv'; // 源路径
    sTargetName    : T_MaxString := 'D:/log/20260520.csv'; // 目标路径
    bRenameRequest : BOOL; // 在线写 TRUE 触发一次改名
    bRenameError   : BOOL; // TRUE = 改名失败
    nErrIdLast     : UDINT; // ADS 错误号
    bBusyMon       : BOOL; // ADS 通讯中
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：班次切换：'process.csv' → '20260520.csv' 归档。
// 价值：原子 rename，省去复制+删除两步。
// 验证：在线置 bRenameRequest := TRUE → 旧文件消失新文件出现；目标已存在时 bRenameError = TRUE。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileRename(
    sNetId   := '',
    sOldName := sSourceName,
    sNewName := sTargetName,
    ePath    := PATH_GENERIC,
    bExecute := bRenameRequest,
    tTimeout := T#10S,
    bBusy    => bBusyMon,
    bError   => bRenameError,
    nErrId   => nErrIdLast
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
