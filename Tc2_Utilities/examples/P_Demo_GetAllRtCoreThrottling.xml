      <pou name="P_Demo_GetAllRtCoreThrottling" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCBM">
              <type><derived name="TC_CoreBoostMonitor"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TC_CoreBoostMonitor 实例</xhtml></documentation>
            </variable>
            <variable name="hrResult">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">方法返回的 HRESULT</xhtml></documentation>
            </variable>
            <variable name="out_bRtInThermalThrottling">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">方法 REFERENCE TO bRtInThermalThrottling 出参</xhtml></documentation>
            </variable>
            <variable name="out_bRtInPowerThrottling">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">方法 REFERENCE TO bRtInPowerThrottling 出参</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.TC_CoreBoostMonitor.GetAllRtCoreThrottling 演示程序（METHOD）
// ============================================================
// 注意：必须 Intel Core i 11 代+ 且 TwinCAT Core Boost 已启用
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录
//   3. 在 Real-time Settings 启用 Core Boost
//   4. 在线监视 hrResult 与 out_* 出参
// ============================================================

hrResult := fbCBM.GetAllRtCoreThrottling(out_bRtInThermalThrottling, out_bRtInPowerThrottling);
</xhtml>
          </ST>
        </body>
