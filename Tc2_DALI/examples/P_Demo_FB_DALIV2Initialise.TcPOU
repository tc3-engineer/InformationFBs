<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2Initialise" Id="{eb5ae0bc-90da-570e-bee1-0185fe2274b8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2Initialise
VAR
    fbFB_DALIV2Initialise        : FB_DALIV2Initialise;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    nLampAddr        : BYTE := 0;


    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：底层寻址：让所有灯进入寻址模式。
//
// 价值：底层寻址命令。
//
// 验证步骤：
//   1. 通信 FB 跑起；编译；登录。
//   2. 把 eAddrType 改为 eDALIV2AddrTypeBroadcast 让全部灯进入寻址模式。
//   3. 在线 bTrigger 一次上升沿；等 bBusy 回 FALSE。
//   4. 灯具应进入寻址模式（普通命令被忽略 15 分钟）。
//   5. 用 P_Demo_FB_DALIV2Terminate 主动结束寻址模式。
// =============================================================================
fbFB_DALIV2Initialise(
    bStart           := bTrigger,
    nAddr            := nLampAddr,
    eAddrType        := eDALIV2AddrTypeShort,
    eCommandPriority := eDALIV2CommandPriorityMiddle,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2Initialise.bBusy;
bErr   := fbFB_DALIV2Initialise.bError;
nErrId := fbFB_DALIV2Initialise.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
