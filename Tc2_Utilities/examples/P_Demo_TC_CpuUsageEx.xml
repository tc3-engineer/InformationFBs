  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.TC_CpuUsageEx Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_TC_CpuUsageEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbTC_CpuUsageEx">
              <type><derived name="TC_CpuUsageEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TC_CpuUsageEx 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="aCpu">
              <type><array><dimension lower="0" upper="63"/><baseType><BYTE/></baseType></array></type>
            </variable>
            <variable name="nCount">
              <type><BYTE/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：多核负载分析。
// 价值：分核观察。
// 验证：触发后 aCpu[0..N-1] 装载各核占用率，N = nCount。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbTC_CpuUsageEx(
    NETID := '', START := bRead, TMOUT := DEFAULT_ADS_TIMEOUT,
    aCpuUsage =&gt; aCpu, nCpuCount =&gt; nCount,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
