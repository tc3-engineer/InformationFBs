<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepAbsoluteSwitchDetection" Id="{85a9cc91-92bc-5c54-b757-0d61e5757570}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepAbsoluteSwitchDetection
VAR
    fbStepAbsoluteSwitchDetection : MC_StepAbsoluteSwitchDetection;
    axisHoming                    : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec                        : R_TRIG; // 把保持型请求位整成单次上升沿
    bDetectReq                    : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam                   : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    refSignal                     : MC_Ref_Signal_Ref; // 参考信号源配置（锁存单元 / 信号源 / 当前电平）
    bPosLimit                     : BOOL := FALSE; // 正向硬件限位开关信号（行程内为 FALSE）；实机接 PLC 输入
    bNegLimit                     : BOOL := FALSE; // 负向硬件限位开关信号（行程内为 FALSE）；实机接 PLC 输入
    homingOptions                 : ST_Home_Options4; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bDetectDone                   : BOOL;
    bBusy                         : BOOL;
    bDetectActive                 : BOOL;
    bAborted                      : BOOL;
    bError                        : BOOL;
    nErrorID                      : UDINT;
    lrRecordedPos                 : LREAL; // Detection 版返回的检测位置（轴位置本身不被改写）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：多轴装配前先测出参考凸轮相对当前坐标的实际位置做机械偏差检查，由本 FB 返回
//       RecordedPosition，上层据此决定是否置零、置多少。本 FB 不改写轴位置。
// 价值：测量与置零解耦——本 FB 只精确测开关位置，置零策略交给上层，便于做对齐判断。
// 验证：先 MC_Power 使能；在线写 bDetectReq := TRUE，观察 bDetectActive TRUE，轴朝负向走；
//       命中凸轮后 bDetectDone 短暂 TRUE，lrRecordedPos 显示检测到的位置值（轴位置读数不变）。

// 配置参考信号源：用驱动默认信号源 + 默认锁存单元（实机按编码器/驱动手册选 TouchProbe）
refSignal.SignalSource := SignalSource_Default;
refSignal.TouchProbe   := PlcEvent;

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bDetectReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepAbsoluteSwitchDetection(
    Execute             := rtExec.Q,
    Direction           := mcNegativeDirection,
    SwitchMode          := mcRisingEdge,
    ReferenceSignal     := refSignal,
    Velocity            := 20.0,
    Acceleration        := 0.0,
    Deceleration        := 0.0,
    Jerk                := 0.0,
    TimeLimit           := T#30S,
    DistanceLimit       := 2000.0,
    TorqueLimit         := 100.0,
    PositiveLimitSwitch := bPosLimit,
    NegativeLimitSwitch := bNegLimit,
    BufferMode          := MC_Aborting,
    Options             := homingOptions,
    Done                => bDetectDone,
    Busy                => bBusy,
    Active              => bDetectActive,
    CommandAborted      => bAborted,
    Error               => bError,
    ErrorID             => nErrorID,
    RecordedPosition    => lrRecordedPos,
    Axis                := axisHoming,
    Parameter           := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bDetectReq AND NOT bBusy THEN
    bDetectDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
