<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_GetBoxAddrByNameEx Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_GetBoxAddrByNameEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbResolveBoxAddrByDevName">
              <type><derived name="IOF_GetBoxAddrByNameEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">用设备名+box 名查站号</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机空串</xhtml></documentation>
            </variable>
            <variable name="sActiveBusName">
              <initialValue><simpleValue value="'DP_Master_Right'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">当前选用的 Profibus 主站名</xhtml></documentation>
            </variable>
            <variable name="sQueryBoxName">
              <initialValue><simpleValue value="'Pump5'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要查的 box 名</xhtml></documentation>
            </variable>
            <variable name="bStartLookup">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tLookupTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 超时</xhtml></documentation>
            </variable>
            <variable name="bLookupBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bLookupError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="nResolvedBoxAddr">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查得站号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：生产线有 2 路 Profibus（命名 DP_Master_Left / DP_Master_Right），需要根据线路 ID 动态选总线再查 box；用设备名字调用避免硬编码 DeviceId。
// 价值：用名字代替 ID，工程改动不需要重编程序。
// 验证：登录后 sActiveBusName := "DP_Master_Right"、sQueryBoxName := "Pump5"，在线写 bStartLookup := TRUE → bLookupBusy 短暂 TRUE → 回 FALSE 后 nResolvedBoxAddr 显示 Pump5 在右侧 Profibus 上的站号。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbResolveBoxAddrByDevName(
    NETID      := sTargetNetId,
    DEVICENAME := sActiveBusName,
    BOXNAME    := sQueryBoxName,
    START      := bStartLookup,
    TMOUT      := tLookupTimeout,
    BUSY       =&gt; bLookupBusy,
    ERR        =&gt; bLookupError,
    ERRID      =&gt; nLastErrCode,
    BOXADDR    =&gt; nResolvedBoxAddr
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
