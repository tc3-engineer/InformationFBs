<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACRedundancyCtrl" Id="{7550b6b4-9e59-5cb9-b7ed-484ea0f8ff41}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACRedundancyCtrl
VAR
    fb : FB_HVACRedundancyCtrl;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    iCountCtrl_in : INT := 0;
    bForceChange_in : BOOL := FALSE;
    dtSystemTime_in : DT ;
    bSysTakt1Hz_in : BOOL := FALSE;
    bResetAllHours_in : BOOL := FALSE;
    bResetAllCounter_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    rHours_io : REAL := 0.0;
    uiCount_io : UINT := 0;
    tOverlap1Actuator_io : TIME := T#0S;
    uiMaxOnLevel_io : UINT := 0;
    tNoFeedbActuator_io : TIME := T#0S;
    eErrorCode_out : E_HVACErrorCodes;
    bErrorGeneral_out : BOOL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACRedundancyCtrl 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACRedundancyCtrl.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    iCountCtrl := iCountCtrl_in,
    bForceChange := bForceChange_in,
    dtSystemTime := dtSystemTime_in,
    bSysTakt1Hz := bSysTakt1Hz_in,
    bResetAllHours := bResetAllHours_in,
    bResetAllCounter := bResetAllCounter_in,
    bReset := bReset_in,
    rHours := rHours_io,
    uiCount := uiCount_io,
    tOverlap1Actuator := tOverlap1Actuator_io,
    uiMaxOnLevel := uiMaxOnLevel_io,
    tNoFeedbActuator := tNoFeedbActuator_io,
    eErrorCode => eErrorCode_out,
    bErrorGeneral => bErrorGeneral_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
