  <contentHeader name="Tc2_Utilities.LEN2 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LEN2" pouType="program">
        <interface>
          <localVars>
            <variable name="sLargeBuf"><initialValue><simpleValue value="'Logs accumulating...'"/></initialValue><type><string><length>1024</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：长 STRING(1024) 日志缓冲</xhtml></documentation></variable>
            <variable name="nLen"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">字符长度（&gt;255 时 Tc2_Standard.LEN 会错）</xhtml></documentation></variable>
            <variable name="bCheck"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：计算变长 logBuffer 当前已写入字符数，作为下次 append 的偏移基准。
// 价值：`Tc2_Standard.LEN` 限 255——`STRING(1024)` 必须用 `LEN2`。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bCheck THEN
    nLen := LEN2(pSTRING := ADR(sLargeBuf));
    bCheck := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
