  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.WSTRING_TO_STRING2 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_WSTRING_TO_STRING2" pouType="program">
        <interface>
          <localVars>
            <variable name="wsSrc"><initialValue><simpleValue value="&quot;HMI long text&quot;"/></initialValue><type><wstring><length>1024</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：长 WSTRING</xhtml></documentation></variable>
            <variable name="sOut"><type><string><length>1024</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后 STRING</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完整转换</xhtml></documentation></variable>
            <variable name="bConvert"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：UI 输入 WSTRING（多语言）→ 写入只支持 STRING 的旧设备。
// 价值：无限长度；`Tc2_Standard` 限 255。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bConvert THEN
    bOk := WSTRING_TO_STRING2(pDstString  := ADR(sOut),
                              pSrcWString := ADR(wsSrc),
                              nDstSize    := SIZEOF(sOut));
    bConvert := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
