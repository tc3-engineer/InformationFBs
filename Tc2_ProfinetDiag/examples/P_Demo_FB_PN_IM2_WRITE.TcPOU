<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_PN_IM2_WRITE" Id="{e275265a-358f-53c2-9265-3e01fb4420eb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_PN_IM2_WRITE
VAR
    fbIM2Write    : FB_PN_IM2_WRITE;
    bWriteDate    : BOOL := FALSE;            // 在线上升沿触发写入
    stCommissionDate : TIMESTRUCT := (wYear := 2026, wMonth := 6, wDay := 2, wHour := 8, wMinute := 0);
    bBusy         : BOOL;
    bErr          : BOOL;
    nErrId        : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ProfinetDiag.FB_PN_IM2_WRITE 演示程序
// ============================================================
// 场景：投运时给设备写 I&M2 安装日期。
// 价值：投运日期随设备持久化。
// 验证：登录后 bWriteDate 上升沿，写入 stCommissionDate。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ProfinetDiag（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 把投运日期 2026-06-02 08:00 写入设备 I&M2
fbIM2Write(
    bStart := bWriteDate,
    NETID  := '',
    PORT   := 16#1001,
    str_Date := stCommissionDate,
    bBusy  => bBusy,
    bError => bErr,
    iErrorID => nErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
