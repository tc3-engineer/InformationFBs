<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.Unsubscribe Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Unsubscribe" pouType="program">
        <interface>
          <localVars>
            <variable name="fbListener">
              <type><derived name="FB_ListenerBase2"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">listener 实例</xhtml></documentation>
            </variable>
            <variable name="bDoUnsubscribe">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoUnsubscribePrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：模块下线前取消 listener 订阅
// 价值：规范的资源释放
// 验证：先 Subscribe；再写 bDoUnsubscribe := TRUE 触发 Unsubscribe；hr 应为 S_OK
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoUnsubscribe AND NOT bDoUnsubscribePrev THEN
    hr := fbListener.Unsubscribe();
END_IF;
bDoUnsubscribePrev := bDoUnsubscribe;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
