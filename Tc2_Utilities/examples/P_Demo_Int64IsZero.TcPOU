<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_Int64IsZero" Id="{20acbfb2-ccbf-532f-bf81-5da989aae71b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_Int64IsZero
VAR
    liDivisor : T_LARGE_INTEGER;
    bIsZero   : BOOL;
    bCheck    : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.Int64IsZero 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：除法 / 模运算前的除数校验。
// 价值：替代结构体 `=` 比较。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bIsZero := Int64IsZero(liDivisor);
    bCheck := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
