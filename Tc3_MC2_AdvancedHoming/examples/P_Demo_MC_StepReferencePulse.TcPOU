<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MC_StepReferencePulse" Id="{85bf0452-5d5c-5ac3-9215-7383a80e8a46}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MC_StepReferencePulse
VAR
    fbStepReferencePulse : MC_StepReferencePulse;
    axisHoming           : AXIS_REF; // 归零目标轴；运行前需先 MC_Power 使能
    rtExec               : R_TRIG; // 把保持型请求位整成单次上升沿
    bPulseReq            : BOOL := FALSE; // 在线置 TRUE 触发一次执行
    homingParam          : MC_HomingParameter; // 贯穿整条归零序列、各 FB 间逐级传递的参数结构
    refSignal            : MC_Ref_Signal_Ref; // 参考信号源配置（锁存单元 / 信号源 / 当前电平）
    homingOptions        : ST_Home_Options4; // 选项结构，Beckhoff 伺服保持默认（DisableDriveAccess := FALSE）
    bPulseDone           : BOOL;
    bBusy                : BOOL;
    bPulseActive         : BOOL;
    bAborted             : BOOL;
    bError               : BOOL;
    nErrorID             : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 场景：高精度直线电机轴两段式归零的第二段——前级已粗定位到零脉冲附近，本 FB 低速朝正向
//       小范围搜索编码器零脉冲，命中后把该点定为坐标 0，把重复定位精度提到编码器级别。
// 价值：零脉冲精度远高于接近开关，是高精度归零关键步骤。
// 验证：先 MC_Power 使能且已粗定位到零脉冲附近；在线写 bPulseReq := TRUE，观察 bPulseActive
//       TRUE，轴低速正向走约一转内命中零脉冲后 bPulseDone 短暂 TRUE，位置读数变 0。

// 配置参考信号源：用驱动默认信号源 + 默认锁存单元（实机按编码器/驱动手册选 TouchProbe）
refSignal.SignalSource := SignalSource_Default;
refSignal.TouchProbe   := PlcEvent;

// 把保持型在线请求位整成单次上升沿，避免持续触发（charter: Execute 用 R_TRIG）
rtExec(CLK := bPulseReq);

// 单次完整调用：所有 VAR_INPUT 显式赋值，Axis（及 Parameter）按 VAR_IN_OUT 必须传引用
fbStepReferencePulse(
    Execute         := rtExec.Q,
    Direction       := mcPositiveDirection,
    ReferenceSignal := refSignal,
    Velocity        := 5.0,
    Acceleration    := 0.0,
    Deceleration    := 0.0,
    Jerk            := 0.0,
    SetPosition     := 0.0,
    TimeLimit       := T#10S,
    DistanceLimit   := 360.0,
    TorqueLimit     := 100.0,
    BufferMode      := MC_Aborting,
    Options         := homingOptions,
    Done            => bPulseDone,
    Busy            => bBusy,
    Active          => bPulseActive,
    CommandAborted  => bAborted,
    Error           => bError,
    ErrorID         => nErrorID,
    Axis            := axisHoming,
    Parameter       := homingParam);

// stateful 输出复位：请求复位后清掉本地观察位，便于下次干净触发
IF NOT bPulseReq AND NOT bBusy THEN
    bPulseDone := FALSE;
    bAborted := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
