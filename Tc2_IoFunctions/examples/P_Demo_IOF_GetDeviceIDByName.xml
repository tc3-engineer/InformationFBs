<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_GetDeviceIDByName Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_GetDeviceIDByName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLookupDeviceId">
              <type><derived name="IOF_GetDeviceIDByName"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">设备名 → ID FB</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="sLookupDeviceName">
              <initialValue><simpleValue value="'DP_Master_Main'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">设备名字（区分大小写）</xhtml></documentation>
            </variable>
            <variable name="bStartLookupDeviceId">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tLookupTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bLookupBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bLookupError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
            <variable name="nLookedUpDeviceId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查得 Device Id</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：程序需要按设备名字定位 Profibus 主站做后续操作，避免硬编码 ID。
// 价值：与工程配置同步：改 ID 不影响 PLC 程序，只要名字不改。
// 验证：登录后 sLookupDeviceName := "DP_Master_Main"，在线写 bStartLookupDeviceId := TRUE → 回 FALSE 后 nLookedUpDeviceId 显示 System Manager 中分配给该设备的 Device Id。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbLookupDeviceId(
    NETID      := sTargetNetId,
    DEVICENAME := sLookupDeviceName,
    START      := bStartLookupDeviceId,
    TMOUT      := tLookupTimeout,
    BUSY       =&gt; bLookupBusy,
    ERR        =&gt; bLookupError,
    ERRID      =&gt; nLastErrCode,
    DEVICEID   =&gt; nLookedUpDeviceId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
