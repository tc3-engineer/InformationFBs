<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.F_ARGCMP Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_ARGCMP" pouType="program">
        <interface>
          <localVars>
            <variable name="nValueA"><type><INT/></type>
              <initialValue><simpleValue value="100"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模拟上一条消息的参数</xhtml></documentation>
            </variable>
            <variable name="nValueB"><type><INT/></type>
              <initialValue><simpleValue value="100"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模拟本条消息的参数</xhtml></documentation>
            </variable>
            <variable name="argA"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">A 的描述符</xhtml></documentation>
            </variable>
            <variable name="argB"><type><derived name="T_Arg"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">B 的描述符</xhtml></documentation>
            </variable>
            <variable name="bUseTypeSafeCmp"><type><BOOL/></type>
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">是否启用类型安全比较</xhtml></documentation>
            </variable>
            <variable name="nCmpResult"><type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">七档比较结果</xhtml></documentation>
            </variable>
            <variable name="bCompare"><type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线置 TRUE 触发一次比较</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.F_ARGCMP 演示程序
// ============================================================
// 场景：EventLogger 消息去重——同 (eventId, param) 连续上报只保留首次。
// 价值：替代手写 "比 eType + 比 cbLen + MEMCMP 内容" 三段；一行得带方向的结果。
// 验证：在线把 nValueA 改为 100、nValueB 改为 200，bCompare := TRUE；
//       下一周期 nCmpResult 应为 -1（A 内容小于 B）。改回相同则 nCmpResult = 0。
// ============================================================

// 用 F_INT 把两个业务量打包成 T_Arg
argA := F_INT(nValueA);
argB := F_INT(nValueB);

IF bCompare THEN
    nCmpResult := F_ARGCMP(typeSafe := bUseTypeSafeCmp, arg1 := argA, arg2 := argB);
    bCompare := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances>
    <configurations/>
  </instances>
