<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DMXGetParameterDescription" Id="{53194bb8-f547-5ea0-bc22-c2c35c6ef349}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DMXGetParameterDescription
VAR
    fbGetParamDesc    : FB_DMXGetParameterDescription; // 读 PID 定义
    stDmxCmdBuffer    : ST_DMXCommandBuffer;          // 与通讯 FB 共用
    wTargetManufId    : WORD := 16#4241;              // 目标灯具厂商 ID
    dwTargetDeviceId  : DWORD := 16#12131415;         // 目标灯具设备 ID
    byTargetPort      : BYTE := 0;                    // 根设备通道 0
    eQueryPid         : E_DMXParameterId;             // 要查定义的 PID
    bDoRead           : BOOL := FALSE;                // 在线给一次上升沿触发
    bBusy             : BOOL;
    bError            : BOOL;
    udiErrId          : UDINT;
    stParamDesc       : ST_DMXParameterDescription;   // PID 定义结构
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_DMX.FB_DMXGetParameterDescription 演示程序
// ============================================================
// 场景：开发适配任意品牌的通用上位机：对每个厂商自定义 PID 先查定义，动态构建参数编辑界面。
// 价值：把厂商私有参数元信息从设备读出，实现自描述式参数访问，一套程序适配多品牌设备。
// 验证：先用 FB_DMXGetSupportedParameters 取得一个自定义 PID 赋给 eQueryPid，给 bDoRead 一次上升沿 -> bBusy 短暂 TRUE -> 回 FALSE 后 stParamDesc 含该 PID 的类型/范围/文本等定义。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_DMX；同项目里放一个 FB_EL6851CommunicationEx 实例并共用 stDmxCmdBuffer（非 CycleMode）
//   3. 编译 → 登录 → 运行；按上方『验证』行在线给上升沿观察
// ============================================================

fbGetParamDesc(
    bStart                     := bDoRead,
    wDestinationManufacturerId := wTargetManufId,
    dwDestinationDeviceId      := dwTargetDeviceId,
    byPortId                   := byTargetPort,
    eParameterId               := eQueryPid,
    dwOptions                  := 0,
    stCommandBuffer            := stDmxCmdBuffer,
    bBusy                      => bBusy,
    bError                     => bError,
    udiErrorId                 => udiErrId,
    stParameterDescription     => stParamDesc
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
