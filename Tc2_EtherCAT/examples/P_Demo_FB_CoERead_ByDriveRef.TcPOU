<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_CoERead_ByDriveRef" Id="{fe62fef8-949b-5edf-86fc-88e21b46725c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_CoERead_ByDriveRef
VAR
    fbReadStatusword    : FB_CoERead_ByDriveRef;
    bRequestReadOnce    : BOOL := FALSE;
    stAxis1DriveRef     : ST_DriveRef;            // 在 System Manager 中链接到 NC Axis 1
    wStatuswordIndex    : WORD := 16#6041;        // CIA402 Statusword
    nStatuswordSubIndex : BYTE := 0;
    wStatusword         : WORD;
    cbActualRead        : UDINT;
    bReadBusy           : BOOL;
    bReadError          : BOOL;
    nAdsErr             : UINT;
    nCanopenErr         : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc2_EtherCAT.FB_CoERead_ByDriveRef 演示程序
// =============================================================================
// 场景：6 轴运动机器，每轴在 NC 中独立配置。PLC 端读 CIA402 Statusword
//       (0x6041) 做轴状态监视。每轴一个全局 ST_DriveRef，PLC 启动时 NC
//       自动填入；本 FB 直接读 statusword，无需硬编码从站地址。
//
// 价值：PLC 引用驱动用结构体；NC 与 PLC 解耦，工程更模块化。
//
// 验证步骤：
//   1. Import 本文件，编译 → 登录
//   2. 在 System Manager 中右键 stAxis1DriveRef → Change Link → NC Axis 1
//   3. 编译激活配置；现场至少 1 轴当前 OP
//   4. 在线置 bRequestReadOnce := TRUE
//        - bReadBusy 短暂 TRUE 后落回
//        - wStatusword 应为 CIA402 状态字（bit 0..3 状态机, bit 11=轴误差等）
//        - nAdsErr = 0 AND nCanopenErr = 0
// =============================================================================

fbReadStatusword(
    stDriveRef      := stAxis1DriveRef,
    nIndex          := wStatuswordIndex,
    nSubIndex       := nStatuswordSubIndex,
    pDstBuf         := ADR(wStatusword),
    cbBufLen        := SIZEOF(wStatusword),
    bExecute        := bRequestReadOnce,
    tTimeout        := T#5S,
    bCompleteAccess := FALSE,
    bBusy           => bReadBusy,
    bError          => bReadError,
    iAdsErrId       => nAdsErr,
    iCANopenErrId   => nCanopenErr,
    cbRead          => cbActualRead
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
