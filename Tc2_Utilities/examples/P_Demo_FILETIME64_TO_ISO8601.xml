<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.FILETIME64_TO_ISO8601 Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FILETIME64_TO_ISO8601" pouType="program">
        <interface>
          <localVars>
            <variable name="ftAlarm">
              <type><derived name="T_FILETIME64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">报警发生的 T_FILETIME64 时间戳</xhtml></documentation>
            </variable>
            <variable name="nBiasUTC">
              <type><INT/></type>
              <initialValue><simpleValue value="0"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UTC = 本地 + nBias；UTC 输入时此值无关</xhtml></documentation>
            </variable>
            <variable name="bIsUTC">
              <type><BOOL/></type>
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输入是 UTC 吗？</xhtml></documentation>
            </variable>
            <variable name="nDecimalSec">
              <type><USINT/></type>
              <initialValue><simpleValue value="3"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">秒后小数位数</xhtml></documentation>
            </variable>
            <variable name="sISOTimestamp">
              <type><string><length>39</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输出的 ISO 8601 字符串</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：MQTT 报警消息要求时间字段为 ISO 8601 字符串以便上层 Node-RED 解析
//
// 价值：1 行拿到带 TZD 的 ISO 字符串，手写至少 30+ 行（sprintf + 拼接 + DST）
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.3.46.0）
//   2. 编译 + 登录 + 运行
//   3. 用 DT_TO_FILETIME64(DT#2026-05-11-12:34:56) 给 ftAlarm 赋值
//   4. 强制 bRunOnce := TRUE
//   5. 在线观察 sISOTimestamp = «2026-05-11T12:34:56.000Z»
//   6. 改 nDecimalSec := 0 重测 → «2026-05-11T12:34:56Z»
// =============================================================================
sISOTimestamp := FILETIME64_TO_ISO8601(ftAlarm, nBiasUTC, bIsUTC, nDecimalSec);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
