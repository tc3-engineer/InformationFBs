<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_CAN_Layer2Command Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_CAN_Layer2Command" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCanLayer2">
              <type><derived name="IOF_CAN_Layer2Command"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CAN layer-2 命令 FB</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nCanDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">CAN 主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="nCanNodeAddr">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标节点</xhtml></documentation>
            </variable>
            <variable name="aCanLayer2Data">
              <type><array><dimension lower="1" upper="5"/><baseType><WORD/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">10 字节 CAN layer-2 命令</xhtml></documentation>
            </variable>
            <variable name="bStartCanCmd">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tCanCmdTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bCanCmdBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bCanCmdError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastCanErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HILSCHER CIF3xx ISA 卡 + CANopen 现场总线：发原始 CAN 帧做诊断（如手动触发 NMT 复位）。
// 价值：维护早期老工程的诊断能力。
// 验证：⚠️ TwinCAT 3 不支持本功能；本例程仅作"代码兼容性参考"，运行时不会真正发出 CAN 报文。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 注：PDF VAR_INPUT 漏列 LEN/SRCADDR，但描述列说有；按描述列调用
fbCanLayer2(
    NETID    := sTargetNetId,
    DEVICEID := nCanDeviceId,
    BOXADDR  := nCanNodeAddr,
    START    := bStartCanCmd,
    TMOUT    := tCanCmdTimeout,
    BUSY     =&gt; bCanCmdBusy,
    ERR      =&gt; bCanCmdError,
    ERRID    =&gt; nLastCanErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
