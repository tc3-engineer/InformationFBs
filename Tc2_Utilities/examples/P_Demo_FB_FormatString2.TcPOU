<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_FormatString2" Id="{618d762f-8e55-5d2b-b8b3-e6860bb65574}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_FormatString2
VAR
    fbFB_FormatString2 : FB_FormatString2; // FB_FormatString2 实例
    pFormatString      : POINTER TO STRING(80);
    arg1               : T_Arg;
    arg2               : T_Arg;
    arg3               : T_Arg;
    arg4               : T_Arg;
    arg5               : T_Arg;
    arg6               : T_Arg;
    arg7               : T_Arg;
    arg8               : T_Arg;
    arg9               : T_Arg;
    arg10              : T_Arg;
    pDstString         : POINTER TO STRING(80);
    nDstSize           : UDINT;
    bError             : BOOL;
    nErrId             : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HMI Unicode 拼装。
// 价值：支持 Unicode。
// 验证：格式串带中文，输出应正确。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_FormatString2(
    pFormatString := pFormatString,
    arg1 := arg1,
    arg2 := arg2,
    arg3 := arg3,
    arg4 := arg4,
    arg5 := arg5,
    arg6 := arg6,
    arg7 := arg7,
    arg8 := arg8,
    arg9 := arg9,
    arg10 := arg10,
    pDstString := pDstString,
    nDstSize := nDstSize,
    bError => bError,
    nErrId => nErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
