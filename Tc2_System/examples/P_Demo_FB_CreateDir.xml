<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_CreateDir Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_CreateDir" pouType="program">
        <interface>
          <localVars>
            <variable name="fbCreateDir">
              <type><derived name="FB_CreateDir"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_CreateDir 实例</xhtml></documentation>
            </variable>
            <variable name="sDirToCreate">
              <initialValue><simpleValue value="'D:/log/20260520'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要创建的目录路径</xhtml></documentation>
            </variable>
            <variable name="bCreateDirRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次创建</xhtml></documentation>
            </variable>
            <variable name="bCreateDirError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 创建失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS / OS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：每天 0 点确保 'D:/log/20260520' 目录存在，存放当天日志。
// 价值：一次调用即可，省去 OS 命令转发。
// 验证：在线置 bCreateDirRequest := TRUE → 目标目录出现；目录已存在时 bCreateDirError = TRUE 且 nErrIdLast = 183。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbCreateDir(
    sNetId    := '',
    sPathName := sDirToCreate,
    ePath     := PATH_GENERIC,
    bExecute  := bCreateDirRequest,
    tTimeout  := T#10S,
    bBusy     =&gt; bBusyMon,
    bError    =&gt; bCreateDirError,
    nErrId    =&gt; nErrIdLast
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
