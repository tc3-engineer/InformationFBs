<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_GetTaskTotalTime" Id="{ecd5e588-41a6-5b3e-a0b8-e815f6204217}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_GetTaskTotalTime
VAR
    nMonitoredTaskIndex   : DINT := 1; // 被监视任务索引（TwinCAT System Manager 任务列表序号，1=PlcTask）
    udwTaskExecTime_100ns : UDINT; // 上一周期任务执行总时长（100ns）
    rTaskLoadPercent      : REAL; // 任务 CPU 利用率 %（基于 1ms 周期估算）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.F_GetTaskTotalTime 演示程序
// ============================================================
// 场景：1ms 任务做负载趋势监控，提前发现接近周期上限的容量风险。
// 价值：替代 System Manager 手工巡检，自动化监控可告警。
// 验证：登录后 udwTaskExecTime_100ns 应稳定在某个值（例如 200000 = 20us）；rTaskLoadPercent 给百分比。任务负载升高时该值应同步上升。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 取指定任务上一周期累计执行时长（100ns 单位）
udwTaskExecTime_100ns := F_GetTaskTotalTime(nMonitoredTaskIndex);

// 基于 1ms 任务周期估算利用率（10000 = 1ms）
rTaskLoadPercent := TO_REAL(udwTaskExecTime_100ns) / 100.0;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
