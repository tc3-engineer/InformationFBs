<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UA_HistoryUpdate" Id="{a69def67-d61d-5707-8adc-ff0579406986}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UA_HistoryUpdate
VAR
    fbHistoryPush       : UA_HistoryUpdate;
    bRequestHistoryPush : BOOL := FALSE;            // 在线置 TRUE 触发一次推送
    hMesConnection      : DWORD;                     // 由 UA_Connect 设置
    hHistoryNode        : DWORD;                     // 目标历史节点句柄（要在 Server 端开 HA）

    // 历史数据缓冲：5 个 LREAL 值 + 时间戳示例
    // 实例化时 ValueSize 必须与实际写入的 PLC 类型大小一致（LREAL = 8）
    aBufferedValues     : ARRAY[1..5] OF UAHADataValue(ValueSize := SIZEOF(LREAL));
    aValueErrors        : ARRAY[1..5] OF DWORD;     // FB 写入各值的错误码

    afOriginalValues    : ARRAY[1..5] OF LREAL      // 业务侧实际数据
                        := [12.34, 15.67, 18.90, 22.45, 25.11];

    tHistoryTimeout     : TIME := T#30S;             // 历史批量推送给大值
    nValueCountToPush   : UINT := 5;

    // —— 输出 ——
    bPushDone           : BOOL;
    bPushBusy           : BOOL;
    bPushError          : BOOL;
    nPushErrorId        : DWORD;

    bInitDone           : BOOL := FALSE;
    nPushedBatches      : UDINT;                      // 累计成功批次数
    nFailedValues       : UDINT;                      // 累计失败单值数
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：CX 控制器本地缓存了过去 5 分钟的工序液位数据（因网络抖动 SCADA 没
//       收到），需要补传到 MES OPC UA Server 的 Historical Access 历史库供事
//       后报表查询。本 demo 在 PROGRAM 头部预填 5 个 LREAL 历史值，触发后用
//       UA_HistoryUpdate 一次性推送，并演示单值错误的识别。
//
// 价值：批量推送（5 条单次往返）远比 5 次 UA_Write 高效；带时间戳的历史数据
//       由协议层标准编码，跨 Server 通用；含每值错误码可精细化重试失败项。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU
//   2. 引用 Tc3_PLCopen_OpcUa + Tc2_System（F_GetSystemTime 用）；
//      要求 TwinCAT 3.1 ≥ 4024.1、Tc3_PLCopen_OpcUa ≥ v3.1.9.0
//   3. 在 Server 端用 TwinCAT OPC UA Configurator 把目标节点开启 HistoryAccess
//      并选 adapter（File / SQL）；先跑通 UA_Connect + UA_NodeGetHandle 得到
//      ConnectionHdl / NodeHdl
//   4. 编译 → 登录 → 运行；在线脉冲 bRequestHistoryPush := TRUE
//   5. 约 1-3 秒后 bPushDone = TRUE；nPushedBatches += 1；在 Server 的历史
//      adapter 数据库 / 文件里应能查到 5 条新记录，时间戳依次递增 1 秒
//   6. 用 UaExpert 浏览目标节点的 Historical Access 视图能看到这 5 个点
//   7. 把 hHistoryNode 改成 0：bPushError = TRUE，nPushErrorId 应为
//      0xE4DD0116 (UAC_E_INVAL_NODE_HDL)；若目标 Server 不支持 HistoryUpdate
//      则得 0xE4DD0128 (UAC_E_NOTSUPPORTED)
// =============================================================================

// —— 一次性数据装填：每个 UAHADataValue 设 Value 指针 + StatusCode + 时间戳 ——
IF NOT bInitDone THEN
    // 时间戳从「当前 - 5 秒」起，每个值间隔 1 秒（业务侧应保证递增）
    aBufferedValues[1].Value           := ADR(afOriginalValues[1]);
    aBufferedValues[1].StatusCode      := UAHAUpdateStatusCode.HistorianRaw;
    aBufferedValues[1].SourceTimeStamp := F_GetSystemTime() - LINT_TO_ULINT(50000000);  // 5 秒

    aBufferedValues[2].Value           := ADR(afOriginalValues[2]);
    aBufferedValues[2].StatusCode      := UAHAUpdateStatusCode.HistorianRaw;
    aBufferedValues[2].SourceTimeStamp := F_GetSystemTime() - LINT_TO_ULINT(40000000);

    aBufferedValues[3].Value           := ADR(afOriginalValues[3]);
    aBufferedValues[3].StatusCode      := UAHAUpdateStatusCode.HistorianRaw;
    aBufferedValues[3].SourceTimeStamp := F_GetSystemTime() - LINT_TO_ULINT(30000000);

    aBufferedValues[4].Value           := ADR(afOriginalValues[4]);
    aBufferedValues[4].StatusCode      := UAHAUpdateStatusCode.HistorianRaw;
    aBufferedValues[4].SourceTimeStamp := F_GetSystemTime() - LINT_TO_ULINT(20000000);

    aBufferedValues[5].Value           := ADR(afOriginalValues[5]);
    aBufferedValues[5].StatusCode      := UAHAUpdateStatusCode.HistorianRaw;
    aBufferedValues[5].SourceTimeStamp := F_GetSystemTime() - LINT_TO_ULINT(10000000);

    bInitDone := TRUE;
END_IF;

// —— 单次调用：所有 VAR_INPUT/IN_OUT 显式赋值 ——
fbHistoryPush(
    Execute        := bRequestHistoryPush,
    ConnectionHdl  := hMesConnection,
    NodeHdl        := hHistoryNode,
    PerformInsert  := TRUE,        // 插入新值（PDF 默认）
    PerformReplace := FALSE,       // 不替换（仅 SQL adapter 支持替换）
    DataValueCount := nValueCountToPush,
    Timeout        := tHistoryTimeout,
    DataValues     := aBufferedValues,
    ValueErrorIDs  := aValueErrors,
    Done           => bPushDone,
    Busy           => bPushBusy,
    Error          => bPushError,
    ErrorID        => nPushErrorId
);

// —— 成功后清缓冲准备下批；失败按 aValueErrors 单值统计 ——
IF bPushDone THEN
    IF NOT bPushError THEN
        nPushedBatches := nPushedBatches + 1;
    ELSE
        // 统计本批失败值数（业务侧据此决定重试哪些值）
        nFailedValues := nFailedValues
                       + SEL(aValueErrors[1] <> 0, 0, 1)
                       + SEL(aValueErrors[2] <> 0, 0, 1)
                       + SEL(aValueErrors[3] <> 0, 0, 1)
                       + SEL(aValueErrors[4] <> 0, 0, 1)
                       + SEL(aValueErrors[5] <> 0, 0, 1);
    END_IF;
END_IF;

// 工程化提醒：生产代码里 aBufferedValues 数组通常做成滚动缓冲（FIFO），
// 业务采集时尾部追加、推送成功后头部移除；本 demo 静态预填 5 个值演示协议
// 调用本身。注意 UAHADataValue 实例化的 ValueSize 必须与 PLC 实际类型一致。
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
