<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_PREAL_TO_REAL" Id="{f38b7574-6cdd-510c-beaa-3ef4b59ecd3e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_PREAL_TO_REAL
VAR
    fRealValue           : REAL := 3.14; // 模拟 wire 缓冲区中的 REAL 字段
    pREALField           : POINTER TO REAL; // 业务侧先算好的字段地址（ADR 或 pBase+nOff）
    bExtractField        : BOOL; // 在线置 TRUE 触发一次解析
    fRealValue_extracted : REAL; // 解析后的副本，供业务逻辑使用
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.PREAL_TO_REAL 演示程序（FUNCTION）
// ============================================================
// 场景：从一段二进制 wire 缓冲区里按偏移取 REAL 字段（Modbus/CAN/ADS Raw）。
// 价值：替代手写 pField + nOff + ^ 指针算术；一次调用取值，少打错符号。
// 验证：在线写 fRealValue := 3.14；bExtractField := TRUE；
//       下一周期 fRealValue_extracted 应等于 fRealValue。
// ============================================================

// 业务代码通常已经算好字段地址（pBase + 协议偏移）；演示用 ADR 等价
pREALField := ADR(fRealValue);

IF bExtractField AND pREALField <> 0 THEN
    // 单次完整调用：避免手写 ^ 解引用，统一风格便于和字节序转换串联
    fRealValue_extracted := PREAL_TO_REAL(pREALField);
    bExtractField := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
