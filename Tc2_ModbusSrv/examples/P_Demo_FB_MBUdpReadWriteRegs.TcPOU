<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_MBUdpReadWriteRegs" Id="{6e508c74-7d46-5bf5-85b6-5b555c0255d4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_MBUdpReadWriteRegs
VAR
    fbUdpReadWriteRegs: FB_MBUdpReadWriteRegs;
    sTargetIp     : STRING(15) := '192.168.1.50';   // 目标 Modbus 设备 IP（按现场改）
    bTrigger      : BOOL;          // 在线置一次上升沿触发本次访问
    bBusy         : BOOL;          // 在线 monitor：执行中为 TRUE
    bError        : BOOL;          // 出错置 TRUE
    nErrId        : UDINT;         // 出错时的 ADS/Modbus 错误码
    nReadCount    : UDINT;         // 实际读到的字节数
    arrReadData   : ARRAY [0..8] OF WORD;   // 读回的 9 个寄存器
    arrWriteData  : ARRAY [0..8] OF WORD := [1,2,3,4,5,6,7,8,9];  // 待写的 9 个寄存器
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ModbusSrv.FB_MBUdpReadWriteRegs 演示程序（Modbus TCP 客户端 / 主站）
// ============================================================
// 场景：在一次 Modbus 事务里既读回设备状态又下发新设定，例如读回当前测量值同时写入下一周期设定值，保证读写在同一往返内原子完成。 选用 UDP 版多见于同一控制柜/同网段、对实时性敏感且能容忍偶发丢包的场景，省去 TCP 建链开销。
// 价值：功能码 23 把读+写合并为一次报文往返，比分开两次（功能码 3 + 16）延迟低、且语义上更接近原子；本 FB 一次调用搞定。
// 验证：登录后在线置 bTrigger := TRUE 触发一次；观察 bBusy 在数个周期后回 FALSE，
//       bError 应为 FALSE、nErrId 应为 0；若对端不在线则 bError=TRUE 且 nErrId 含超时码。
//       本例：同一事务：读 9 个寄存器、写 9 个寄存器
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ModbusSrv（References → Add library），并确保 TF6250 Modbus TCP 已授权运行
//   3. 把 sTargetIp 改成现场 Modbus 设备 IP；编译 → 登录 → 运行
//   4. 在线脉冲 bTrigger，按上方『验证』观察输出
// ============================================================

// 单次完整调用：所有 VAR_INPUT 显式赋值；bExecute 边沿触发一次
fbUdpReadWriteRegs(
    sIPAddr        := sTargetIp,
    nTCPPort       := MODBUS_TCP_PORT,
    nUnitID        := 16#FF,
    nReadQuantity  := 9,
    nMBReadAddr    := 0,
    nWriteQuantity := 9,
    nMBWriteAddr   := 16,
    cbDestLength   := SIZEOF(arrReadData),
    pDestAddr      := ADR(arrReadData),
    cbSrcLength    := SIZEOF(arrWriteData),
    pSrcAddr       := ADR(arrWriteData),
    bExecute       := bTrigger,
    tTimeout       := T#5S,
    bBUSY          => bBusy,
    bError         => bError,
    nErrId         => nErrId,
    cbRead         => nReadCount
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
