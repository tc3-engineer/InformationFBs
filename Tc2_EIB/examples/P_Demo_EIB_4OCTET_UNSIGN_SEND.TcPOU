<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_4OCTET_UNSIGN_SEND" Id="{4ab2a69f-aec8-589e-906c-7db9d78ce2c8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_4OCTET_UNSIGN_SEND
VAR
    fbEIB_4OCTET_UNSIGN_SEND     : EIB_4OCTET_UNSIGN_SEND;
    stEibRec           : EIB_REC;
    stGroup            : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 4, NUMBER := 15);
    data               : UDINT := UDINT#0;
    bSendError         : BOOL;
    iLastErrID         : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_4OCTET_UNSIGN_SEND 演示程序
// ============================================================
// 场景：PLC 测得的 绝对运行秒数 经 EIB 组地址 1/4/15 推送到 BMS。
// 价值：替代手写 DPT 12.xxx 编码；变化触发自动
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：改 `data` → 1 秒内 EIB 总线上 1/4/15 出新帧。
// ============================================================

// 每周期调用：只在 data 变化时下发 telegram
fbEIB_4OCTET_UNSIGN_SEND(
    Group_Address := stGroup,
    uiData        := data,
    str_Rec       := stEibRec,
    bError        => bSendError,
    iErrorID      => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
