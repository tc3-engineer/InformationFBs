      <pou name="P_Demo_RequestEventText" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRequestEventText">
              <type><derived name="RequestEventText"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Tc3_EventLogger.RequestEventText 实例</xhtml></documentation>
            </variable>
            <variable name="arg_nLangId">
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">VAR_INPUT nLangId</xhtml></documentation>
