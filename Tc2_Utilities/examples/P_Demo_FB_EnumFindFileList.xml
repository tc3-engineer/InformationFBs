  <contentHeader name="Tc2_Utilities.FB_EnumFindFileList Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_EnumFindFileList" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_EnumFindFileList">
              <type><derived name="FB_EnumFindFileList"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_EnumFindFileList 实例</xhtml></documentation>
            </variable>
            <variable name="bExec">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="sPattern">
              <initialValue><simpleValue value="'C:\\TwinCAT\\Boot\\*.config'"/></initialValue>
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="aFiles">
              <type><array><dimension lower="0" upper="63"/><baseType><derived name="ST_FindFileEntry"/></baseType></array></type>
            </variable>
            <variable name="nCount">
              <type><UDINT/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：批量列文件。
// 价值：一次完成。
// 验证：触发后 aFiles 数组填入文件名，nCount 给数量。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_EnumFindFileList(
    bExecute := bExec, sPathName := sPattern, ePath := PATH_GENERIC,
    pAddr := ADR(aFiles), cbAddr := SIZEOF(aFiles), tTimeout := DEFAULT_ADS_TIMEOUT,
    nFileCnt =&gt; nCount, bBusy =&gt; bBusy_, bError =&gt; bErrFlag, nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
