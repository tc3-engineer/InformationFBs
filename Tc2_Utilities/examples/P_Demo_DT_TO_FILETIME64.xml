<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T12:00:00"/>
  <contentHeader name="Tc2_Utilities.DT_TO_FILETIME64 Demo" modificationDateTime="2026-05-11T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_DT_TO_FILETIME64" pouType="program">
        <interface>
          <localVars>
            <variable name="dtMaintenance">
              <type><DATE_AND_TIME/></type>
              <initialValue><simpleValue value="DT#2026-05-11-12:00:00"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">维护事件发生时间（DT 格式）</xhtml></documentation>
            </variable>
            <variable name="ftMaintenance">
              <type><derived name="T_FILETIME64"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后的 T_FILETIME64 值（用于写日志）</xhtml></documentation>
            </variable>
            <variable name="bRunOnce">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">脉冲触发一次执行</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：PLC 内部以 DT 记录维护事件时间，写入 Windows 日志 / 数据库前需转 T_FILETIME64
//
// 价值：1 行调用完成基准换算 + 单位换算，避免手写 1970↔1601 基准差与 100ns 系数
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（≥ 3.3.44.0）
//   2. 编译 + 登录 + 运行
//   3. 强制 bRunOnce := TRUE 一个周期
//   4. 在线监视 ftMaintenance，dwLowDateTime/dwHighDateTime 应非零
//   5. 用 FILETIME64_TO_DT 反向应得回 DT#2026-05-11-12:00:00
// =============================================================================
ftMaintenance := DT_TO_FILETIME64(dtMaintenance);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
