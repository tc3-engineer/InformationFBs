  <contentHeader name="Tc2_Utilities.INT64_TO_LREAL Demo" modificationDateTime="2026-05-12T12:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
