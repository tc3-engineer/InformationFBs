<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.Subscribe2 Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_Subscribe2" pouType="program">
        <interface>
          <localVars>
            <variable name="fbListener">
              <type><derived name="FB_ListenerBase2"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">listener 实例</xhtml></documentation>
            </variable>
            <variable name="fbFilter">
              <type><derived name="FB_TcEventFilter"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件过滤器实例（在线配置规则）</xhtml></documentation>
            </variable>
            <variable name="bSubscribed">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">订阅 latch</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：新工程统一过滤器订阅
// 价值：单过滤器实例同时控制 message + alarm 的接收
// 验证：登录后 monitor bSubscribed 第一周期变 TRUE
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF NOT bSubscribed THEN
    hr := fbListener.Subscribe2(ipEventFilter := fbFilter);
    bSubscribed := SUCCEEDED(hr);
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
