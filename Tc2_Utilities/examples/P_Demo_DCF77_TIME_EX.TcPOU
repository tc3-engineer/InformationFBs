<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_DCF77_TIME_EX" Id="{740bad28-8a69-59e3-a96f-7df32b26e347}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_DCF77_TIME_EX
VAR
    fbDCF77_TIME_EX : DCF77_TIME_EX; // DCF77_TIME_EX 实例
    DCF_PULSE       : BOOL := FALSE;
    RUN             : BOOL := FALSE;
    TLP             : TIME := T#140ms;
    BUSY            : BOOL;
    ERR             : BOOL;
    ERRID           : UDINT;
    ERRCNT          : UDINT;
    READY           : BOOL;
    CDT             : DATE_AND_TIME;
    DOW             : subrangeUnsigned;
    TZI             : E_TimeZoneID;
    ADVTZI          : BOOL;
    LEAPSEC         : BOOL;
    RAWDT           : ARRAY[0..60] OF BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：DCF77_TIME_EX 的最小可编译演示——所有 VAR_INPUT 均以 doc/PDF 中真实引脚名调用。
//       业务侧请在线 monitor / 在线写值触发对应输入，看输出端 monitor 结果。
//
// 价值：保证示例 ST 代码所有引脚名与 DCF77_TIME_EX 的 VAR_INPUT/VAR_OUTPUT 一致，
//       Add Existing Item (.TcPOU) → 编译 → 登录 流程能跑通，作为 hand-curated 例程
//       的脚手架。
//
// 验证步骤：
//   1. 引用 Tc2_Utilities（及其依赖 Tc2_System）
//   2. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件 → OK → 编译、登录
//   3. 在线对 VAR_INPUT 写入合适触发值（典型 bExecute / RUN / START 上升沿）
//   4. 在线 monitor VAR_OUTPUT 观察 FB 反应
// =============================================================================

fbDCF77_TIME_EX(
    DCF_PULSE := DCF_PULSE,
    RUN := RUN,
    TLP := TLP,
    BUSY => BUSY,
    ERR => ERR,
    ERRID => ERRID,
    ERRCNT => ERRCNT,
    READY => READY,
    CDT => CDT,
    DOW => DOW,
    TZI => TZI,
    ADVTZI => ADVTZI,
    LEAPSEC => LEAPSEC,
    RAWDT => RAWDT
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
