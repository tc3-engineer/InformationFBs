<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonDomParser_PushbackDcTimeValue" Id="{8a6b1de4-fba8-5ae5-9657-21a9aa9c663e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonDomParser_PushbackDcTimeValue
VAR
    fbParser : FB_JsonDomParser; // 父 FB 实例
    v : SJsonValue;
    value : DCTIME;
    vRet : SJsonValue; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：循环把采样数据加入 JSON 数组（如 1 秒采 10 次温度，组成 10 元素数组上报）。
// 价值：按位 append 比每次重建数组高效。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.PushbackDcTimeValue(
        v := v,
        value := value
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
