<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonSaxWriter_CopyDocument" Id="{a2477a41-6bb9-51e5-8a70-156bdeeaf9d5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonSaxWriter_CopyDocument
VAR
    fbParser : FB_JsonSaxWriter; // 父 FB 实例
    nDoc : UDINT;
    pDoc : STRING(255);
    hrErrorCode : HRESULT;
    vRet : UDINT; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：在 `FB_JsonSaxWriter` 的工作流程里完成一个具体子操作；通常配合本 FB 的其他方法组合使用。
// 价值：作为 `FB_JsonSaxWriter` API 的一部分提供标准化能力，业务代码无需自实现。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.CopyDocument(
        nDoc := nDoc,
        pDoc := pDoc,
        hrErrorCode => hrErrorCode
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
