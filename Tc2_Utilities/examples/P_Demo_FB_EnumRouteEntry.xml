  <contentHeader name="Tc2_Utilities.FB_EnumRouteEntry Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_EnumRouteEntry" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_EnumRouteEntry">
              <type><derived name="FB_EnumRouteEntry"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_EnumRouteEntry 实例</xhtml></documentation>
            </variable>
            <variable name="bEnum">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="nIdx">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">遍历游标</xhtml></documentation>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：枚举本机所有路由，依次填入 HMI 显示表。
// 价值：可批量盘点。
// 验证：改 bEnum := TRUE，观察每次完成后 nIndex +1，sRouteName / sIp 填新值；直到 bErr → TRUE 表示遍历完。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_EnumRouteEntry(
    bExecute := bEnum,
    nIndex := nIdx,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
// 业务代码：bDone 后 nIdx := nIdx + 1; 再次触发
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
