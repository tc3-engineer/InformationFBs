<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_PROFINET_SET_NAME" Id="{9ecacf71-08b4-592d-ad1a-b2ca2fcfc09b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_PROFINET_SET_NAME
VAR
    fbSetName     : FB_PROFINET_SET_NAME;
    bSetReq       : BOOL := FALSE;            // 在线上升沿触发改名
    sNewName      : STRING(240) := 'b930-dev-01';     // 合规新名
    bLockName     : BOOL := FALSE;            // 是否锁定名称（慎用）
    bBusy         : BOOL;
    bErr          : BOOL;
    nErrId        : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_ProfinetDiag.FB_PROFINET_SET_NAME 演示程序
// ============================================================
// 场景：CCAT/TF6270 设备端自改 PROFINET 名。
// 价值：设备端自助改名，可锁名。
// 验证：登录后备好 sNewName，bSetReq 上升沿改名（需驱动 06+）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_ProfinetDiag（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 上升沿触发；设备端自改 PROFINET 名（需驱动 06/V00.34+、TF6270、CCAT B930）
fbSetName(
    bStart := bSetReq,
    NETID  := '',
    PORT   := 16#FFFF,
    sProfinetName := sNewName,
    bNotChangeable := bLockName,
    bBusy  => bBusy,
    bError => bErr,
    nErrorID => nErrId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
