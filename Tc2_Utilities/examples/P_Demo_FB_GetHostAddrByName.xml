<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_GetHostAddrByName Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetHostAddrByName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetHostAddrByName">
              <type><derived name="FB_GetHostAddrByName"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetHostAddrByName 实例</xhtml></documentation>
            </variable>
            <variable name="bResolve">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="sHost">
              <initialValue><simpleValue value="'localhost'"/></initialValue>
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="sIp">
              <type><string><length>15</length></string></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：解析对端机器名为 IP，再用解析结果配置 ADS 路由。
// 价值：支持 DHCP 自动跟随。
// 验证：改 sHost := 'localhost'，触发 bResolve；sIp 应得到 `127.0.0.1`。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetHostAddrByName(
    bExecute := bResolve,
    sHostName := sHost,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    sAddr =&gt; sIp,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
