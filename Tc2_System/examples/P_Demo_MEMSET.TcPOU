<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MEMSET" Id="{1ecb4de7-34f1-55ef-a382-5b7f8c1a00a0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MEMSET
VAR
    aBigBuffer    : ARRAY[0..1023] OF BYTE; // 1 KB 工艺缓冲区
    bClearRequest : BOOL; // 在线写 TRUE 触发一次清零
    nBytesCleared : UDINT; // 实际清零字节数
    rtClear       : R_TRIG; // 上升沿检测
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：设备启动时一次性清零 1 KB 工艺缓冲区，避免冷启动残留旧数据。
// 价值：一行调用替代 1024 次 FOR 赋零；快 5-10 倍。
// 验证：bClearRequest := TRUE → 观察 aBigBuffer 全部归零；nBytesCleared = 1024。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

rtClear(CLK := bClearRequest);
IF rtClear.Q THEN
    nBytesCleared := MEMSET(
        destAddr := ADR(aBigBuffer),
        fillByte := 0,
        n        := SIZEOF(aBigBuffer)
    );
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
