<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_GetRemotePCInfo" Id="{cf2c292c-4ae2-53d7-99d0-6d181dac1697}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_GetRemotePCInfo
VAR
    fbGetRemotePCInfo : GetRemotePCInfo; // GetRemotePCInfo 实例
    NETID             : T_AmsNetId;
    START             : BOOL;
    TMOUT             : TIME := DEFAULT_ADS_TIMEOUT;
    BUSY              : BOOL;
    ERR               : BOOL;
    ERRID             : UDINT;
    RemotePCInfo      : REMOTEPCINFOSTRUCT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：远程盘点。
// 价值：一次完成。
// 验证：触发后 stInfo 多个字段装载。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbGetRemotePCInfo(
    NETID := NETID,
    START := START,
    TMOUT := TMOUT,
    BUSY => BUSY,
    ERR => ERR,
    ERRID => ERRID,
    RemotePCInfo => RemotePCInfo
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
