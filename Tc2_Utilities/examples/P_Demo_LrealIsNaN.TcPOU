<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_LrealIsNaN" Id="{ddefb579-4a12-564f-a595-7d1521c13515}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_LrealIsNaN
VAR
    lrSensor : LREAL;
    bIsNaN   : BOOL;
    bCheck   : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.LrealIsNaN 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：积分器算出 0/0 后变 NaN，在喂下游前判 NaN 切回安全默认值。
// 价值：替代手写 `NOT(x = x)`；语义清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    bIsNaN := LrealIsNaN(lrSensor);
    bCheck := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
