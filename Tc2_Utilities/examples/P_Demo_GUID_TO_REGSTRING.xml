  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_GUID_TO_REGSTRING" pouType="program">
        <interface>
          <localVars>
            <variable name="stGuid"><type><derived name="GUID"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：OPC UA App ID（GUID）</xhtml></documentation></variable>
            <variable name="sRegStr"><type><string><length>38</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">格式化后注册表字符串</xhtml></documentation></variable>
            <variable name="bFormat"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把 PLC 内的 OPC UA Application URI（GUID 形式）格式化为日志可读字符串；记入审计表。
// 价值：替代手写 16 字节 → hex 字符串 + 拼接连字符 + 加大括号的 30 行代码；本函数 1 调用。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bFormat THEN
    sRegStr := GUID_TO_REGSTRING(in := stGuid);
    bFormat := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
