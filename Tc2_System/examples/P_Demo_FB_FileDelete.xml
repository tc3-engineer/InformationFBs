<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileDelete Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileDelete" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileDelete">
              <type><derived name="FB_FileDelete"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileDelete 实例</xhtml></documentation>
            </variable>
            <variable name="sFileToDelete">
              <initialValue><simpleValue value="'D:/log/old.csv'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要删除的文件路径</xhtml></documentation>
            </variable>
            <variable name="bDeleteRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次删除</xhtml></documentation>
            </variable>
            <variable name="bDeleteError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 删除失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：清理过期日志：把 'D:/log/old.csv' 删除腾出磁盘空间。
// 价值：封装 ADS 删除命令的状态机。
// 验证：在线写 sFileToDelete + bDeleteRequest := TRUE → 文件被删除；故意删不存在的文件 → bDeleteError = TRUE 且 nErrIdLast = 0x70C。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileDelete(
    sNetId    := '',
    sPathName := sFileToDelete,
    ePath     := PATH_GENERIC,
    bExecute  := bDeleteRequest,
    tTimeout  := T#10S,
    bBusy     =&gt; bBusyMon,
    bError    =&gt; bDeleteError,
    nErrId    =&gt; nErrIdLast
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
