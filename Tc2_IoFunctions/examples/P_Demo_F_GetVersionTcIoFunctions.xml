<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.F_GetVersionTcIoFunctions Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetVersionTcIoFunctions" pouType="program">
        <interface>
          <localVars>
            <variable name="nMajorVersion">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">主版本号</xhtml></documentation>
            </variable>
            <variable name="nMinorVersion">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">次版本号</xhtml></documentation>
            </variable>
            <variable name="nRevisionVersion">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">修订号</xhtml></documentation>
            </variable>
            <variable name="bReadVersionField">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发读取（一次性）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：旧工程的版本读取代码兼容性参考；新工程不要用。
// 价值：⚠️ 仅向后兼容，不推荐使用。
// 验证：登录后写 bReadVersionField := TRUE → 一周期后 nMajorVersion / nMinorVersion / nRevisionVersion 显示库版本各字段。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：本 FC 已废弃。新工程直接读 stLibVersion_Tc2_IoFunctions.iMajor 等
IF bReadVersionField THEN
    nMajorVersion    := F_GetVersionTcIoFunctions(nVersionElement := 1);
    nMinorVersion    := F_GetVersionTcIoFunctions(nVersionElement := 2);
    nRevisionVersion := F_GetVersionTcIoFunctions(nVersionElement := 3);
    bReadVersionField := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
