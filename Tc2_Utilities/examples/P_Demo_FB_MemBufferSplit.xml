        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：拆通讯协议包。
// 价值：意图清晰。
// 验证：给一段缓冲 + 拆分位置 N，触发后前 N 字节进段 1，剩余进段 2。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_MemBufferSplit(
    eCmd := eCmd,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    cbSize := cbSize,
    bOk =&gt; bOk,
    pSegment =&gt; pSegment,
    cbSegment =&gt; cbSegment,
    bEOS =&gt; bEOS
);
</xhtml></ST>
