  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Div16Ex" pouType="program">
        <interface>
          <localVars>
            <variable name="uliNanos">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">纳秒时间戳</xhtml></documentation>
            </variable>
            <variable name="wDivider">
              <type><WORD/></type>
              <initialValue><simpleValue value="1000;"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转毫秒的除数</xhtml></documentation>
            </variable>
            <variable name="uliMillis">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">商：毫秒数</xhtml></documentation>
            </variable>
            <variable name="uliRemainder">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">余数：剩余纳秒</xhtml></documentation>
            </variable>
            <variable name="bDivide">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Div16Ex 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：64 位时钟戳（ns）除以 1000 转毫秒、再除以 1000 转秒等小除数链。
// 价值：替代手写 64 位除法链；硬件指令一次搞定，性能可预测。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bDivide AND wDivider &lt;&gt; 0 THEN
    // 除 0 PDF 未定义 → 前置校验
    uliMillis := UInt64Div16Ex(uliNanos, wDivider, uliRemainder);
    bDivide := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
