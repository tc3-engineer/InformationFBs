<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_SetPhase Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_SetPhase" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSercosSetPhase">
              <type><derived name="IOF_SER_SetPhase"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS phase 切换 FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nSercosDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="nTargetPhaseValue">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标 phase 值 (0..4)</xhtml></documentation>
            </variable>
            <variable name="bSetPhaseReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发切换</xhtml></documentation>
            </variable>
            <variable name="tSetPhaseTimeout">
              <initialValue><simpleValue value="T#15S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时（phase 切换较慢）</xhtml></documentation>
            </variable>
            <variable name="bSetPhaseBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bSetPhaseErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：调试期：HMI 按"进入调试模式"按钮 → 把 SERCOS 环切到 phase 2 让参数可访问。
// 价值：让"参数调试"成为正式工序的一部分。
// 验证：**先停所有 motion** → 写 nTargetPhaseValue := 2、bSetPhaseReq := TRUE → bSetPhaseBusy 短暂 TRUE → 回 FALSE 后用 IOF_SER_GetPhase 确认 phase = 2。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：从 phase 4 切回低 phase 会停所有 motion；先确保 drive 已 disable
fbSercosSetPhase(
    NETID    := sLocalNetId,
    DEVICEID := nSercosDeviceId,
    PHASE    := nTargetPhaseValue,
    SET      := bSetPhaseReq,
    TMOUT    := tSetPhaseTimeout,
    BUSY     =&gt; bSetPhaseBusy,
    ERR      =&gt; bSetPhaseErr,
    ERRID    =&gt; nLastErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
