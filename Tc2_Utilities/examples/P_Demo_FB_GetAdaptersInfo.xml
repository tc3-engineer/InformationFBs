<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_GetAdaptersInfo Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetAdaptersInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetAdaptersInfo">
              <type><derived name="FB_GetAdaptersInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetAdaptersInfo 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="aAdapterList">
              <type><array><dimension lower="0" upper="15"/><baseType><derived name="ST_AdapterInfo"/></baseType></array></type>
            </variable>
            <variable name="nAdapterCount">
              <type><UDINT/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：开机 self-test 读所有网卡信息。
// 价值：标准库调用，跨 Win 版本稳定。
// 验证：改 bRead := TRUE，观察 nAdapterCount &gt; 0；aAdapterList[0].sIpAddress 应为 PLC 主网卡 IP。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetAdaptersInfo(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    pAddr := ADR(aAdapterList),
    cbBuffLen := SIZEOF(aAdapterList),
    nAdapters =&gt; nAdapterCount,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
