//   3. 按 doc.md 给 arg_* 赋值
//   4. 在线监视 out_* / io_* 输出
// ============================================================

fbRTC(
    EN := arg_EN,
    PDT := arg_PDT,
    Q =&gt; out_Q,
    CDT =&gt; out_CDT
);
