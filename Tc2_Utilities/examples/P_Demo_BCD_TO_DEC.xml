<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.BCD_TO_DEC Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_BCD_TO_DEC" pouType="program">
        <interface>
          <localVars>
            <variable name="fbBCD_TO_DEC">
              <type><derived name="BCD_TO_DEC"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">BCD_TO_DEC 实例</xhtml></documentation>
            </variable>
            <variable name="bcdRawInput">
              <initialValue><simpleValue value="16#47"/></initialValue>
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">模拟从 BK1120 拨码开关读到的 BCD 字节</xhtml></documentation>
            </variable>
            <variable name="decWorkstationNo">
              <type><BYTE/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后的十进制工位编号 (0..99)</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：模拟从 IO 模块读到一个 BCD 字节 16#47（实际表示工位号 47），用本 FB 转成十进制 BYTE 显示给 HMI。
// 价值：替代手写 SHR/AND 位运算。
// 验证：登录后在线改 bcdRawInput := 16#47，观察 decWorkstationNo 应为 47；改 16#99 应为 99；改 16#0F（非法 BCD）能看到结果异常值，提醒输入需校验。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次调用形式
fbBCD_TO_DEC(BCDIN := bcdRawInput, DECOUT =&gt; decWorkstationNo);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
