<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_KL3208Config Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_KL3208Config" pouType="program">
        <interface>
          <localVars>
            <variable name="fbKl3208">
              <type><derived name="FB_KL3208Config"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">KL3208-0010 配置 FB（每通道一个实例）</xhtml></documentation>
            </variable>
            <variable name="stKl3208InProcessImg">
              <type><derived name="ST_KL3208InData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">过程映像 输入</xhtml></documentation>
            </variable>
            <variable name="stKl3208OutProcessImg">
              <type><derived name="ST_KL3208OutData"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">过程映像 输出</xhtml></documentation>
            </variable>
            <variable name="bDoConfigure">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿写配置</xhtml></documentation>
            </variable>
            <variable name="bDoReadConfig">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿只读</xhtml></documentation>
            </variable>
            <variable name="iSensorTypeCode">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><INT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PT1000 编码（具体表见 PDF）</xhtml></documentation>
            </variable>
            <variable name="tConfigTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bKl3208Busy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bKl3208Error">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="iLastError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：8 路 PT1000 上电批量配置；本 demo 只演示一个通道，实际要 8 个 FB 实例。
// 价值：代码化配置。
// 验证：登录确认 stKl3208InProcessImg / OutProcessImg 已链；写 bDoConfigure := TRUE → fbKl3208.bBusy 短暂 TRUE → 回 FALSE 后 iLastError = 0。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbKl3208(
    bConfigurate   := bDoConfigure,
    bReadConfig    := bDoReadConfig,
    iSetSensorType := iSensorTypeCode,
    tTimeout       := tConfigTimeout,
    stInData       := stKl3208InProcessImg,
    stOutData      := stKl3208OutProcessImg,
    bBusy          =&gt; bKl3208Busy,
    bError         =&gt; bKl3208Error,
    iErrorId       =&gt; iLastError
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
