  <contentHeader name="Tc2_Utilities.F_CreateLinkedListHnd Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_CreateLinkedListHnd" pouType="program">
        <interface>
          <localVars>
            <variable name="aEntries"><type><array><dimension lower="0" upper="99"/><baseType><derived name="T_LinkedListEntry"/></baseType></array></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：100 槽位报警历史链表池</xhtml></documentation></variable>
            <variable name="hList"><type><derived name="T_HLINKEDLIST"/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">链表句柄</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">初始化成功</xhtml></documentation></variable>
            <variable name="bInit"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发（启动一次）</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：报警历史记录的环形缓冲：最近 100 条报警按时序入链表，超过 100 自动剔除最早一条。
// 价值：替代手写 ARRAY + head/tail 索引环形缓冲——本函数提供库支持的双向链表数据结构。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bInit THEN
    bOk := F_CreateLinkedListHnd(pEntries  := ADR(aEntries),
                                 cbEntries := SIZEOF(aEntries),
                                 hList     := hList);
    bInit := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
