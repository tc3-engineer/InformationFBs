<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_NT_StartProcess" Id="{32833634-eafd-53fd-aa6a-d54e0b3cbe89}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_NT_StartProcess
VAR
    fbNT_StartProcess : NT_StartProcess; // NT_StartProcess 实例
    bStart            : BOOL := FALSE;
    sPath             : STRING(255) := 'C:\Windows\notepad.exe';
    sDir              : STRING(255) := 'C:\Windows';
    sCmd              : STRING(255) := '';
    bBusy_            : BOOL;
    bErrFlag          : BOOL;
    nErrCode          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：日终触发外部脚本生成报表。
// 价值：事件驱动，无需上位机配合。
// 验证：改 bStart := TRUE，触发后目标机器应能看到 notepad.exe 启动（或自定义脚本）。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_StartProcess(
    NETID := '', START := bStart, PATHSTR := sPath, DIRNAME := sDir, COMNDLINE := sCmd,
    TMOUT := DEFAULT_ADS_TIMEOUT, BUSY => bBusy_, ERR => bErrFlag, ERRID => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
