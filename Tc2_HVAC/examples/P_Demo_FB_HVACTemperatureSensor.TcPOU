<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACTemperatureSensor" Id="{68006f6d-743b-5329-adce-acdd6748ea87}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACTemperatureSensor
VAR
    fb : FB_HVACTemperatureSensor;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    iRawValue_in : INT := 0;
    byStatusRawValue_in : BYTE := 0;
    tTaskCycleTime_in : TIME := T#0S;
    tCtrlCycleTime_in : TIME := T#0S;
    bEnableLimitCtrl_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    rOffset_io : REAL := 0.0;
    rHighLimit_io : REAL := 0.0;
    rLowLimit_io : REAL := 0.0;
    rReplacementValue_io : REAL := 0.0;
    tFilterTime_io : TIME := T#0S;
    eTemperatureSensorMode_io : E_HVACTemperatureSensorMode ;
    rPresentValue_out : REAL;
    bErrorGeneral_out : BOOL;
    byError_out : BYTE;
    bErrorShortCircuit_out : BOOL;
    bErrorBrokenSensor_out : BOOL;
    bErrorHighLimit_out : BOOL;
    bErrorLowLimit_out : BOOL;
    bErrorCycleTime_out : BOOL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACTemperatureSensor 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACTemperatureSensor.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    iRawValue := iRawValue_in,
    byStatusRawValue := byStatusRawValue_in,
    tTaskCycleTime := tTaskCycleTime_in,
    tCtrlCycleTime := tCtrlCycleTime_in,
    bEnableLimitCtrl := bEnableLimitCtrl_in,
    bReset := bReset_in,
    rOffset := rOffset_io,
    rHighLimit := rHighLimit_io,
    rLowLimit := rLowLimit_io,
    rReplacementValue := rReplacementValue_io,
    tFilterTime := tFilterTime_io,
    eTemperatureSensorMode := eTemperatureSensorMode_io,
    rPresentValue => rPresentValue_out,
    bErrorGeneral => bErrorGeneral_out,
    byError => byError_out,
    bErrorShortCircuit => bErrorShortCircuit_out,
    bErrorBrokenSensor => bErrorBrokenSensor_out,
    bErrorHighLimit => bErrorHighLimit_out,
    bErrorLowLimit => bErrorLowLimit_out,
    bErrorCycleTime => bErrorCycleTime_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
