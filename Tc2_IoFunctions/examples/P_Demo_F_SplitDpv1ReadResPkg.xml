<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.F_SplitDpv1ReadResPkg Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_SplitDpv1ReadResPkg" pouType="program">
        <interface>
          <localVars>
            <variable name="aDpv1ReadResBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">DPV1 读响应帧 240 字节</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">与请求相同的参数清单</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ValueHdr">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ValueHeaderEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">解析输出：每条参数值</xhtml></documentation>
            </variable>
            <variable name="bSplitReadResPkg">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：解析响应</xhtml></documentation>
            </variable>
            <variable name="nReadResPkgLen">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应帧实际长度</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：DPV1 读完后调本 FC 解析响应：填回 arrDpv1ValueHdr[1..3]。
// 价值：封装 DPV1 解析 + 字节序转换。
// 验证：收到响应后写 bSplitReadResPkg := TRUE → 一周期后 nReadResPkgLen &gt; 0 表示解析成功；可在线查看 arrDpv1ValueHdr 各字段。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

IF bSplitReadResPkg THEN
    nReadResPkgLen := F_SplitDpv1ReadResPkg(
        pDpv1ResData        := ADR(aDpv1ReadResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitReadResPkg := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
