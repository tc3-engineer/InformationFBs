<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEWritePassword" Id="{65a19e58-96a3-5599-9081-4b5984b3646d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEWritePassword
VAR
    fbWritePassword : FB_SoEWritePassword;
    NcToPlcAxis     : NCTOPLC_AXIS_REF; // NC 轴过程映像（实际工程映射到 %I*）
    sDrivePassword  : ST_SoE_String; // 由驱动器手册给出的口令字符串
    bUnlockRequest  : BOOL; // 在线置 TRUE 触发一次解锁
    rtUnlock        : R_TRIG;
    bBusy           : BOOL;
    bError          : BOOL;
    iAdsErr         : UINT;
    iSercosErr      : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_NcDrive.FB_SoEWritePassword 演示程序
// ============================================================
// 场景：调试 AX5000 需要修改受密码保护的电机参数，写参数前必须先写入
//       驱动器密码（S-0-0267）解锁。
// 价值：不用本 FB 时要自己用 FB_SoEWrite 操作 S-0-0267、拼 Sercos 字符串、
//       管时序；本 FB 把"解锁"封装为一个带 ADS / Sercos 错误码反馈的边沿。
// 验证：登录后给 sDrivePassword 赋正确口令，置 bUnlockRequest := TRUE，
//       观察 bBusy 短暂为 TRUE 后落回；口令正确则 bError 保持 FALSE，
//       口令被拒则 iSercosErr 出现非零码。
// ============================================================

// 上升沿保证一次按钮只写一次密码
rtUnlock(CLK := bUnlockRequest);

// 单次完整调用
fbWritePassword(
    Axis      := NcToPlcAxis,
    sNetId    := '',
    bExecute  := rtUnlock.Q,
    tTimeout  := DEFAULT_ADS_TIMEOUT,
    sPassword := sDrivePassword,
    bBusy        => bBusy,
    bError       => bError,
    iAdsErrId    => iAdsErr,
    iSercosErrId => iSercosErr
);

// 命令完成后复位按钮，准备下一次边沿
IF NOT bBusy THEN
    bUnlockRequest := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
