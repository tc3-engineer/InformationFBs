  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.MAXSTRING_TO_BYTEARR Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_MAXSTRING_TO_BYTEARR" pouType="program">
        <interface>
          <localVars>
            <variable name="sTag"><initialValue><simpleValue value="'PumpAlpha-01'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：设备标签 STRING</xhtml></documentation></variable>
            <variable name="aBytes"><type><array><dimension lower="0" upper="255"/><baseType><BYTE/></baseType></array></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">字节数组输出</xhtml></documentation></variable>
            <variable name="bExport"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把配置文件中的 STRING 标签写入 ModBus 寄存器区（按字节数组对齐）。
// 价值：替代手写 FOR + 字节复制；本函数 1 调用。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bExport THEN
    aBytes := MAXSTRING_TO_BYTEARR(in := sTag);
    bExport := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
