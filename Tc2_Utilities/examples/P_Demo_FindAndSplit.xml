  <contentHeader name="Tc2_Utilities.FindAndSplit Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FindAndSplit" pouType="program">
        <interface>
          <localVars>
            <variable name="sNodeId"><initialValue><simpleValue value="'ns=2;s=Pump.State'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：OPC UA NodeId</xhtml></documentation></variable>
            <variable name="sSep"><initialValue><simpleValue value="';'"/></initialValue><type><string><length>4</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">分隔符</xhtml></documentation></variable>
            <variable name="sLeft"><type><string><length>128</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">namespace 部分</xhtml></documentation></variable>
            <variable name="sRight"><type><string><length>128</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">node id 部分</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">切分成功</xhtml></documentation></variable>
            <variable name="bSplit"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：解析 OPC UA NodeId 字符串 `'ns=2;s=Pump.State'`：用 `';'` 切左右段，再分别解析 `'ns=2'` 和 `'s=...'`。
// 价值：替代 `FIND2` + `LEFT` + `MID` 三调用链；返回 `BOOL` 直观判断成功。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bSplit THEN
    bOk := FindAndSplit(pSeparator       := ADR(sSep),
                        pSrcString       := ADR(sNodeId),
                        pLeftString      := ADR(sLeft),
                        nLeftSize        := SIZEOF(sLeft),
                        pRightString     := ADR(sRight),
                        nRightSize       := SIZEOF(sRight),
                        bSearchFromRight := FALSE);
    bSplit := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
