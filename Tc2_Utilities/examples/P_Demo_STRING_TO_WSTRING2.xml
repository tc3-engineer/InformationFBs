<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.STRING_TO_WSTRING2 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_STRING_TO_WSTRING2" pouType="program">
        <interface>
          <localVars>
            <variable name="sLocal"><initialValue><simpleValue value="'Long log line...'"/></initialValue><type><string><length>1024</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：长 STRING</xhtml></documentation></variable>
            <variable name="wsOut"><type><wstring><length>1024</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后 WSTRING</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">完整转换</xhtml></documentation></variable>
            <variable name="bConvert"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 模块用 WSTRING 显示多语言字符串；从配置文件读出的 STRING 配置项需要转 WSTRING 才能显示。
// 价值：`Tc2_Standard` 的 255 限制；本函数无限制。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bConvert THEN
    bOk := STRING_TO_WSTRING2(pDstWSTRING := ADR(wsOut),
                              pSrcSTRING  := ADR(sLocal),
                              nDstSize    := SIZEOF(wsOut));
    bConvert := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
