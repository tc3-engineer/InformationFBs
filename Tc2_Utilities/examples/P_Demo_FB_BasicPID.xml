  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_BasicPID" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_BasicPID">
              <type><derived name="FB_BasicPID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_BasicPID 实例</xhtml></documentation>
            </variable>
            <variable name="fSetpointValue">
              <type><LREAL/></type>
            </variable>
            <variable name="fActualValue">
              <type><LREAL/></type>
            </variable>
            <variable name="bReset">
              <type><BOOL/></type>
            </variable>
            <variable name="fCtrlCycleTime">
              <type><LREAL/></type>
            </variable>
            <variable name="fKp">
              <type><LREAL/></type>
            </variable>
            <variable name="fTn">
              <type><LREAL/></type>
            </variable>
            <variable name="fTv">
              <type><LREAL/></type>
            </variable>
            <variable name="fTd">
              <type><LREAL/></type>
            </variable>
            <variable name="fCtrlOutput">
              <type><LREAL/></type>
            </variable>
            <variable name="nErrorStatus">
              <type><UINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：水箱温度闭环控制。
// 价值：带 anti-windup。
// 验证：设置 setpoint，monitor 输出在合理范围；改 setpoint 输出跟随。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_BasicPID(
    fSetpointValue := fSetpointValue,
    fActualValue := fActualValue,
    bReset := bReset,
    fCtrlCycleTime := fCtrlCycleTime,
    fKp := fKp,
    fTn := fTn,
    fTv := fTv,
    fTd := fTd,
    fCtrlOutput =&gt; fCtrlOutput,
    nErrorStatus =&gt; nErrorStatus
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
