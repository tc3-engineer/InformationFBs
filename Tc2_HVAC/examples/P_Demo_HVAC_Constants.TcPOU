<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_HVAC_Constants" Id="{a8a8a8a8-1234-5678-9abc-1c2c3c4c5c6c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_HVAC_Constants
VAR
    // ---- 本 demo 监视 Tc2_HVAC 库的持久化状态总线 ----
    bSystemReady          : BOOL;     // 持久化数据已加载完成
    bPersistWriteOngoing  : BOOL;     // 持久化正在写盘中
    bNovramWriteOngoing   : BOOL;     // NOVRAM 正在写入中
    bNovramFirstUse       : BOOL;     // NOVRAM 首次被使用
    bPersistFirstUse      : BOOL;     // 持久化数据首次被创建

    // ---- 引用 GVL 的近零判定阈用作演示 ----
    rTestVal              : REAL := 0.0000001;
    bIsCloseToZero        : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc2_HVAC.HVAC_Constants (GVL) 演示程序
// =============================================================================
// 场景：HMI 主程序需要在「系统就绪」前不显示业务界面（避免读到未初始化的持久化
//       数据）；持久化写盘进行时禁用「保存」按钮防止写盘冲突；监视 NOVRAM 是否
//       首次被使用以触发出厂自检。
//
// 价值：本 GVL 把库内部持久化状态完整透明化，外部代码可以与库行为同步。手写无法
//       替代——FB_HVACPersistentDataHandling 的内部状态如果不通过 GVL 暴露就无
//       法被 HMI / 业务层观察到。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线 monitor bSystemReady：上电后约 1-3 秒应变 TRUE
//   5. 在线 monitor bIsCloseToZero：应该是 TRUE（0.0000001 < rCloseToZero）
//   6. 触发持久化写盘（如修改某个 FB_HVAC*PersistentXxx 的 IN_OUT），
//      bPersistWriteOngoing 应短暂变 TRUE
// =============================================================================

// 把 Tc2_HVAC 内部状态位读到本 PRG 的局部位（GVL 全部带 Tc2_HVAC. 库名前缀）
bSystemReady          := Tc2_HVAC.g_bHVACPersDataReadDone AND Tc2_HVAC.g_bHVACNOVRAMDataReadDone;
bPersistWriteOngoing  := Tc2_HVAC.g_bHVACPersParamsChanged;
bNovramWriteOngoing   := Tc2_HVAC.g_bHVACNOVRAMParamsChanged;
bNovramFirstUse       := Tc2_HVAC.g_bHVACNOVRAMUsed;
bPersistFirstUse      := Tc2_HVAC.g_bHVACPersUsed;

// 演示近零判定阈值的使用：当 |rTestVal| < rCloseToZero 时认为是 0
bIsCloseToZero := ABS(rTestVal) < Tc2_HVAC.rCloseToZero;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
