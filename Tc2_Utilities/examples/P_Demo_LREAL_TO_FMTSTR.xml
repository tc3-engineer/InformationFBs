  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LREAL_TO_FMTSTR" pouType="program">
        <interface>
          <localVars>
            <variable name="fPressureBar"><initialValue><simpleValue value="1.0132456"/></initialValue><type><LREAL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：压力测量值（Bar）</xhtml></documentation></variable>
            <variable name="sFormatted"><type><string><length>32</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">格式化输出</xhtml></documentation></variable>
            <variable name="bRender"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 显示温度 / 压力等模拟量——按工程量精度（如 2 位小数）格式化为字符串。
// 价值：替代手写整数取整 + 余数 + 拼接的繁琐代码；本函数 1 调用 + 自带 NaN/INF 处理。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bRender THEN
    // 2 位小数 + 四舍五入
    sFormatted := LREAL_TO_FMTSTR(in := fPressureBar, iPrecision := 2, bRound := TRUE);
    // sFormatted = '1.01'
    bRender := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
