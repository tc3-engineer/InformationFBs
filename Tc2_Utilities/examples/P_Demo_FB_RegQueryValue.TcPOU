<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_RegQueryValue" Id="{9f234df9-3cf0-53c2-ba2e-54a26902472c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_RegQueryValue
VAR
    fbFB_RegQueryValue : FB_RegQueryValue; // FB_RegQueryValue 实例
    sNetId             : T_AmsNetId;
    sSubKey            : T_MaxString;
    sValName           : T_MaxString;
    cbData             : UDINT;
    pData              : POINTER TO BYTE;
    bExecute           : BOOL;
    tTimeOut           : TIME := DEFAULT_ADS_TIMEOUT;
    bBusy              : BOOL;
    bError             : BOOL;
    nErrId             : UDINT;
    cbRead             : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：读注册表。
// 价值：替代 Shell。
// 验证：读 `HKLM\SOFTWARE\Beckhoff` 任一键应非空。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_RegQueryValue(
    sNetId := sNetId,
    sSubKey := sSubKey,
    sValName := sValName,
    cbData := cbData,
    pData := pData,
    bExecute := bExecute,
    tTimeOut := tTimeOut,
    bBusy => bBusy,
    bError => bError,
    nErrId => nErrId,
    cbRead => cbRead
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
