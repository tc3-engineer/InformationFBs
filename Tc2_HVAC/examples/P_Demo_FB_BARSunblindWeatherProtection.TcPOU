<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARSunblindWeatherProtection" Id="{db922119-c3c3-5be7-abe3-381fa584186c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARSunblindWeatherProtection
VAR
    fb : FB_BARSunblindWeatherProtection;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bEnable_in : BOOL := FALSE;
    lrWindSpeed_in : LREAL := 0.0;
    lrOutsideTemperature_in : LREAL := 0.0;
    bRainSensor_in : BOOL := FALSE;
    lrFrostTemperature_io : LREAL := 0.0;
    lrWindSpeedStormUpcoming_io : LREAL := 0.0;
    lrWindSpeedStormAbating_io : LREAL := 0.0;
    uiDeiceTime_io : UINT := 0;
    uiDelayStormUpcoming_io : UINT := 0;
    uiDelayStormAbating_io : UINT := 0;
    uiPositionProtection_io : UINT := 0;
    iAngleProtection_io : INT := 0;
    stSunblind_out : ST_BARSunblind;
    bIceAlarm_out : BOOL;
    udiRemainingTimeIceAlarm_out : UDINT;
    bStormAlarm_out : BOOL;
    uiRemainingTimeStormDetect_out : UINT;
    uiRemainingTimeStormAlarm_out : UINT;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARSunblindWeatherProtection 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARSunblindWeatherProtection.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bEnable := bEnable_in,
    lrWindSpeed := lrWindSpeed_in,
    lrOutsideTemperature := lrOutsideTemperature_in,
    bRainSensor := bRainSensor_in,
    lrFrostTemperature := lrFrostTemperature_io,
    lrWindSpeedStormUpcoming := lrWindSpeedStormUpcoming_io,
    lrWindSpeedStormAbating := lrWindSpeedStormAbating_io,
    uiDeiceTime := uiDeiceTime_io,
    uiDelayStormUpcoming := uiDelayStormUpcoming_io,
    uiDelayStormAbating := uiDelayStormAbating_io,
    uiPositionProtection := uiPositionProtection_io,
    iAngleProtection := iAngleProtection_io,
    stSunblind => stSunblind_out,
    bIceAlarm => bIceAlarm_out,
    udiRemainingTimeIceAlarm => udiRemainingTimeIceAlarm_out,
    bStormAlarm => bStormAlarm_out,
    uiRemainingTimeStormDetect => uiRemainingTimeStormDetect_out,
    uiRemainingTimeStormAlarm => uiRemainingTimeStormAlarm_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
