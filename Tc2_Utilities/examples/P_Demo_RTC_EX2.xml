<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.RTC_EX2 Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_RTC_EX2" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRTC_EX2">
              <type><derived name="RTC_EX2"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RTC_EX2 实例</xhtml></documentation>
            </variable>
            <variable name="bEnable">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stRef">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">外部参考（GPS / NT_GetTime）</xhtml></documentation>
            </variable>
            <variable name="stActual">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RTC_EX2 输出（含毫秒）</xhtml></documentation>
            </variable>
            <variable name="bDst">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：GPS PPS + NMEA 解析得到的 TIMESTRUCT 作为 PDT，RTC_EX2 在两次 GPS 帧之间自走。
// 价值：带时区 + 毫秒 + 自动校准。
// 验证：观察 stActual 每秒推进，wMilliseconds 在 0..999 之间循环；改 stRef 模拟 GPS 帧，stActual 会被拉到新值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbRTC_EX2(EN := bEnable, PDT := stRef, ACT_TIME =&gt; stActual, CDT =&gt; bDst);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
