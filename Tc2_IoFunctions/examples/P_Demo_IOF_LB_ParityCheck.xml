<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_LB_ParityCheck Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_LB_ParityCheck" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLightbusParityRead">
              <type><derived name="IOF_LB_ParityCheck"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Lightbus 奇偶错读 FB</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nLightbusDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="aParityErrCounters">
              <type><array><dimension lower="1" upper="256"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">奇偶错计数缓冲</xhtml></documentation>
            </variable>
            <variable name="nParityCounterCount">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要读的模块数（= 字节数）</xhtml></documentation>
            </variable>
            <variable name="bStartReadParity">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tReadTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bReadBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bReadErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Lightbus 长期运行下趋势监控：每天定时读 5 个模块的奇偶错计数到本地缓冲。
// 价值：让 SCADA 看光纤层的故障趋势。
// 验证：登录后 nLightbusDeviceId 设为主站 ID；nParityCounterCount := 5；写 bStartReadParity := TRUE → bReadBusy 短暂 TRUE → 回 FALSE 后 aParityErrCounters[1..5] 显示 5 个模块的奇偶错累积值。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// LEN 是字节数 = 计数器个数；DESTADDR 用 ADR()
fbLightbusParityRead(
    NETID    := sTargetNetId,
    DEVICEID := nLightbusDeviceId,
    LEN      := nParityCounterCount,
    DESTADDR := ADR(aParityErrCounters),
    START    := bStartReadParity,
    TMOUT    := tReadTimeout,
    BUSY     =&gt; bReadBusy,
    ERR      =&gt; bReadErr,
    ERRID    =&gt; nLastErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
