<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileRename Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileRename" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileRename">
              <type><derived name="FB_FileRename"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileRename 实例</xhtml></documentation>
            </variable>
            <variable name="sSourceName">
              <initialValue><simpleValue value="'D:/log/process.csv'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">源路径</xhtml></documentation>
            </variable>
            <variable name="sTargetName">
              <initialValue><simpleValue value="'D:/log/20260520.csv'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">目标路径</xhtml></documentation>
            </variable>
            <variable name="bRenameRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次改名</xhtml></documentation>
            </variable>
            <variable name="bRenameError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 改名失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：班次切换：'process.csv' → '20260520.csv' 归档。
// 价值：原子 rename，省去复制+删除两步。
// 验证：在线置 bRenameRequest := TRUE → 旧文件消失新文件出现；目标已存在时 bRenameError = TRUE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFileRename(
    sNetId   := '',
    sOldName := sSourceName,
    sNewName := sTargetName,
    ePath    := PATH_GENERIC,
    bExecute := bRenameRequest,
    tTimeout := T#10S,
    bBusy    =&gt; bBusyMon,
    bError   =&gt; bRenameError,
    nErrId   =&gt; nErrIdLast
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
