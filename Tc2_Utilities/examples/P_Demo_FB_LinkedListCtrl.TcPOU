<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_LinkedListCtrl" Id="{e15454a4-52b0-5297-af16-a47691775762}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_LinkedListCtrl
VAR
    fbFB_LinkedListCtrl : FB_LinkedListCtrl; // FB_LinkedListCtrl 实例
    putValue            : PVOID := 0;
    putPosPtr           : POINTER TO T_LinkedListEntry := 0;
    bOk                 : BOOL;
    getValue            : PVOID;
    getPosPtr           : POINTER TO T_LinkedListEntry;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：工单队列。
// 价值：O(1) 中间操作。
// 验证：AddHead / AddTail / Remove 操作，遍历看顺序。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_LinkedListCtrl(
    putValue := putValue,
    putPosPtr := putPosPtr,
    bOk => bOk,
    getValue => getValue,
    getPosPtr => getPosPtr
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
