  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LWORD_TO_BASE36STR" pouType="program">
        <interface>
          <localVars>
            <variable name="nBatchSeq"><initialValue><simpleValue value="12345678"/></initialValue><type><LWORD/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：当前生产序号</xhtml></documentation></variable>
            <variable name="sBatchId"><type><string><length>16</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Base36 工单号</xhtml></documentation></variable>
            <variable name="bEncode"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：生产订单号编码：当前序号 `nBatchSeq : LWORD` → 5 字符 Base36 字符串作为工单 ID 打印到标签。
// 价值：比 hex 字符串紧凑 38%；比 Base64 字符集简单（无 `+ /` 等特殊字符）。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bEncode THEN
    sBatchId := LWORD_TO_BASE36STR(in := nBatchSeq, iPrecision := 5, bLoCase := FALSE);
    bEncode := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
