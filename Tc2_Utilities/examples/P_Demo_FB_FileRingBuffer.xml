  <contentHeader name="Tc2_Utilities.FB_FileRingBuffer Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileRingBuffer" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_FileRingBuffer">
              <type><derived name="FB_FileRingBuffer"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileRingBuffer 实例</xhtml></documentation>
            </variable>
            <variable name="sNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
            </variable>
            <variable name="sPathName">
              <initialValue><simpleValue value="'c:\Temp\data.dat'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
            </variable>
            <variable name="ePath">
              <initialValue><simpleValue value="PATH_GENERIC"/></initialValue>
              <type><derived name="E_OpenPath"/></type>
            </variable>
            <variable name="nID">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><UDINT/></type>
            </variable>
            <variable name="cbBuffer">
              <initialValue><simpleValue value="16#100000"/></initialValue>
              <type><UDINT/></type>
            </variable>
            <variable name="bOverwrite">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="pWriteBuff">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbWriteLen">
              <type><UDINT/></type>
            </variable>
            <variable name="pReadBuff">
              <type><pointer><baseType><BYTE/></baseType></pointer></type>
            </variable>
            <variable name="cbReadLen">
              <type><UDINT/></type>
            </variable>
            <variable name="tTimeout">
              <initialValue><simpleValue value="DEFAULT_ADS_TIMEOUT"/></initialValue>
              <type><TIME/></type>
            </variable>
            <variable name="bBusy">
              <type><BOOL/></type>
            </variable>
            <variable name="bError">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrId">
              <type><UDINT/></type>
            </variable>
            <variable name="cbReturn">
              <type><UDINT/></type>
            </variable>
            <variable name="stHeader">
              <type><derived name="ST_FileRBufferHead"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：30 天循环日志。
// 价值：库提供 rotation。
// 验证：调 Init 配置 N=30 文件，循环 Write，观察磁盘上 log_*.txt 滚动。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_FileRingBuffer(
    sNetId := sNetId,
    sPathName := sPathName,
    ePath := ePath,
    nID := nID,
    cbBuffer := cbBuffer,
    bOverwrite := bOverwrite,
    pWriteBuff := pWriteBuff,
    cbWriteLen := cbWriteLen,
    pReadBuff := pReadBuff,
    cbReadLen := cbReadLen,
    tTimeout := tTimeout,
    bBusy =&gt; bBusy,
    bError =&gt; bError,
    nErrId =&gt; nErrId,
    cbReturn =&gt; cbReturn,
    stHeader =&gt; stHeader
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
