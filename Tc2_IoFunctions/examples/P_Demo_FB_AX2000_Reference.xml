<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_AX2000_Reference Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_AX2000_Reference" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAx2000Ref">
              <type><derived name="FB_AX2000_Reference"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">AX2000 回零 FB</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdIn">
              <type><derived name="ST_PZD_IN"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 输入</xhtml></documentation>
            </variable>
            <variable name="stAx2000PzdOut">
              <type><derived name="ST_PZD_OUT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PZD 输出</xhtml></documentation>
            </variable>
            <variable name="bSetRefPointReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI：设定当前为零位</xhtml></documentation>
            </variable>
            <variable name="bHomingStartReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI：启动 homing</xhtml></documentation>
            </variable>
            <variable name="bHomingStopReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">HMI：停 homing</xhtml></documentation>
            </variable>
            <variable name="iHomingVelocity">
              <initialValue><simpleValue value="50"/></initialValue>
              <type><WORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">homing 基础速度</xhtml></documentation>
            </variable>
            <variable name="bHomingBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bHomingErrFlag">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">驱动器故障</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：维修后重新对零：HMI 按钮触发本 FB 启动 homing，伺服按机械原点感应器找零位。
// 价值：homing 程序化，工人按一键完成。
// 验证：登录后 stAx2000PzdIn / stAx2000PzdOut 已链；在线写 bHomingStartReq := TRUE → fbAx2000Ref.bBusy 短暂 TRUE → 驱动器开始 homing → 找到零位后 bBusy 落回 FALSE，bHomingErrFlag = FALSE 表示成功。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbAx2000Ref(
    bSetRefPoint := bSetRefPointReq,
    bCalibrStart := bHomingStartReq,
    bCalibrStop  := bHomingStopReq,
    iCalVelo     := iHomingVelocity,
    stPZDIN      := stAx2000PzdIn,
    stPZDOUT     := stAx2000PzdOut,
    bBusy        =&gt; bHomingBusy,
    bErr         =&gt; bHomingErrFlag
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
