<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_LicFileCopyToDongle" Id="{421bde34-29f3-5cc3-a578-605e39f660b3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_LicFileCopyToDongle
VAR
    fbFB_LicFileCopyToDongle : FB_LicFileCopyToDongle; // FB_LicFileCopyToDongle 实例
    bExec                    : BOOL := FALSE;
    bBusy_                   : BOOL;
    bErrFlag                 : BOOL;
    nErrCode                 : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：写 License 到 dongle。
// 价值：完成激活闭环。
// 验证：触发后观察 bDone / bErr，错误号 nErrId 反映 ADS Return Codes。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_LicFileCopyToDongle(
    bExecute := bExec, tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy => bBusy_, bError => bErrFlag, nErrorId => nErrCode
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
