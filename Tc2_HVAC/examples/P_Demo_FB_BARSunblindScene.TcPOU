<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARSunblindScene" Id="{d68f67e4-f9f3-5c4b-a745-8f2340c35b4e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARSunblindScene
VAR
    fb : FB_BARSunblindScene;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bEnable_in : BOOL := FALSE;
    usiSelectedScene_in : USINT := 0;
    bSwitchUp_in : BOOL := FALSE;
    bSwitchDown_in : BOOL := FALSE;
    bInvokeScene_in : BOOL := FALSE;
    bSaveScene_in : BOOL := FALSE;
    uiSetpointPosition_in : UINT := 0;
    iSetpointAngle_in : INT := 0;
    uiSwitchOverTime_io : UINT := 0;
    arrBlindScenes_io : ARRAY[0..20] OF ST_BARSunblindScene ;
    stSunblind_out : ST_BARSunblind;
    bActive_out : BOOL;
    uiPositionActScene_out : UINT;
    iAnglePositionActScene_out : INT;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARSunblindScene 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARSunblindScene.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bEnable := bEnable_in,
    usiSelectedScene := usiSelectedScene_in,
    bSwitchUp := bSwitchUp_in,
    bSwitchDown := bSwitchDown_in,
    bInvokeScene := bInvokeScene_in,
    bSaveScene := bSaveScene_in,
    uiSetpointPosition := uiSetpointPosition_in,
    iSetpointAngle := iSetpointAngle_in,
    uiSwitchOverTime := uiSwitchOverTime_io,
    arrBlindScenes := arrBlindScenes_io,
    stSunblind => stSunblind_out,
    bActive => bActive_out,
    uiPositionActScene => uiPositionActScene_out,
    iAnglePositionActScene => iAnglePositionActScene_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
