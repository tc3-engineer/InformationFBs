  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_Dpv1ReadPNET" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDpv1ReadPNET">
              <type><derived name="FB_Dpv1ReadPNET"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Profinet DPV1 读 FB</xhtml></documentation>
            </variable>
            <variable name="sProfinetMasterNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EL6632 主站 NetId</xhtml></documentation>
            </variable>
            <variable name="iSinamicsPnetPort">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SINAMICS Profinet port</xhtml></documentation>
            </variable>
            <variable name="iDriveObjectId">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive A</xhtml></documentation>
            </variable>
            <variable name="aDpv1ReqBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求</xhtml></documentation>
            </variable>
            <variable name="aDpv1ResBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应</xhtml></documentation>
            </variable>
            <variable name="iReqBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求长度</xhtml></documentation>
            </variable>
            <variable name="iResBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应长度</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">清单</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ValueHdr">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ValueHeaderEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">解析输出</xhtml></documentation>
            </variable>
            <variable name="iNumParamsToRead">
              <initialValue><simpleValue value="3"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读 3 个</xhtml></documentation>
            </variable>
            <variable name="nReqPkgLenPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求帧长度</xhtml></documentation>
            </variable>
            <variable name="nReadResPkgLenPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应帧长度</xhtml></documentation>
            </variable>
            <variable name="bBuildReqPkgPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发构造</xhtml></documentation>
            </variable>
            <variable name="bDpv1ReadReqPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发发送</xhtml></documentation>
            </variable>
            <variable name="bSplitReadResPkgPNET">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发解析</xhtml></documentation>
            </variable>
            <variable name="tDpv1ReadTimeout">
              <initialValue><simpleValue value="T#10S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bDpv1ReadBusyPNET">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="iDpv1ReadRequestRefPNET">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求引用</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Profinet SINAMICS 完整读流程：构造 → 发送 → 解析。
// 价值：与 Profibus 版本对称。
// 验证：登录后 sProfinetMasterNetId 设为 EL6632 NetId，iSinamicsPnetPort := slave port；bBuildReqPkgPNET → nReqPkgLenPNET &gt; 0；bDpv1ReadReqPNET → bDpv1ReadBusyPNET 落回 → bSplitReadResPkgPNET 解析。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 步骤 1：构造请求
IF bBuildReqPkgPNET THEN
    nReqPkgLenPNET := F_CreateDpv1ReadReqPkgPNET(
        pDpv1ReqData    := ADR(aDpv1ReqBuffer),
        iNumOfParams    := iNumParamsToRead,
        iDriveId        := iDriveObjectId,
        stDpv1Parameter := arrDpv1ReqParams
    );
    bBuildReqPkgPNET := FALSE;
END_IF;

// 步骤 2：发送
fbDpv1ReadPNET(
    bExecute        := bDpv1ReadReqPNET,
    aNetId          := sProfinetMasterNetId,
    iProfinetPort   := iSinamicsPnetPort,
    iDriveId        := iDriveObjectId,
    pDpv1ReqData    := ADR(aDpv1ReqBuffer),
    iDpv1ReqDataLen := iReqBufLen,
    pDpv1ResData    := ADR(aDpv1ResBuffer),
    iDpv1ResDataLen := iResBufLen,
    tTmOut          := tDpv1ReadTimeout,
    iRequestRef     =&gt; iDpv1ReadRequestRefPNET
);
bDpv1ReadBusyPNET := fbDpv1ReadPNET.bBusy;

// 步骤 3：解析
IF bSplitReadResPkgPNET THEN
    nReadResPkgLenPNET := F_SplitDpv1ReadResPkgPNET(
        pDpv1ResData        := ADR(aDpv1ResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitReadResPkgPNET := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
