<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_EcGetAllSlaveAddr" Id="{4183fa77-5c17-5ffc-8327-d98ef04623fb}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_EcGetAllSlaveAddr
VAR
    fbGetAllAddr        : FB_EcGetAllSlaveAddr;
    bRequestEnumerate   : BOOL := FALSE;
    arrSlaveAddresses   : ARRAY[0..EC_MAX_SLAVES] OF UINT;   // 接收所有从站固定地址
    nSlaveCount         : UINT;
    bEnumerateBusy      : BOOL;
    bEnumerateError     : BOOL;
    nLastAdsErr         : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// Tc2_EtherCAT.FB_EcGetAllSlaveAddr 演示程序
// =============================================================================
// 场景：新机型工程上电首次扫描，前 50 个从站均需 FPRD 读厂商寄存器。先用
//       本 FB 一次性枚举出全部从站的 Configured Address，存到全局数组
//       arrSlaveAddresses，后续 FB_EcPhysicalReadCmd 直接按数组遍历。
//
// 价值：免去手工抄录 50 个 adp 数值；一次 ADS 调用拿全清单，运行时永远
//       与实际配置一致。
//
// 验证步骤：
//   1. Import 本文件，编译 → 登录
//   2. 在线置 bRequestEnumerate := TRUE
//        - bEnumerateBusy 一两个周期后落回
//        - nSlaveCount 应为本机 EtherCAT 主站连接的从站数
//        - arrSlaveAddresses[0..nSlaveCount-1] 应填入从 16#03E9 (1001) 开始
//          的固定地址（典型按 1001, 1002, ... 递增）
//   3. 把 nLastAdsErr 监视到 0
// =============================================================================

fbGetAllAddr(
    sNetId   := '',
    pAddrBuf := ADR(arrSlaveAddresses),
    cbBufLen := SIZEOF(arrSlaveAddresses),
    bExecute := bRequestEnumerate,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy    => bEnumerateBusy,
    bError   => bEnumerateError,
    nErrId   => nLastAdsErr,
    nSlaves  => nSlaveCount
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
