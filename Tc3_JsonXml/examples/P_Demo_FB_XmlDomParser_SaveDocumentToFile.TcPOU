<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_XmlDomParser_SaveDocumentToFile" Id="{7b3a7a7e-1178-5012-9efd-55474ed45e1c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_XmlDomParser_SaveDocumentToFile
VAR
    fbParser : FB_XmlDomParser; // 父 FB 实例
    bExecRaw : BOOL; // 给 bExec 用的具名后备变量
    sFile : STRING(255);
    hrErrorCode : HRESULT;
    vRet : BOOL; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：把当前生成的 JSON 文档持久化到 SD 卡，下次断电重启可继续。
// 价值：一次调用完成异步写盘 + UTF-8 编码 + DOM 序列化。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.SaveDocumentToFile(
        bExec := bExecRaw,
        sFile := sFile,
        hrErrorCode => hrErrorCode
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
