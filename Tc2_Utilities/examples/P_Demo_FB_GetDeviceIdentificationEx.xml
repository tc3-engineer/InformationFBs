  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetDeviceIdentificationEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetDeviceIdentificationEx">
              <type><derived name="FB_GetDeviceIdentificationEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetDeviceIdentificationEx 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stDeviceId">
              <type><derived name="ST_DeviceIdentification"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：盘点 5 台 PLC 的 TwinCAT 版本。
// 价值：脚本化盘点。
// 验证：改 bRead := TRUE，观察 stDeviceId.sTwinCATVersion 装载字符串如 `3.1.4024.32`。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetDeviceIdentificationEx(
    sNetID := '',
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    stDeviceIdentification =&gt; stDeviceId,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
