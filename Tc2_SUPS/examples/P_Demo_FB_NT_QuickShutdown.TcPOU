<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_NT_QuickShutdown" Id="{6bf64cdf-043c-5b75-a3e5-23c4ae7743ff}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_NT_QuickShutdown
VAR
    fbQuickShutdown         : FB_NT_QuickShutdown; // ⚠️ 内部用 FB：业务代码请改用 FB_S_UPS_*，不要独立调用本 FB
    sLocalNetIDForReboot    : T_AmsNetId := ''; // 本机 AmsNetID = 空串
    bTriggerEmergencyReboot : BOOL := FALSE; // ⚠️ 上升沿即重启；演示用，工程禁用
    tShutdownAdsTimeout     : TIME := DEFAULT_ADS_TIMEOUT; // ADS 超时，默认即可
    bQuickShutdownBusy      : BOOL; // quick shutdown 命令仍在执行
    bQuickShutdownError     : BOOL; // 出错标志：TRUE = 触发失败
    nQuickShutdownErrID     : UDINT; // 错误号（仅当 bQuickShutdownError = TRUE）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// ⚠️ 警告：本例程仅用于演示 FB_NT_QuickShutdown 的接口结构。
//         实际工程中不要直接调用本 FB——它不会先存 retain，重启时数据会丢。
//         所有断电应急场景都应该用 FB_S_UPS_CB3011 / FB_S_UPS / FB_S_UPS_CX51x0
//         / FB_S_UPS_CX9020_U900 / FB_S_UPS_BAPI 之一。
//
// 场景：演示用——让工程师能在 PLC 工程里看到这个 FB 的接口长什么样。
//
// 价值：避免误用。读懂接口后请改用 FB_S_UPS_*。
//
// 验证步骤：
//   1. 引用 Tc2_SUPS（含依赖 Tc2_System）
//   2. 在 PLC 项目中右键 → Add Existing Item (.TcPOU) → 选本文件 → OK
//   3. 编译、登录、运行（但**不要**给 bTriggerEmergencyReboot 置 TRUE
//      除非台架且 retain 不重要）
//   4. 在线观察 bQuickShutdownBusy / bQuickShutdownError / nQuickShutdownErrID
//      均为初始默认（FALSE / FALSE / 0），证明 FB 已正确实例化
//   5. 若确实要演示重启效果（仅台架）：在线把 bTriggerEmergencyReboot 置 TRUE
//      一个周期 → 系统在 100-500 ms 内重启
// =============================================================================

// 单次调用形式：所有输入显式赋值；输出端 3 项全部接出
// ⚠️ 工程中不要把 bTriggerEmergencyReboot 接到任何业务信号上
fbQuickShutdown(
    NETID := sLocalNetIDForReboot,
    START := bTriggerEmergencyReboot,
    TMOUT := tShutdownAdsTimeout,
    BUSY  => bQuickShutdownBusy,
    ERR   => bQuickShutdownError,
    ERRID => nQuickShutdownErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
