  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_GetSystemId Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetSystemId" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetSystemId">
              <type><derived name="FB_GetSystemId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetSystemId 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="systemId">
              <type><derived name="GUID"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机 SystemID</xhtml></documentation>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：License POU 启动时读一次 SystemID 做校验。
// 价值：标准 License 绑定锚点。
// 验证：改 bRead := TRUE，观察 systemId 装载 16 字节 GUID（非全 0）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetSystemId(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    systemId =&gt; systemId,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
