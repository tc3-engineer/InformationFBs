<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_StringRingBuffer" Id="{68fc0439-4436-537b-b568-d97983e5ccf5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_StringRingBuffer
VAR
    fbFB_StringRingBuffer : FB_StringRingBuffer; // FB_StringRingBuffer 实例
    bOverwrite            : BOOL;
    putValue              : T_MaxString := '';
    pBuffer               : POINTER TO BYTE;
    cbBuffer              : UDINT;
    bOk                   : BOOL;
    getValue              : T_MaxString;
    nCount                : UDINT;
    cbSize                : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：HMI 消息历史。
// 价值：字符串专用。
// 验证：Add 多条 STRING，Get 顺序取回。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_StringRingBuffer(
    bOverwrite := bOverwrite,
    putValue := putValue,
    pBuffer := pBuffer,
    cbBuffer := cbBuffer,
    bOk => bOk,
    getValue => getValue,
    nCount => nCount,
    cbSize => cbSize
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
