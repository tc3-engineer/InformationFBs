  <contentHeader name="Tc2_Utilities.FB_GetHostName Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetHostName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetHostName">
              <type><derived name="FB_GetHostName"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetHostName 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="sName">
              <type><string><length>255</length></string></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：开机后读机器名给 HMI 标题。
// 价值：标准库调用，免写注册表读取。
// 验证：改 bRead := TRUE，观察 sName 装载主机名字符串。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetHostName(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    sHostName =&gt; sName,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
