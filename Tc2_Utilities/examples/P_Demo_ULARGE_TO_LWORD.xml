  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ULARGE_TO_LWORD" pouType="program">
        <interface>
          <localVars>
            <variable name="uliStatus">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">legacy 状态结构体</xhtml></documentation>
            </variable>
            <variable name="lwStatusBits">
              <type><derived name="LWORD;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换后的位串</xhtml></documentation>
            </variable>
            <variable name="bConvert">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.ULARGE_TO_LWORD 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：legacy 报文里读到的 64 位状态位转 LWORD 后直接用 IEC 原生 `AND` 屏蔽。
// 价值：替代结构体位运算；之后可用原生 `AND/OR/SHR`，代码可读性更高。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bConvert THEN
    lwStatusBits := ULARGE_TO_LWORD(uliStatus);
    bConvert := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
