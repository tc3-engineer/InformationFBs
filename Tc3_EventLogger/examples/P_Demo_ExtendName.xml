<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.ExtendName Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ExtendName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSrc">
              <type><derived name="FB_TcSourceInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">源信息实例</xhtml></documentation>
            </variable>
            <variable name="sStationId">
              <initialValue><simpleValue value="'Station-01'"/></initialValue>
              <type><string><length>40</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工位号后缀</xhtml></documentation>
            </variable>
            <variable name="bDoExtend">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoExtendPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：给当前工位的 SourceInfo 加工位号后缀
// 价值：事件天然带工位标识
// 验证：登录后调用一次 ExtendName 后 fbSrc.sSourceName 应包含 sExtName 内容
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoExtend AND NOT bDoExtendPrev THEN
    hr := fbSrc.ExtendName(sExtName := sStationId);
END_IF;
bDoExtendPrev := bDoExtend;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
