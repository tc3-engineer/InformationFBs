<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_LB_ParityCheckWithReset Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_LB_ParityCheckWithReset" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLightbusParityReadReset">
              <type><derived name="IOF_LB_ParityCheckWithReset"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Lightbus 奇偶错读+复位 FB</xhtml></documentation>
            </variable>
            <variable name="sTargetNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nLightbusDeviceId">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">主站 Device Id</xhtml></documentation>
            </variable>
            <variable name="aParityIncrement">
              <type><array><dimension lower="1" upper="256"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">奇偶错增量缓冲</xhtml></documentation>
            </variable>
            <variable name="nParityCounterCount">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要读的模块数</xhtml></documentation>
            </variable>
            <variable name="bStartReadResetParity">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="tReadTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bReadBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bReadErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">失败</xhtml></documentation>
            </variable>
            <variable name="nLastErrCode">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：Lightbus 实时错误率：每分钟读 5 个模块奇偶错增量送 SCADA。
// 价值：做差量计数比软件自己减更可靠。
// 验证：登录后第一次写 bStartReadResetParity := TRUE → 完成后 aParityIncrement[1..5] 显示自上次复位以来的奇偶错次数；间隔 1 分钟再触发一次 → 看 aParityIncrement 是否随通讯质量波动。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbLightbusParityReadReset(
    NETID    := sTargetNetId,
    DEVICEID := nLightbusDeviceId,
    LEN      := nParityCounterCount,
    DESTADDR := ADR(aParityIncrement),
    START    := bStartReadResetParity,
    TMOUT    := tReadTimeout,
    BUSY     =&gt; bReadBusy,
    ERR      =&gt; bReadErr,
    ERRID    =&gt; nLastErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
