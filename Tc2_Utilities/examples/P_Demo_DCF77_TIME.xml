<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.DCF77_TIME Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_DCF77_TIME" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDCF77_TIME">
              <type><derived name="DCF77_TIME"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">DCF77_TIME 实例</xhtml></documentation>
            </variable>
            <variable name="bDcfPulseInput">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">DCF77 接收模块的数字脉冲输出（每秒 100 ms 或 200 ms 高电平）</xhtml></documentation>
            </variable>
            <variable name="bTimeValid">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">每分钟整点出现 1 个 PLC 周期的 TRUE</xhtml></documentation>
            </variable>
            <variable name="dtDecodedTime">
              <type><DT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">最近解出的日期时间</xhtml></documentation>
            </variable>
            <variable name="bIsDaylightSaving">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = CEST 夏令时</xhtml></documentation>
            </variable>
            <variable name="bDstChangeHourly">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">切换前 1 小时预警</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把 DI 模块上接的 DCF77 解调脉冲喂给本 FB，monitor 解码结果。
// 价值：自动处理 59 位 DCF77 报文。
// 验证：使 bDcfPulseInput 按 DCF77 协议节奏跳变（实际是真实模块输入），1 分钟后观察 bTimeValid 翻 TRUE 一个周期，dtDecodedTime 装载新时间。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbDCF77_TIME(
    DCF_INPUT := bDcfPulseInput,
    DCF_TIME_VALID =&gt; bTimeValid,
    DCF_DATE_AND_TIME =&gt; dtDecodedTime,
    CDT =&gt; bIsDaylightSaving,
    CHANGE_DT =&gt; bDstChangeHourly
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
