<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_AppendErrorString" Id="{eaace665-2eba-5b28-a221-c6a76fee3146}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_AppendErrorString
VAR
    fbAppendErrorString : AppendErrorString; // AppendErrorString 实例
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.AppendErrorString 演示程序
// ============================================================
// 场景：演示在 SFC 工程中引用 Tc2_System 后本 FB 由编译器在错误分析路径自动调用。
// 价值：业务代码零调用。
// 验证：项目 References 节点下出现 Tc2_System；按 AnalyzeExpression 配齐 SFC flag；运行超时后 SFCErrorAnalyzation 字符串正确拼装。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

// 严禁手动调用 AppendErrorString。只要 Tc2_System 被引用，本 FB 由编译器自动使用。
;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
