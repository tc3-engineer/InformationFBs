<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FindAndDelete Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FindAndDelete" pouType="program">
        <interface>
          <localVars>
            <variable name="sHtmlSrc"><initialValue><simpleValue value="'Tank&amp;lt;br&amp;gt;level low&amp;lt;/p&amp;gt;'"/></initialValue><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：含 HTML 标签的原始报警串</xhtml></documentation></variable>
            <variable name="sBrTag"><initialValue><simpleValue value="'&amp;lt;br&amp;gt;'"/></initialValue><type><string><length>8</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要删除的标签</xhtml></documentation></variable>
            <variable name="sCleaned"><type><string><length>255</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">清理后的纯文本</xhtml></documentation></variable>
            <variable name="nRemoved"><type><UDINT/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">删除次数</xhtml></documentation></variable>
            <variable name="bClean"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HTML 转纯文本：用 `FindAndDelete` 把 `'&lt;br&gt;'`、`'&lt;/p&gt;'` 等固定标签整批删掉。
// 价值：不用本函数则需 `FIND2` + `DELETE2` 循环，至少 8 行；本函数 1 行解决，并返回总删除次数用于报表。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
// 从报警消息中剥除 &lt;br&gt; 标签
IF bClean THEN
    nRemoved := FindAndDelete(pSrcString    := ADR(sHtmlSrc),
                              pDeleteString := ADR(sBrTag),
                              pDstString    := ADR(sCleaned),
                              nDstSize      := SIZEOF(sCleaned));
    bClean := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
