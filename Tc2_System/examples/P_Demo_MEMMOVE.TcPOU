<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_MEMMOVE" Id="{3bddf3f1-8b1b-5ebd-a0ac-3719b1682217}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_MEMMOVE
VAR
    aSamples      : ARRAY[0..9] OF LREAL; // 环形采样缓冲（10 个）
    lrNewSample   : LREAL := 0.0; // 新采样值（在线写入）
    bShiftRequest : BOOL; // 在线写 TRUE 触发一次移位
    nBytesShifted : UDINT; // 实际移位字节数
    rtShift       : R_TRIG; // 上升沿检测
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：环形采样缓冲区左移：每次新采样到来时，把 aSamples[1..9] 整体左移到 aSamples[0..8]，aSamples[9] 留给新值。
// 价值：MEMCPY 在重叠区行为未定义；MEMMOVE 保证正确。
// 验证：在线 bShiftRequest := TRUE 触发一次 → 观察 aSamples[0] 等于之前的 aSamples[1] 值。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 上升沿检测，避免周期性误触发
rtShift(CLK := bShiftRequest);
IF rtShift.Q THEN
    // 把 aSamples[1..9] 整体左移到 aSamples[0..8]；源和目的重叠，必须 MEMMOVE
    nBytesShifted := MEMMOVE(
        destAddr := ADR(aSamples[0]),
        srcAddr  := ADR(aSamples[1]),
        n        := SIZEOF(aSamples) - SIZEOF(aSamples[0])
    );
    // 末尾位置填新采样
    aSamples[9] := lrNewSample;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
