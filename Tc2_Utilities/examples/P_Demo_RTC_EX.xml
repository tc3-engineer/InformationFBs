<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.RTC_EX Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_RTC_EX" pouType="program">
        <interface>
          <localVars>
            <variable name="fbRTC_EX">
              <type><derived name="RTC_EX"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RTC_EX 实例</xhtml></documentation>
            </variable>
            <variable name="bEn">
              <initialValue><simpleValue value="TRUE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stReference">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">外部参考时间（NT_GetTime 输出）</xhtml></documentation>
            </variable>
            <variable name="stActualTime">
              <type><derived name="TIMESTRUCT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RTC_EX 推进输出</xhtml></documentation>
            </variable>
            <variable name="bDst">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：给事件日志打毫秒时间戳，NT_GetTime 5 秒一次校准。
// 价值：带毫秒精度 + 自动校准。
// 验证：观察 stActualTime.wMilliseconds 在变；周期把 stReference 从 NT_GetTime 拉新值，stActualTime 跟随。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbRTC_EX(EN := bEn, PDT := stReference, ACT_TIME =&gt; stActualTime, CDT =&gt; bDst);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
