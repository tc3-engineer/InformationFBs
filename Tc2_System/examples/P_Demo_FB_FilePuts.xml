<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FilePuts Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FilePuts" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFilePuts">
              <type><derived name="FB_FilePuts"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FilePuts 实例</xhtml></documentation>
            </variable>
            <variable name="hOpenedFile">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已打开的句柄（文本模式追加）</xhtml></documentation>
            </variable>
            <variable name="sEventLine">
              <initialValue><simpleValue value="'2026-05-20T12:00:00,event,OK$N'"/></initialValue>
              <type><derived name="T_MaxString"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">一行事件文本，末尾必须自己加 $N 换行</xhtml></documentation>
            </variable>
            <variable name="bPutsRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次写入</xhtml></documentation>
            </variable>
            <variable name="bPutsError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 写失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把 sEventLine ('2026-05-20T12:00:00,设备启动,OK') 追加写入 D:/log/events.csv（文本模式）。
// 价值：一行调用替代 FB_FileWrite + ADR + LEN，约省 5-8 行。
// 验证：在线写 sEventLine 后置 bPutsRequest := TRUE → 用文本编辑器打开 events.csv 应见新行；bPutsError 始终 FALSE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用；sEventLine 末尾自己加了 $N 确保换行
fbFilePuts(
    sNetId   := '',
    hFile    := hOpenedFile,
    sLine    := sEventLine,
    bExecute := bPutsRequest,
    tTimeout := T#10S,
    bBusy    =&gt; bBusyMon,
    bError   =&gt; bPutsError,
    nErrId   =&gt; nErrIdLast
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
