<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_UA_Read" Id="{816cbd08-c8b7-5ed7-9c3d-f274a4581751}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_UA_Read
VAR
    fbReadTankLevel    : UA_Read;                  // 周期读 LREAL 节点
    fbReadTrigger      : TON;                       // 5 秒一次的周期触发器
    bReadTriggerOut    : BOOL;
    bRequestRead       : BOOL;                      // 给 FB 的 Execute（脉冲）

    hMesConnection     : DWORD;                     // 会话句柄（由 UA_Connect 设置）
    hTankLevelNode     : DWORD;                     // 节点句柄（由 UA_NodeGetHandle 设置）

    stReadAttrInfo     : ST_UANodeAdditionalInfo;   // 读属性配置（PROGRAM 头部初始化）
    fTankLevelValue    : LREAL;                     // 接收缓冲区（PROGRAM 持有，异步保活）
    tReadTimeout       : TIME := T#3S;

    // —— 输出 ——
    bReadDone          : BOOL;
    bReadBusy          : BOOL;
    bReadError         : BOOL;
    nReadErrorId       : UDINT;
    nBytesReceived     : UDINT;                      // 实际接收字节数（应 = 8）

    bInitDone          : BOOL := FALSE;
    nSuccessfulReads   : UDINT;                      // 累计成功读次数
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：CX 控制器作为 OPC UA Client 每 5 秒从远端 MES 服务器读「水箱液位」
//       (PLC 端 LREAL 变量 'MAIN.fTankLevel') 给本地 HMI 显示。本 demo 演示
//       UA_Read 的完整正确用法：周期触发 + Value 属性读 + PROGRAM 级缓冲区
//       生命周期管理 + 错误码识别。
//
// 价值：替代「I/O Client 静态映射 + 编译期变量绑定」的局限性——动态采集任
//       意 NodeID，业务可在运行时切换目标节点。把 OPC UA Read 协议全套封装为
//       4 输入 4 输出的 FB 调用。
//
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU
//   2. 引用 Tc3_PLCopen_OpcUa；目标 Server 端 PLC 有 fTankLevel:LREAL
//   3. 先跑通 P_Demo_UA_Connect + P_Demo_UA_GetNamespaceIndex + P_Demo_UA_NodeGetHandle
//      把 ConnectionHdl / NodeHdl 抄到本程序
//   4. 编译 → 登录 → 运行
//   5. 在线监视：每 5 秒 bReadDone 闪一下；fTankLevelValue 应填入 Server 当前
//      值；nBytesReceived 应 = 8（LREAL 占 8 字节）；nSuccessfulReads 累计递增
//   6. 在 Server 端在线写 fTankLevel := 12.34：下一周期本地 fTankLevelValue 应
//      变为 12.34
//   7. 把 hTankLevelNode 改成 0：bReadError = TRUE，nReadErrorId 应为
//      0xE4DD0116 (UAC_E_INVAL_NODE_HDL)
// =============================================================================

// —— 一次性初始化：读 Value 属性，不切 IndexRange ——
IF NOT bInitDone THEN
    stReadAttrInfo.eAttributeID     := eUAAI_Value;    // 默认就是 Value，显式赋值更清晰
    stReadAttrInfo.nIndexRangeCount := 0;              // 不切数组
    bInitDone := TRUE;
END_IF;

// —— 周期触发：每 5 秒发一个脉冲 ——
fbReadTrigger(IN := NOT bReadTriggerOut, PT := T#5S, Q => bReadTriggerOut);
bRequestRead := bReadTriggerOut;

// —— 单次调用：所有 VAR_INPUT 显式赋值 ——
// pVariable 用 ADR(fTankLevelValue) 指向 PROGRAM 级变量，异步期间地址保活
fbReadTankLevel(
    Execute       := bRequestRead,
    ConnectionHdl := hMesConnection,
    NodeHdl       := hTankLevelNode,
    stNodeAddInfo := stReadAttrInfo,
    pVariable     := ADR(fTankLevelValue),
    cbData        := SIZEOF(fTankLevelValue),
    Timeout       := tReadTimeout,
    Done          => bReadDone,
    Busy          => bReadBusy,
    Error         => bReadError,
    ErrorID       => nReadErrorId,
    cbData_R      => nBytesReceived
);

// —— 计数：成功读完后累加（用作业务侧「数据新鲜度」指示）——
IF bReadDone AND NOT bReadError THEN
    nSuccessfulReads := nSuccessfulReads + 1;
END_IF;

// 工程化提醒：Read 失败时 fTankLevelValue 保留上次成功的值（不会被覆盖）；业务
// 侧应同时看 bReadError + 一个 timestamp 判断数据是否「新鲜」。生产代码常常
// 把多个节点的 Read 串成一个状态机或直接用 UA_ReadList 批量读。
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
