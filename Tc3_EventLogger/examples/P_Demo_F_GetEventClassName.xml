<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.F_GetEventClassName Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_GetEventClassName" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">事件源（已 Create）</xhtml></documentation>
            </variable>
            <variable name="fbResult">
              <type><derived name="FB_AsyncStrResult"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">异步结果</xhtml></documentation>
            </variable>
            <variable name="nLangId">
              <initialValue><simpleValue value="2052"/></initialValue>
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">中文 LangId</xhtml></documentation>
            </variable>
            <variable name="bDoReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoReqPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="sClassName">
              <type><string><length>80</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">类名</xhtml></documentation>
            </variable>
            <variable name="bGot">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已取标志</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Function 返回值</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：一次性查询事件类名
// 价值：函数式调用简洁
// 验证：登录后写 bDoReq := TRUE 触发；几周期后 fbResult.bBusy 变 FALSE，取 sClassName
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoReq AND NOT bDoReqPrev THEN
    hr := F_GetEventClassName(
        nLangId := nLangId,
        fbEventBase := fbAlarm,
        fbResult := fbResult);
    bGot := FALSE;
END_IF;
bDoReqPrev := bDoReq;

IF NOT fbResult.bBusy AND NOT fbResult.bError AND NOT bGot THEN
    fbResult.GetString(sResult := sClassName);
    bGot := TRUE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
