<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_FileRingBuffer" Id="{fb681e03-c90c-5937-844b-e8b62a7e54c8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_FileRingBuffer
VAR
    fbFB_FileRingBuffer : FB_FileRingBuffer; // FB_FileRingBuffer 实例
    sNetId              : T_AmsNetId := '';
    sPathName           : T_MaxString := 'c:\Temp\data.dat';
    ePath               : E_OpenPath := PATH_GENERIC;
    nID                 : UDINT := 0;
    cbBuffer            : UDINT := 16#100000;
    bOverwrite          : BOOL := FALSE;
    pWriteBuff          : POINTER TO BYTE;
    cbWriteLen          : UDINT;
    pReadBuff           : POINTER TO BYTE;
    cbReadLen           : UDINT;
    tTimeout            : TIME := DEFAULT_ADS_TIMEOUT;
    bBusy               : BOOL;
    bError              : BOOL;
    nErrId              : UDINT;
    cbReturn            : UDINT;
    stHeader            : ST_FileRBufferHead;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：30 天循环日志。
// 价值：库提供 rotation。
// 验证：调 Init 配置 N=30 文件，循环 Write，观察磁盘上 log_*.txt 滚动。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_FileRingBuffer(
    sNetId := sNetId,
    sPathName := sPathName,
    ePath := ePath,
    nID := nID,
    cbBuffer := cbBuffer,
    bOverwrite := bOverwrite,
    pWriteBuff := pWriteBuff,
    cbWriteLen := cbWriteLen,
    pReadBuff := pReadBuff,
    cbReadLen := cbReadLen,
    tTimeout := tTimeout,
    bBusy => bBusy,
    bError => bError,
    nErrId => nErrId,
    cbReturn => cbReturn,
    stHeader => stHeader
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
