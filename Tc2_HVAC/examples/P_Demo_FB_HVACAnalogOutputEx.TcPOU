<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACAnalogOutputEx" Id="{debcdc64-051b-5e4d-87cc-5e63d43e12e3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACAnalogOutputEx
VAR
    fb : FB_HVACAnalogOutputEx;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    bSetDefault_in : BOOL := FALSE;
    bEnable_in : BOOL := FALSE;
    rSetpoint_in : REAL := 0.0;
    bCtrlVoltage_in : BOOL := FALSE;
    eCtrlModeAnalogOutput_in : E_HVACAnalogOutputMode ;
    rYManual_in : REAL := 0.0;
    rFeedb_in : REAL := 0.0;
    bFrost_in : BOOL := FALSE;
    bReset_in : BOOL := FALSE;
    rX2_io : REAL := 0.0;
    rX1_io : REAL := 0.0;
    iY2_io : INT := 0;
    iY1_io : INT := 0;
    bDirection_io : BOOL := FALSE;
    bEnableFeedbCtrl_io : BOOL := FALSE;
    rHysteresisFeedbCtrl_io : REAL := 0.0;
    tDelayFeedbCtrl_io : TIME := T#0S;
    rY_out : REAL;
    iYTerminal_out : INT;
    eStateModeAnalogOutput_out : E_HVACAnalogOutputMode;
    bManualMode_out : BOOL;
    byState_out : BYTE;
    bErrorFeedb_out : BOOL;
    bErrorGeneral_out : BOOL;
    byError_out : BYTE;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACAnalogOutputEx 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACAnalogOutputEx.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    bSetDefault := bSetDefault_in,
    bEnable := bEnable_in,
    rSetpoint := rSetpoint_in,
    bCtrlVoltage := bCtrlVoltage_in,
    eCtrlModeAnalogOutput := eCtrlModeAnalogOutput_in,
    rYManual := rYManual_in,
    rFeedb := rFeedb_in,
    bFrost := bFrost_in,
    bReset := bReset_in,
    rX2 := rX2_io,
    rX1 := rX1_io,
    iY2 := iY2_io,
    iY1 := iY1_io,
    bDirection := bDirection_io,
    bEnableFeedbCtrl := bEnableFeedbCtrl_io,
    rHysteresisFeedbCtrl := rHysteresisFeedbCtrl_io,
    tDelayFeedbCtrl := tDelayFeedbCtrl_io,
    rY => rY_out,
    iYTerminal => iYTerminal_out,
    eStateModeAnalogOutput => eStateModeAnalogOutput_out,
    bManualMode => bManualMode_out,
    byState => byState_out,
    bErrorFeedb => bErrorFeedb_out,
    bErrorGeneral => bErrorGeneral_out,
    byError => byError_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
