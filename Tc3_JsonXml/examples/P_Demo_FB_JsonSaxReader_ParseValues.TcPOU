<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_JsonSaxReader_ParseValues" Id="{b9882247-25df-52d4-9759-bfd10ea62f6f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_JsonSaxReader_ParseValues
VAR
    fbParser : FB_JsonSaxReader; // 父 FB 实例
    ipHdl : ITcJsonSaxValues;
    sJson : STRING(255);
    hrErrorCode : HRESULT;
    vRet : BOOL; // 返回值监视
    bTrigger : BOOL := FALSE; // 在线置 TRUE 触发一次调用
    bTriggerPrev : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：解析嵌套深的 JSON 配置（如 users[i].address.street），需要知道当前路径才能取舍。
// 价值：回调自带 level + infos，业务代码不必自己维护路径栈。
// 验证：登录 PLC 在线写 bTrigger := TRUE 触发，monitor 返回值/输出参数。具体步骤见下方注释。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_JsonXml（References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 上升沿触发一次方法调用并观察输出。
IF bTrigger AND NOT bTriggerPrev THEN
    vRet := fbParser.ParseValues(
        ipHdl := ipHdl,
        sJson := sJson,
        hrErrorCode => hrErrorCode
    );
END_IF;
bTriggerPrev := bTrigger;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
