<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_TcEventFilter" Id="{9e3633cf-0a8c-5888-b6b4-c3582bc9ebb7}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_TcEventFilter
VAR
    fbFilter    : FB_TcEventFilter; // 过滤器实例
    fbListener  : FB_ListenerBase2; // listener 实例
    bSubscribed : BOOL; // 订阅 latch
    hr          : HRESULT; // 返回值监视
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：构建「Severity ≥ Warning AND Source.Name 含 Main」的过滤器
// 价值：链式条件 + 早过滤节省 CPU
// 验证：实例化后链式调用配置规则；传给 Subscribe2 后只收到匹配事件
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

// 在 listener 订阅前构建过滤规则
// 示意（具体属性接口随库版本演进；以下伪写法表达意图）：
// fbFilter.Severity.GreaterEqual(TcEventSeverity.Warning).AND_OP()
//         .Source.Name.Like('%Main%');
//
// 然后订阅：
IF NOT bSubscribed THEN
    hr := fbListener.Subscribe2(ipEventFilter := fbFilter);
    bSubscribed := SUCCEEDED(hr);
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
