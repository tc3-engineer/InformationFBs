<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_EuropeanLocalTime" Id="{e0a8ddf4-8cd8-5a4f-ae2a-6588721117cd}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_EuropeanLocalTime
VAR
    stUTC             : TIMESTRUCT; // PLC 内部记录的 UTC 时间 (初始化通过在线手动赋值; 推荐字段：( wYear := 2026, wMonth := 5, wDay := 11, wHour := 10, wMinute := 0, wSecond := 0, wMilliseconds := 0 ))
    nTimeZoneOffset   : INT := 60; // 欧洲时区偏移（分钟）：CET 区 = 60
    stLocal           : TIMESTRUCT; // 转换后的欧洲本地时间
    bIsDaylightSaving : BOOL; // TRUE = 当前夏令时（CEST）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：德国 / 法国工厂 HMI 把 PLC 内部用 UTC 记的时间戳转成欧洲本地时间
//
// 价值：无需 FB 实例 / ST_TimeZoneInformation 结构体，1 行调用拿本地时间 + DST 标志
//
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线观察 stLocal: 5 月 11 日为夏令时 → bIsDaylightSaving = TRUE，wHour = 12（UTC+2）
//   4. 改 wMonth := 1 重测 → bIsDaylightSaving = FALSE，wHour = 11（UTC+1）
// =============================================================================
stLocal := F_EuropeanLocalTime(UTC := stUTC, UTC_Offset := nTimeZoneOffset, bDaylightSavingTime => bIsDaylightSaving);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
