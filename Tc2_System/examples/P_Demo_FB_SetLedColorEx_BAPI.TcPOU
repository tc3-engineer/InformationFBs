<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SetLedColorEx_BAPI" Id="{3fca4fc3-047e-5206-85c5-638ec2b61e0f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SetLedColorEx_BAPI
VAR
    fbFB_SetLedColorEx_BAPI : FB_SetLedColorEx_BAPI; // FB_SetLedColorEx_BAPI 实例
    bSetLedReq              : BOOL; // 上升沿触发切灯
    nTargetLed              : USINT := 1; // 1 = U1 LED，2 = U2 LED
    eDesiredColor           : E_UsrLED_Color := eUsrLED_Green; // 目标颜色
    bLedSwitching           : BOOL; // 切换中
    bLedSwitchErr           : BOOL; // 切换错误
    nLastAdsError           : UDINT; // 错误码
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_System.FB_SetLedColorEx_BAPI 演示程序
// ============================================================
// 场景：CX5230 双 LED：U1 显示 PLC 运行态，U2 显示 SCADA 链路态。
// 价值：替代为两颗灯各写一份 ADS 命令。
// 验证：把 nTargetLed = 1 / eDesiredColor = eUsrLED_Red，触发后 U1 应变红；改 nTargetLed = 2 / eDesiredColor = eUsrLED_Blue，U2 应变蓝。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

fbFB_SetLedColorEx_BAPI(
    sNetID := '', nLedID := nTargetLed, eNewColor := eDesiredColor, bExecute := bSetLedReq, tTimeout := DEFAULT_ADS_TIMEOUT,
    bBusy => bLedSwitching, bError => bLedSwitchErr, nErrID => nLastAdsError
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
