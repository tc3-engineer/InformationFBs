  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.NT_GetTime Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_NT_GetTime" pouType="program">
        <interface>
          <localVars>
            <variable name="fbNT_GetTime">
              <type><derived name="NT_GetTime"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">NT_GetTime 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="stTimeOut">
              <type><derived name="TIMESTRUCT"/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：一次性读 Windows 时间。
// 价值：标准 ADS 调用。
// 验证：改 bRead := TRUE，观察 stTimeOut 装载时间且与桌面时钟一致。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbNT_GetTime(
    NETID := '', START := bRead, TMOUT := DEFAULT_ADS_TIMEOUT,
    TIMESTR =&gt; stTimeOut, BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
