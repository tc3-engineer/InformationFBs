<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_BIT_REC" Id="{52ff2fb4-2f97-546c-ac07-ed8c63e1f8f8}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_BIT_REC
VAR
    fbReceiveSwitch   : EIB_BIT_REC;
    stEibRec          : EIB_REC;
    stGroupSwitch     : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 1, NUMBER := 3);
    bLightOn          : BOOL;
    bGotNewSample     : BOOL;
    rTrigOnEvent      : R_TRIG;        // bLightOn 上升沿 = 按下一次
    nButtonPressCount : DINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_BIT_REC 演示程序
// ============================================================
// 场景：DPT 1.001 灯光开关：办公室按钮经组地址 1/1/3 控制灯。本 demo 接收开关命令，并按按钮上升沿计按键次数（用于使用统计）。
// 价值：KNX 1-bit 最简单的接收；XAE 调试时 1 行代码搞定按钮事件
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：按下 → `bLightOn = TRUE`，`bGotNewSample` 单周期高；放开后按钮再发 `bData = FALSE` → `bLightOn = FALSE`；`nButtonPressCount` 每按下一次加 1。
// ============================================================

fbReceiveSwitch(
    Group_Address := stGroupSwitch,
    strData_Rec   := stEibRec,
    bDataReceive  => bGotNewSample,
    bData         => bLightOn
);

// bLightOn 是电平保持；按下 TRUE 计一次按键
rTrigOnEvent(CLK := bLightOn);
IF rTrigOnEvent.Q THEN
    nButtonPressCount := nButtonPressCount + 1;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
