              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Tc3_EventLogger.FB_TcAlarm 实例</xhtml></documentation>
            </variable>
            <variable name="arg_eventClass">
              <type><derived name="GUID"/></type>
