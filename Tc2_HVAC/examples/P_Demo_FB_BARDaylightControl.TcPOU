<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BARDaylightControl" Id="{35e309a2-1a8d-5043-bb9c-cff84a8a6acd}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BARDaylightControl
VAR
    fb : FB_BARDaylightControl;                            // 被演示 FB 实例
    eDataSecurityType_in : E_HVACDataSecurityType ;
    uiLightCtrlMode_in : UINT := 0;
    bSwitch_in : BOOL := FALSE;
    bCentralOn_in : BOOL := FALSE;
    bCentralOff_in : BOOL := FALSE;
    uiBrightness_in : UINT := 0;
    uiSwitchOnValue_io : UINT := 0;
    uiSwitchOffOffset_io : UINT := 0;
    uiLightOnTime_io : UINT := 0;
    uiOnDelay_io : UINT := 0;
    uiOffDelay_io : UINT := 0;
    lrDimValue_out : LREAL;
    bOn_out : BOOL;
    uiRemainingOnDelay_out : UINT;
    uiRemainingOffDelay_out : UINT;
    uiPreOnValue_out : UINT;
    uiLightGain_out : UINT;
    uiSwitchOffValue_out : UINT;
    bControlActive_out : BOOL;
    bError_out : BOOL;
    udiErrorId_out : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_BARDaylightControl 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_BARDaylightControl.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    eDataSecurityType := eDataSecurityType_in,
    uiLightCtrlMode := uiLightCtrlMode_in,
    bSwitch := bSwitch_in,
    bCentralOn := bCentralOn_in,
    bCentralOff := bCentralOff_in,
    uiBrightness := uiBrightness_in,
    uiSwitchOnValue := uiSwitchOnValue_io,
    uiSwitchOffOffset := uiSwitchOffOffset_io,
    uiLightOnTime := uiLightOnTime_io,
    uiOnDelay := uiOnDelay_io,
    uiOffDelay := uiOffDelay_io,
    lrDimValue => lrDimValue_out,
    bOn => bOn_out,
    uiRemainingOnDelay => uiRemainingOnDelay_out,
    uiRemainingOffDelay => uiRemainingOffDelay_out,
    uiPreOnValue => uiPreOnValue_out,
    uiLightGain => uiLightGain_out,
    uiSwitchOffValue => uiSwitchOffValue_out,
    bControlActive => bControlActive_out,
    bError => bError_out,
    udiErrorId => udiErrorId_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
