  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_HEXCHRNIBBLE_TO_BYTE" pouType="program">
        <interface>
          <localVars>
            <variable name="sHexChar"><initialValue><simpleValue value="'F'"/></initialValue><type><string><length>1</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：要解码的 hex 字符</xhtml></documentation></variable>
            <variable name="nNibble"><type><BYTE/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">解码 nibble</xhtml></documentation></variable>
            <variable name="bDecode"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：手工解码 hex 配置串（如 `'AB'` → 0xAB 字节）；小量数据场景，避免引入 `HEXSTR_TO_DATA` 的完整 API。
// 价值：比 `HEXASCNIBBLE_TO_BYTE` 直观——字符常量直接传。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================

IF bDecode THEN
    nNibble := HEXCHRNIBBLE_TO_BYTE(chr := sHexChar);
    // 'F' -&gt; 15
    bDecode := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
