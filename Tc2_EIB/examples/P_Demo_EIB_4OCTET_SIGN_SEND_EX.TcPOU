<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_EIB_4OCTET_SIGN_SEND_EX" Id="{1980128e-c12f-52f6-b4e0-203a6be2fbff}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_EIB_4OCTET_SIGN_SEND_EX
VAR
    fbSendEnergyEx     : EIB_4OCTET_SIGN_SEND_EX;
    stEibRec           : EIB_REC;
    stGroup            : EIB_GROUP_ADDR := (MAIN := 1, SUB_MAIN := 4, NUMBER := 14);
    bSendStart         : BOOL;
    iWorkMode          : INT := 3;
    tCyclePeriod       : TIME := T#5S;
    tMinIntervalChange : TIME := T#500MS;
    data               : DINT := 0;
    bResponseToRead    : BOOL := TRUE;
    bSendBusy          : BOOL;
    bSendError         : BOOL;
    iLastErrID         : EIB_ERROR_CODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_EIB.EIB_4OCTET_SIGN_SEND_EX 演示程序
// ============================================================
// 场景：PLC 累计电能 OnChangePolling 模式发到组 1/4/14。
// 价值：周期心跳 + 即时变化 + 答查
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_EIB（References → Add library）
//   3. 编译 → 登录 → 运行；按下方在线写值步骤操作
// 验证：登录 `bSendStart := TRUE` → 周期 5 秒 1/4/14 出帧。
// ============================================================

fbSendEnergyEx(
    bStart         := bSendStart,
    iMode          := iWorkMode,
    CyclePolling   := tCyclePeriod,
    MinSendTime    := tMinIntervalChange,
    Group_Address  := stGroup,
    uiData         := data,
    str_Rec        := stEibRec,
    bEnableReadReq := bResponseToRead,
    bBusy          => bSendBusy,
    bError         => bSendError,
    iErrorID       => iLastErrID
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
