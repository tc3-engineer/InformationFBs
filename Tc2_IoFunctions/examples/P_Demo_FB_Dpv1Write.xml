<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_Dpv1Write Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_Dpv1Write" pouType="program">
        <interface>
          <localVars>
            <variable name="fbDpv1Write">
              <type><derived name="FB_Dpv1Write"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SINAMICS DPV1 写 FB</xhtml></documentation>
            </variable>
            <variable name="sProfibusMasterNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">主站 NetId</xhtml></documentation>
            </variable>
            <variable name="iSinamicsStation">
              <initialValue><simpleValue value="5"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">站号</xhtml></documentation>
            </variable>
            <variable name="iDriveObjectId">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive A</xhtml></documentation>
            </variable>
            <variable name="aDpv1ReqBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求缓冲</xhtml></documentation>
            </variable>
            <variable name="aDpv1ResBuffer">
              <type><array><dimension lower="1" upper="240"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应缓冲</xhtml></documentation>
            </variable>
            <variable name="iReqBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求缓冲长度</xhtml></documentation>
            </variable>
            <variable name="iResBufLen">
              <initialValue><simpleValue value="240"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应缓冲长度</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ReqParams">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ParamAddrEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数清单</xhtml></documentation>
            </variable>
            <variable name="arrDpv1ValueHdr">
              <type><array><dimension lower="1" upper="39"/><baseType><derived name="ST_Dpv1ValueHeaderEx"/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">值清单（写）+ 状态（解析后）</xhtml></documentation>
            </variable>
            <variable name="iNumParamsToWrite">
              <initialValue><simpleValue value="2"/></initialValue>
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">参数数</xhtml></documentation>
            </variable>
            <variable name="nWriteReqPkgLen">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求长度</xhtml></documentation>
            </variable>
            <variable name="nWriteResPkgLen">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">响应长度</xhtml></documentation>
            </variable>
            <variable name="bBuildWriteReqPkg">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：构造写请求</xhtml></documentation>
            </variable>
            <variable name="bDpv1WriteReq">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：发送</xhtml></documentation>
            </variable>
            <variable name="bSplitWriteResPkg">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">触发：解析</xhtml></documentation>
            </variable>
            <variable name="tDpv1WriteTimeout">
              <initialValue><simpleValue value="T#10S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="bDpv1WriteBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="iDpv1WriteRequestRef">
              <type><USINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">请求引用号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：SINAMICS S120 上电下发 2 个驱动参数。
// 价值：参数纳入 PLC 版本控制；现场无需 Starter 软件。
// 验证：登录后准备好 arrDpv1ReqParams + arrDpv1ValueHdr；bBuildWriteReqPkg → 帧构造完；bDpv1WriteReq := TRUE → bDpv1WriteBusy 短暂 TRUE → 落回后 bSplitWriteResPkg → 解析 → arrDpv1ValueHdr[k].nError 全 0 表示成功。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 步骤 1：构造写请求帧
IF bBuildWriteReqPkg THEN
    nWriteReqPkgLen := F_CreateDpv1WriteReqPkg(
        pDpv1ReqData        := ADR(aDpv1ReqBuffer),
        iNumOfParams        := iNumParamsToWrite,
        iDriveId            := iDriveObjectId,
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bBuildWriteReqPkg := FALSE;
END_IF;

// 步骤 2：发送
fbDpv1Write(
    bExecute          := bDpv1WriteReq,
    aNetId            := sProfibusMasterNetId,
    iProfibusSlaveAdr := iSinamicsStation,
    iDriveId          := iDriveObjectId,
    pDpv1ReqData      := ADR(aDpv1ReqBuffer),
    iDpv1ReqDataLen   := iReqBufLen,
    pDpv1ResData      := ADR(aDpv1ResBuffer),
    iDpv1ResDataLen   := iResBufLen,
    tTmOut            := tDpv1WriteTimeout,
    iRequestRef       =&gt; iDpv1WriteRequestRef
);

bDpv1WriteBusy := fbDpv1Write.bBusy;

// 步骤 3：bBusy 落回后解析响应
IF bSplitWriteResPkg THEN
    nWriteResPkgLen := F_SplitDpv1WriteResPkg(
        pDpv1ResData        := ADR(aDpv1ResBuffer),
        stDpv1Parameter     := arrDpv1ReqParams,
        stDpv1ValueHeaderEx := arrDpv1ValueHdr
    );
    bSplitWriteResPkg := FALSE;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
