<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.ADSREAD Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ADSREAD" pouType="program">
        <interface>
          <localVars>
            <variable name="fbADSREAD">
              <type><derived name="ADSREAD"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADSREAD 实例</xhtml></documentation>
            </variable>
            <variable name="bReadAxisErrReq">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线上升沿触发</xhtml></documentation>
            </variable>
            <variable name="dwNcAxisError">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读出的 NC 轴 1 错误码</xhtml></documentation>
            </variable>
            <variable name="bAdsReading">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">正在读</xhtml></documentation>
            </variable>
            <variable name="bAdsReadErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误</xhtml></documentation>
            </variable>
            <variable name="nLastAdsError">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误码</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_System.ADSREAD 演示程序
// ============================================================
// 场景：周期读 NC 轴 1 错误码推到 HMI 做轴诊断。
// 价值：替代 PDO 映射；动态采样无需改硬件配置。
// 验证：登录后 bReadAxisErrReq := TRUE，bAdsReading 一闪后 dwNcAxisError 装入轴 1 当前错误（正常态 = 0）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』指引在线写值观察
// ============================================================

fbADSREAD(
    NETID := '', PORT := 501, IDXGRP := 16#00004006, IDXOFFS := 1, LEN := 4, DESTADDR := ADR(dwNcAxisError), READ := bReadAxisErrReq, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY =&gt; bAdsReading, ERR =&gt; bAdsReadErr, ERRID =&gt; nLastAdsError
);

</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
