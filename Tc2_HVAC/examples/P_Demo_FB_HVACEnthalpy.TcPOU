<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_HVACEnthalpy" Id="{13ead897-ee10-5b47-a883-9ac02f4f268f}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_HVACEnthalpy
VAR
    fb : FB_HVACEnthalpy;                            // 被演示 FB 实例
    rTemperature_in : REAL := 0.0;
    rRelativeHumidity_in : REAL := 0.0;
    rBarometricPressure_in : REAL := 0.0;
    rDewPoint_out : REAL;
    rEnthalpy_out : REAL;
    rAbsoluteHumidity_out : REAL;
    rRho_out : REAL;
    rYpsilon_out : REAL;
    bInvalidParameter_out : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// Tc2_HVAC.FB_HVACEnthalpy 演示程序
// ============================================================================
// 场景：把本 FB 实例化到一个 PLC 程序里，每周期单次调用；按需要把 VAR_INPUT 与
//       VAR_IN_OUT 接到工程信号；VAR_OUTPUT 写入对应监视变量。
// 价值：使用本 FB 比手写状态机 / 控制算法节省大量代码；与 Tc2_HVAC 体系内其它 FB
//       直接对接，命名 / 持久化 / 模式仲裁等约定一致。具体语义见 FB_HVACEnthalpy.md 主文档。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_HVAC（References → Add library）
//   3. 编译 → 登录 → 运行
//   4. 在线写各 *_in 输入信号触发 FB；在线 monitor *_out 引脚观察状态
// ============================================================================

fb(
    rTemperature := rTemperature_in,
    rRelativeHumidity := rRelativeHumidity_in,
    rBarometricPressure := rBarometricPressure_in,
    rDewPoint => rDewPoint_out,
    rEnthalpy => rEnthalpy_out,
    rAbsoluteHumidity => rAbsoluteHumidity_out,
    rRho => rRho_out,
    rYpsilon => rYpsilon_out,
    bInvalidParameter => bInvalidParameter_out
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
