  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_CHAR_TO_WCHAR" pouType="program">
        <interface>
          <localVars>
            <variable name="sTextIn"><initialValue><simpleValue value="'Y'"/></initialValue><type><string><length>1</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">输入单字符 ASCII；在线写值，如 'Y'</xhtml></documentation></variable>
            <variable name="wOut"><type><wstring><length>1</length></wstring></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换得到的 WSTRING(1)</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：HMI 把操作员输入的 ASCII 控制字符（如 'Y' / 'N' / 'Q'）转换为 Unicode 送到 OPC UA 或 ADS notification 接口。
// 价值：不用本函数则需手写位扩展（高字节补 0）+ null 终结，3 行代码；本函数 1 行解决，且 Beckhoff 保证 codepage 处理一致。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
wOut := CHAR_TO_WCHAR(sTextIn);</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
