  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_F_TRIG" pouType="program">
        <interface>
          <localVars>
            <variable name="fbF_TRIG">
              <type><derived name="F_TRIG"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Trigger 实例</xhtml></documentation>
            </variable>
            <variable name="bButton">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">按钮输入（按下时 TRUE）</xhtml></documentation>
            </variable>
            <variable name="bRelease">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">按钮释放沿（单周期脉冲）</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Standard.F_TRIG 演示程序
// ============================================================
// 场景：按钮释放（下降沿）时触发一次动作
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译并登录目标
//   1. bButton := TRUE 保持任意时长 → bRelease 始终 FALSE
//   2. bButton := FALSE → bRelease 在该周期变 TRUE，下一周期回 FALSE
// ============================================================

fbF_TRIG(
    CLK := bButton,
    Q   =&gt; bRelease
);
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
