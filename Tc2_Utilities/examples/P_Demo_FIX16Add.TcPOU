<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FIX16Add" Id="{d0c1e28d-bd21-5467-98fa-ba042d7b647a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FIX16Add
VAR
    fp8A     : T_FIX16;
    fp8B     : T_FIX16;
    fp8Sum   : T_FIX16;
    lrResult : LREAL;
    bAdd     : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.FIX16Add 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：电机 PID 算法里两个相同分辨率的误差项做累加。
// 价值：替代手写'分辨率对齐 + INT 加法 + 越界检查'；本函数封装了对齐步骤。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

// 与 PDF 示例对齐：0.5 + (-0.25) = 0.25（同为 Q8 编码）
fp8A := LREAL_TO_FIX16(0.5,  8);
fp8B := LREAL_TO_FIX16(-0.25, 8);
IF bAdd THEN
    fp8Sum   := FIX16Add(fp8A, fp8B);
    lrResult := FIX16_TO_LREAL(fp8Sum);   // 应为 0.25
    bAdd := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
