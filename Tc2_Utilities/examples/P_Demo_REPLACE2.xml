<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.REPLACE2 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_REPLACE2" pouType="program">
        <interface>
          <localVars>
            <variable name="sTpl"><initialValue><simpleValue value="'2026-05-12T08:00:?? UTC'"/></initialValue><type><string><length>64</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：模板含占位 '?'</xhtml></documentation></variable>
            <variable name="sFill"><initialValue><simpleValue value="'42'"/></initialValue><type><string><length>8</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际秒数字符串</xhtml></documentation></variable>
            <variable name="sOut"><type><string><length>64</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">替换结果</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">成功</xhtml></documentation></variable>
            <variable name="bFill"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：时间字符串规范化：把固定位置的 `'?'` 替换为实际秒数（如 RFID 信号触发前秒数未知）。
// 价值：替代 `LEFT` + `CONCAT2` + `MID` + `CONCAT2`；本函数 1 调用。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
// 把第 18 位起 2 字符 '??' 替换为实际秒数
IF bFill THEN
    bOk := REPLACE2(pSrcString    := ADR(sTpl),
                    pInsertString := ADR(sFill),
                    pDstString    := ADR(sOut),
                    nDstSize      := SIZEOF(sOut),
                    nLen          := 2,    // 替换 2 字符
                    nPos          := 18);  // 从第 18 位开始
    bFill := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
