<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_ScopeServerControl" Id="{bf58cdf1-3bd6-58f4-b093-c42a74e59af4}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_ScopeServerControl
VAR
    fbFB_ScopeServerControl : FB_ScopeServerControl; // FB_ScopeServerControl 实例
    sNetId                  : T_AmsNetId;
    eReqState               : E_ScopeServerState := SCOPE_SERVER_IDLE;
    sConfigFile             : STRING(80);
    sSaveFile               : STRING(80);
    tTimeout                : TIME := DEFAULT_ADS_TIMEOUT;
    bExternalTriggerEvent   : BOOL := FALSE;
    bBusy                   : BOOL;
    bDone                   : BOOL;
    bError                  : BOOL;
    nErrorId                : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：异常时录波。
// 价值：自动化诊断。
// 验证：触发 Start → 几秒 Stop → Scope 目录里有新波形文件。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_ScopeServerControl(
    sNetId := sNetId,
    eReqState := eReqState,
    sConfigFile := sConfigFile,
    sSaveFile := sSaveFile,
    tTimeout := tTimeout,
    bExternalTriggerEvent := bExternalTriggerEvent,
    bBusy => bBusy,
    bDone => bDone,
    bError => bError,
    nErrorId => nErrorId
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
