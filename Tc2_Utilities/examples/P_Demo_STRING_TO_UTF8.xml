<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-12T00:00:00"/>
  <contentHeader name="Tc2_Utilities.STRING_TO_UTF8 Demo" modificationDateTime="2026-05-12T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_STRING_TO_UTF8" pouType="program">
        <interface>
          <localVars>
            <variable name="sLocal"><initialValue><simpleValue value="'Hühner alarm'"/></initialValue><type><string><length>128</length></string></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工业语义：本地 Codepage STRING（含 Umlaut）</xhtml></documentation></variable>
            <variable name="aUtf8"><type><array><dimension lower="0" upper="255"/><baseType><BYTE/></baseType></array></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">UTF-8 输出缓冲</xhtml></documentation></variable>
            <variable name="bOk"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">转换成功</xhtml></documentation></variable>
            <variable name="bConvert"><type><BOOL/></type><documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线触发</xhtml></documentation></variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把 PLC 报警消息（STRING 区域码）发送到云端 MQTT broker——broker 要求 UTF-8 payload。
// 价值：替代手写 Codepage→UTF-8 编码表；统一上云接口编码。
// 验证步骤：
//   1. 引用 Tc2_Utilities
//   2. 编译 + 登录 + 运行
//   3. 在线写触发位 TRUE，monitor 输出变量
// =============================================================================
IF bConvert THEN
    bOk := STRING_TO_UTF8(pDstUTF8   := ADR(aUtf8),
                          pSrcSTRING := ADR(sLocal),
                          nDstSize   := SIZEOF(aUtf8));
    bConvert := FALSE;
END_IF;</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
