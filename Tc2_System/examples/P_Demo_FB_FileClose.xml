<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-20T00:00:00"/>
  <contentHeader name="Tc2_System.FB_FileClose Demo" modificationDateTime="2026-05-20T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_FileClose" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFileClose">
              <type><derived name="FB_FileClose"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_FileClose 实例</xhtml></documentation>
            </variable>
            <variable name="hOpenedFile">
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">之前 FB_FileOpen 得到的句柄</xhtml></documentation>
            </variable>
            <variable name="bCloseRequest">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写 TRUE 触发一次关闭</xhtml></documentation>
            </variable>
            <variable name="bCloseDone">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 关闭成功</xhtml></documentation>
            </variable>
            <variable name="bCloseError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = 关闭失败</xhtml></documentation>
            </variable>
            <variable name="nErrIdLast">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 错误号</xhtml></documentation>
            </variable>
            <variable name="bBusyMon">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 通讯中</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：把之前 FB_FileOpen 拿到的 hFile 安全关闭，把缓冲区数据强制刷盘。
// 价值：不用本 FB 就要自己拼 ADS Write 0x10004 命令并跟状态。
// 验证：在线置 bCloseRequest := TRUE → 观察 bBusy 跳起后落下 → hOpenedFile 在业务侧被清零；故意传一个 0 句柄 → bCloseError = TRUE。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用：关闭文件并把本地句柄清零
fbFileClose(
    sNetId   := '',
    hFile    := hOpenedFile,
    bExecute := bCloseRequest,
    tTimeout := T#10S,
    bBusy    =&gt; bBusyMon,
    bError   =&gt; bCloseError,
    nErrId   =&gt; nErrIdLast
);

// 业务侧：busy 落沿且无错则视为关闭成功，清掉本地句柄
bCloseDone := (NOT bBusyMon) AND (NOT bCloseError) AND bCloseRequest;
IF bCloseDone THEN
    hOpenedFile := 0;
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
