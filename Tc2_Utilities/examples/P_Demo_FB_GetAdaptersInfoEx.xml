  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.FB_GetAdaptersInfoEx Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_GetAdaptersInfoEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFB_GetAdaptersInfoEx">
              <type><derived name="FB_GetAdaptersInfoEx"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">FB_GetAdaptersInfoEx 实例</xhtml></documentation>
            </variable>
            <variable name="bRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="aAdapters">
              <type><array><dimension lower="0" upper="15"/><baseType><derived name="ST_AdapterInfoEx"/></baseType></array></type>
            </variable>
            <variable name="nCount">
              <type><UDINT/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读所有网卡含 IPv6 信息。
// 价值：支持 IPv6。
// 验证：同 FB_GetAdaptersInfo，多看 IPv6 字段。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbFB_GetAdaptersInfoEx(
    bExecute := bRead,
    tTimeout := DEFAULT_ADS_TIMEOUT,
    pAddr := ADR(aAdapters),
    cbBuffLen := SIZEOF(aAdapters),
    nAdapters =&gt; nCount,
    bBusy =&gt; bBusy_,
    bErr =&gt; bErrFlag,
    nErrId =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
