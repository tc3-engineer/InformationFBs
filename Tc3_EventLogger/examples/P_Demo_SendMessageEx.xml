<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.SendMessageEx Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_SendMessageEx" pouType="program">
        <interface>
          <localVars>
            <variable name="fbLogger">
              <type><derived name="FB_TcEventLogger"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">EventLogger 实例</xhtml></documentation>
            </variable>
            <variable name="stEventEntry">
              <type><derived name="TcEventEntry"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">在线写入事件定义</xhtml></documentation>
            </variable>
            <variable name="bDoSend">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="bDoSendPrev">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">边沿检测</xhtml></documentation>
            </variable>
            <variable name="hr">
              <type><derived name="HRESULT"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回值监视</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：按结构体发送一条 message
// 价值：结构体接口便于事件清单批量处理
// 验证：登录后写 bDoSend := TRUE，HMI EventLogger 出现一条对应 message
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

IF bDoSend AND NOT bDoSendPrev THEN
    hr := fbLogger.SendMessageEx(
        stEventEntry := stEventEntry,
        ipSourceInfo := 0,
        nTimeStamp := 0,
        ipArguments := 0);
END_IF;
bDoSendPrev := bDoSend;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
