<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T00:00:00"/>
  <contentHeader name="Tc2_Utilities.TC_Restart Demo" modificationDateTime="2026-05-11T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_TC_Restart" pouType="program">
        <interface>
          <localVars>
            <variable name="fbTC_Restart">
              <type><derived name="TC_Restart"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">TC_Restart 实例</xhtml></documentation>
            </variable>
            <variable name="bExec">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
            </variable>
            <variable name="bBusy_">
              <type><BOOL/></type>
            </variable>
            <variable name="bErrFlag">
              <type><BOOL/></type>
            </variable>
            <variable name="nErrCode">
              <type><UDINT/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：升级后重启 SystemService。
// 价值：比整机快。
// 验证：触发后目标机器 SystemService 重启（XAE 中能观察到）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

fbTC_Restart(
    NETID := '', START := bExec, TMOUT := DEFAULT_ADS_TIMEOUT,
    BUSY =&gt; bBusy_, ERR =&gt; bErrFlag, ERRID =&gt; nErrCode
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
