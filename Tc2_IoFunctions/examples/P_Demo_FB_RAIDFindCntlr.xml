<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.FB_RAIDFindCntlr Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_RAIDFindCntlr" pouType="program">
        <interface>
          <localVars>
            <variable name="fbFindRaidCtlr">
              <type><derived name="FB_RAIDFindCntlr"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">RAID 控制器枚举 FB（仅一次）</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="bDoFindRaidCtlrs">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发（仅一次！）</xhtml></documentation>
            </variable>
            <variable name="tRaidQueryTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">ADS 超时</xhtml></documentation>
            </variable>
            <variable name="stFoundRaidCtlrs">
              <type><derived name="ST_RAIDCntlrFound"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">查得控制器列表</xhtml></documentation>
            </variable>
            <variable name="nRaidBytesRead">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">返回字节数</xhtml></documentation>
            </variable>
            <variable name="bRaidFindBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bRaidFindError">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nRaidFindErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：工业服务器上电诊断：调一次拿到所有 RAID 控制器的 ID 后存起来，给后续 FB_RAIDGetInfo / FB_RAIDGetStatus 用。
// 价值：RAID 健康状态可程序化监控。
// 验证：登录后写 bDoFindRaidCtlrs := TRUE → bRaidFindBusy 短暂 TRUE → 回 FALSE 后 stFoundRaidCtlrs 含数量与 ID；**只能调一次**，不要放在循环里。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 警告：本 FB 不能循环调用，会严重影响性能！
// 业务侧应该确保 bDoFindRaidCtlrs 只在上电时给一次上升沿。
fbFindRaidCtlr(
    sNETID           := sLocalNetId,
    bWrtRd           := bDoFindRaidCtlrs,
    tTimeOut         := tRaidQueryTimeout,
    stRAIDCntlrFound =&gt; stFoundRaidCtlrs,
    nBytesRead       =&gt; nRaidBytesRead,
    bBusy            =&gt; bRaidFindBusy,
    bError           =&gt; bRaidFindError,
    nErrorID         =&gt; nRaidFindErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
