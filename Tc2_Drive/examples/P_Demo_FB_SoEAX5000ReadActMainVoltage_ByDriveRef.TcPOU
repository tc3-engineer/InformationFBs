<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_SoEAX5000ReadActMainVoltage_ByDriveRef" Id="{4fca023a-e07e-503d-84a6-12847f6262b6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_SoEAX5000ReadActMainVoltage_ByDriveRef
VAR
    fbReadVoltage : FB_SoEAX5000ReadActMainVoltage_ByDriveRef; // 读 AX5000 主电源电压 FB 实例
    rtrigRead     : R_TRIG; // 把 bReadReq 转成单次上升沿
    stPlcDriveRef : ST_PlcDriveRef; // 链接到 System Manager 的驱动器过程映像
    stDriveRef    : ST_DriveRef; // 解析出的驱动器引用
    bInit         : BOOL := TRUE; // 等过程映像就绪再放行
    bReadReq      : BOOL := FALSE; // 在线置 TRUE 读一次电压
    bReadBusy     : BOOL; // 读取执行中
    bReadError    : BOOL; // 读取出错
    iAdsErr       : UINT; // ADS 错误码
    iSercosErr    : UINT; // Sercos 错误码
    dwAttr        : DWORD; // P-0-0200 参数属性字
    fMainVoltage  : REAL; // 主电源峰值电压(V)
    bUnderVoltage : BOOL; // 简单欠压判断结果
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：监视 AX5000 主供电是否正常。欠压会导致力矩不足/报警；在掉电检测逻辑里
//       读实时母线电压，作为是否触发紧急停机/数据保存的判据。
//
// 价值：把"读 P-0-0200 + 解析 REAL + 异步状态机 + 超时"封装成一次上升沿调用，
//       业务侧只给触发信号即可拿到电压，无需手写 SoE 读时序。
//
// 验证步骤：
//   1. 引用 Tc2_Drive 库
//   2. System Manager 里把某 AX5000 SoE 从站过程映像链接到 stPlcDriveRef
//   3. 编译、登录、运行；观察 bInit 在过程映像就绪后自动变 FALSE
//   4. 在线把 bReadReq := TRUE
//      → bReadBusy 短暂为 TRUE，落下后 bReadError 应为 FALSE
//      → fMainVoltage 显示当前峰值电压（如 230V RMS 供电时约 325V）
//   5. 注意：fMainVoltage 是峰值不是 RMS，欠压阈值要按峰值设
//   6. 若 bReadError = TRUE，读 iAdsErr / iSercosErr 定位（电压值此时无效）
// =============================================================================

// 初始化驱动器引用
IF bInit THEN
    stDriveRef.sNetId     := F_CreateAmsNetId(stPlcDriveRef.aNetId);
    stDriveRef.nSlaveAddr := stPlcDriveRef.nSlaveAddr;
    stDriveRef.nDriveNo   := stPlcDriveRef.nDriveNo;
    stDriveRef.nDriveType := stPlcDriveRef.nDriveType;
    IF (stDriveRef.sNetId <> '') AND (stDriveRef.nSlaveAddr <> 0) THEN
        bInit := FALSE;
    END_IF;
END_IF;

rtrigRead(CLK := bReadReq);

// 单次调用形式：所有 VAR_INPUT 显式赋值
fbReadVoltage(
    stDriveRef := stDriveRef,
    bExecute   := rtrigRead.Q AND NOT bInit,
    tTimeout   := DEFAULT_ADS_TIMEOUT,
    bBusy              => bReadBusy,
    bError             => bReadError,
    iAdsErrId          => iAdsErr,
    iSercosErrId       => iSercosErr,
    dwAttribute        => dwAttr,
    fActualMainVoltage => fMainVoltage
);

// 读取成功后才做欠压判断（峰值 < 250V 视为欠压示例阈值）
IF NOT bReadBusy AND NOT bReadError AND NOT bInit THEN
    bUnderVoltage := fMainVoltage < 250.0;
    bReadReq := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
