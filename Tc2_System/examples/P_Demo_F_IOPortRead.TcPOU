<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_IOPortRead" Id="{aec904ee-2802-5b1b-9dd0-96756150e90b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_IOPortRead
VAR
    nLptPortAddress : UDINT := 16#378; // LPT1 默认 I/O 端口地址
    nPortValue      : DWORD; // 读到的端口值
    bReadRequest    : BOOL; // 在线写 TRUE 触发一次读取
    rtRead          : R_TRIG; // 上升沿检测
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：读取 LPT 端口 0x378 的当前 8 位输入状态做硬件诊断（无 EtherCAT 终端时的应急通道）。
// 价值：替代写 Windows 驱动 inp/outp，PLC 一行调用直读硬件端口。
// 验证：bReadRequest := TRUE 一次 → 观察 nPortValue 反映 LPT 引脚状态；改变并口外部输入再触发 → nPortValue 改变。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 上升沿检测，避免每周期读耗 CPU
rtRead(CLK := bReadRequest);
IF rtRead.Q THEN
    nPortValue := F_IOPortRead(
        nAddr := nLptPortAddress,
        eSize := IOAS_BYTE
    );
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
