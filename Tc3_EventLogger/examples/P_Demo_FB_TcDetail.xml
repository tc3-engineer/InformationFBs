<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.FB_TcDetail Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_FB_TcDetail" pouType="program">
        <interface>
          <localVars>
            <variable name="fbReq">
              <type><derived name="FB_RequestEventClassDetails"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上游请求 FB</xhtml></documentation>
            </variable>
            <variable name="fbDetail">
              <type><derived name="FB_TcDetail"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">承载详情子项</xhtml></documentation>
            </variable>
            <variable name="sName">
              <type><string><length>80</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">name 字段</xhtml></documentation>
            </variable>
            <variable name="sText">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">text 字段</xhtml></documentation>
            </variable>
            <variable name="sComment">
              <type><string><length>255</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">comment 字段</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：循环读取事件详情列表的所有项
// 价值：结构化访问详情字段
// 验证：先有完成的 FB_RequestEventClassDetails；调 Get 填充本 FB；读各字段
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

fbReq.Get(nIndex := 0, fbResult := fbDetail);
fbDetail.GetName(sResult := sName);
fbDetail.GetText(sResult := sText);
fbDetail.GetComment(sResult := sComment);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
