<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_DALIV2ProgramShortAddress" Id="{9a31f355-145b-5c1f-9e14-0ed30ff324a1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_DALIV2ProgramShortAddress
VAR
    fbFB_DALIV2ProgramShortAddress        : FB_DALIV2ProgramShortAddress;
    stCommandBuffer : ST_DALIV2CommandBuffer;

    bTrigger        : BOOL;
    nLampAddr        : BYTE := 0;

    nNewShortAddr    : BYTE := 0;

    bBusy           : BOOL;
    bErr            : BOOL;
    nErrId          : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：寻址过程中给 SELECT 灯写短地址 0。
//
// 价值：底层寻址命令。
//
// 验证步骤：
//   1. 必须先完成 Initialise + Randomise + SearchAddr 序列把目标灯 SELECT 上。
//   2. 在线 bTrigger 一次上升沿；等 bBusy 回 FALSE。
//   3. 用 P_Demo_FB_DALIV2VerifyShortAddress 应能用 short addr 0 验证到该灯。
// =============================================================================
fbFB_DALIV2ProgramShortAddress(
    bStart           := bTrigger,
    nAddr            := nLampAddr,
    eAddrType        := eDALIV2AddrTypeShort,
    eCommandPriority := eDALIV2CommandPriorityMiddle,
    nShortAddress    := nNewShortAddr,
    stCommandBuffer  := stCommandBuffer
);

bBusy  := fbFB_DALIV2ProgramShortAddress.bBusy;
bErr   := fbFB_DALIV2ProgramShortAddress.bError;
nErrId := fbFB_DALIV2ProgramShortAddress.nErrorId;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
