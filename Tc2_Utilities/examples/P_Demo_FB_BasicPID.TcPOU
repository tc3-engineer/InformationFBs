<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_FB_BasicPID" Id="{d3125941-f083-5c24-9407-5d43ac7689c5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_FB_BasicPID
VAR
    fbFB_BasicPID  : FB_BasicPID; // FB_BasicPID 实例
    fSetpointValue : LREAL;
    fActualValue   : LREAL;
    bReset         : BOOL;
    fCtrlCycleTime : LREAL;
    fKp            : LREAL;
    fTn            : LREAL;
    fTv            : LREAL;
    fTd            : LREAL;
    fCtrlOutput    : LREAL;
    nErrorStatus   : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：水箱温度闭环控制。
// 价值：带 anti-windup。
// 验证：设置 setpoint，monitor 输出在合理范围；改 setpoint 输出跟随。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_Utilities（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次完整调用形式（所有 VAR_INPUT 显式赋值）
fbFB_BasicPID(
    fSetpointValue := fSetpointValue,
    fActualValue := fActualValue,
    bReset := bReset,
    fCtrlCycleTime := fCtrlCycleTime,
    fKp := fKp,
    fTn := fTn,
    fTv := fTv,
    fTd := fTd,
    fCtrlOutput => fCtrlOutput,
    nErrorStatus => nErrorStatus
);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
