<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_GETTASKTIME" Id="{0c6627e7-ab87-51f7-8c6f-3104375f303e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_GETTASKTIME
VAR
    fbGetTaskTime  : GETTASKTIME; // 废弃 FB 实例（仅演示）
    nTaskTimeLo    : UDINT; // 低 32 位
    nTaskTimeHi    : UDINT; // 高 32 位
    ulTaskStartOld : ULINT; // 拼装的 64 位任务启动时刻
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：对照演示：调用废弃 GETTASKTIME 与现代写法，两者拼出的任务启动时间戳应一致。
// 价值：提醒切换到现代写法。
// 验证：观察 ulTaskStartOld 与 ulTaskStartNew 应当一致。
// 验证步骤：
//   1. 右键 PLC 项目下 POUs 文件夹 → Add → Existing Item → 选本 .TcPOU 文件
//   2. 引用 Tc2_System（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 废弃方式
fbGetTaskTime(
    timeLoDW => nTaskTimeLo,
    timeHiDW => nTaskTimeHi
);
ulTaskStartOld := SHL(TO_ULINT(nTaskTimeHi), 32) OR TO_ULINT(nTaskTimeLo);

// 现代写法：ulTaskStartNew := F_GetTaskTime();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
