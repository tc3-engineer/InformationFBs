<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-21T00:00:00"/>
  <contentHeader name="Tc2_IoFunctions.IOF_SER_IDN_Read Demo" modificationDateTime="2026-05-21T00:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_IOF_SER_IDN_Read" pouType="program">
        <interface>
          <localVars>
            <variable name="fbSercosIdnRead">
              <type><derived name="IOF_SER_IDN_Read"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">SERCOS IDN 读 FB</xhtml></documentation>
            </variable>
            <variable name="sLocalNetId">
              <initialValue><simpleValue value="''"/></initialValue>
              <type><derived name="T_AmsNetId"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">本机</xhtml></documentation>
            </variable>
            <variable name="nIdnToRead">
              <initialValue><simpleValue value="100"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">要读的 IDN (S-100)</xhtml></documentation>
            </variable>
            <variable name="bStartIdnRead">
              <initialValue><simpleValue value="FALSE"/></initialValue>
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">上升沿触发</xhtml></documentation>
            </variable>
            <variable name="nDrivePort">
              <initialValue><simpleValue value="1"/></initialValue>
              <type><UINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">drive port 号</xhtml></documentation>
            </variable>
            <variable name="nReadMode">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><DINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">0=Value 2=Name 3=Attr 4=Unit 5=Min 6=Max</xhtml></documentation>
            </variable>
            <variable name="nCachedAttrib">
              <initialValue><simpleValue value="0"/></initialValue>
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">已知属性（0 = 让 FB 自动读）</xhtml></documentation>
            </variable>
            <variable name="aReadBuffer">
              <type><array><dimension lower="1" upper="64"/><baseType><BYTE/></baseType></array></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">读取缓冲 64 字节</xhtml></documentation>
            </variable>
            <variable name="cbReadBufferLen">
              <initialValue><simpleValue value="64"/></initialValue>
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">缓冲长度</xhtml></documentation>
            </variable>
            <variable name="tIdnReadTimeout">
              <initialValue><simpleValue value="T#5S"/></initialValue>
              <type><TIME/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">超时</xhtml></documentation>
            </variable>
            <variable name="cbReadbackLen">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">实际读到字节数</xhtml></documentation>
            </variable>
            <variable name="nReadAttribOut">
              <type><DWORD/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">属性返回（可缓存）</xhtml></documentation>
            </variable>
            <variable name="stReadAttribDecoded">
              <type><derived name="ST_SercosParamAttrib"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">属性字段分解</xhtml></documentation>
            </variable>
            <variable name="bIdnReadBusy">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">工作中</xhtml></documentation>
            </variable>
            <variable name="bIdnReadErr">
              <type><BOOL/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">出错</xhtml></documentation>
            </variable>
            <variable name="nIdnReadErrId">
              <type><UDINT/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">错误号</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：SERCOS drive 1（port = 1）调试：读 IDN-100（位置环增益）。
// 价值：把 IDN 访问封装为 PLC 调用，免去 SERCANS 工具。
// 验证：登录后 sLocalNetId := ""、nDrivePort := 1、nIdnToRead := 100、bStartIdnRead := TRUE → bIdnReadBusy 短暂 TRUE → 回 FALSE 后 cbReadbackLen 显示实际字节数、aReadBuffer[1..4] 含读到的 IDN-100 值（按 DINT 解释）。
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc2_IoFunctions（References → Add library）
//   3. 编译 → 登录 → 运行；按上方『验证』行的指示在线写值观察
// =============================================================================

// 单次调用形式；多次读同 drive 时把 nReadAttribOut 缓存给下次的 nCachedAttrib 提速
fbSercosIdnRead(
    sNetId     := sLocalNetId,
    nIDN       := nIdnToRead,
    bExecute   := bStartIdnRead,
    nPort      := nDrivePort,
    nMode      := nReadMode,
    nAttrib    := nCachedAttrib,
    cbLen      := cbReadBufferLen,
    dwDestAddr := ADR(aReadBuffer),
    tTimeout   := tIdnReadTimeout,
    cbRead     =&gt; cbReadbackLen,
    nAttribRd  =&gt; nReadAttribOut,
    sAttrib    =&gt; stReadAttribDecoded,
    bBusy      =&gt; bIdnReadBusy,
    bError     =&gt; bIdnReadErr,
    nErrId     =&gt; nIdnReadErrId
);
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
