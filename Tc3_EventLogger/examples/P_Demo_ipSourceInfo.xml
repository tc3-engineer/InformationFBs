<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200">
  <fileHeader companyName="tc3-libraries-kb" productName="TwinCAT" productVersion="3.1" creationDateTime="2026-05-11T01:00:00"/>
  <contentHeader name="Tc3_EventLogger.ipSourceInfo Demo" modificationDateTime="2026-05-11T01:00:00">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_ipSourceInfo" pouType="program">
        <interface>
          <localVars>
            <variable name="fbAlarm">
              <type><derived name="FB_TcAlarm"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">alarm 实例（已 Create）</xhtml></documentation>
            </variable>
            <variable name="ipSrc">
              <type><derived name="I_TcSourceInfo"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">源信息接口</xhtml></documentation>
            </variable>
            <variable name="sSourceName">
              <type><string><length>80</length></string></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">拿到的 SourceName</xhtml></documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST><xhtml xmlns="http://www.w3.org/1999/xhtml">// =============================================================================
// 场景：读取 alarm 的源信息用于日志归档
// 价值：一次调用拿到 SourceInfo 接口供后续读 SourceName/SourceID
// 验证：登录后 monitor ipSrc，应能拿到非 0 接口；调用 ipSrc 上的 getter 能读出 SourceName 字符串
// 验证步骤：
//   1. 右键 PLC 项目 → Import PLCopenXML → 选本文件
//   2. 引用 Tc3_EventLogger（System → References → Add library）
//   3. 编译 → 登录 → 运行；按 verify 注释里给出的在线写值操作
// =============================================================================

ipSrc := fbAlarm.ipSourceInfo;
IF ipSrc &amp;lt;&amp;gt; 0 THEN
    sSourceName := ipSrc.sSourceName;     // I_TcSourceInfo 的属性
END_IF;
</xhtml></ST>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
