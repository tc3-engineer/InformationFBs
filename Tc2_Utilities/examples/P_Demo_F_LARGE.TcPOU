<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_LARGE" Id="{c7fb4aad-7dc8-590c-b755-8748647da88a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_LARGE
VAR
    lgLargeCounter : T_LARGE_INTEGER; // 业务量（T_LARGE_INTEGER）
    bPackArg       : BOOL; // 在线置 TRUE 触发一次打包
    argDescriptor  : T_Arg; // 打包后的 T_Arg 描述符（含 eType/cbLen/pData）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// Tc2_Utilities.F_LARGE 演示程序（FUNCTION，返回 T_Arg）
// ============================================================
// 场景：把 T_LARGE_INTEGER 业务量打包为 T_Arg，供下游 EventLogger / FormatString2
//       / ADS 消息的可变参数机制使用。
// 价值：替代手填 T_Arg 三字段（eType/cbLen/pData），一行调用搞定。
// 验证：在线写 lgLargeCounter 为示例值，bPackArg := TRUE；
//       下一周期 argDescriptor.cbLen = SIZEOF(T_LARGE_INTEGER)，argDescriptor.pData <> 0。
// ============================================================

IF bPackArg THEN
    // 单次完整调用：返回的 T_Arg 立即可喂给 F_PutInArg(arg := argDescriptor, ...)
    argDescriptor := F_LARGE(lgLargeCounter);
    bPackArg := FALSE;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
