  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_UInt64Rol" pouType="program">
        <interface>
          <localVars>
            <variable name="uliHashState">
              <type><derived name="T_ULARGE_INTEGER;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">哈希中间状态</xhtml></documentation>
            </variable>
            <variable name="dwShiftBits">
              <type><DWORD/></type>
              <initialValue><simpleValue value="31;"/></initialValue>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">MurmurHash3 推荐值</xhtml></documentation>
            </variable>
            <variable name="uliRotated">
              <type><derived name="T_ULARGE_INTEGER"/></type>
            </variable>
            <variable name="bRotate">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.UInt64Rol 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：MurmurHash3 64-bit 实现里 `k = ROTL(k, 31)` 的混淆步骤。
// 价值：替代手写 SHL + SHR + OR 三步；一次调用语义清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bRotate AND dwShiftBits &lt; 64 THEN
    // 必须 n &lt; 64，否则 PDF 未定义
    uliRotated := UInt64Rol(uliHashState, dwShiftBits);
    bRotate := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>
