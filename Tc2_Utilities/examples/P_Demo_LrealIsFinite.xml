  <types>
    <dataTypes/>
    <pous>
      <pou name="P_Demo_LrealIsFinite" pouType="program">
        <interface>
          <localVars>
            <variable name="lrPidOut">
              <type><derived name="LREAL;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">PID 输出</xhtml></documentation>
            </variable>
            <variable name="bFinite">
              <type><derived name="BOOL;"/></type>
              <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">是否安全使用</xhtml></documentation>
            </variable>
            <variable name="bCheck">
              <type><BOOL/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// ============================================================
// Tc2_Utilities.LrealIsFinite 演示程序（FUNCTION，单周期触发）
// ============================================================
// 场景：PID 输出做电机命令前必须先 finite 校验，否则下游 LREAL_TO_INT64 命中 PDF 未定义。
// 价值：替代手写 IEEE 754 位检测；一次调用语义清晰。
// 验证步骤：
//   1. 把本 PROGRAM 加到 PlcTask 调用列表
//   2. 编译 + 登录
//   3. 在线把 b... 触发位置 TRUE 一个周期
//   4. 观察输出变量是否符合期望
// ============================================================

IF bCheck THEN
    // 必须用变量传址 —— REFERENCE TO 不接表达式
    bFinite := LrealIsFinite(lrPidOut);
    bCheck := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
