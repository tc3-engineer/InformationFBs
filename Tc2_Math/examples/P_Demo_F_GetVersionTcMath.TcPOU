<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.5">
  <POU Name="P_Demo_F_GetVersionTcMath" Id="{97e3ecd9-d558-5b0b-9585-391ac8e9002e}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Demo_F_GetVersionTcMath
VAR
    nMajor_OldWay    : UINT; // 旧 API：F_GetVersionTcMath(1) 返回 major
    nMinor_OldWay    : UINT; // 旧 API：F_GetVersionTcMath(2) 返回 minor
    nRevision_OldWay : UINT; // 旧 API：F_GetVersionTcMath(3) 返回 revision
    nMajor_NewWay    : UINT; // 新 API：stLibVersion_Tc2_Math.iMajor
    nMinor_NewWay    : UINT; // 新 API：stLibVersion_Tc2_Math.iMinor
    nBuild_NewWay    : UINT; // 新 API 独有：stLibVersion_Tc2_Math.iBuild（旧 API 拿不到）
    nRevision_NewWay : UINT; // 新 API：stLibVersion_Tc2_Math.iRevision
    sVersion_NewWay  : STRING(23); // 新 API 独有：完整版本字符串，方便 HMI 显示
    bChecked         : BOOL; // 只跑一次的 latch（版本是编译期常量，无需每周期取）
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================================
// 场景：从 TwinCAT 2 迁移过来的老工程中残留 F_GetVersionTcMath 调用，本程序
//       并行对比旧 API（F_GetVersionTcMath）与新 API（stLibVersion_Tc2_Math
//       + F_CmpLibVersion）取相同版本数据，用作迁移参考。
//
// 价值：本程序是"反面教材"——展示旧 API 是新 API 的真子集，缺 build 字段、
//       缺字符串、需要传魔法数 1/2/3。新代码应一律改用新 API。
//
// 验证步骤：
//   1. 引用 Tc2_Math + Tc2_System
//   2. 在 PLC 项目右键 → Add Existing Item (.TcPOU) → 选本文件 → OK
//   3. 编译、登录、运行
//   4. 在线 monitor 看：
//      - nMajor_OldWay = nMajor_NewWay = 1
//      - nMinor_OldWay = nMinor_NewWay = 3
//      - nRevision_OldWay = nRevision_NewWay = 3
//      - nBuild_NewWay 独立有值（如 0），旧 API 完全拿不到这个字段
//      - sVersion_NewWay 显示 '1.3.3.0' 字符串
//   5. 结论：旧 API 是子集——没有任何继续使用的理由
// =============================================================================

IF NOT bChecked THEN
    bChecked := TRUE;

    // ─── 旧 API（弃用，仅迁移参考）──────────────────────
    // 注意：每个字段都要传魔法数 1/2/3，无 self-documenting
    nMajor_OldWay    := F_GetVersionTcMath(nVersionElement := 1);
    nMinor_OldWay    := F_GetVersionTcMath(nVersionElement := 2);
    nRevision_OldWay := F_GetVersionTcMath(nVersionElement := 3);

    // ─── 新 API（强烈推荐）─────────────────────────────
    // 直接成员访问；类型即文档；还能拿 build 与完整字符串
    nMajor_NewWay    := stLibVersion_Tc2_Math.iMajor;
    nMinor_NewWay    := stLibVersion_Tc2_Math.iMinor;
    nBuild_NewWay    := stLibVersion_Tc2_Math.iBuild;
    nRevision_NewWay := stLibVersion_Tc2_Math.iRevision;
    sVersion_NewWay  := stLibVersion_Tc2_Math.sVersion;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
